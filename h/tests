/*******************************************************************
 * File:        tests
 * Purpose:     Self-tests for the assemble_6502, assemble_6809,
 *              assemble_x86_64 and assemble_z80 libraries.
 * Author:      Charles Ferguson (Gerph)
 ******************************************************************/

#ifndef TESTS_H
#define TESTS_H

/*******************************************************************
 Function:      run_tests
 Description:   Runs all assemble_6502 self-tests, printing a line
                per failure and a summary at the end.
 Parameters:    none
 Returns:       the number of failing tests (0 if all passed)
 ******************************************************************/
int run_tests(void);

/*******************************************************************
 Function:      run_tests_6809
 Description:   Runs all assemble_6809 self-tests, printing a line
                per failure and a summary at the end.
 Parameters:    none
 Returns:       the number of failing tests (0 if all passed)
 ******************************************************************/
int run_tests_6809(void);

/*******************************************************************
 Function:      run_tests_x86_64
 Description:   Runs all assemble_x86_64 self-tests, printing a line
                per failure and a summary at the end.
 Parameters:    none
 Returns:       the number of failing tests (0 if all passed)
 ******************************************************************/
int run_tests_x86_64(void);

/*******************************************************************
 Function:      run_tests_z80
 Description:   Runs all assemble_z80 self-tests, printing a line
                per failure and a summary at the end.
 Parameters:    none
 Returns:       the number of failing tests (0 if all passed)
 ******************************************************************/
int run_tests_z80(void);

#endif
