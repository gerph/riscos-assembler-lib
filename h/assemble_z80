#ifndef ASSEMBLE_Z80_H
#define ASSEMBLE_Z80_H

#include <stdint.h>
#include <stddef.h>

#include "kernel.h"
#include "assemble_common.h"

/* Known deficiencies:
   - EQU is not supported, matching the original BBC BASIC (Z80)
     assembler on which this backend's pseudo-op behaviour is based.
   - Undocumented instructions are always enabled; there is no dialect
     option to restrict assembly to documented Z80 instructions. */

/* The Z80 has a single dialect, so (unlike assemble_6502)
   context->opt carries no CPU-specific bits; only the standard
   ASSEMBLE_OPT_* bits apply. Undocumented instructions (IXH/IXL/
   IYH/IYL halves, SLL, the DD CB/FD CB "shadow register" rotate/
   shift/RES/SET forms, and IN F,(C)/OUT (C),0) are always accepted;
   there is no flag to disable them, matching how this library treats
   such things elsewhere (assemble_6809 always accepts its full
   documented set with no dialect switch). */
typedef enum assemble_z80_error_variant
{
    ASSEMBLE_Z80_ERR_NONE = 0,
    ASSEMBLE_Z80_ERR_EXPECT_REGISTER,      /* Expected a register name */
    ASSEMBLE_Z80_ERR_EXPECT_CONDITION,     /* Expected a condition (NZ/Z/NC/C/PO/PE/P/M, or NZ/Z/NC/C for JR/DJNZ) */
    ASSEMBLE_Z80_ERR_BAD_ADDRESSING,       /* Mnemonic does not support this combination of operands */
    ASSEMBLE_Z80_ERR_EXPECT_COMMA,         /* Expected , */
    ASSEMBLE_Z80_ERR_EXPECT_RPAREN,        /* Indexed/indirect addressing: expected ) */
    ASSEMBLE_Z80_ERR_CONST_OVERFLOW_BYTE,  /* Immediate/displacement value out of range [-128..255] */
    ASSEMBLE_Z80_ERR_CONST_OVERFLOW_WORD,  /* Immediate value out of range [0..65535] */
    ASSEMBLE_Z80_ERR_OFFSET_OUT_OF_RANGE,  /* (IX+d)/(IY+d) displacement out of range [-128..127] */
    ASSEMBLE_Z80_ERR_BRANCH_RANGE,         /* JR/DJNZ target out of range */
    ASSEMBLE_Z80_ERR_BAD_BIT_INDEX,        /* BIT/RES/SET bit index not in [0..7] */
    ASSEMBLE_Z80_ERR_BAD_RST,              /* RST operand not one of 0,8,16,...,56 */
    ASSEMBLE_Z80_ERR_BAD_IM,               /* IM operand not 0, 1 or 2 */
    ASSEMBLE_Z80_ERR_BAD_HL_HL             /* LD (HL),(HL) is not a valid instruction (that encoding is HALT) */
} assemble_z80_error_variant_t;

/*******************************************************************
 Function:      assemble_z80_line
 Description:   Assembles one line of tokenised BASIC source as a
                Z80 instruction, label definition or data pseudo-op
                (DEFB/DB, DEFW/DW, DEFM/DM, OPT), writing the result
                to context->buffer (or just measuring it, if
                context->buffer_length is -1). context->bytes_used is
                set to the number of bytes written or that would have
                been written. All multi-byte values are little-endian,
                matching the Z80 itself. There is no EQU pseudo-op,
                matching the original BBC BASIC (Z80) assembler this
                is ported from.
 Parameters:    context = the assembly context; address, buffer,
                          buffer_length and opt must be filled in
                line = tokenised BASIC source for the line, not
                       including the terminating CR/LF
                line_length = number of bytes at 'line'
 Returns:       NULL if successful, otherwise a pointer to a static
                error block (see assemble_common.h)
 ******************************************************************/
_kernel_oserror *assemble_z80_line(assemble_context_t *context,
                                    const uint8_t *line,
                                    size_t line_length);

#endif
