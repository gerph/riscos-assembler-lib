#define ASSEMBLER_ERROR_TEXT_SIZE 252
#define ASSEMBLER_OWNER_CALLER 1
#define ASSEMBLER_OWNER_ASSEMBLER 2

typedef struct symbol
{
    struct symbol *next;
    char *name;
    int32_t value;
    int owner;
} symbol_t;

typedef struct assembler_context
{
    struct assembler_context *next;
    uint32_t handle;
    assemble_line_fn assemble;
    int pass;
    int line_started;
    uint8_t *buffer;
    int32_t remaining;
    uint32_t address;
    uint32_t unresolved_count;
    int record_references;
    symbol_t *symbols;
    int last_valid;
    int last_module_error;
    uint32_t last_classifier;
    char last_message[ASSEMBLER_ERROR_TEXT_SIZE];
} assembler_context_t;

typedef struct expression_parser
{
    assembler_context_t *context;
    const uint8_t *text;
    size_t length;
    size_t pos;
    int failed;
} expression_parser_t;

static assembler_context_t *contexts;
static uint32_t next_handle = 1;

/*******************************************************************
 Function:      clear_error
 Description:   Clears a context's saved diagnostic after success.
 Parameters:    context = context to update
 Returns:       none
 ******************************************************************/
static void clear_error(assembler_context_t *context)
{
    context->last_valid = 0;
    context->last_module_error = 0;
    context->last_classifier = 0;
    context->last_message[0] = '\0';
}

static void set_error(assembler_context_t *context, _kernel_oserror *error,
                      _kernel_oserror *module_error)
{
    if (context == NULL) return;
    context->last_valid = 1;
    context->last_module_error = module_error == NULL ? 0 : module_error->errnum;
    context->last_classifier = error == NULL ? 0 : (uint32_t) error->errnum;
    if (error != NULL) strncpy(context->last_message, error->errmess,
                               ASSEMBLER_ERROR_TEXT_SIZE - 1);
    else if (module_error != NULL) strncpy(context->last_message, module_error->errmess,
                                           ASSEMBLER_ERROR_TEXT_SIZE - 1);
    else context->last_message[0] = '\0';
    context->last_message[ASSEMBLER_ERROR_TEXT_SIZE - 1] = '\0';
}

static assembler_context_t *find_context(uint32_t handle)
{
    assembler_context_t *context;
    for (context = contexts; context != NULL; context = context->next)
        if (context->handle == handle) return context;
    return NULL;
}

static void free_symbols(symbol_t *symbol)
{
    symbol_t *next;
    while (symbol != NULL)
    {
        next = symbol->next;
        free(symbol->name);
        free(symbol);
        symbol = next;
    }
}

static symbol_t *copy_symbols(const symbol_t *source)
{
    symbol_t *head = NULL;
    symbol_t **tail = &head;
    while (source != NULL)
    {
        symbol_t *item = (symbol_t *) malloc(sizeof(*item));
        size_t length;
        if (item == NULL) { free_symbols(head); return NULL; }
        length = strlen(source->name);
        item->name = (char *) malloc(length + 1);
        if (item->name == NULL) { free(item); free_symbols(head); return NULL; }
        memcpy(item->name, source->name, length + 1);
        item->value = source->value;
        item->owner = source->owner;
        item->next = NULL;
        *tail = item;
        tail = &item->next;
        source = source->next;
    }
    return head;
}

static symbol_t *find_symbol(assembler_context_t *context, const char *name, size_t length)
{
    symbol_t *symbol;
    for (symbol = context->symbols; symbol != NULL; symbol = symbol->next)
        if (strlen(symbol->name) == length && memcmp(symbol->name, name, length) == 0) return symbol;
    return NULL;
}

static int add_symbol(assembler_context_t *context, const char *name, size_t length,
                      int32_t value, int owner)
{
    symbol_t *symbol = (symbol_t *) malloc(sizeof(*symbol));
    if (symbol == NULL) return 0;
    symbol->name = (char *) malloc(length + 1);
    if (symbol->name == NULL) { free(symbol); return 0; }
    memcpy(symbol->name, name, length);
    symbol->name[length] = '\0';
    symbol->value = value;
    symbol->owner = owner;
    symbol->next = context->symbols;
    context->symbols = symbol;
    return 1;
}

static void remove_assembler_symbols(assembler_context_t *context)
{
    symbol_t **link = &context->symbols;
    while (*link != NULL)
    {
        symbol_t *symbol = *link;
        if (symbol->owner == ASSEMBLER_OWNER_ASSEMBLER)
        {
            *link = symbol->next;
            free(symbol->name);
            free(symbol);
        }
        else link = &symbol->next;
    }
}

static int identifier_start(int ch)
{
    return (ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') || ch == '_';
}

static int identifier_char(int ch)
{
    return identifier_start(ch) || (ch >= '0' && ch <= '9');
}

static void skip_spaces(expression_parser_t *parser)
{
    while (parser->pos < parser->length &&
           (parser->text[parser->pos] == ' ' || parser->text[parser->pos] == '\t')) parser->pos += 1;
}

static int match_word(expression_parser_t *parser, const char *word)
{
    size_t length = strlen(word);
    size_t pos;
    skip_spaces(parser);
    if (parser->pos + length > parser->length ||
        memcmp(parser->text + parser->pos, word, length) != 0) return 0;
    pos = parser->pos + length;
    if (pos < parser->length && identifier_char(parser->text[pos])) return 0;
    parser->pos = pos;
    return 1;
}

static int32_t parse_or(expression_parser_t *parser);

static int parse_primary(expression_parser_t *parser, int32_t *result)
{
    size_t start;
    int sign = 1;
    uint32_t value = 0;
    symbol_t *symbol;
    skip_spaces(parser);
    if (parser->pos < parser->length && (parser->text[parser->pos] == '+' || parser->text[parser->pos] == '-'))
    {
        if (parser->text[parser->pos++] == '-') sign = -1;
        if (!parse_primary(parser, result)) return 0;
        if (sign < 0)
        {
            if (*result == INT32_MIN) { parser->failed = 1; return 0; }
            *result = -*result;
        }
        return 1;
    }
    if (parser->pos < parser->length && parser->text[parser->pos] == '(')
    {
        parser->pos += 1;
        *result = parse_or(parser);
        skip_spaces(parser);
        if (parser->failed || parser->pos >= parser->length || parser->text[parser->pos++] != ')')
        { parser->failed = 1; return 0; }
        return 1;
    }
    if (parser->pos < parser->length && (parser->text[parser->pos] == '&' ||
        (parser->text[parser->pos] >= '0' && parser->text[parser->pos] <= '9')))
    {
        int base = parser->text[parser->pos] == '&' ? 16 : 10;
        int digit;
        if (base == 16) parser->pos += 1;
        start = parser->pos;
        while (parser->pos < parser->length)
        {
            int ch = parser->text[parser->pos];
            if (ch >= '0' && ch <= '9') digit = ch - '0';
            else if (ch >= 'A' && ch <= 'F') digit = ch - 'A' + 10;
            else if (ch >= 'a' && ch <= 'f') digit = ch - 'a' + 10;
            else break;
            if (digit >= base || value > (uint32_t) INT32_MAX / (uint32_t) base ||
                (value == (uint32_t) INT32_MAX / (uint32_t) base &&
                 (uint32_t) digit > (uint32_t) INT32_MAX % (uint32_t) base))
            { parser->failed = 1; return 0; }
            value = value * (uint32_t) base + (uint32_t) digit;
            parser->pos += 1;
        }
        if (start == parser->pos) { parser->failed = 1; return 0; }
        *result = (int32_t) value;
        return 1;
    }
    if (parser->pos < parser->length && identifier_start(parser->text[parser->pos]))
    {
        start = parser->pos++;
        while (parser->pos < parser->length && identifier_char(parser->text[parser->pos])) parser->pos += 1;
        symbol = find_symbol(parser->context, (const char *) parser->text + start, parser->pos - start);
        if (symbol != NULL) { *result = symbol->value; return 1; }
        if (parser->context->pass == ASSEMBLER_PASS_FIRST)
        {
            if (parser->context->record_references) parser->context->unresolved_count += 1;
            *result = 0;
            return 1;
        }
    }
    parser->failed = 1;
    return 0;
}

static int checked_binary(int32_t lhs, int32_t rhs, int op, int32_t *result)
{
    if (op == '+')
    {
        if ((rhs > 0 && lhs > INT32_MAX - rhs) || (rhs < 0 && lhs < INT32_MIN - rhs)) return 0;
        *result = lhs + rhs;
    }
    else if (op == '-')
    {
        if ((rhs < 0 && lhs > INT32_MAX + rhs) || (rhs > 0 && lhs < INT32_MIN + rhs)) return 0;
        *result = lhs - rhs;
    }
    else if (op == '*')
    {
        if (lhs != 0 && (rhs == INT32_MIN || (lhs == -1 && rhs == INT32_MIN) ||
            lhs > INT32_MAX / rhs || lhs < INT32_MIN / rhs)) return 0;
        *result = lhs * rhs;
    }
    else if (op == '/')
    {
        if (rhs == 0 || (lhs == INT32_MIN && rhs == -1)) return 0;
        *result = lhs / rhs;
    }
    else if (op == '%')
    {
        if (rhs == 0 || (lhs == INT32_MIN && rhs == -1)) return 0;
        *result = lhs % rhs;
    }
    return 1;
}

static int32_t parse_multiply(expression_parser_t *parser)
{
    int32_t value, rhs;
    if (!parse_primary(parser, &value)) return 0;
    for (;;)
    {
        int op;
        skip_spaces(parser);
        if (parser->pos < parser->length && (parser->text[parser->pos] == '*' || parser->text[parser->pos] == '/'))
            op = parser->text[parser->pos++];
        else if (match_word(parser, "MOD")) op = '%';
        else break;
        if (!parse_primary(parser, &rhs) || !checked_binary(value, rhs, op, &value)) { parser->failed = 1; return 0; }
    }
    return value;
}

static int32_t parse_add(expression_parser_t *parser)
{
    int32_t value = parse_multiply(parser), rhs;
    while (!parser->failed)
    {
        int op;
        skip_spaces(parser);
        if (parser->pos >= parser->length || (parser->text[parser->pos] != '+' && parser->text[parser->pos] != '-')) break;
        op = parser->text[parser->pos++];
        rhs = parse_multiply(parser);
        if (parser->failed || !checked_binary(value, rhs, op, &value)) { parser->failed = 1; break; }
    }
    return value;
}

static int32_t parse_shift(expression_parser_t *parser)
{
    int32_t value = parse_add(parser), rhs;
    while (!parser->failed)
    {
        int left;
        skip_spaces(parser);
        if (parser->pos + 1 >= parser->length || parser->text[parser->pos] != '<' && parser->text[parser->pos] != '>') break;
        left = parser->text[parser->pos] == '<';
        if (parser->text[parser->pos + 1] != parser->text[parser->pos]) break;
        parser->pos += 2;
        rhs = parse_add(parser);
        if (parser->failed || rhs < 0 || rhs >= 32) { parser->failed = 1; break; }
        value = left ? (int32_t) ((uint32_t) value << rhs) : value >> rhs;
    }
    return value;
}

static int32_t parse_and(expression_parser_t *parser)
{
    int32_t value = parse_shift(parser), rhs;
    while (!parser->failed && match_word(parser, "AND"))
    { rhs = parse_shift(parser); if (parser->failed) break; value &= rhs; }
    return value;
}

static int32_t parse_eor(expression_parser_t *parser)
{
    int32_t value = parse_and(parser), rhs;
    while (!parser->failed && match_word(parser, "EOR"))
    { rhs = parse_and(parser); if (parser->failed) break; value ^= rhs; }
    return value;
}

static int32_t parse_or(expression_parser_t *parser)
{
    int32_t value = parse_eor(parser), rhs;
    while (!parser->failed && match_word(parser, "OR"))
    { rhs = parse_eor(parser); if (parser->failed) break; value |= rhs; }
    return value;
}

static assemble_result_t resolve_expression(void *user_data, const uint8_t *text, size_t length,
                                            assemble_value_t *value, size_t *consumed,
                                            _kernel_oserror **error)
{
    expression_parser_t parser;
    parser.context = (assembler_context_t *) user_data;
    parser.text = text;
    parser.length = length;
    parser.pos = 0;
    parser.failed = 0;
    value->type = ASSEMBLE_VALUE_INTEGER;
    value->value.as_integer = parse_or(&parser);
    if (parser.failed || parser.pos == 0) { *error = Err_Expression; return ASSEMBLE_RESULT_ERROR; }
    *consumed = parser.pos;
    return ASSEMBLE_RESULT_OK;
}

static assemble_result_t assign_variable(void *user_data, const char *name, size_t length,
                                         const assemble_value_t *value, _kernel_oserror **error)
{
    assembler_context_t *context = (assembler_context_t *) user_data;
    symbol_t *symbol;
    if (length == 0 || value->type != ASSEMBLE_VALUE_INTEGER) { *error = Err_Value; return ASSEMBLE_RESULT_ERROR; }
    symbol = find_symbol(context, name, length);
    if (symbol == NULL)
    {
        if (!add_symbol(context, name, length, value->value.as_integer, ASSEMBLER_OWNER_ASSEMBLER))
        { *error = Err_NoMemory; return ASSEMBLE_RESULT_ERROR; }
        return ASSEMBLE_RESULT_OK;
    }
    if (symbol->owner == ASSEMBLER_OWNER_CALLER) { *error = Err_ProtectedValue; return ASSEMBLE_RESULT_ERROR; }
    if (symbol->value == value->value.as_integer) return ASSEMBLE_RESULT_OK;
    *error = Err_Value;
    return ASSEMBLE_RESULT_ERROR;
}

/* assembler_cpu_t (h/assembler) is deliberately numbered the same as
   assemble_cpu_class_t (Assemble's h/assemble_common), so the SWI's
   CPU ID can be passed straight through to the registry. */
static assemble_line_fn cpu_assembler(uint32_t cpu)
{
    const assemble_interface_t *iface = assemble_find_by_class((assemble_cpu_class_t) cpu);
    return iface != NULL ? iface->assemble_line : NULL;
}

static _kernel_oserror *assemble_line(assembler_context_t *context, const uint8_t *line,
                                      size_t length, uint32_t opt, uint32_t *bytes)
{
    assemble_context_t backend;
    _kernel_oserror *error;
    symbol_t *snapshot;
    uint32_t old_unresolved;
    uint32_t counted_unresolved;
    uint8_t *staging = NULL;
    if (context->pass == 0) return Err_BadPass;
    snapshot = copy_symbols(context->symbols);
    if (context->symbols != NULL && snapshot == NULL) return Err_NoMemory;
    old_unresolved = context->unresolved_count;
    memset(&backend, 0, sizeof(backend));
    backend.buffer = NULL;
    backend.buffer_length = -1;
    backend.address = context->address;
    backend.opt = opt;
    backend.resolve_expr = resolve_expression;
    backend.assign_var = assign_variable;
    backend.user_data = context;
    context->record_references = 1;
    error = context->assemble(&backend, line, length);
    counted_unresolved = context->unresolved_count;
    if (error != NULL)
    {
        free_symbols(context->symbols);
        context->symbols = snapshot;
        context->unresolved_count = old_unresolved;
        set_error(context, error, Err_Assembly);
        return Err_Assembly;
    }
    if (context->buffer != NULL)
    {
        staging = (uint8_t *) malloc(backend.bytes_used == 0 ? 1 : backend.bytes_used);
        if (staging == NULL)
        {
            free_symbols(context->symbols);
            context->symbols = snapshot;
            context->unresolved_count = old_unresolved;
            set_error(context, NULL, Err_NoMemory);
            return Err_NoMemory;
        }
        free_symbols(context->symbols);
        context->symbols = copy_symbols(snapshot);
        if (snapshot != NULL && context->symbols == NULL)
        {
            free(staging);
            context->symbols = snapshot;
            context->unresolved_count = old_unresolved;
            set_error(context, NULL, Err_NoMemory);
            return Err_NoMemory;
        }
        context->unresolved_count = old_unresolved;
        context->record_references = 0;
        backend.buffer = staging;
        backend.buffer_length = (int32_t) backend.bytes_used;
        backend.bytes_used = 0;
        error = context->assemble(&backend, line, length);
        if (error != NULL)
        {
            free(staging);
            free_symbols(context->symbols);
            context->symbols = snapshot;
            context->unresolved_count = old_unresolved;
            set_error(context, error, Err_Assembly);
            return Err_Assembly;
        }
        if (backend.bytes_used > (uint32_t) context->remaining)
        {
            free(staging);
            free_symbols(context->symbols);
            context->symbols = snapshot;
            context->unresolved_count = old_unresolved;
            set_error(context, NULL, Err_BadParameter);
            return Err_BadParameter;
        }
        memcpy(context->buffer, staging, backend.bytes_used);
        free(staging);
        free_symbols(snapshot);
    }
    else free_symbols(snapshot);
    context->unresolved_count = counted_unresolved;
    context->record_references = 0;
    context->address += backend.bytes_used;
    if (context->buffer != NULL) { context->buffer += backend.bytes_used; context->remaining -= (int32_t) backend.bytes_used; }
    context->line_started = 1;
    *bytes = backend.bytes_used;
    clear_error(context);
    return NULL;
}

_kernel_oserror *Mod_Init(const char *tail, int podule_base, void *pw)
{
    (void) tail; (void) podule_base; (void) pw;
    contexts = NULL;
    next_handle = 1;
    return NULL;
}

_kernel_oserror *Mod_Final(int fatal, int podule_base, void *pw)
{
    (void) fatal; (void) podule_base; (void) pw;
    if (contexts != NULL) return Err_ContextsActive;
    return NULL;
}

_kernel_oserror *SWI_Create(int number, _kernel_swi_regs *r, void *pw)
{
    assembler_context_t *context;
    (void) number; (void) pw;
    if (cpu_assembler((uint32_t) r->r[0]) == NULL) return Err_BadCPU;
    context = (assembler_context_t *) calloc(1, sizeof(*context));
    if (context == NULL) return Err_NoMemory;
    context->assemble = cpu_assembler((uint32_t) r->r[0]);
    context->handle = next_handle++;
    if (context->handle == 0) context->handle = next_handle++;
    context->next = contexts;
    contexts = context;
    r->r[0] = (int) context->handle;
    return NULL;
}

_kernel_oserror *SWI_Destroy(int number, _kernel_swi_regs *r, void *pw)
{
    assembler_context_t **link = &contexts;
    (void) number; (void) pw;
    while (*link != NULL && (*link)->handle != (uint32_t) r->r[0]) link = &(*link)->next;
    if (*link == NULL) return Err_BadHandle;
    {
        assembler_context_t *context = *link;
        *link = context->next;
        free_symbols(context->symbols);
        free(context);
    }
    return NULL;
}

_kernel_oserror *SWI_BeginPass(int number, _kernel_swi_regs *r, void *pw)
{
    assembler_context_t *context = find_context((uint32_t) r->r[0]);
    int phase = r->r[1];
    (void) number; (void) pw;
    if (context == NULL) return Err_BadHandle;
    if (phase != ASSEMBLER_PASS_FIRST && phase != ASSEMBLER_PASS_SECOND) { set_error(context, NULL, Err_BadPass); return Err_BadPass; }
    if (phase == ASSEMBLER_PASS_SECOND && context->pass != ASSEMBLER_PASS_FIRST) { set_error(context, NULL, Err_BadPass); return Err_BadPass; }
    if (phase == ASSEMBLER_PASS_FIRST)
    {
        remove_assembler_symbols(context);
        context->unresolved_count = 0;
        context->line_started = 0;
    }
    if (r->r[2] == 0 && r->r[3] != -1) { set_error(context, NULL, Err_BadParameter); return Err_BadParameter; }
    if (phase == ASSEMBLER_PASS_SECOND && (r->r[2] == 0 || r->r[3] < 0)) { set_error(context, NULL, Err_BadParameter); return Err_BadParameter; }
    context->pass = phase;
    context->buffer = (uint8_t *) (intptr_t) r->r[2];
    context->remaining = r->r[3];
    context->address = (uint32_t) r->r[4];
    r->r[0] = phase == ASSEMBLER_PASS_SECOND ? (int) context->unresolved_count : 0;
    clear_error(context);
    return NULL;
}

_kernel_oserror *SWI_AssembleLine(int number, _kernel_swi_regs *r, void *pw)
{
    assembler_context_t *context = find_context((uint32_t) r->r[0]);
    uint32_t bytes;
    _kernel_oserror *error;
    (void) number; (void) pw;
    if (context == NULL) return Err_BadHandle;
    if (r->r[1] == 0 || r->r[2] < 0) { set_error(context, NULL, Err_BadParameter); return Err_BadParameter; }
    error = assemble_line(context, (const uint8_t *) (intptr_t) r->r[1], (size_t) r->r[2], (uint32_t) r->r[3], &bytes);
    if (error != NULL) return error;
    r->r[0] = (int) bytes;
    r->r[1] = (int) context->address;
    r->r[2] = (int) (intptr_t) context->buffer;
    r->r[3] = context->remaining;
    return NULL;
}

_kernel_oserror *SWI_Value(int number, _kernel_swi_regs *r, void *pw)
{
    assembler_context_t *context = find_context((uint32_t) r->r[0]);
    const char *name = (const char *) (intptr_t) r->r[2];
    size_t length = (size_t) r->r[3];
    assembler_module_value_t *value = (assembler_module_value_t *) (intptr_t) r->r[4];
    symbol_t *symbol;
    (void) number; (void) pw;
    if (context == NULL) return Err_BadHandle;
    if (name == NULL || length == 0 || value == NULL) { set_error(context, NULL, Err_BadParameter); return Err_BadParameter; }
    symbol = find_symbol(context, name, length);
    if (r->r[1] == ASSEMBLER_VALUE_READ)
    {
        if (symbol == NULL) { set_error(context, NULL, Err_Value); return Err_Value; }
        value->magic = ASSEMBLER_VALUE_MAGIC; value->type = ASSEMBLER_VALUE_INTEGER;
        value->integer = symbol->value; value->reserved = 0;
    }
    else if (r->r[1] == ASSEMBLER_VALUE_WRITE)
    {
        if (context->line_started || value->magic != ASSEMBLER_VALUE_MAGIC || value->type != ASSEMBLER_VALUE_INTEGER || value->reserved != 0)
        { set_error(context, NULL, Err_Value); return Err_Value; }
        if (symbol != NULL && symbol->owner != ASSEMBLER_OWNER_CALLER) { set_error(context, NULL, Err_ProtectedValue); return Err_ProtectedValue; }
        if (symbol != NULL) symbol->value = value->integer;
        else if (!add_symbol(context, name, length, value->integer, ASSEMBLER_OWNER_CALLER)) { set_error(context, NULL, Err_NoMemory); return Err_NoMemory; }
    }
    else if (r->r[1] == ASSEMBLER_VALUE_DELETE)
    {
        symbol_t **link = &context->symbols;
        if (context->line_started) { set_error(context, NULL, Err_Value); return Err_Value; }
        while (*link != NULL && *link != symbol) link = &(*link)->next;
        if (symbol == NULL) { set_error(context, NULL, Err_Value); return Err_Value; }
        if (symbol->owner != ASSEMBLER_OWNER_CALLER) { set_error(context, NULL, Err_ProtectedValue); return Err_ProtectedValue; }
        *link = symbol->next; free(symbol->name); free(symbol);
    }
    else { set_error(context, NULL, Err_BadParameter); return Err_BadParameter; }
    clear_error(context);
    return NULL;
}

_kernel_oserror *SWI_Evaluate(int number, _kernel_swi_regs *r, void *pw)
{
    assembler_context_t *context = find_context((uint32_t) r->r[0]);
    expression_parser_t parser;
    assembler_module_value_t *value = (assembler_module_value_t *) (intptr_t) r->r[3];
    (void) number; (void) pw;
    if (context == NULL) return Err_BadHandle;
    if (r->r[1] == 0 || r->r[2] < 0 || value == NULL) { set_error(context, NULL, Err_BadParameter); return Err_BadParameter; }
    parser.context = context; parser.text = (const uint8_t *) (intptr_t) r->r[1]; parser.length = (size_t) r->r[2]; parser.pos = 0; parser.failed = 0;
    value->integer = parse_or(&parser); skip_spaces(&parser);
    if (parser.failed || parser.pos != parser.length) { set_error(context, NULL, Err_Expression); return Err_Expression; }
    value->magic = ASSEMBLER_VALUE_MAGIC; value->type = ASSEMBLER_VALUE_INTEGER; value->reserved = 0;
    clear_error(context);
    return NULL;
}

_kernel_oserror *SWI_Capabilities(int number, _kernel_swi_regs *r, void *pw)
{
    (void) number; (void) pw;
    if (r->r[0] == 0)
    {
        size_t count, i;
        const assemble_interface_t *interfaces = assemble_get_interfaces(&count);
        uint32_t cpu_mask = 0;

        for (i = 0; i < count; i++) cpu_mask |= (1u << interfaces[i].cpu_class);
        r->r[0] = ASSEMBLER_API_VERSION;
        r->r[1] = (int) cpu_mask;
        r->r[2] = 1 << ASSEMBLER_VALUE_INTEGER;
    }
    else if (r->r[0] == 1)
    {
        const assemble_interface_t *iface = assemble_find_by_class((assemble_cpu_class_t) r->r[1]);
        uint32_t opt_mask;
        size_t j;

        if (iface == NULL) return Err_BadParameter;
        opt_mask = 0;
        for (j = 0; j < iface->opt_flag_count; j++) opt_mask |= iface->opt_flags[j].bit;
        r->r[0] = r->r[1];
        r->r[2] = (int) opt_mask;
    }
    else return Err_BadParameter;
    return NULL;
}

_kernel_oserror *SWI_LastError(int number, _kernel_swi_regs *r, void *pw)
{
    assembler_context_t *context = find_context((uint32_t) r->r[0]);
    char *buffer = (char *) (intptr_t) r->r[1];
    int32_t size = r->r[2];
    size_t needed;
    (void) number; (void) pw;
    if (context == NULL) return Err_BadHandle;
    if (!context->last_valid) { r->r[0] = 0; r->r[1] = 0; r->r[2] = 0; return NULL; }
    needed = strlen(context->last_message) + 1;
    if (buffer == NULL) { r->r[0] = context->last_module_error; r->r[1] = (int) context->last_classifier; r->r[2] = (int) needed; return NULL; }
    if (size < 0 || (size_t) size < needed) { r->r[2] = -(int) needed; return Err_BufferOverflow; }
    memcpy(buffer, context->last_message, needed);
    r->r[0] = context->last_module_error; r->r[1] = (int) context->last_classifier; r->r[2] = (int) needed;
    return NULL;
}

_kernel_oserror *Mod_SWI(int swi, _kernel_swi_regs *r, void *pw)
{
    (void) swi; (void) r; (void) pw;
    return error_BAD_SWI;
}
