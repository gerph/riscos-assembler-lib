static const unsigned char segpfx[] = {0x26, 0x2E, 0x36, 0x3E, 0x64, 0x65} ;

#define NUM_MNEMONICS (sizeof(mnemonics) / sizeof(mnemonics[0]))
#define NUM_SPECIALS  (sizeof(specials) / sizeof(specials[0]))
#define NUM_OPERANDS  (sizeof(operands) / sizeof(operands[0]))
#define NUM_INSTRUCTIONS (sizeof(instructions) / 6)

/* Bytes 2 and 3 of an instruction table entry, taken together, are a
   16-bit encoding flags word (see the big comment in x86_encode()
   below); reading them with an aligned byte-by-byte assembly (rather
   than casting to short* and dereferencing, as the original does)
   avoids relying on unaligned-access tolerance. */
static uint16_t read_flags(const unsigned char *entry)
{
    return (uint16_t) (entry[2] | (entry[3] << 8));
}

/* nchop()'s binary search compares the packed 32-bit sort key formed
   from bytes [2..5] of an entry (mnemonic index, operand1 and
   operand2 acceptance ranges); read that explicitly as little-endian
   rather than an unaligned unsigned int* cast. */
static uint32_t read_sortkey(const unsigned char *entry_plus_2)
{
    return (uint32_t) entry_plus_2[0] |
           ((uint32_t) entry_plus_2[1] << 8) |
           ((uint32_t) entry_plus_2[2] << 16) |
           ((uint32_t) entry_plus_2[3] << 24);
}

/* Character class used by scan_table() to find the extent of an
   operand token. This intentionally matches the original's odd
   '>= A, except ]' rule rather than isalpha(): several operands[]
   entries ("[RAX" etc) literally embed their opening bracket in the
   table string, so '[' must scan as an ordinary identifier
   character for those to ever match as a single token. Tokenised
   BASIC keyword bytes (>=0x80) are excluded, matching the original's
   behaviour under signed-char comparison. */
static int x86_scan_char(uint8_t ch)
{
    if (ch >= 0x80)
    {
        return 0;
    }
    return (ch >= 'A' && ch != ']') || (ch >= '0' && ch <= '9');
}

/* Character class used by schop_mnemonic(): as x86_scan_char() but
   without the ']' exclusion (irrelevant for pure-alpha mnemonics;
   kept distinct to mirror the original's two separate functions). */
static int x86_mnem_char(uint8_t ch)
{
    if (ch >= 0x80)
    {
        return 0;
    }
    return (ch >= 'A') || (ch >= '0' && ch <= '9');
}

/* Case-insensitive comparison of the 'n' bytes at 'text' against the
   NUL-terminated string 'q', requiring an exact length match (a
   proper prefix of a longer 'q' compares as less-than, matching the
   original cmps()/strnicmp semantics). */
static int cmps(const uint8_t *text, size_t n, const char *q)
{
    size_t qlen = strlen(q);
    size_t minlen = (n < qlen) ? n : qlen;
    size_t i;

    for (i = 0; i < minlen; i++)
    {
        int a = toupper((int) text[i]);
        int b = toupper((int) (unsigned char) q[i]);

        if (a != b)
        {
            return (a < b) ? -1 : 1;
        }
    }
    if (n != qlen)
    {
        return (n < qlen) ? -1 : 1;
    }
    return 0;
}

/* Scan for an identifier in the unordered 'operands' table (linear
   search). Returns the index, or -1 if the identifier at 'pos' (if
   any) does not match any entry; advances '*pos_inout' past the
   identifier only on a match. */
static int scan_table(const uint8_t *text, size_t length, size_t *pos_inout,
                       const char *const *arr, int num)
{
    size_t pos = *pos_inout;
    size_t n = 0;
    int i;

    while (pos + n < length && x86_scan_char(text[pos + n]))
    {
        n += 1;
    }
    if (n == 0)
    {
        return -1;
    }
    for (i = 0; i < num; i++)
    {
        if (cmps(text + pos, n, arr[i]) == 0)
        {
            *pos_inout = pos + n;
            return i;
        }
    }
    return -1;
}

/* Find an identifier in the ordered 'mnemonics' table (binary
   search); same identifier-scanning rule as scan_table(). */
static int schop_mnemonic(const uint8_t *text, size_t length, size_t *pos_inout)
{
    size_t pos = *pos_inout;
    size_t n = 0;
    int b = 0, c = 0, h = 1;

    while (pos + n < length && x86_mnem_char(text[pos + n]))
    {
        n += 1;
    }
    if (n == 0)
    {
        return -1;
    }
    while (h < (int) NUM_MNEMONICS)
    {
        h *= 2;
    }
    while (h)
    {
        int i;

        h /= 2;
        i = b + h;
        if (i < (int) NUM_MNEMONICS)
        {
            if ((c = cmps(text + pos, n, mnemonics[i])) >= 0)
            {
                b += h;
            }
        }
    }
    if (c != 0)
    {
        return -1;
    }
    *pos_inout = pos + n;
    return b;
}

/* Binary search of the (sorted) instructions[] table for the packed
   (mnemonic, operand1, operand2[, operand3]) sort key; see
   x86_lookup() for how the key is built. */
static int find_instruction(uint32_t key)
{
    int b = 0, h = 1;

    while (h < (int) NUM_INSTRUCTIONS)
    {
        h *= 2;
    }
    while (h)
    {
        int i;

        h /= 2;
        i = b + h;
        if (i < (int) NUM_INSTRUCTIONS)
        {
            if (key >= (0xFFFFFF00u & read_sortkey(instructions + 6 * i + 2)))
            {
                b += h;
            }
        }
    }
    if (key != (0xFFFFFF00u & read_sortkey(instructions + 6 * b + 2)))
    {
        return -1;
    }
    return b;
}

/* Lookup combination of mnemonic and operands in instructions table.
   Ported unchanged from the original lookup(): pure integer
   arithmetic over the packed sort key, trying each operand-size
   'promotion' in turn (eg an 8-bit-register table entry also serves
   16/32/64-bit registers, tried in order al,ax,eax,rax etc). */
static int x86_lookup(int mnemonic, int operand1, int operand2, int operand3)
{
    int instruction = 0;
    int promote;
    int found;

    if ((operand1 >= 0x78) && (operand1 <= 0x7B)) /* SPL etc. */
    {
        operand1 -= 0x74;
    }
    if ((operand2 >= 0x78) && (operand2 <= 0x7B)) /* SPL etc. */
    {
        operand2 -= 0x74;
    }

    for (promote = 0; promote < 180; promote++)
    {
        instruction = (mnemonic << 23) | (operand1 << 16) | (operand2 << 9);
        if ((operand1 == 0x7E) || (operand2 == 0x7E) || (operand3 == 0x7E))
        {
            instruction |= 0x00000100;
        }
        if (promote / 90)
        {
            instruction &= ~0x00000100;
        }

        switch (promote % 10) /* vertical promotion (do first for al,ax,eax special cases) */
        {
            case 9: instruction |= 0x00102000 ; /* 0x->1x regb,regb */
            case 8:
                if (instruction & 0x00204000)
                {
                    continue;
                }
                instruction += 0x00102000 ; /* 1x->2x regw,regw */
            case 7: instruction |= 0x00102000 ; /* 2x->3x regq,regq */
                if (instruction & 0x00408000)
                {
                    continue;
                }
                break;

            case 6: instruction |= 0x00002000 ; /* 0x->1x nc,regb */
            case 5:
                if (instruction & 0x00004000)
                {
                    continue;
                }
                instruction += 0x00002000 ; /* 1x->2x nc,regw */
            case 4: instruction |= 0x00002000 ; /* 2x->3x nc,regq */
                if (instruction & 0x00008000)
                {
                    continue;
                }
                break;

            case 3: instruction |= 0x00100000 ; /* 0x->1x regb,nc */
            case 2:
                if (instruction & 0x00200000)
                {
                    continue;
                }
                instruction += 0x00100000 ; /* 1x->2x regw,nc */
            case 1: instruction |= 0x00100000 ; /* 2x->3x regq,nc */
                if (instruction & 0x00400000)
                {
                    continue;
                }
        }
        switch ((promote / 10) % 3) /* horizontal promotion of operand 1 */
        {
            case 2: instruction |= 0x000F0000 ; /*        regd,[mem] */
            case 1: instruction |= 0x00070000 ; /*     STn/MMn,[mem] */
        }
        switch ((promote / 30) % 3) /* horizontal promotion of operand 2 */
        {
            case 2: instruction |= 0x00001E00 ; /*      [mem],regd */
            case 1: instruction |= 0x00000E00 ; /*      [mem],STn/MMn */
        }
        found = find_instruction((uint32_t) instruction);
        if (found >= 0)
        {
            return found;
        }
    }
    return -1;
}

/* ---- Lexer helpers ------------------------------------------------ */

static _kernel_oserror *x86_error_syntax(void)
{
    return assemble_set_error(ASSEMBLE_CPU_X86_64, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_X86_64_ERR_NONE,
                               "Syntax error");
}

/* Skips spaces at '*pos_inout' and returns the byte found there (or
   CR, matching BASIC's own line-terminator convention, at/past the
   end of the line); mutates '*pos_inout' to the skipped-to position,
   corresponding to the original external nxt(). */
static uint8_t x86_nxt(const uint8_t *text, size_t length, size_t *pos_inout)
{
    size_t pos = *pos_inout;

    while (pos < length && text[pos] == ' ')
    {
        pos += 1;
    }
    *pos_inout = pos;
    return (pos < length) ? text[pos] : 0x0D;
}

static size_t x86_skip_spaces(const uint8_t *text, size_t length, size_t pos)
{
    while (pos < length && text[pos] == ' ')
    {
        pos += 1;
    }
    return pos;
}

static int32_t value_to_integer(const assemble_value_t *value)
{
    switch (value->type)
    {
        case ASSEMBLE_VALUE_FLOAT:
            return (int32_t) value->value.as_float;
        case ASSEMBLE_VALUE_INTEGER:
        default:
            return value->value.as_integer;
    }
}

/* Evaluates a numeric expression at '*pos_inout' (ie expri()/expr()
   returning a non-string result), advancing '*pos_inout' past it. */
static _kernel_oserror *eval_numeric(assemble_context_t *context,
                                      const uint8_t *text, size_t length,
                                      size_t *pos_inout, int32_t *out_value)
{
    assemble_value_t value;
    size_t consumed;
    _kernel_oserror *error = NULL;

    if (context->resolve_expr(context->user_data, text + *pos_inout, length - *pos_inout,
                               &value, &consumed, &error) != ASSEMBLE_RESULT_OK)
    {
        if (error != NULL)
        {
            return error;
        }
        return assemble_set_error(ASSEMBLE_CPU_X86_64, ASSEMBLE_ERROR_TYPE_EXPRESSION, ASSEMBLE_X86_64_ERR_NONE,
                                   "Expression could not be evaluated");
    }
    if (value.type == ASSEMBLE_VALUE_STRING)
    {
        return assemble_set_error(ASSEMBLE_CPU_X86_64, ASSEMBLE_ERROR_TYPE_EXPRESSION, ASSEMBLE_X86_64_ERR_NONE,
                                   "Expected a numeric value");
    }
    *pos_inout += consumed;
    *out_value = value_to_integer(&value);
    return NULL;
}

/* Adds register 'reg' (0-15)'s scale contribution 'p' into the split
   64-bit sibinfo accumulator (registers 0-7 in *lo, 8-15 in *hi, 4
   bits per register) -- the same packing the original uses as a
   single 'long long', split across two 32-bit halves since neither
   the 32-bit nor 64-bit build of this library has a 64-bit integer
   type available (assemble_value_t itself only carries 32 bits).
 */
static void sib_add(uint32_t *lo, uint32_t *hi, int reg, int p)
{
    reg &= 15;
    if (reg < 8)
    {
        *lo += ((uint32_t) p) << (reg * 4);
    }
    else
    {
        *hi += ((uint32_t) p) << ((reg - 8) * 4);
    }
}

/*******************************************************************
 Function:      x86_sibeval
 Description:   Parses a 64-bit indexed memory operand's contents:
                reg{*n} {+{n*}reg{*n}}... {+disp | -disp}. Ported
                from the original sibeval().
 Parameters:    context = the assembly context
                text/length = the source line
                pos_inout = current position, just after the initial
                            '[reg' already matched by the caller
                type = the initial register's operand-table index
                       (0x40-0x4F range; only the low 4 bits, the
                       register number, are used)
                pdis = set to the trailing displacement, if any
                sib_lo/sib_hi = the accumulated register/scale info
 Returns:       NULL if successful, otherwise a static error block
 ******************************************************************/
static _kernel_oserror *x86_sibeval(assemble_context_t *context,
                                     const uint8_t *text, size_t length, size_t *pos_inout,
                                     int type, int32_t *pdis, uint32_t *sib_lo, uint32_t *sib_hi)
{
    size_t pos = *pos_inout;
    uint8_t c;
    int p = 1;
    _kernel_oserror *error;

    *sib_lo = 0;
    *sib_hi = 0;

    for (;;)
    {
        type &= 15;
        c = x86_nxt(text, length, &pos);
        if (c == '*')
        {
            pos += 1;
            c = x86_nxt(text, length, &pos);
            if (c < '1' || c > '9')
            {
                return x86_error_syntax();
            }
            p *= (c & 0xF);
            pos += 1;
            c = x86_nxt(text, length, &pos);
        }

        sib_add(sib_lo, sib_hi, type, p);
        p = 1;

        if (c == '-')
        {
            int32_t value;

            error = eval_numeric(context, text, length, &pos, &value);
            if (error != NULL)
            {
                return error;
            }
            *pdis = value;
            *pos_inout = pos;
            return NULL;
        }

        if (c != '+')
        {
            break;
        }

        pos += 1;
        c = x86_nxt(text, length, &pos);
        if (c >= '1' && c <= '9')
        {
            /* 'pos' already points at the digit (x86_nxt() only peeks);
               only commit past it if it really is a 'n*' scale prefix,
               otherwise leave 'pos' here so it can be re-read as the
               start of a plain displacement expression below. */
            size_t peek_pos = pos + 1;

            if (x86_nxt(text, length, &peek_pos) == '*')
            {
                p *= (c & 0xF);
                pos = x86_skip_spaces(text, length, peek_pos + 1);
            }
        }
        type = scan_table(text, length, &pos, operands, (int) NUM_OPERANDS);
        if (type < 0 && p == 1)
        {
            int32_t value;

            error = eval_numeric(context, text, length, &pos, &value);
            if (error != NULL)
            {
                return error;
            }
            *pdis = value;
            *pos_inout = pos;
            return NULL;
        }
        if (type < 0x20 || type > 0x2F)
        {
            return x86_error_syntax();
        }
    }

    *pos_inout = pos;
    return NULL;
}

/*******************************************************************
 Function:      x86_operand
 Description:   Parses and evaluates one operand. Ported from the
                original operand(). 'displacement' and 'immediate'
                are updated only if the operand is of the relevant
                type (0x7C, 0x7E). If no operand (or only a size/
                segment override) is present, *out_type is set to
                0x7F.
 Parameters:    context = the assembly context
                text/length = the source line
                pos_inout = current position
                pdis/pimm = displacement/immediate results
                povr = accumulated override bits
                sib_lo/sib_hi = indexed-addressing register info
                string_buf/string_len = capture buffer for a
                          string-valued operand (override bit 0x80),
                          eg an immediate byte-data or, in the
                          original, a system routine name -- this
                          port does not support resolving routine
                          names to addresses (see the file banner
                          comment), only embedding the string's own
                          bytes as data
                out_type = the resolved operand type
 Returns:       NULL if successful, otherwise a static error block
 ******************************************************************/
static _kernel_oserror *x86_operand(assemble_context_t *context,
                                     const uint8_t *text, size_t length, size_t *pos_inout,
                                     int32_t *pdis, int32_t *pimm, int *povr,
                                     uint32_t *sib_lo, uint32_t *sib_hi,
                                     uint8_t *string_buf, size_t *string_len,
                                     int *out_type)
{
    size_t pos = *pos_inout;
    uint8_t c;
    int type;
    _kernel_oserror *error;

    c = x86_nxt(text, length, &pos);
    if (c == 0x0D || c == ':' || c == ';')
    {
        *pos_inout = pos;
        *out_type = 0x7F;
        return NULL;
    }
    type = scan_table(text, length, &pos, operands, (int) NUM_OPERANDS);

    if (type >= 0x80) /* size override */
    {
        *povr |= 1 << (type - 0x80);
        *pos_inout = pos;
        return x86_operand(context, text, length, pos_inout, pdis, pimm, povr, sib_lo, sib_hi,
                            string_buf, string_len, out_type);
    }

    if (type >= 0x70 && type < 0x76 && pos < length && text[pos] == ':') /* segment override */
    {
        pos += 1;
        *povr |= 1 << (type - 0x68);
        *pos_inout = pos;
        return x86_operand(context, text, length, pos_inout, pdis, pimm, povr, sib_lo, sib_hi,
                            string_buf, string_len, out_type);
    }

    if (type == 0x7C) /* [rel dest] */
    {
        int32_t target;

        error = eval_numeric(context, text, length, &pos, &target);
        if (error != NULL)
        {
            return error;
        }
        *pdis = target - (int32_t) context->address;
        if (x86_nxt(text, length, &pos) != ']')
        {
            return x86_error_syntax();
        }
        pos += 1;
        *sib_lo = 0;
        *sib_hi = 0;
        *pos_inout = pos;
        *out_type = 0x45;
        return NULL;
    }

    if (type == 0x7D) /* [rip + disp] */
    {
        if (x86_nxt(text, length, &pos) != ']')
        {
            error = eval_numeric(context, text, length, &pos, pdis);
            if (error != NULL)
            {
                return error;
            }
        }
        if (x86_nxt(text, length, &pos) != ']')
        {
            return x86_error_syntax();
        }
        pos += 1;
        *sib_lo = 0;
        *sib_hi = 0;
        *pos_inout = pos;
        *out_type = 0x45; /* [rip coded as [rbp when SIB = 0 */
        return NULL;
    }

    if (type >= 0x40 && type <= 0x4F) /* indirect addressing */
    {
        uint8_t peek = x86_nxt(text, length, &pos);

        if (peek != ']' || type == 0x44 || type == 0x45 || type == 0x4C || type == 0x4D)
        {
            error = x86_sibeval(context, text, length, &pos, type, pdis, sib_lo, sib_hi);
            if (error != NULL)
            {
                return error;
            }
        }
        if (x86_nxt(text, length, &pos) != ']')
        {
            return x86_error_syntax();
        }
        pos += 1;
    }

    if (type >= 0)
    {
        *pos_inout = pos;
        *out_type = type;
        return NULL;
    }

    if (c == '[') /* direct address */
    {
        pos += 1;
        error = eval_numeric(context, text, length, &pos, pimm);
        if (error != NULL)
        {
            return error;
        }
        if (x86_nxt(text, length, &pos) != ']')
        {
            return x86_error_syntax();
        }
        pos += 1;
        *pos_inout = pos;
        *out_type = 0x7C;
        return NULL;
    }

    {
        assemble_value_t v;
        size_t consumed;

        error = NULL;
        if (context->resolve_expr(context->user_data, text + pos, length - pos, &v, &consumed, &error)
            != ASSEMBLE_RESULT_OK)
        {
            if (error != NULL)
            {
                return error;
            }
            return assemble_set_error(ASSEMBLE_CPU_X86_64, ASSEMBLE_ERROR_TYPE_EXPRESSION, ASSEMBLE_X86_64_ERR_NONE,
                                       "Expression could not be evaluated");
        }
        pos += consumed;

        if (v.type == ASSEMBLE_VALUE_STRING)
        {
            if (v.value.as_string.length > 255)
            {
                return assemble_set_error(ASSEMBLE_CPU_X86_64, ASSEMBLE_ERROR_TYPE_RANGE,
                                           ASSEMBLE_X86_64_ERR_STRING_TOO_LONG, "String too long");
            }
            memcpy(string_buf, v.value.as_string.text, v.value.as_string.length);
            *string_len = v.value.as_string.length;
            *pimm = (int32_t) v.value.as_string.length;
            *povr |= 0x80; /* flag string */
        }
        else
        {
            int32_t n = value_to_integer(&v);

            if (x86_nxt(text, length, &pos) == '[')
            {
                *pdis = n;
                *pos_inout = pos;
                return x86_operand(context, text, length, pos_inout, pdis, pimm, povr, sib_lo, sib_hi,
                                    string_buf, string_len, out_type);
            }
            *pimm = n;
        }
    }

    *pos_inout = pos;
    *out_type = 0x7E;
    return NULL;
}

/* ---- Encoding ------------------------------------------------------ */

#define X86_NO_RIP_PATCH ((size_t) -1)

static int sib_nibble(uint32_t lo, uint32_t hi, int reg)
{
    if (reg < 8)
    {
        return (int) ((lo >> (reg * 4)) & 0xF);
    }
    return (int) ((hi >> ((reg - 8) * 4)) & 0xF);
}

/* Emits a displacement/immediate value in 'n' bytes (1, 2, 4 or 8),
   little-endian, matching poke(&value,n) on a little-endian host. */
static _kernel_oserror *x86_poke(assemble_context_t *context, int32_t value, int n)
{
    switch (n)
    {
        case 1:
            return assemble_emit_byte(context, ASSEMBLE_CPU_X86_64, (uint8_t) (value & 0xFF));
        case 2:
            return assemble_emit_word(context, ASSEMBLE_CPU_X86_64, (uint16_t) (value & 0xFFFF));
        case 4:
            return assemble_emit_dword(context, ASSEMBLE_CPU_X86_64, (uint32_t) value);
        case 8:
            return assemble_emit_qword(context, ASSEMBLE_CPU_X86_64, value);
        default:
            return assemble_set_error(ASSEMBLE_CPU_X86_64, ASSEMBLE_ERROR_TYPE_INTERNAL, ASSEMBLE_X86_64_ERR_NONE,
                                       "Unhandled immediate size");
    }
}

static _kernel_oserror *error_size_mismatch(void)
{
    return assemble_set_error(ASSEMBLE_CPU_X86_64, ASSEMBLE_ERROR_TYPE_BAD_OPERAND, ASSEMBLE_X86_64_ERR_SIZE_MISMATCH,
                               "Size mismatch");
}

static _kernel_oserror *error_size_needed(void)
{
    return assemble_set_error(ASSEMBLE_CPU_X86_64, ASSEMBLE_ERROR_TYPE_BAD_OPERAND, ASSEMBLE_X86_64_ERR_SIZE_NEEDED,
                               "Size needed");
}

static _kernel_oserror *error_type_mismatch(void)
{
    return assemble_set_error(ASSEMBLE_CPU_X86_64, ASSEMBLE_ERROR_TYPE_BAD_OPERAND, ASSEMBLE_X86_64_ERR_TYPE_MISMATCH,
                               "Type mismatch");
}

static _kernel_oserror *error_jump_range(void)
{
    return assemble_set_error(ASSEMBLE_CPU_X86_64, ASSEMBLE_ERROR_TYPE_RANGE, ASSEMBLE_X86_64_ERR_JUMP_OUT_OF_RANGE,
                               "Jump out of range");
}

static _kernel_oserror *error_system_call_unsupported(void)
{
    return assemble_set_error(ASSEMBLE_CPU_X86_64, ASSEMBLE_ERROR_TYPE_BAD_OPERAND,
                               ASSEMBLE_X86_64_ERR_SYSTEM_CALL_UNSUPPORTED,
                               "Resolving a routine name to an address is not supported; "
                               "use its numeric address instead");
}

/*******************************************************************
 Function:      x86_encode
 Description:   Encodes a single instruction's opcode/prefix/ModR-M/
                SIB/displacement/immediate bytes. Ported from the
                original encode(): the bit-level REX/ModR-M/flags
                logic is unchanged, only the byte-output (poke ->
                assemble_emit_*), lookup table access (unaligned
                pointer casts -> explicit little-endian byte reads)
                and error reporting have been adapted.
 Parameters:    context = the assembly context
                mnemonic/operand1/operand2/operand3 = as parsed
                override = accumulated override bits
                displacement = memory operand displacement
                sib_lo/sib_hi = indexed-addressing register info
                immediate = immediate operand value
                out_rip_patch_offset = set to the buffer offset (from
                          the start of this instruction) of a
                          [rip+disp]-style displacement field that
                          needs a late fix-up once the instruction's
                          total length is known, or X86_NO_RIP_PATCH
 Returns:       NULL if successful, otherwise a static error block
 ******************************************************************/
static _kernel_oserror *x86_encode(assemble_context_t *context,
                                    int mnemonic, int operand1, int operand2, int operand3, int override,
                                    int32_t displacement, uint32_t sib_lo, uint32_t sib_hi, int32_t immediate,
                                    const uint8_t *string_buf, size_t string_len,
                                    size_t *out_rip_patch_offset)
{
    int found = -1;
    uint8_t opcode1, opcode2, modrm = 0;
    uint8_t scale = 0, index = 0, base = 0;
    uint16_t flags;
    _kernel_oserror *error;

    *out_rip_patch_offset = X86_NO_RIP_PATCH;

    if ((operand1 == 0x30) && (operand2 == 0x7E) && (immediate >= -128) && (immediate <= 127))
    {
        found = x86_lookup(mnemonic, 0x3F, operand2, operand3);
    }

    /* 32-bit addressing is not useful in a 64-bit flat addressing space. */

    if (found < 0)
    {
        found = x86_lookup(mnemonic, operand1, operand2, operand3);
    }
    if (found < 0)
    {
        return x86_error_syntax();
    }
    flags = read_flags(instructions + found * 6);
    opcode1 = instructions[found * 6 + 1];
    opcode2 = instructions[found * 6];

    /* Flag bits (9 bits, see the original bbasmb_x86_64.c for the
       full derivation):
        bit 0:    48, 66, F2 or F3 prefix present (depending on opcode2) +
        bit 1:    add 0F prefix (Floating Point: 9B prefix)
        bit 2:    update word-size flag W (Floating Point: F flag)
        bit 3:    update sign-extend flag S (Floating Point: M flag)
        bits 5-4: 00 = normal *
                  01 = Mod R/M present: reg from LH, r/m from RH operand
                  10 = No Mod R/M: update LS 3-bits of opcode from LH operand
                  11 = Mod R/M present: reg from RH, r/m from LH operand
        bits 8-6: 000 = no extra data bytes
                  001 = 32-bit immediate data
                  010 = 16-bit immediate data
                  011 = 64-bit immediate data
                  100 = 8-bit signed PC relative offset
                  101 = 32-bit signed PC relative offset
                  110 = 8-bit immediate data
                  111 = 16-bit, 32-bit or 64-bit immediate data (8-bit ?SW)
        + if bit 0 is one, opcode2 is the prefix byte if 48/F2/F3, else prefix is 66
        * if bit 4 is zero, opcode2 is a second opcode byte (eg for FP instructions)
          if bit 4 is one, opcode2 is a skeleton Mod R/M byte (with optional
          3-bit opcode extension) */

    if (override & 0x7F & ((override & 0x7F) - 1))
    {
        return x86_error_syntax();
    }

    if (((opcode1 & 0xF6) != 0xB6) && (opcode1 != 0x63) && (opcode1 != 0xD3))
    {
        if ((operand1 <= 0x3F) && (operand2 <= 0x3F) && ((operand1 ^ operand2) & 0x30))
        {
            return error_size_mismatch();
        }
    }

    if (((opcode1 & 0xF6) == 0xB6) && (operand2 >= 0x40) && (operand2 <= 0x4F))
    {
        if ((override & 0x3) == 0)
        {
            return error_size_needed();
        }
    }

    /* Output segment prefix, if any: */
    if (override & 0x3F00)
    {
        int i;

        for (i = 0; i < 6; i++)
        {
            if (override & (1 << (i + 8)))
            {
                error = assemble_emit_byte(context, ASSEMBLE_CPU_X86_64, segpfx[i]);
                if (error != NULL)
                {
                    return error;
                }
            }
        }
    }

    /* Output 66 prefix if 16-bit register or WORD override: */
    if ((opcode1 != 0x00) && (((operand1 >= 0x10) && (operand1 <= 0x1F))
       || ((((operand2 >= 0x10) && (operand2 <= 0x1F)) || (override & 0x2))
       && ((opcode1 & 0xF6) != 0xB6) && ((opcode1 != 0x01) || (opcode2 != 0x20)))))
    {
        if ((mnemonic < FPLO) || (mnemonic > FPHI))
        {
            if ((operand1 < 0x70) || (operand1 > 0x75))
            {
                error = assemble_emit_byte(context, ASSEMBLE_CPU_X86_64, 0x66);
                if (error != NULL)
                {
                    return error;
                }
            }
        }
    }

    /* Output 48, 66, 67, F2 or F3 prefix, if any: */
    if (flags & 0x1)
    {
        uint8_t prefix = 0x66;

        if ((opcode2 == 0xF2) || (opcode2 == 0xF3) || (opcode2 == 0x48) || (opcode2 == 0x67))
        {
            prefix = opcode2;
            opcode2 = 0;
        }
        error = assemble_emit_byte(context, ASSEMBLE_CPU_X86_64, prefix);
        if (error != NULL)
        {
            return error;
        }
    }

    /* Convert sibinfo (split lo/hi) to scale, index and base: */
    if (sib_lo != 0 || sib_hi != 0)
    {
        int i, s;

        for (s = 3; s >= 0; s--)
        {
            for (i = 0; i < 16; i++)
            {
                if (sib_nibble(sib_lo, sib_hi, i) & (1 << s))
                {
                    if (s)
                    {
                        if (index)
                        {
                            return x86_error_syntax();
                        }
                        index = (uint8_t) (i | 0x80);
                        scale = (uint8_t) s;
                    }
                    else if (base)
                    {
                        if (index)
                        {
                            return x86_error_syntax();
                        }
                        index = (uint8_t) (i | 0x80);
                        scale = 0;
                    }
                    else
                    {
                        base = (uint8_t) (i | 0x80);
                    }
                }
            }
        }

        /* Choose shorter encodings when there are alternatives: */
        if ((scale == 0) && (index == 0x84)) /* if index is RSP swap base and index */
        {
            index = base;
            base = 0x84;
        }

        if ((scale == 0) && (index != 0) && ((base == 0x85) || (base == 0x8D)))
        {
            uint8_t tmp = index;

            index = base;
            base = tmp;
        }

        if ((scale == 1) && (base == 0)) /* [reg+reg] has shorter encoding than [reg*2] */
        {
            scale = 0;
            base = index;
        }
    }

    /* Output 9B prefix, if any: */
    if ((flags & 0x2) && (mnemonic >= FPLO) && (mnemonic <= FPHI))
    {
        error = assemble_emit_byte(context, ASSEMBLE_CPU_X86_64, 0x9B);
        if (error != NULL)
        {
            return error;
        }
    }

    /* Output REX prefix, if any: */
    {
        uint8_t rex = 0x40;

        if ((opcode1 != 0x8F) && ((opcode1 != 0xFF) || (opcode2 < 0x10))
            && (((opcode1 != 0x50) && (opcode1 != 0x58)) || (flags & 3)))
        {
            if (((operand1 >= 0x20) && (operand1 <= 0x2F)) || ((operand2 >= 0x20) && (operand2 <= 0x2F))
               || ((override & 0x8) && ((mnemonic < FPLO) || (mnemonic > FPHI)))
               || (mnemonic == CMPXCHG16B))
            {
                rex |= 0x8; /* REX.W bit */
            }
        }
        else
        {
            if (override & 0x5)
            {
                return assemble_set_error(ASSEMBLE_CPU_X86_64, ASSEMBLE_ERROR_TYPE_SYNTAX,
                                           ASSEMBLE_X86_64_ERR_INVALID_SIZE_OVERRIDE, "Invalid size override");
            }
        }

        if (flags & 0x10)
        {
            if ((operand1 < 0x60) && (operand1 & 8))
            {
                if (flags & 0x20)
                {
                    rex |= 0x1; /* REX.B */
                }
                else
                {
                    rex |= 0x4; /* REX.R */
                }
            }
            if ((operand2 < 0x60) && (operand2 & 8))
            {
                if (flags & 0x20)
                {
                    rex |= 0x4; /* REX.R */
                }
                else
                {
                    rex |= 0x1; /* REX.B */
                }
            }
        }
        else
        {
            if (((operand1 < 0x60) && (operand1 & 8))
             || ((operand2 < 0x60) && (operand2 & 8)))
            {
                rex |= 0x1; /* REX.B */
            }
        }

        if (index || base)
        {
            rex &= 0xFC; /* zero REX.B and REX.X */
        }
        if (index & 8)
        {
            rex |= 0x2; /* REX.X */
        }
        if (base & 8)
        {
            rex |= 0x1; /* REX.B */
        }

        if (((operand1 >= 0x78) && (operand1 <= 0x7B)) ||
            ((operand2 >= 0x78) && (operand2 <= 0x7B)) ||
            (rex != 0x40))
        {
            if (((operand1 >= 0x04) && (operand1 <= 0x07)) ||
                ((operand2 >= 0x04) && (operand2 <= 0x07)))
            {
                return assemble_set_error(ASSEMBLE_CPU_X86_64, ASSEMBLE_ERROR_TYPE_SYNTAX,
                                           ASSEMBLE_X86_64_ERR_INVALID_REGISTER_COMBINATION,
                                           "Invalid register combination");
            }
            error = assemble_emit_byte(context, ASSEMBLE_CPU_X86_64, rex);
            if (error != NULL)
            {
                return error;
            }
        }
    }

    /* Short / near jumps: the assembler must not attempt to determine
       whether a 'short' or 'near' jump is suitable because that
       needs more than two passes! */
    if ((flags & 0x1C0) == 0x100)
    {
        if (opcode1 == 0xEB) /* unconditional jump */
        {
            if ((override & 0x20) == 0) /* not short */
            {
                flags |= 0x40;
                opcode1 = (uint8_t) (opcode1 - 2);
            }
        }
        else if (opcode1 != 0xE8) /* conditional jumps */
        {
            if ((override & 0x40) != 0) /* near */
            {
                flags |= 0x42;
                opcode1 = (uint8_t) (opcode1 + 0x10);
            }
        }
    }

    /* Output 0F prefix, if any: */
    if ((flags & 0x2) && ((mnemonic < FPLO) || (mnemonic > FPHI)))
    {
        error = assemble_emit_byte(context, ASSEMBLE_CPU_X86_64, 0x0F);
        if (error != NULL)
        {
            return error;
        }
    }

    /* Affect W and S bits according to operand and displacement: */
    if (((operand1 >= 0x00) && (operand1 <= 0x0F)) || ((operand2 >= 0x00) && (operand2 <= 0x0F) && (opcode1 != 0xD3))
     || ((operand1 >= 0x78) && (operand1 <= 0x7B)) || ((operand2 >= 0x78) && (operand2 <= 0x7B) && (opcode1 != 0xD3))
     || (override & 0x1))
    {
        if (flags & 4) /* W bit */
        {
            opcode1 &= 0xFE;
        }
    }
    else if (flags & 8)
    {
        if ((mnemonic < FPLO) || (mnemonic > FPHI)) /* S bit */
        {
            if ((immediate < -128) || (immediate > 127) || (override & 1))
            {
                opcode1 &= 0xFD;
            }
            else
            {
                opcode1 |= 0x02;
                flags = (uint16_t) ((flags & 0x3E) | 0x180);
            }
        }
        else /* MF bits */
        {
            if (override & 0xA)
            {
                opcode1 |= 0x04;
            }
            else
            {
                opcode1 &= 0xFB;
            }
        }
    }

    /* Reset W bit if BYTE override: */
    if (flags & 4)
    {
        if (((operand1 >= 0x40) && (operand1 <= 0x4F) && (operand2 >= 0x7D))
         || ((operand2 >= 0x40) && (operand2 <= 0x4F) && (operand1 >= 0x7D)))
        {
            if ((override & 0x1F) == 0)
            {
                return error_size_needed();
            }
            if (override & 1)
            {
                opcode1 &= 0xFE;
            }
        }
    }

    /* Special treatment for FILD, FISTP: */
    if (((mnemonic == FILD) || (mnemonic == FISTP)) && (override & 0x8))
    {
        opcode2 |= 5 << 3;
    }

    /* Special treatment for FLD, FSTP: */
    if (((mnemonic == FLD) || (mnemonic == FSTP)) && (override & 0x10))
    {
        opcode1 |= 2;
        opcode2 |= 5 << 3;
    }

    /* Special treatment for shifts: */
    if (((opcode1 == 0xC0) || (opcode1 == 0xC1)) && (immediate == 1))
    {
        opcode1 = (uint8_t) (opcode1 + 0x10);
        flags &= 0x3E;
        operand2 = 0;
    }
    if (((opcode1 == 0xD2) || (opcode1 == 0xD3)) && (operand2 == 1))
    {
        operand2 = 0;
    }

    /* Construct ModR/M byte (if any): */
    if (flags & 0x10)
    {
        if (opcode2 < 0x80)
        {
            modrm = opcode2; /* use as skeleton */
            opcode2 = 0;
        }

        /* Write Mod field: */
        if ((operand1 == 0x7C) || (operand2 == 0x7C))
        {
            modrm &= 0x3F;
            base = 0x85;
        }
        else if (((operand1 < 0x40) || (operand1 >= 0x50))
              && ((operand2 < 0x40) || (operand2 >= 0x50)))
        {
            modrm |= 0xC0;
        }
        else
        {
            modrm &= 0x3F;
            if ((displacement < -128) || (displacement > 127))
            {
                modrm |= 0x80;
            }
            else if ((displacement) || (base == 0x85) || (base == 0x8D))
            {
                modrm |= 0x40;
            }
            if ((base == 0) && (index != 0))
            {
                modrm &= 0x3F;
            }
            if ((base == 0) && ((operand1 == 0x45) || (operand2 == 0x45)))
            {
                modrm &= 0x3F;
            }
        }

        /* Write R/M and/or reg fields: */
        if (flags & 0x20)
        {  /* reg from operand2, R/M from operand1 */
            if ((operand2 <= 0x7C) && !(modrm & 0x38))
            {
                modrm |= ((operand2 & 7) << 3); /* reg */
                if (operand2 >= 0x78)
                {
                    modrm |= 4 << 3;
                }
            }
            if (operand1 <= 0x7C)
            {
                modrm |= (operand1 & 7);        /* R/M */
                if (operand1 >= 0x78)
                {
                    modrm |= 4;
                }
            }
        }
        else
        {  /* reg from operand1, R/M from operand2 */
            if ((operand1 <= 0x7C) && !(modrm & 0x38))
            {
                modrm |= ((operand1 & 7) << 3); /* reg */
                if (operand1 >= 0x78)
                {
                    modrm |= 4 << 3;
                }
            }
            if (operand2 <= 0x7C)
            {
                modrm |= (operand2 & 7);        /* R/M */
                if (operand2 >= 0x78)
                {
                    modrm |= 4;
                }
            }
        }

        /* Override R/M field if SIB: */
        if (index != 0)
        {
            modrm = (uint8_t) ((modrm & 0xF8) | 0x4);
        }
    }

    /* Output opcode and ModR/M byte(s) (if any): */
    if ((opcode1 != 0xFF) || (opcode2 != 0xFF))
    {
        if ((flags & 0x30) == 0x20)
        {
            opcode1 |= (operand1 & 7);
            if (operand1 >= 0x78)
            {
                opcode1 |= 4;
            }
        }
        error = assemble_emit_byte(context, ASSEMBLE_CPU_X86_64, opcode1);
        if (error != NULL)
        {
            return error;
        }

        if (opcode2 != 0)
        {
            error = assemble_emit_byte(context, ASSEMBLE_CPU_X86_64, opcode2);
            if (error != NULL)
            {
                return error;
            }
        }

        if (flags & 0x10)
        {
            error = assemble_emit_byte(context, ASSEMBLE_CPU_X86_64, modrm);
            if (error != NULL)
            {
                return error;
            }
        }
    }

    /* Output SIB byte (if any): */
    if (((modrm & 0xC0) != 0xC0) && ((modrm & 0x7) == 0x4))
    {
        uint8_t sib;

        if (index == 0x84)
        {
            return assemble_set_error(ASSEMBLE_CPU_X86_64, ASSEMBLE_ERROR_TYPE_BAD_OPERAND,
                                       ASSEMBLE_X86_64_ERR_INDEX_CANNOT_BE_RSP, "Index cannot be RSP");
        }
        sib = (uint8_t) ((scale << 6) | ((index & 7) << 3) | (base & 7));
        if ((displacement == 0) && (base == 0))
        {
            sib |= 5;
        }
        if (index == 0)
        {
            sib |= 0x20;
        }
        error = assemble_emit_byte(context, ASSEMBLE_CPU_X86_64, sib);
        if (error != NULL)
        {
            return error;
        }
        if (sib == 0x25)
        {
            error = x86_poke(context, displacement, 4); /* absolute address */
            if (error != NULL)
            {
                return error;
            }
        }
    }

    /* Output displacement (if any) depends on ModR/M: */
    if ((operand1 == 0x7E) && (operand2 == 0x7E))
    {
        error = x86_poke(context, displacement, 2); /* for ENTER instruction */
    }
    else if ((modrm & 0xC0) == 0x40)
    {
        error = x86_poke(context, displacement, 1); /* disp8 */
    }
    else if ((modrm & 0xC0) == 0x80)
    {
        error = x86_poke(context, displacement, 4); /* disp32 */
    }
    else if ((index != 0) && (base == 0))
    {
        error = x86_poke(context, displacement, 4); /* disp32 */
    }
    else if ((base == 0) && ((operand1 == 0x45) || (operand2 == 0x45)))
    {
        *out_rip_patch_offset = context->bytes_used;
        error = x86_poke(context, displacement, 4); /* disp32 */
    }
    else
    {
        error = NULL;
    }
    if (error != NULL)
    {
        return error;
    }

    /* Output immediate data (if any): */
    switch (flags & 0x1C0)
    {
        case 0x0: /* no data */
            if ((operand1 == 0x7E) || (operand2 == 0x7E) || (operand3 == 0x7E))
            {
                return x86_error_syntax();
            }
            break;

        case 0x40: /* 32-bit immediate data */
            if (override & 0x80)
            {
                return error_type_mismatch();
            }
            error = x86_poke(context, immediate, 4);
            break;

        case 0x80: /* 16-bit immediate data */
            if (override & 0x80)
            {
                return error_type_mismatch();
            }
            error = x86_poke(context, immediate, 2);
            break;

        case 0xC0: /* 64-bit immediate data */
            if (override & 0x80)
            {
                return error_system_call_unsupported();
            }
            error = x86_poke(context, immediate, 8);
            break;

        case 0x100: /* 8-bit PC-relative offset */
            if (override & 0x80)
            {
                return error_type_mismatch();
            }
            immediate -= (int32_t) (context->address + context->bytes_used) + 1;
            if ((immediate < -128) || (immediate > 127))
            {
                return error_jump_range();
            }
            error = x86_poke(context, immediate, 1);
            break;

        case 0x140: /* 32-bit PC-relative offset */
            if (override & 0x80)
            {
                return error_type_mismatch();
            }
            immediate -= (int32_t) (context->address + context->bytes_used) + 4;
            error = x86_poke(context, immediate, 4);
            break;

        case 0x180: /* 8-bit immediate data or string */
            if (override & 0x80)
            {
                size_t i;

                error = NULL;
                for (i = 0; i < string_len; i++)
                {
                    error = assemble_emit_byte(context, ASSEMBLE_CPU_X86_64, string_buf[i]);
                    if (error != NULL)
                    {
                        break;
                    }
                }
            }
            else
            {
                error = x86_poke(context, immediate, 1);
            }
            break;

        case 0x1C0: /* Variable-length data depending on promotions etc. */
            if ((operand1 <= 0x0F) || (operand2 <= 0x0F) || (override & 0x1)
             || ((operand1 >= 0x78) && (operand1 <= 0x7B))
             || ((operand2 >= 0x78) && (operand2 <= 0x7B)))
            {
                error = x86_poke(context, immediate, 1);
            }
            else if (((operand1 >= 0x10) && (operand1 <= 0x1F)) || ((operand2 >= 0x10) && (operand2 <= 0x1F))
              || (override & 0x2))
            {
                error = x86_poke(context, immediate, 2);
            }
            else if ((((operand1 >= 0x20) && (operand1 <= 0x2F)) || ((operand2 >= 0x20) && (operand2 <= 0x2F))
              || (override & 0x8)) && ((opcode1 & 0xF8) == 0xB8))
            {
                if (override & 0x80)
                {
                    return error_system_call_unsupported();
                }
                error = x86_poke(context, immediate, 8);
            }
            else
            {
                error = x86_poke(context, immediate, 4);
            }
            break;

        default:
            error = NULL;
            break;
    }

    return error;
}

/* ---- Top-level line entry point ------------------------------------ */

static _kernel_oserror *assign_label(assemble_context_t *context,
                                      const char *label, size_t label_length,
                                      const assemble_value_t *value)
{
    _kernel_oserror *error = NULL;

    if (context->assign_var(context->user_data, label, label_length, value, &error) != ASSEMBLE_RESULT_OK)
    {
        if (error != NULL)
        {
            return error;
        }
        return assemble_set_error(ASSEMBLE_CPU_X86_64, ASSEMBLE_ERROR_TYPE_BAD_LABEL, ASSEMBLE_X86_64_ERR_NONE,
                                   "Label could not be assigned");
    }
    return NULL;
}

_kernel_oserror *assemble_x86_64_line(assemble_context_t *context,
                                       const uint8_t *line, size_t line_length)
{
    size_t pos;
    _kernel_oserror *error;
    int mnemonic;
    int operand1 = 0x7F, operand2 = 0x7F, operand3 = 0x7F;
    int override = 0;
    int32_t displacement = 0, immediate = 0;
    uint32_t sib_lo = 0, sib_hi = 0;
    uint8_t string_buf[256];
    size_t string_len = 0;
    size_t rip_patch_offset;

    context->bytes_used = 0;
    pos = x86_skip_spaces(line, line_length, 0);

    if (pos < line_length && line[pos] == '.')
    {
        size_t start;
        char label[64];
        size_t label_length;

        pos += 1;
        start = pos;
        if (!(pos < line_length && assemble_is_ident_start(line[pos])))
        {
            return assemble_set_error(ASSEMBLE_CPU_X86_64, ASSEMBLE_ERROR_TYPE_BAD_LABEL, ASSEMBLE_X86_64_ERR_NONE,
                                       "Expected a label name after '.'");
        }
        while (pos < line_length && assemble_is_ident_char(line[pos]))
        {
            pos += 1;
        }
        label_length = pos - start;
        if (label_length >= sizeof(label))
        {
            label_length = sizeof(label) - 1;
        }
        memcpy(label, line + start, label_length);
        label[label_length] = '\0';

        /* Multiple-label check: does this name already resolve to a
           non-zero value? Mirrors the original's loadn()/storen()
           duplicate-definition check. An undefined name, or one the
           caller's resolver can't/won't evaluate this way, is simply
           treated as not yet defined. */
        {
            assemble_value_t existing;
            size_t consumed;
            _kernel_oserror *ignored = NULL;

            if (context->resolve_expr(context->user_data, (const uint8_t *) label, label_length,
                                       &existing, &consumed, &ignored) == ASSEMBLE_RESULT_OK)
            {
                if (existing.type == ASSEMBLE_VALUE_INTEGER && existing.value.as_integer != 0)
                {
                    return assemble_set_error(ASSEMBLE_CPU_X86_64, ASSEMBLE_ERROR_TYPE_BAD_LABEL,
                                               ASSEMBLE_X86_64_ERR_MULTIPLE_LABEL, "Multiple label");
                }
            }
        }

        {
            assemble_value_t value;

            value.type = ASSEMBLE_VALUE_INTEGER;
            value.value.as_integer = (int32_t) context->address;
            error = assign_label(context, label, label_length, &value);
            if (error != NULL)
            {
                return error;
            }
        }

        pos = x86_skip_spaces(line, line_length, pos);
    }

    if (pos >= line_length)
    {
        return NULL; /* label-only, or blank, line */
    }

    mnemonic = schop_mnemonic(line, line_length, &pos);

    if (mnemonic == OPT)
    {
        /* OPT does not affect the assembled bytes; controlling passes
           and listing output is the calling assembler driver's job. */
        pos = x86_skip_spaces(line, line_length, pos);
        if (pos < line_length)
        {
            int32_t opt_value;

            error = eval_numeric(context, line, line_length, &pos, &opt_value);
            if (error != NULL)
            {
                return error;
            }
        }
        return NULL;
    }

    if (mnemonic == -1)
    {
        int special_idx = scan_table(line, line_length, &pos, specials, (int) NUM_SPECIALS);

        if (special_idx == -1)
        {
            return assemble_set_error(ASSEMBLE_CPU_X86_64, ASSEMBLE_ERROR_TYPE_BAD_MNEMONIC,
                                       ASSEMBLE_X86_64_ERR_BAD_MNEMONIC, "Bad mnemonic");
        }
        immediate = special_idx % 8;
        mnemonic = special[special_idx / 8];
        operand3 = 0x7E;
    }

    /* LOCK and the REP family are self-contained single-byte prefix
       'instructions' with no operands of their own -- write LOCK, or
       REP/REPE/REPNE, on its own line immediately before the
       instruction it prefixes. */
    if (!((mnemonic == LOCK) || (mnemonic >= REPLO && mnemonic <= REPHI)))
    {
        pos = x86_skip_spaces(line, line_length, pos);
        error = x86_operand(context, line, line_length, &pos, &displacement, &immediate, &override,
                             &sib_lo, &sib_hi, string_buf, &string_len, &operand1);
        if (error != NULL)
        {
            return error;
        }
        if (x86_nxt(line, line_length, &pos) == ',')
        {
            pos += 1;
        }
        if (operand1 == 0x7E)
        {
            displacement = immediate; /* for ENTER */
        }
        error = x86_operand(context, line, line_length, &pos, &displacement, &immediate, &override,
                             &sib_lo, &sib_hi, string_buf, &string_len, &operand2);
        if (error != NULL)
        {
            return error;
        }
        if (x86_nxt(line, line_length, &pos) == ',')
        {
            pos += 1;
        }
        if (operand3 == 0x7F)
        {
            error = x86_operand(context, line, line_length, &pos, &displacement, &immediate, &override,
                                 &sib_lo, &sib_hi, string_buf, &string_len, &operand3);
            if (error != NULL)
            {
                return error;
            }
        }
    }

    error = x86_encode(context, mnemonic, operand1, operand2, operand3, override,
                        displacement, sib_lo, sib_hi, immediate, string_buf, string_len,
                        &rip_patch_offset);
    if (error != NULL)
    {
        return error;
    }

    if (rip_patch_offset != X86_NO_RIP_PATCH && context->buffer != NULL)
    {
        int32_t total_length = (int32_t) context->bytes_used;
        int32_t stored;
        uint8_t *p = context->buffer + rip_patch_offset;

        stored = (int32_t) ((uint32_t) p[0] | ((uint32_t) p[1] << 8) |
                             ((uint32_t) p[2] << 16) | ((uint32_t) p[3] << 24));
        stored -= total_length;
        p[0] = (uint8_t) (stored & 0xFF);
        p[1] = (uint8_t) ((stored >> 8) & 0xFF);
        p[2] = (uint8_t) ((stored >> 16) & 0xFF);
        p[3] = (uint8_t) ((stored >> 24) & 0xFF);
    }

    return NULL;
}
