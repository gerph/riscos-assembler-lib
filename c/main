/*******************************************************************
 * File:        main
 * Purpose:     Assemble command line tool
 * Author:      Charles Ferguson (Gerph)
 ******************************************************************/

#include <stdlib.h>
#include <stdio.h>
#include <string.h>
#include <ctype.h>
#include <limits.h>

#include "assemble_common.h"
#include "assemble_registry.h"

#define MAX_SYMBOLS 256
#define MAX_NAME 64
#define MAX_LINE 1024
#define COMMAND_ERROR 0x7f000001

typedef struct source_line
{
    char *original;
    char *text;
    char label[MAX_NAME];
    unsigned long number;
    uint32_t pass1_bytes;
} source_line_t;

typedef struct symbol
{
    char name[MAX_NAME];
    int32_t value;
} symbol_t;

typedef struct command_state
{
    symbol_t symbols[MAX_SYMBOLS];
    size_t symbol_count;
    int pass;
    int allow_undefined;
    _kernel_oserror error;
} command_state_t;

typedef struct command_options
{
    const char *cpu_name;
    const char *input_name;
    const char *output_name;
    uint32_t initial_org;
    uint32_t initial_opt;
    assemble_line_fn assembler;
} command_options_t;

/*******************************************************************
 Function:      command_error
 Description:   Sets the command driver's static error block.
 Parameters:    state = command state owning the block
                message = diagnostic text
 Returns:       pointer to the error block
 ******************************************************************/
static _kernel_oserror *command_error(command_state_t *state, const char *message)
{
    state->error.errnum = COMMAND_ERROR;
    strncpy(state->error.errmess, message, sizeof(state->error.errmess) - 1);
    state->error.errmess[sizeof(state->error.errmess) - 1] = '\0';
    return &state->error;
}

static void skip_spaces(const uint8_t *text, size_t length, size_t *pos)
{
    while (*pos < length && (text[*pos] == ' ' || text[*pos] == '\t'))
    {
        *pos += 1;
    }
}

static int identifier_start(int ch)
{
    return isalpha(ch) || ch == '_' || ch == '`';
}

static int identifier_char(int ch)
{
    return isalnum(ch) || ch == '_' || ch == '`' || ch == '%' || ch == '$';
}

static symbol_t *find_symbol(command_state_t *state, const char *name, size_t length)
{
    size_t i;
    for (i = 0; i < state->symbol_count; i++)
    {
        if (strlen(state->symbols[i].name) == length &&
            memcmp(state->symbols[i].name, name, length) == 0)
        {
            return &state->symbols[i];
        }
    }
    return NULL;
}

/* Expression parsing deliberately stops at the first character which is
   not part of the expression.  This is the callback contract used by the
   existing instruction assemblers. */
static int parse_expression(command_state_t *, const uint8_t *, size_t, size_t *, int32_t *, _kernel_oserror **);

static int checked_add(int32_t a, int32_t b, int32_t *out)
{
    if ((b > 0 && a > INT32_MAX - b) || (b < 0 && a < INT32_MIN - b)) return 0;
    *out = a + b;
    return 1;
}

static int checked_mul(int32_t a, int32_t b, int32_t *out)
{
    if (a == 0 || b == 0) { *out = 0; return 1; }
    if (a == -1 && b == INT32_MIN) return 0;
    if (b == -1 && a == INT32_MIN) return 0;
    if (a > 0)
    {
        if (b > 0 ? a > INT32_MAX / b : b < INT32_MIN / a) return 0;
    }
    else if (b > 0 ? a < INT32_MIN / b : a != 0 && b < INT32_MAX / a) return 0;
    *out = a * b;
    return 1;
}

static int parse_primary(command_state_t *state, const uint8_t *text, size_t length,
                         size_t *pos, int32_t *out, _kernel_oserror **error)
{
    uint32_t unsigned_value;
    size_t start;
    symbol_t *symbol;
    skip_spaces(text, length, pos);
    if (*pos < length && text[*pos] == '(')
    {
        *pos += 1;
        if (!parse_expression(state, text, length, pos, out, error)) return 0;
        skip_spaces(text, length, pos);
        if (*pos >= length || text[*pos] != ')')
        {
            *error = command_error(state, "Expected ')' in expression");
            return 0;
        }
        *pos += 1;
        return 1;
    }
    if (*pos < length && (text[*pos] == '&' || isdigit((int) text[*pos])))
    {
        int base = text[*pos] == '&' ? 16 : 10;
        int digit_count = 0;
        unsigned_value = 0;
        if (base == 16) *pos += 1;
        while (*pos < length)
        {
            int ch = text[*pos];
            int digit = isdigit(ch) ? ch - '0' : (isxdigit(ch) ? toupper(ch) - 'A' + 10 : -1);
            if (digit < 0 || digit >= base) break;
            if (unsigned_value > (base == 16 ? UINT32_MAX : (uint32_t) INT32_MAX) / (uint32_t) base ||
                (unsigned_value == (base == 16 ? UINT32_MAX : (uint32_t) INT32_MAX) / (uint32_t) base &&
                 (uint32_t) digit > (base == 16 ? UINT32_MAX : (uint32_t) INT32_MAX) % (uint32_t) base))
            {
                *error = command_error(state, "Integer literal overflows 32 bits");
                return 0;
            }
            unsigned_value = unsigned_value * (uint32_t) base + (uint32_t) digit;
            digit_count += 1;
            *pos += 1;
        }
        if (digit_count == 0 || (base == 10 && unsigned_value > (uint32_t) INT32_MAX))
        {
            *error = command_error(state, "Invalid or overflowing integer literal");
            return 0;
        }
        *out = (int32_t) unsigned_value;
        return 1;
    }
    if (*pos < length && identifier_start((int) text[*pos]))
    {
        start = *pos;
        while (*pos < length && identifier_char((int) text[*pos])) *pos += 1;
        symbol = find_symbol(state, (const char *) text + start, *pos - start);
        if (symbol != NULL)
        {
            *out = symbol->value;
            return 1;
        }
        if (state->allow_undefined)
        {
            *out = 0;
            return 1;
        }
        *error = command_error(state, "Undefined symbol in expression");
        return 0;
    }
    *error = command_error(state, "Expected expression");
    return 0;
}

static int parse_unary(command_state_t *state, const uint8_t *text, size_t length,
                       size_t *pos, int32_t *out, _kernel_oserror **error)
{
    int op;
    skip_spaces(text, length, pos);
    if (*pos < length && (text[*pos] == '+' || text[*pos] == '-'))
    {
        op = text[*pos];
        *pos += 1;
        if (!parse_unary(state, text, length, pos, out, error)) return 0;
        if (op == '-' && *out == INT32_MIN)
        {
            *error = command_error(state, "Expression overflow");
            return 0;
        }
        if (op == '-') *out = -*out;
        return 1;
    }
    return parse_primary(state, text, length, pos, out, error);
}

static int parse_term(command_state_t *state, const uint8_t *text, size_t length,
                      size_t *pos, int32_t *out, _kernel_oserror **error)
{
    int32_t rhs;
    int op;
    if (!parse_unary(state, text, length, pos, out, error)) return 0;
    for (;;)
    {
        size_t saved = *pos;
        skip_spaces(text, length, pos);
        if (*pos >= length || (text[*pos] != '*' && text[*pos] != '/')) { *pos = saved; return 1; }
        op = text[(*pos)++];
        if (!parse_unary(state, text, length, pos, &rhs, error)) return 0;
        if (op == '/')
        {
            if (rhs == 0 || (*out == INT32_MIN && rhs == -1))
            {
                *error = command_error(state, rhs == 0 ? "Division by zero" : "Expression overflow");
                return 0;
            }
            *out /= rhs;
        }
        else if (!checked_mul(*out, rhs, out))
        {
            *error = command_error(state, "Expression overflow");
            return 0;
        }
    }
}

static int parse_expression(command_state_t *state, const uint8_t *text, size_t length,
                            size_t *pos, int32_t *out, _kernel_oserror **error)
{
    int32_t rhs;
    int op;
    if (!parse_term(state, text, length, pos, out, error)) return 0;
    for (;;)
    {
        size_t saved = *pos;
        skip_spaces(text, length, pos);
        if (*pos >= length || (text[*pos] != '+' && text[*pos] != '-')) { *pos = saved; return 1; }
        op = text[(*pos)++];
        if (!parse_term(state, text, length, pos, &rhs, error)) return 0;
        if (op == '-')
        {
            if (rhs == INT32_MIN) { *error = command_error(state, "Expression overflow"); return 0; }
            rhs = -rhs;
        }
        if (!checked_add(*out, rhs, out)) { *error = command_error(state, "Expression overflow"); return 0; }
    }
}

static assemble_result_t resolve_expr(void *user_data, const uint8_t *text, size_t length,
                                      assemble_value_t *value, size_t *consumed, _kernel_oserror **error)
{
    command_state_t *state = (command_state_t *) user_data;
    size_t pos = 0;
    int32_t result;
    if (!parse_expression(state, text, length, &pos, &result, error)) return ASSEMBLE_RESULT_ERROR;
    value->type = ASSEMBLE_VALUE_INTEGER;
    value->value.as_integer = result;
    *consumed = pos;
    return ASSEMBLE_RESULT_OK;
}

static assemble_result_t assign_var(void *user_data, const char *name, size_t length,
                                    const assemble_value_t *value, _kernel_oserror **error)
{
    command_state_t *state = (command_state_t *) user_data;
    symbol_t *symbol;
    if (length == 0 || length >= MAX_NAME || value->type != ASSEMBLE_VALUE_INTEGER)
    {
        *error = command_error(state, "Invalid symbol assignment");
        return ASSEMBLE_RESULT_ERROR;
    }
    symbol = find_symbol(state, name, length);
    if (symbol != NULL)
    {
        if (state->pass == 2 && symbol->value == value->value.as_integer) return ASSEMBLE_RESULT_OK;
        *error = command_error(state, "Duplicate or inconsistent symbol assignment");
        return ASSEMBLE_RESULT_ERROR;
    }
    if (state->pass == 2)
    {
        *error = command_error(state, "Symbol missing from first pass");
        return ASSEMBLE_RESULT_ERROR;
    }
    if (state->symbol_count == MAX_SYMBOLS)
    {
        *error = command_error(state, "Symbol table is full");
        return ASSEMBLE_RESULT_ERROR;
    }
    memcpy(state->symbols[state->symbol_count].name, name, length);
    state->symbols[state->symbol_count].name[length] = '\0';
    state->symbols[state->symbol_count].value = value->value.as_integer;
    state->symbol_count += 1;
    return ASSEMBLE_RESULT_OK;
}

static char *duplicate_string(const char *text)
{
    size_t length = strlen(text);
    char *result = (char *) malloc(length + 1);
    if (result != NULL) memcpy(result, text, length + 1);
    return result;
}

/* Remove source comments without treating punctuation inside quotes as a
   comment introducer. */
static void strip_comment(char *text)
{
    char quote = 0;
    size_t i;
    for (i = 0; text[i] != '\0'; i++)
    {
        if (quote != 0)
        {
            if (text[i] == quote) quote = 0;
        }
        else if (text[i] == '\'' || text[i] == '"') quote = text[i];
        else if (text[i] == ';' || (text[i] == '/' && text[i + 1] == '/')) { text[i] = '\0'; break; }
    }
    i = strlen(text);
    while (i > 0 && (text[i - 1] == ' ' || text[i - 1] == '\t')) text[--i] = '\0';
}

/* Normalise column-one labels into the .label form accepted by every
   backend.  Instructions themselves remain required to be indented. */
static int normalise_line(source_line_t *line, command_state_t *state)
{
    char *p = line->original;
    char *q;
    char *end;
    size_t label_length;
    line->label[0] = '\0';
    line->text = duplicate_string(p);
    if (line->text == NULL) return 0;
    strip_comment(line->text);
    p = line->text;
    if (*p == '\0' || *p == ' ' || *p == '\t') return 1;
    if (*p == '.') p++;
    if (!identifier_start((int) *p))
    {
        command_error(state, "Unindented line must start with a label");
        return 0;
    }
    q = p;
    while (identifier_char((int) *q)) q++;
    label_length = (size_t) (q - p);
    if (label_length >= MAX_NAME) { command_error(state, "Label is too long"); return 0; }
    memcpy(line->label, p, label_length);
    line->label[label_length] = '\0';
    if (*q == ':') q++;
    if (*q != '\0' && *q != ' ' && *q != '\t') { command_error(state, "Invalid label syntax"); return 0; }
    while (*q == ' ' || *q == '\t') q++;
    end = (char *) malloc(label_length + strlen(q) + 4);
    if (end == NULL) return 0;
    end[0] = '.';
    memcpy(end + 1, line->label, label_length);
    if (*q != '\0') { end[label_length + 1] = ' '; strcpy(end + label_length + 2, q); }
    else end[label_length + 1] = '\0';
    free(line->text);
    line->text = end;
    return 1;
}

static int word_is(const char *text, const char *word, const char **after)
{
    size_t length = strlen(word);
    if (strncmp(text, word, length) != 0 ||
        (text[length] != '\0' && text[length] != ' ' && text[length] != '\t')) return 0;
    *after = text + length;
    while (**after == ' ' || **after == '\t') *after += 1;
    return 1;
}

static int directive_after_label(const source_line_t *line, const char **body)
{
    const char *p = line->text;
    if (line->label[0] != '\0')
    {
        p += strlen(line->label) + 1;
        while (*p == ' ' || *p == '\t') p++;
    }
    else while (*p == ' ' || *p == '\t') p++;
    *body = p;
    return *p != '\0';
}

static int select_cpu(command_options_t *options, const char *name)
{
    const assemble_interface_t *iface;
    uint32_t default_opt = 0;

    iface = assemble_find_by_name(name, &default_opt);
    if (iface == NULL)
    {
        return 0;
    }
    options->cpu_name = name;
    options->assembler = iface->assemble_line;
    options->initial_opt = default_opt;
    return 1;
}

/*******************************************************************
 Function:      list_interfaces
 Description:   Prints every backend registered in assemble_registry
                (name, description, minimum output buffer size and
                any CPU-specific OPT bits), followed by the -cpu
                aliases that select a backend with a preset OPT value.
                Used by '*Assemble -list'.
 Parameters:    none
 Returns:       nothing
 ******************************************************************/
static void list_interfaces(void)
{
    size_t count, alias_count, i;
    const assemble_interface_t *interfaces = assemble_get_interfaces(&count);
    const assemble_alias_t *aliases = assemble_get_aliases(&alias_count);

    printf("Available -cpu names:\n\n");
    for (i = 0; i < count; i++)
    {
        const assemble_interface_t *iface = &interfaces[i];
        size_t j;

        printf("  %-8s %s\n", iface->name, iface->description);
        printf("           minimum output buffer: %u bytes\n", (unsigned) iface->max_instruction_length);
        for (j = 0; j < iface->opt_flag_count; j++)
        {
            printf("           -opt +&%02X: %s\n",
                   (unsigned) iface->opt_flags[j].bit, iface->opt_flags[j].description);
        }
    }

    if (alias_count != 0)
    {
        printf("\nAliases (a backend name plus a preset -opt value):\n\n");
        for (i = 0; i < alias_count; i++)
        {
            const assemble_interface_t *base = assemble_find_by_class(aliases[i].cpu_class);

            printf("  %-14s -> -cpu %s -opt &%02X\n",
                   aliases[i].name, base != NULL ? base->name : "?", (unsigned) aliases[i].opt);
        }
    }
}

static int parse_options(int argc, char **argv, command_options_t *options)
{
    int i;
    int seen_cpu = 0, seen_input = 0, seen_output = 0, seen_org = 0, seen_opt = 0;
    command_state_t state;
    memset(options, 0, sizeof(*options));
    memset(&state, 0, sizeof(state));
    for (i = 1; i < argc; i += 2)
    {
        size_t consumed = 0;
        int32_t value;
        _kernel_oserror *error = NULL;
        if (i + 1 >= argc) return 0;
        if (strcmp(argv[i], "-cpu") == 0 && !seen_cpu) { if (!select_cpu(options, argv[i + 1])) return 0; seen_cpu = 1; }
        else if (strcmp(argv[i], "-input") == 0 && !seen_input) { options->input_name = argv[i + 1]; seen_input = 1; }
        else if (strcmp(argv[i], "-output") == 0 && !seen_output) { options->output_name = argv[i + 1]; seen_output = 1; }
        else if ((strcmp(argv[i], "-org") == 0 || strcmp(argv[i], "-opt") == 0) && i + 1 < argc)
        {
            if ((strcmp(argv[i], "-org") == 0 && seen_org) || (strcmp(argv[i], "-opt") == 0 && seen_opt)) return 0;
            if (!parse_expression(&state, (const uint8_t *) argv[i + 1], strlen(argv[i + 1]), &consumed, &value, &error) || argv[i + 1][consumed] != '\0') return 0;
            if (strcmp(argv[i], "-org") == 0) { options->initial_org = (uint32_t) value; seen_org = 1; }
            else { options->initial_opt = (uint32_t) value; seen_opt = 1; }
        }
        else return 0;
    }
    return seen_cpu && seen_input && seen_output;
}

static void print_diagnostic(const command_options_t *options, const source_line_t *line,
                             int pass, uint32_t address, const _kernel_oserror *error)
{
    fprintf(stderr, "%s:%lu: pass %d, address &%08X, cpu %s: error &%08X (%u/%u/%u): %s\n  %s\n",
            options->input_name, line == NULL ? 0ul : line->number, pass, address,
            options->cpu_name, error == NULL ? 0u : (uint32_t) error->errnum,
            error == NULL ? 0u : (unsigned) ASSEMBLE_ERRNUM_CPU_CLASS(error->errnum),
            error == NULL ? 0u : (unsigned) ASSEMBLE_ERRNUM_TYPE(error->errnum),
            error == NULL ? 0u : (unsigned) ASSEMBLE_ERRNUM_VARIANT(error->errnum),
            error == NULL ? "command failure" : error->errmess,
            line == NULL ? "" : line->original);
}

static int run_pass(const command_options_t *options, source_line_t *lines, size_t count,
                    command_state_t *state, int pass, uint8_t *output, size_t output_length)
{
    size_t i;
    uint32_t address = options->initial_org;
    uint32_t offset = 0;
    uint32_t opt = options->initial_opt;
    int locked_address = 0;
    for (i = 0; i < count; i++)
    {
        const char *body;
        const char *argument;
        assemble_context_t context;
        _kernel_oserror *error;
        int32_t value;
        size_t consumed;
        uint32_t bytes;
        if (!directive_after_label(&lines[i], &body)) continue;
        if (word_is(body, "ORG", &argument))
        {
            consumed = 0; error = NULL;
            if (lines[i].label[0] != '\0' || !parse_expression(state, (const uint8_t *) argument, strlen(argument), &consumed, &value, &error) || argument[consumed] != '\0' || (locked_address && address != (uint32_t) value))
            {
                if (error == NULL) error = command_error(state, "ORG must precede labels and emitted code");
                print_diagnostic(options, &lines[i], pass, address, error); return 0;
            }
            address = (uint32_t) value;
            continue;
        }
        if (word_is(body, "OPT", &argument))
        {
            consumed = 0; error = NULL;
            if (!parse_expression(state, (const uint8_t *) argument, strlen(argument), &consumed, &value, &error) || argument[consumed] != '\0')
            { print_diagnostic(options, &lines[i], pass, address, error); return 0; }
            opt = (uint32_t) value;
            continue;
        }
        if (word_is(body, "EQU", &argument))
        {
            assemble_value_t assigned;
            if (lines[i].label[0] == '\0') { error = command_error(state, "EQU requires a label"); print_diagnostic(options, &lines[i], pass, address, error); return 0; }
            consumed = 0; error = NULL;
            if (!parse_expression(state, (const uint8_t *) argument, strlen(argument), &consumed, &value, &error) || argument[consumed] != '\0')
            { print_diagnostic(options, &lines[i], pass, address, error); return 0; }
            assigned.type = ASSEMBLE_VALUE_INTEGER; assigned.value.as_integer = value;
            if (assign_var(state, lines[i].label, strlen(lines[i].label), &assigned, &error) != ASSEMBLE_RESULT_OK)
            { print_diagnostic(options, &lines[i], pass, address, error); return 0; }
            locked_address = 1;
            continue;
        }
        context.buffer = pass == 1 || output == NULL ? NULL : output + offset;
        context.buffer_length = pass == 1 ? -1 : (int32_t) (output_length - offset);
        context.address = address;
        context.opt = (opt & ~(ASSEMBLE_OPT_ERROR)) | (pass == 2 ? ASSEMBLE_OPT_ERROR : 0);
        context.resolve_expr = resolve_expr;
        context.assign_var = assign_var;
        context.user_data = state;
        context.bytes_used = 0;
        error = options->assembler(&context, (const uint8_t *) lines[i].text, strlen(lines[i].text));
        if (error != NULL) { print_diagnostic(options, &lines[i], pass, address, error); return 0; }
        bytes = context.bytes_used;
        if (pass == 1) lines[i].pass1_bytes = bytes;
        else if (bytes != lines[i].pass1_bytes)
        {
            error = command_error(state, "Line size differs from first pass");
            print_diagnostic(options, &lines[i], pass, address, error); return 0;
        }
        if (pass == 2 && (opt & ASSEMBLE_OPT_LIST) && bytes != 0)
        {
            uint32_t j;
            printf("%08X ", address);
            for (j = 0; j < bytes; j++) printf("%02X", output[offset + j]);
            printf(" %s\n", lines[i].original);
        }
        offset += bytes;
        address += bytes;
        if (bytes != 0 || lines[i].label[0] != '\0') locked_address = 1;
    }
    return 1;
}

int main(int argc, char *argv[])
{
    command_options_t options;
    command_state_t state;
    source_line_t *lines = NULL;
    size_t count = 0, capacity = 0, i, output_length = 0;
    FILE *input;
    FILE *output;
    char buffer[MAX_LINE];
    uint8_t *image;
    if (argc == 2 && strcmp(argv[1], "-list") == 0)
    {
        list_interfaces();
        return EXIT_SUCCESS;
    }
    if (!parse_options(argc, argv, &options))
    {
        fprintf(stderr, "Syntax: *Assemble -cpu <cpu> -input <source> -output <binary> [-org <expression>] [-opt <expression>]\n"
                         "        *Assemble -list\n");
        return EXIT_FAILURE;
    }
    input = fopen(options.input_name, "r");
    if (input == NULL) { perror(options.input_name); return EXIT_FAILURE; }
    while (fgets(buffer, sizeof(buffer), input) != NULL)
    {
        size_t length = strlen(buffer);
        source_line_t *grown;
        if (length != 0 && buffer[length - 1] != '\n' && !feof(input)) { fprintf(stderr, "%s: source line too long\n", options.input_name); fclose(input); return EXIT_FAILURE; }
        while (length != 0 && (buffer[length - 1] == '\n' || buffer[length - 1] == '\r')) buffer[--length] = '\0';
        if (count == capacity)
        {
            capacity = capacity == 0 ? 64 : capacity * 2;
            grown = (source_line_t *) realloc(lines, capacity * sizeof(*lines));
            if (grown == NULL) { fclose(input); return EXIT_FAILURE; }
            lines = grown;
        }
        memset(&lines[count], 0, sizeof(lines[count]));
        lines[count].original = duplicate_string(buffer);
        lines[count].number = (unsigned long) count + 1;
        if (lines[count].original == NULL || !normalise_line(&lines[count], &state)) { fprintf(stderr, "%s: out of memory or invalid input\n", options.input_name); fclose(input); return EXIT_FAILURE; }
        count += 1;
    }
    fclose(input);
    memset(&state, 0, sizeof(state)); state.pass = 1; state.allow_undefined = 1;
    if (!run_pass(&options, lines, count, &state, 1, NULL, 0)) return EXIT_FAILURE;
    for (i = 0; i < count; i++) output_length += lines[i].pass1_bytes;
    image = output_length == 0 ? NULL : (uint8_t *) malloc(output_length);
    if (output_length != 0 && image == NULL) { fprintf(stderr, "Not enough memory for output\n"); return EXIT_FAILURE; }
    state.pass = 2; state.allow_undefined = 0;
    if (!run_pass(&options, lines, count, &state, 2, image, output_length)) { free(image); return EXIT_FAILURE; }
    output = fopen(options.output_name, "wb");
    if (output == NULL) { perror(options.output_name); free(image); return EXIT_FAILURE; }
    if (output_length != 0 && fwrite(image, 1, output_length, output) != output_length) { perror(options.output_name); fclose(output); free(image); return EXIT_FAILURE; }
    if (fclose(output) != 0) { perror(options.output_name); free(image); return EXIT_FAILURE; }
    free(image);
    for (i = 0; i < count; i++) { free(lines[i].original); free(lines[i].text); }
    free(lines);
    return EXIT_SUCCESS;
}
