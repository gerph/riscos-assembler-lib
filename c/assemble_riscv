/*******************************************************************
 * File:        assemble_riscv
 * Purpose:     Assembler backend for the RV32I base integer
 *              instruction set (plus the Zicsr CSR instructions).
 *              Parses one tokenised BASIC source line at a time into
 *              machine code, using the callbacks in the assembly
 *              context to evaluate expressions and to assign labels.
 *              All values are little-endian, matching RISC-V itself.
 * Author:      Charles Ferguson (Gerph)
 ******************************************************************/

#include <string.h>
#include <ctype.h>

#include "assemble_riscv.h"

/* BASIC tokenises AND/OR as single bytes; since bare AND/OR (and,
   with a following letter picked up by the normal read loop below,
   ANDI/ORI) are real RV32I mnemonics, these tokens must be expanded
   back to their mnemonic spelling before normal mnemonic lookup
   (the same technique assemble_6809 and assemble_6502 use). RISC-V
   has no EOR mnemonic (it uses XOR), so there is no third token to
   handle here. */
#define TOKEN_AND 0x80
#define TOKEN_OR  0x84

#define OPC_LOAD     0x03u
#define OPC_OP_IMM   0x13u
#define OPC_AUIPC    0x17u
#define OPC_STORE    0x23u
#define OPC_OP       0x33u
#define OPC_LUI      0x37u
#define OPC_BRANCH   0x63u
#define OPC_JALR     0x67u
#define OPC_JAL      0x6Fu
#define OPC_SYSTEM   0x73u
#define OPC_MISC_MEM 0x0Fu

typedef enum riscv_format
{
    FMT_R,          /* rd, rs1, rs2 */
    FMT_I_ARITH,    /* rd, rs1, imm (12-bit signed) */
    FMT_I_SHAMT,    /* rd, rs1, shamt (5-bit unsigned); funct7 selects SLLI/SRLI vs SRAI */
    FMT_I_MEM,      /* rd, imm(rs1) -- loads and JALR share this shape */
    FMT_S,          /* rs2, imm(rs1) -- stores */
    FMT_B,          /* rs1, rs2, target -- PC-relative branch */
    FMT_U,          /* rd, imm (20-bit) */
    FMT_J,          /* rd, target -- PC-relative jump */
    FMT_SYSTEM,     /* no operand; fixed_imm gives the ECALL/EBREAK imm12 */
    FMT_FENCE,      /* optional pred,succ letter sets */
    FMT_FENCE_TSO,  /* no operand; fixed_imm gives the whole imm12 */
    FMT_CSR,        /* rd, csr, rs1 */
    FMT_CSRI        /* rd, csr, uimm (5-bit unsigned) */
} riscv_format_t;

typedef struct opcode_entry
{
    const char     *mnemonic;
    riscv_format_t  format;
    uint32_t        opcode;
    uint32_t        funct3;
    uint32_t        funct7;    /* R-type funct7, or SLLI/SRLI/SRAI's top 7 bits */
    uint32_t        fixed_imm; /* FMT_SYSTEM/FMT_FENCE_TSO only: the whole imm12 */
} opcode_entry_t;

