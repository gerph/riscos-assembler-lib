    { "ROXR", FAM_SHIFT, 2, 0, SZ_BWL },
    { "ROL",  FAM_SHIFT, 3, 1, SZ_BWL },
    { "ROR",  FAM_SHIFT, 3, 0, SZ_BWL }
};

#define NUM_MNEMONICS (sizeof(m68k_mnemonics) / sizeof(m68k_mnemonics[0]))

static const m68k_mnemonic_entry_t *find_mnemonic(const char *root)
{
    size_t i;

    for (i = 0; i < NUM_MNEMONICS; i++)
    {
        if (strcmp(m68k_mnemonics[i].root, root) == 0)
        {
            return &m68k_mnemonics[i];
        }
    }
    return NULL;
}

static size_t read_mnemonic(const uint8_t *text, size_t length, char *out)
{
    size_t pos = 0;
    size_t count = 0;

    if (length == 0)
    {
        out[0] = '\0';
        return 0;
    }

    if (text[0] == TOKEN_AND) { out[count++] = 'A'; out[count++] = 'N'; out[count++] = 'D'; pos = 1; }
    else if (text[0] == TOKEN_EOR) { out[count++] = 'E'; out[count++] = 'O'; out[count++] = 'R'; pos = 1; }
    else if (text[0] == TOKEN_OR)  { out[count++] = 'O'; out[count++] = 'R';                    pos = 1; }
    else if (text[0] == TOKEN_NOT) { out[count++] = 'N'; out[count++] = 'O'; out[count++] = 'T'; pos = 1; }

    while (pos < length && count < 7 &&
           ((text[pos] >= 'A' && text[pos] <= 'Z') || (text[pos] >= 'a' && text[pos] <= 'z')))
    {
        out[count] = (char) toupper((int) text[pos]);
        count += 1;
        pos += 1;
    }

    out[count] = '\0';
    return pos;
}

/*******************************************************************
 Function:      parse_size_suffix
 Description:   Parses an optional '.B'/'.W'/'.L' size suffix
                immediately following a mnemonic root (no space
                allowed between the root and the '.', matching real
                68000 syntax, eg 'MOVE.L').
 Parameters:    text/length = the source line
                pos_inout = current position, just after the mnemonic
                            root; advanced past the suffix if one was
                            present
                out_size = [[out]] the parsed size, or M68K_SIZE_NONE
 Returns:       NULL if successful, otherwise a static error block
 ******************************************************************/
static _kernel_oserror *parse_size_suffix(const uint8_t *text, size_t length, size_t *pos_inout,
                                           m68k_size_t *out_size)
{
    size_t pos = *pos_inout;

    if (pos + 1 < length && text[pos] == '.')
    {
        int ch = toupper((int) text[pos + 1]);

        if (ch == 'B') { *out_size = M68K_SIZE_B; *pos_inout = pos + 2; return NULL; }
        if (ch == 'W') { *out_size = M68K_SIZE_W; *pos_inout = pos + 2; return NULL; }
        if (ch == 'L') { *out_size = M68K_SIZE_L; *pos_inout = pos + 2; return NULL; }

        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_M68K_ERR_BAD_SIZE,
                                   "Invalid size suffix (expected .B, .W or .L)");
    }
    *out_size = M68K_SIZE_NONE;
    return NULL;
}

/* The standard 68000 size-field encoding (00=B, 01=W, 10=L), used by
   almost every instruction in this backend except MOVE/MOVEA, which
   has its own quirky 01/11/10 pattern encoded inline in encode_move(). */
static uint16_t m68k_std_size_bits(m68k_size_t size)
{
    return (uint16_t) ((size == M68K_SIZE_B) ? 0u : (size == M68K_SIZE_W) ? 1u : 2u);
}

/*******************************************************************
 Function:      encode_move
 Description:   Encodes MOVE and MOVEA. MOVEA's destination is
                restricted to An by the allowed-mode mask passed to
                m68k_encode_ea() for the destination operand; both
                mnemonics otherwise share the same opcode field
                layout (MOVEA is not a distinct opcode format -- it is
                the ordinary MOVE format with the destination EA
                forced to address-register-direct).
 Parameters:    context = the assembly context
                is_movea = 0 for MOVE, 1 for MOVEA
                size = the parsed .B/.W/.L size suffix
                text/length = the operand text following the mnemonic
 Returns:       NULL if successful, otherwise a static error block
 ******************************************************************/
static _kernel_oserror *encode_move(assemble_context_t *context, int is_movea,
                                     m68k_size_t size, const uint8_t *text, size_t length)
{
    size_t pos = 0;
    m68k_operand_t src, dst;
    uint16_t src_ea, dst_ea;
    uint16_t src_ext[2], dst_ext[2];
    unsigned char src_ext_count, dst_ext_count;
    uint16_t opword;
    uint16_t size_bits;
    _kernel_oserror *error;

    if (size == M68K_SIZE_NONE)
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_M68K_ERR_BAD_SIZE,
                                   "MOVE/MOVEA requires a .B/.W/.L size suffix");
    }
    if (is_movea && size == M68K_SIZE_B)
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_M68K_ERR_BAD_SIZE,
                                   "MOVEA does not support .B");
    }

    pos += assemble_skip_spaces(text + pos, length - pos);
    error = parse_m68k_operand(context, text, length, &pos, &src);
    if (error != NULL)
    {
        return error;
    }
    pos += assemble_skip_spaces(text + pos, length - pos);
    if (!(pos < length && text[pos] == ','))
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_M68K_ERR_NONE,
                                   "Expected ','");
    }
    pos += 1;
    pos += assemble_skip_spaces(text + pos, length - pos);
    error = parse_m68k_operand(context, text, length, &pos, &dst);
    if (error != NULL)
    {
        return error;
    }
    error = check_trailing(text, length, pos);
    if (error != NULL)
    {
        return error;
    }

    error = m68k_encode_ea(context, &src, size, M68K_EAM_ALL, 0, &src_ea, src_ext, &src_ext_count);
    if (error != NULL)
    {
        return error;
    }
    error = m68k_encode_ea(context, &dst, size, is_movea ? M68K_EAM_AN : M68K_EAM_ALTERABLE,
                            (uint32_t) src_ext_count * 2u, &dst_ea, dst_ext, &dst_ext_count);
    if (error != NULL)
    {
        return error;
    }

    size_bits = (size == M68K_SIZE_B) ? 1u : (size == M68K_SIZE_W) ? 3u : 2u;  /* MOVE's odd B/W/L encoding */

    opword = (uint16_t) ((size_bits << 12) |
                          (((uint32_t) dst_ea & 0x7u) << 9) |
                          ((((uint32_t) dst_ea >> 3) & 0x7u) << 6) |
                          (((uint32_t) src_ea & 0x38u)) |
                          ((uint32_t) src_ea & 0x7u));

    error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, opword);
    if (error != NULL)
    {
        return error;
    }
    if (src_ext_count >= 1) { error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, src_ext[0]); }
    if (error == NULL && src_ext_count >= 2) { error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, src_ext[1]); }
    if (error == NULL && dst_ext_count >= 1) { error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, dst_ext[0]); }
    if (error == NULL && dst_ext_count >= 2) { error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, dst_ext[1]); }
    return error;
}

/*******************************************************************
 Function:      encode_moveq
 Description:   Encodes MOVEQ #imm,Dn. Unlike some 68000 assemblers,
                'MOVE.L #imm,Dn' is never automatically shortened to
                this encoding -- see h/assemble_m68k's deficiencies
                comment.
 Parameters:    context = the assembly context
                text/length = the operand text following 'MOVEQ'
 Returns:       NULL if successful, otherwise a static error block
 ******************************************************************/
static _kernel_oserror *encode_moveq(assemble_context_t *context, m68k_size_t size,
                                      const uint8_t *text, size_t length)
{
    size_t pos = 0;
    int32_t imm;
    uint16_t reg;
    _kernel_oserror *error;

    if (size != M68K_SIZE_NONE)
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_M68K_ERR_BAD_SIZE,
                                   "MOVEQ does not take a size suffix (its size is always .L)");
    }

    pos += assemble_skip_spaces(text + pos, length - pos);
    if (!(pos < length && text[pos] == '#'))
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_BAD_OPERAND, ASSEMBLE_M68K_ERR_BAD_EA,
                                   "MOVEQ requires an immediate source");
    }
    pos += 1;
    error = eval_numeric(context, text, length, &pos, &imm);
    if (error != NULL)
    {
        return error;
    }
    if (imm < -128 || imm > 127)
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_RANGE, ASSEMBLE_M68K_ERR_IMMEDIATE_RANGE,
                                   "MOVEQ immediate out of range -128..127");
    }
    pos += assemble_skip_spaces(text + pos, length - pos);
    if (!(pos < length && text[pos] == ','))
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_M68K_ERR_NONE,
                                   "Expected ','");
    }
    pos += 1;
    pos += assemble_skip_spaces(text + pos, length - pos);
    if (!parse_data_register(text, length, &pos, &reg))
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_BAD_OPERAND,
                                   ASSEMBLE_M68K_ERR_EA_NOT_ALLOWED, "MOVEQ destination must be a data register");
    }
    error = check_trailing(text, length, pos);
    if (error != NULL)
    {
        return error;
    }

    return assemble_emit_word_be(context, ASSEMBLE_CPU_M68K,
                                  (uint16_t) (0x7000u | ((uint32_t) reg << 9) | ((uint32_t) imm & 0xFFu)));
}

static _kernel_oserror *encode_noop(assemble_context_t *context, uint16_t opcode,
                                     const uint8_t *text, size_t length)
{
    _kernel_oserror *error = check_trailing(text, length, 0);

    if (error != NULL)
    {
        return error;
    }
    return assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, opcode);
}

/*******************************************************************
 Function:      parse_two_operands
 Description:   Parses 'src,dst' -- the common shape used by most
                two-operand instructions in this backend.
 Parameters:    context = the assembly context
                text/length = the operand text following the mnemonic
                out_src, out_dst = [[out]] the parsed operands
 Returns:       NULL if successful, otherwise a static error block
 ******************************************************************/
static _kernel_oserror *parse_two_operands(assemble_context_t *context, const uint8_t *text, size_t length,
                                            m68k_operand_t *out_src, m68k_operand_t *out_dst)
{
    size_t pos = 0;
    _kernel_oserror *error;

    pos += assemble_skip_spaces(text + pos, length - pos);
    error = parse_m68k_operand(context, text, length, &pos, out_src);
    if (error != NULL)
    {
        return error;
    }
    pos += assemble_skip_spaces(text + pos, length - pos);
    if (!(pos < length && text[pos] == ','))
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_M68K_ERR_NONE,
                                   "Expected ','");
    }
    pos += 1;
    pos += assemble_skip_spaces(text + pos, length - pos);
    error = parse_m68k_operand(context, text, length, &pos, out_dst);
    if (error != NULL)
    {
        return error;
    }
    return check_trailing(text, length, pos);
}

static _kernel_oserror *emit_ext_words(assemble_context_t *context, const uint16_t ext[2], unsigned char count)
{
    _kernel_oserror *error = NULL;

    if (count >= 1)
    {
        error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, ext[0]);
    }
    if (error == NULL && count >= 2)
    {
        error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, ext[1]);
    }
    return error;
}

/*******************************************************************
 Function:      encode_one_op
 Description:   Encodes CLR/NEG/NEGX/NOT/TST: a single data-alterable
                operand (never An), size .B/.W/.L.
 Parameters:    context = the assembly context
                base_opcode = the opcode with size/ea fields clear
                size = the parsed .B/.W/.L size suffix
                text/length = the operand text following the mnemonic
 Returns:       NULL if successful, otherwise a static error block
 ******************************************************************/
static _kernel_oserror *encode_one_op(assemble_context_t *context, uint16_t base_opcode, m68k_size_t size,
                                       const uint8_t *text, size_t length)
{
    size_t pos = 0;
    m68k_operand_t dst;
    uint16_t dst_ea, dst_ext[2];
    unsigned char dst_ext_count;
    _kernel_oserror *error;

    if (size == M68K_SIZE_NONE)
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_M68K_ERR_BAD_SIZE,
                                   "Requires a .B/.W/.L size suffix");
    }

    pos += assemble_skip_spaces(text + pos, length - pos);
    error = parse_m68k_operand(context, text, length, &pos, &dst);
    if (error != NULL)
    {
        return error;
    }
    error = check_trailing(text, length, pos);
    if (error != NULL)
    {
        return error;
    }

    error = m68k_encode_ea(context, &dst, size, M68K_EAM_DATA_ALTERABLE, 0, &dst_ea, dst_ext, &dst_ext_count);
    if (error != NULL)
    {
        return error;
    }

    error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K,
                                   (uint16_t) (base_opcode | (m68k_std_size_bits(size) << 6) | dst_ea));
    if (error != NULL)
    {
        return error;
    }
    return emit_ext_words(context, dst_ext, dst_ext_count);
}

/*******************************************************************
 Function:      encode_add_sub
 Description:   Encodes ADD/SUB/ADDA/SUBA/ADDI/SUBI. The plain ADD/SUB
                mnemonics auto-detect which real opcode shape the
                operands require (ea+Dn->Dn, Dn+ea->ea, the ADDA/SUBA
                address-register-destination shape, or the ADDI/SUBI
                immediate-source shape) -- see the M68K_FORCE_* comment
                above the mnemonic table for why this isn't the same
                kind of relaxation MOVEQ's auto-selection would be.
 Parameters:    context = the assembly context
                is_sub = 0 for ADD family, 1 for SUB family
                force_kind = M68K_FORCE_AUTO/M68K_FORCE_A/M68K_FORCE_I
                size = the parsed .B/.W/.L size suffix
                text/length = the operand text following the mnemonic
 Returns:       NULL if successful, otherwise a static error block
 ******************************************************************/
static _kernel_oserror *encode_add_sub(assemble_context_t *context, int is_sub, uint32_t force_kind,
                                        m68k_size_t size, const uint8_t *text, size_t length)
{
    m68k_operand_t src, dst;
    uint16_t src_ea, dst_ea, src_ext[2], dst_ext[2];
    unsigned char src_ext_count, dst_ext_count;
    uint16_t opword;
    uint16_t top = is_sub ? 0x9000u : 0xD000u;
    _kernel_oserror *error;

    if (size == M68K_SIZE_NONE)
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_M68K_ERR_BAD_SIZE,
                                   "Requires a .B/.W/.L size suffix");
    }
    error = parse_two_operands(context, text, length, &src, &dst);
    if (error != NULL)
    {
        return error;
    }

    if (force_kind == M68K_FORCE_I)
    {
        if (src.mode != M68K_EA_OTHER || src.reg != M68K_SUB_IMMEDIATE)
        {
            return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_BAD_OPERAND, ASSEMBLE_M68K_ERR_BAD_EA,
                                       "ADDI/SUBI requires an immediate source");
        }
        error = m68k_encode_ea(context, &src, size, M68K_EAM_IMMEDIATE, 0, &src_ea, src_ext, &src_ext_count);
        if (error != NULL)
        {
            return error;
        }
        error = m68k_encode_ea(context, &dst, size, M68K_EAM_DATA_ALTERABLE, (uint32_t) src_ext_count * 2u,
                                &dst_ea, dst_ext, &dst_ext_count);
        if (error != NULL)
        {
            return error;
        }
        opword = (uint16_t) ((is_sub ? 0x0400u : 0x0600u) | (m68k_std_size_bits(size) << 6) | dst_ea);
        error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, opword);
        if (error != NULL) { return error; }
        error = emit_ext_words(context, src_ext, src_ext_count);
        if (error != NULL) { return error; }
        return emit_ext_words(context, dst_ext, dst_ext_count);
    }

    if (force_kind == M68K_FORCE_A || dst.mode == M68K_EA_AN)
    {
        uint16_t opmode;

        if (dst.mode != M68K_EA_AN)
        {
            return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_BAD_OPERAND,
                                       ASSEMBLE_M68K_ERR_EA_NOT_ALLOWED, "ADDA/SUBA destination must be an address register");
        }
        if (size == M68K_SIZE_B)
        {
            return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_M68K_ERR_BAD_SIZE,
                                       "ADDA/SUBA does not support .B");
        }
        opmode = (size == M68K_SIZE_L) ? 7u : 3u;
        error = m68k_encode_ea(context, &src, size, M68K_EAM_ALL, 0, &src_ea, src_ext, &src_ext_count);
        if (error != NULL)
        {
            return error;
        }
        opword = (uint16_t) (top | (((uint32_t) dst.reg) << 9) | (opmode << 6) | src_ea);
        error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, opword);
        if (error != NULL) { return error; }
        return emit_ext_words(context, src_ext, src_ext_count);
    }

    if (dst.mode == M68K_EA_DN)
    {
        error = m68k_encode_ea(context, &src, size, M68K_EAM_ALL, 0, &src_ea, src_ext, &src_ext_count);
        if (error != NULL)
        {
            return error;
        }
        opword = (uint16_t) (top | (((uint32_t) dst.reg) << 9) | (m68k_std_size_bits(size) << 6) | src_ea);
        error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, opword);
        if (error != NULL) { return error; }
        return emit_ext_words(context, src_ext, src_ext_count);
    }

    if (src.mode == M68K_EA_OTHER && src.reg == M68K_SUB_IMMEDIATE)
    {
        error = m68k_encode_ea(context, &src, size, M68K_EAM_IMMEDIATE, 0, &src_ea, src_ext, &src_ext_count);
        if (error != NULL)
        {
            return error;
        }
        error = m68k_encode_ea(context, &dst, size, M68K_EAM_DATA_ALTERABLE, (uint32_t) src_ext_count * 2u,
                                &dst_ea, dst_ext, &dst_ext_count);
        if (error != NULL)
        {
            return error;
        }
        opword = (uint16_t) ((is_sub ? 0x0400u : 0x0600u) | (m68k_std_size_bits(size) << 6) | dst_ea);
        error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, opword);
        if (error != NULL) { return error; }
        error = emit_ext_words(context, src_ext, src_ext_count);
        if (error != NULL) { return error; }
        return emit_ext_words(context, dst_ext, dst_ext_count);
    }

    if (src.mode != M68K_EA_DN)
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_BAD_OPERAND, ASSEMBLE_M68K_ERR_EA_NOT_ALLOWED,
                                   "ADD/SUB with a memory destination requires a data-register source");
    }

    error = m68k_encode_ea(context, &dst, size, M68K_EAM_MEMORY_ALTERABLE, 0, &dst_ea, dst_ext, &dst_ext_count);
    if (error != NULL)
    {
        return error;
    }
    opword = (uint16_t) (top | (((uint32_t) src.reg) << 9) | ((4u + m68k_std_size_bits(size)) << 6) | dst_ea);
    error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, opword);
    if (error != NULL) { return error; }
    return emit_ext_words(context, dst_ext, dst_ext_count);
}

/*******************************************************************
 Function:      encode_addq_subq
 Description:   Encodes ADDQ/SUBQ #imm,<ea> (imm 1-8, with 8 encoded
                as the field value 0). Destination is any alterable
                addressing mode; .B cannot target an address register.
 ******************************************************************/
static _kernel_oserror *encode_addq_subq(assemble_context_t *context, int is_sub, m68k_size_t size,
                                          const uint8_t *text, size_t length)
{
    size_t pos = 0;
    int32_t imm;
    m68k_operand_t dst;
    uint16_t dst_ea, dst_ext[2];
    unsigned char dst_ext_count;
    uint16_t ddd, opword;
    _kernel_oserror *error;

    if (size == M68K_SIZE_NONE)
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_M68K_ERR_BAD_SIZE,
                                   "ADDQ/SUBQ requires a .B/.W/.L size suffix");
    }

    pos += assemble_skip_spaces(text + pos, length - pos);
    if (!(pos < length && text[pos] == '#'))
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_BAD_OPERAND, ASSEMBLE_M68K_ERR_BAD_EA,
                                   "ADDQ/SUBQ requires an immediate source");
    }
    pos += 1;
    error = eval_numeric(context, text, length, &pos, &imm);
    if (error != NULL)
    {
        return error;
    }
    if (imm < 1 || imm > 8)
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_RANGE, ASSEMBLE_M68K_ERR_IMMEDIATE_RANGE,
                                   "ADDQ/SUBQ immediate out of range 1..8");
    }
    pos += assemble_skip_spaces(text + pos, length - pos);
    if (!(pos < length && text[pos] == ','))
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_M68K_ERR_NONE,
                                   "Expected ','");
    }
    pos += 1;
    pos += assemble_skip_spaces(text + pos, length - pos);
    error = parse_m68k_operand(context, text, length, &pos, &dst);
    if (error != NULL)
    {
        return error;
    }
    error = check_trailing(text, length, pos);
    if (error != NULL)
    {
        return error;
    }

    if (dst.mode == M68K_EA_AN && size == M68K_SIZE_B)
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_M68K_ERR_BAD_SIZE,
                                   "ADDQ/SUBQ.B cannot target an address register");
    }

    error = m68k_encode_ea(context, &dst, size, M68K_EAM_ALTERABLE, 0, &dst_ea, dst_ext, &dst_ext_count);
    if (error != NULL)
    {
        return error;
    }

    ddd = (uint16_t) ((imm == 8) ? 0 : imm);
    opword = (uint16_t) (0x5000u | (is_sub ? 0x0100u : 0u) | (ddd << 9) | (m68k_std_size_bits(size) << 6) | dst_ea);

    error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, opword);
    if (error != NULL)
    {
        return error;
    }
    return emit_ext_words(context, dst_ext, dst_ext_count);
}

/*******************************************************************
 Function:      encode_addx_subx
 Description:   Encodes ADDX/SUBX Dy,Dx or ADDX/SUBX -(Ay),-(Ax).
 ******************************************************************/
static _kernel_oserror *encode_addx_subx(assemble_context_t *context, int is_sub, m68k_size_t size,
                                          const uint8_t *text, size_t length)
{
    m68k_operand_t src, dst;
    uint16_t opword;
    unsigned char rm;
    _kernel_oserror *error;

    if (size == M68K_SIZE_NONE)
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_M68K_ERR_BAD_SIZE,
                                   "ADDX/SUBX requires a .B/.W/.L size suffix");
    }

    error = parse_two_operands(context, text, length, &src, &dst);
    if (error != NULL)
    {
        return error;
    }

    if (src.mode == M68K_EA_DN && dst.mode == M68K_EA_DN)
    {
        rm = 0;
    }
    else if (src.mode == M68K_EA_AN_PREDEC && dst.mode == M68K_EA_AN_PREDEC)
    {
        rm = 1;
    }
    else
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_BAD_OPERAND, ASSEMBLE_M68K_ERR_BAD_EA,
                                   "ADDX/SUBX requires two data registers or two predecrement operands");
    }

    opword = (uint16_t) ((is_sub ? 0x9100u : 0xD100u) | (((uint32_t) dst.reg) << 9) |
                          (m68k_std_size_bits(size) << 6) | ((uint32_t) rm << 3) | src.reg);
    return assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, opword);
}

/*******************************************************************
 Function:      encode_mul_div
 Description:   Encodes MULU/MULS/DIVU/DIVS <ea>,Dn. Source is always
                word-sized regardless of any (redundant) size suffix
                written; destination must be a data register.
 ******************************************************************/
static _kernel_oserror *encode_mul_div(assemble_context_t *context, uint16_t base_opcode,
                                        const uint8_t *text, size_t length)
{
    m68k_operand_t src, dst;
    uint16_t src_ea, src_ext[2];
    unsigned char src_ext_count;
    _kernel_oserror *error;

    error = parse_two_operands(context, text, length, &src, &dst);
    if (error != NULL)
    {
        return error;
    }
    if (dst.mode != M68K_EA_DN)
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_BAD_OPERAND, ASSEMBLE_M68K_ERR_EA_NOT_ALLOWED,
                                   "MULU/MULS/DIVU/DIVS destination must be a data register");
    }

    error = m68k_encode_ea(context, &src, M68K_SIZE_W, M68K_EAM_DATA, 0, &src_ea, src_ext, &src_ext_count);
    if (error != NULL)
    {
        return error;
    }

    error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K,
                                   (uint16_t) (base_opcode | (((uint32_t) dst.reg) << 9) | src_ea));
    if (error != NULL)
    {
        return error;
    }
    return emit_ext_words(context, src_ext, src_ext_count);
}

/*******************************************************************
 Function:      encode_cmp
 Description:   Encodes CMP/CMPA/CMPI, with the same auto-detection
                policy as encode_add_sub() -- see M68K_FORCE_* above.
                Unlike ADD/SUB, plain CMP has no 'Dn+ea->ea' reverse
                direction at all; a memory destination is only ever
                reachable via the immediate-source (CMPI) shape.
 ******************************************************************/
static _kernel_oserror *encode_cmp(assemble_context_t *context, uint32_t force_kind, m68k_size_t size,
                                    const uint8_t *text, size_t length)
{
    m68k_operand_t src, dst;
    uint16_t src_ea, dst_ea, src_ext[2], dst_ext[2];
    unsigned char src_ext_count, dst_ext_count;
    uint16_t opword;
    _kernel_oserror *error;

    if (size == M68K_SIZE_NONE)
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_M68K_ERR_BAD_SIZE,
                                   "Requires a .B/.W/.L size suffix");
    }
    error = parse_two_operands(context, text, length, &src, &dst);
    if (error != NULL)
    {
        return error;
    }

    if (force_kind == M68K_FORCE_I)
    {
        if (src.mode != M68K_EA_OTHER || src.reg != M68K_SUB_IMMEDIATE)
        {
            return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_BAD_OPERAND, ASSEMBLE_M68K_ERR_BAD_EA,
                                       "CMPI requires an immediate source");
        }
        error = m68k_encode_ea(context, &src, size, M68K_EAM_IMMEDIATE, 0, &src_ea, src_ext, &src_ext_count);
        if (error != NULL) { return error; }
        error = m68k_encode_ea(context, &dst, size, M68K_EAM_DATA_ALTERABLE, (uint32_t) src_ext_count * 2u,
                                &dst_ea, dst_ext, &dst_ext_count);
        if (error != NULL) { return error; }
        opword = (uint16_t) (0x0C00u | (m68k_std_size_bits(size) << 6) | dst_ea);
        error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, opword);
        if (error != NULL) { return error; }
        error = emit_ext_words(context, src_ext, src_ext_count);
        if (error != NULL) { return error; }
        return emit_ext_words(context, dst_ext, dst_ext_count);
    }

    if (force_kind == M68K_FORCE_A || dst.mode == M68K_EA_AN)
    {
        uint16_t opmode;

        if (dst.mode != M68K_EA_AN)
        {
            return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_BAD_OPERAND,
                                       ASSEMBLE_M68K_ERR_EA_NOT_ALLOWED, "CMPA destination must be an address register");
        }
        if (size == M68K_SIZE_B)
        {
            return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_M68K_ERR_BAD_SIZE,
                                       "CMPA does not support .B");
        }
        opmode = (size == M68K_SIZE_L) ? 7u : 3u;
        error = m68k_encode_ea(context, &src, size, M68K_EAM_ALL, 0, &src_ea, src_ext, &src_ext_count);
        if (error != NULL) { return error; }
        opword = (uint16_t) (0xB000u | (((uint32_t) dst.reg) << 9) | (opmode << 6) | src_ea);
        error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, opword);
        if (error != NULL) { return error; }
        return emit_ext_words(context, src_ext, src_ext_count);
    }

    if (dst.mode == M68K_EA_DN)
    {
        error = m68k_encode_ea(context, &src, size, M68K_EAM_ALL, 0, &src_ea, src_ext, &src_ext_count);
        if (error != NULL) { return error; }
        opword = (uint16_t) (0xB000u | (((uint32_t) dst.reg) << 9) | (m68k_std_size_bits(size) << 6) | src_ea);
        error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, opword);
        if (error != NULL) { return error; }
        return emit_ext_words(context, src_ext, src_ext_count);
    }

    if (src.mode == M68K_EA_OTHER && src.reg == M68K_SUB_IMMEDIATE)
    {
        error = m68k_encode_ea(context, &src, size, M68K_EAM_IMMEDIATE, 0, &src_ea, src_ext, &src_ext_count);
        if (error != NULL) { return error; }
        error = m68k_encode_ea(context, &dst, size, M68K_EAM_DATA_ALTERABLE, (uint32_t) src_ext_count * 2u,
                                &dst_ea, dst_ext, &dst_ext_count);
        if (error != NULL) { return error; }
        opword = (uint16_t) (0x0C00u | (m68k_std_size_bits(size) << 6) | dst_ea);
        error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, opword);
        if (error != NULL) { return error; }
        error = emit_ext_words(context, src_ext, src_ext_count);
        if (error != NULL) { return error; }
        return emit_ext_words(context, dst_ext, dst_ext_count);
    }

    return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_BAD_OPERAND, ASSEMBLE_M68K_ERR_EA_NOT_ALLOWED,
                               "CMP destination must be a data or address register (use CMPI for a memory destination)");
}

/*******************************************************************
 Function:      encode_cmpm
 Description:   Encodes CMPM (Ay)+,(Ax)+ -- the only addressing mode
                CMPM accepts for either operand.
 ******************************************************************/
static _kernel_oserror *encode_cmpm(assemble_context_t *context, m68k_size_t size,
                                     const uint8_t *text, size_t length)
{
    m68k_operand_t src, dst;
    _kernel_oserror *error;

    if (size == M68K_SIZE_NONE)
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_M68K_ERR_BAD_SIZE,
                                   "CMPM requires a .B/.W/.L size suffix");
    }

    error = parse_two_operands(context, text, length, &src, &dst);
    if (error != NULL)
    {
        return error;
    }
    if (src.mode != M68K_EA_AN_POSTINC || dst.mode != M68K_EA_AN_POSTINC)
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_BAD_OPERAND, ASSEMBLE_M68K_ERR_BAD_EA,
                                   "CMPM requires two postincrement operands, eg (A0)+,(A1)+");
    }

    return assemble_emit_word_be(context, ASSEMBLE_CPU_M68K,
                                  (uint16_t) (0xB108u | (((uint32_t) dst.reg) << 9) |
                                              (m68k_std_size_bits(size) << 6) | src.reg));
}

/*******************************************************************
 Function:      encode_chk
 Description:   Encodes CHK <ea>,Dn. Word-only; no size suffix is
                written (CHK.L is a 68020 addition, out of scope).
 ******************************************************************/
static _kernel_oserror *encode_chk(assemble_context_t *context, m68k_size_t size,
                                    const uint8_t *text, size_t length)
{
    m68k_operand_t src, dst;
    uint16_t src_ea, src_ext[2];
    unsigned char src_ext_count;
    _kernel_oserror *error;

    if (size != M68K_SIZE_NONE)
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_M68K_ERR_BAD_SIZE,
                                   "CHK does not take a size suffix (it is always word-sized)");
    }

    error = parse_two_operands(context, text, length, &src, &dst);
    if (error != NULL)
    {
        return error;
    }
    if (dst.mode != M68K_EA_DN)
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_BAD_OPERAND, ASSEMBLE_M68K_ERR_EA_NOT_ALLOWED,
                                   "CHK destination must be a data register");
    }

    error = m68k_encode_ea(context, &src, M68K_SIZE_W, M68K_EAM_DATA, 0, &src_ea, src_ext, &src_ext_count);
    if (error != NULL)
    {
        return error;
    }

    error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K,
                                   (uint16_t) (0x4180u | (((uint32_t) dst.reg) << 9) | src_ea));
    if (error != NULL)
    {
        return error;
    }
    return emit_ext_words(context, src_ext, src_ext_count);
}

/*******************************************************************
 Function:      encode_bcd
 Description:   Encodes ABCD/SBCD Dy,Dx or ABCD/SBCD -(Ay),-(Ax) --
                the same two operand shapes as ADDX/SUBX, always byte
                sized with no suffix written.
 ******************************************************************/
static _kernel_oserror *encode_bcd(assemble_context_t *context, int is_sbcd, m68k_size_t size,
                                    const uint8_t *text, size_t length)
{
    m68k_operand_t src, dst;
    unsigned char rm;
    _kernel_oserror *error;

    if (size != M68K_SIZE_NONE)
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_M68K_ERR_BAD_SIZE,
                                   "ABCD/SBCD does not take a size suffix (it is always byte-sized)");
    }

    error = parse_two_operands(context, text, length, &src, &dst);
    if (error != NULL)
    {
        return error;
    }

    if (src.mode == M68K_EA_DN && dst.mode == M68K_EA_DN)
    {
        rm = 0;
    }
    else if (src.mode == M68K_EA_AN_PREDEC && dst.mode == M68K_EA_AN_PREDEC)
    {
        rm = 1;
    }
    else
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_BAD_OPERAND, ASSEMBLE_M68K_ERR_BAD_EA,
                                   "ABCD/SBCD requires two data registers or two predecrement operands");
    }

    return assemble_emit_word_be(context, ASSEMBLE_CPU_M68K,
                                  (uint16_t) ((is_sbcd ? 0x8100u : 0xC100u) | (((uint32_t) dst.reg) << 9) |
                                              ((uint32_t) rm << 3) | src.reg));
}

/*******************************************************************
 Function:      encode_nbcd
 Description:   Encodes NBCD <ea> -- a single data-alterable operand,
                always byte-sized with no suffix written.
 ******************************************************************/
static _kernel_oserror *encode_nbcd(assemble_context_t *context, m68k_size_t size,
                                     const uint8_t *text, size_t length)
{
    size_t pos = 0;
    m68k_operand_t dst;
    uint16_t dst_ea, dst_ext[2];
    unsigned char dst_ext_count;
    _kernel_oserror *error;

    if (size != M68K_SIZE_NONE)
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_M68K_ERR_BAD_SIZE,
                                   "NBCD does not take a size suffix (it is always byte-sized)");
    }

    pos += assemble_skip_spaces(text + pos, length - pos);
    error = parse_m68k_operand(context, text, length, &pos, &dst);
    if (error != NULL)
    {
        return error;
    }
    error = check_trailing(text, length, pos);
    if (error != NULL)
    {
        return error;
    }

    error = m68k_encode_ea(context, &dst, M68K_SIZE_B, M68K_EAM_DATA_ALTERABLE, 0, &dst_ea, dst_ext, &dst_ext_count);
    if (error != NULL)
    {
        return error;
    }

    error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, (uint16_t) (0x4800u | dst_ea));
    if (error != NULL)
    {
        return error;
    }
    return emit_ext_words(context, dst_ext, dst_ext_count);
}

/*******************************************************************
 Function:      peek_keyword
 Description:   Tests whether 'keyword' (an upper-case ASCII literal)
                appears at 'pos', case-insensitively, not followed by
                a further identifier character. Used to recognise the
                'CCR'/'SR' destination keywords of ANDI/ORI/EORI, which
                aren't ordinary addressing-mode syntax and so must be
                checked before falling into parse_m68k_operand().
 Parameters:    text/length = the source text
                pos = position to test at
                keyword = the upper-case ASCII word to test for
 Returns:       non-zero if 'keyword' matches at 'pos'
 ******************************************************************/
static int peek_keyword(const uint8_t *text, size_t length, size_t pos, const char *keyword)
{
    size_t klen = strlen(keyword);
    size_t i;

    if (pos + klen > length)
    {
        return 0;
    }
    for (i = 0; i < klen; i++)
    {
        if (toupper((int) text[pos + i]) != keyword[i])
        {
            return 0;
        }
    }
    if (pos + klen < length && assemble_is_ident_char(text[pos + klen]))
    {
        return 0;
    }
    return 1;
}

/*******************************************************************
 Function:      encode_logic
 Description:   Encodes AND/OR/EOR/ANDI/ORI/EORI, including the
                ANDI/ORI/EORI #imm,CCR and #imm,SR fixed-opcode forms.
                Like encode_add_sub(), the plain AND/OR mnemonics
                auto-detect the ea+Dn->Dn, Dn+ea->ea and ANDI/ORI-
                shaped immediate-to-memory encodings from the parsed
                operands; EOR has no ea+Dn->Dn form at all (its
                register operand is always the source, never a
                destination read), so it auto-detects only between
                the Dn-source register form and the EORI-shaped
                immediate form.
 Parameters:    context = the assembly context
                kind = 0 for AND, 1 for OR, 2 for EOR
                force_kind = M68K_FORCE_AUTO or M68K_FORCE_I (there is
                             no address-register form for logical ops)
                size = the parsed .B/.W/.L size suffix
                text/length = the operand text following the mnemonic
 Returns:       NULL if successful, otherwise a static error block
 ******************************************************************/
static _kernel_oserror *encode_logic(assemble_context_t *context, int kind, uint32_t force_kind,
                                      m68k_size_t size, const uint8_t *text, size_t length)
{
    static const uint16_t base_rw[3]  = { 0xC000u, 0x8000u, 0xB000u };
    static const uint16_t base_imm[3] = { 0x0200u, 0x0000u, 0x0A00u };
    static const uint16_t base_ccr[3] = { 0x023Cu, 0x003Cu, 0x0A3Cu };
    static const uint16_t base_sr[3]  = { 0x027Cu, 0x007Cu, 0x0A7Cu };

    size_t pos = 0;
    m68k_operand_t src, dst;
    uint16_t src_ea, dst_ea, src_ext[2], dst_ext[2];
    unsigned char src_ext_count, dst_ext_count;
    uint16_t opword;
    _kernel_oserror *error;

    if (size == M68K_SIZE_NONE)
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_M68K_ERR_BAD_SIZE,
                                   "Requires a .B/.W/.L size suffix");
    }

    pos += assemble_skip_spaces(text + pos, length - pos);
    error = parse_m68k_operand(context, text, length, &pos, &src);
    if (error != NULL)
    {
        return error;
    }
    pos += assemble_skip_spaces(text + pos, length - pos);
    if (!(pos < length && text[pos] == ','))
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_M68K_ERR_NONE,
                                   "Expected ','");
    }
    pos += 1;
    pos += assemble_skip_spaces(text + pos, length - pos);

    if (force_kind == M68K_FORCE_I && src.mode == M68K_EA_OTHER && src.reg == M68K_SUB_IMMEDIATE)
    {
        if (peek_keyword(text, length, pos, "CCR"))
        {
            if (size != M68K_SIZE_B)
            {
                return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_M68K_ERR_BAD_SIZE,
                                           "ANDI/ORI/EORI to CCR must be .B");
            }
            error = check_trailing(text, length, pos + 3);
            if (error != NULL) { return error; }
            error = m68k_encode_ea(context, &src, size, M68K_EAM_IMMEDIATE, 0, &src_ea, src_ext, &src_ext_count);
            if (error != NULL) { return error; }
            error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, base_ccr[kind]);
            if (error != NULL) { return error; }
            return emit_ext_words(context, src_ext, src_ext_count);
        }
        if (peek_keyword(text, length, pos, "SR"))
        {
            if (size != M68K_SIZE_W)
            {
                return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_M68K_ERR_BAD_SIZE,
                                           "ANDI/ORI/EORI to SR must be .W");
            }
            error = check_trailing(text, length, pos + 2);
            if (error != NULL) { return error; }
            error = m68k_encode_ea(context, &src, size, M68K_EAM_IMMEDIATE, 0, &src_ea, src_ext, &src_ext_count);
            if (error != NULL) { return error; }
            error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, base_sr[kind]);
            if (error != NULL) { return error; }
            return emit_ext_words(context, src_ext, src_ext_count);
        }
    }

    error = parse_m68k_operand(context, text, length, &pos, &dst);
    if (error != NULL)
    {
        return error;
    }
    error = check_trailing(text, length, pos);
    if (error != NULL)
    {
        return error;
    }

    if (force_kind == M68K_FORCE_I)
    {
        if (src.mode != M68K_EA_OTHER || src.reg != M68K_SUB_IMMEDIATE)
        {
            return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_BAD_OPERAND, ASSEMBLE_M68K_ERR_BAD_EA,
                                       "ANDI/ORI/EORI requires an immediate source");
        }
        error = m68k_encode_ea(context, &src, size, M68K_EAM_IMMEDIATE, 0, &src_ea, src_ext, &src_ext_count);
        if (error != NULL) { return error; }
        error = m68k_encode_ea(context, &dst, size, M68K_EAM_DATA_ALTERABLE, (uint32_t) src_ext_count * 2u,
                                &dst_ea, dst_ext, &dst_ext_count);
        if (error != NULL) { return error; }
        opword = (uint16_t) (base_imm[kind] | (m68k_std_size_bits(size) << 6) | dst_ea);
        error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, opword);
        if (error != NULL) { return error; }
        error = emit_ext_words(context, src_ext, src_ext_count);
        if (error != NULL) { return error; }
        return emit_ext_words(context, dst_ext, dst_ext_count);
    }

    if (kind == 2)
    {
        if (src.mode == M68K_EA_OTHER && src.reg == M68K_SUB_IMMEDIATE)
        {
            error = m68k_encode_ea(context, &src, size, M68K_EAM_IMMEDIATE, 0, &src_ea, src_ext, &src_ext_count);
            if (error != NULL) { return error; }
            error = m68k_encode_ea(context, &dst, size, M68K_EAM_DATA_ALTERABLE, (uint32_t) src_ext_count * 2u,
                                    &dst_ea, dst_ext, &dst_ext_count);
            if (error != NULL) { return error; }
            opword = (uint16_t) (base_imm[kind] | (m68k_std_size_bits(size) << 6) | dst_ea);
            error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, opword);
            if (error != NULL) { return error; }
            error = emit_ext_words(context, src_ext, src_ext_count);
            if (error != NULL) { return error; }
            return emit_ext_words(context, dst_ext, dst_ext_count);
        }
        if (src.mode != M68K_EA_DN)
        {
            return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_BAD_OPERAND,
                                       ASSEMBLE_M68K_ERR_EA_NOT_ALLOWED, "EOR source must be a data register");
        }
        error = m68k_encode_ea(context, &dst, size, M68K_EAM_DATA_ALTERABLE, 0, &dst_ea, dst_ext, &dst_ext_count);
        if (error != NULL) { return error; }
        opword = (uint16_t) (base_rw[kind] | (((uint32_t) src.reg) << 9) | ((4u + m68k_std_size_bits(size)) << 6) | dst_ea);
        error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, opword);
        if (error != NULL) { return error; }
        return emit_ext_words(context, dst_ext, dst_ext_count);
    }

    if (dst.mode == M68K_EA_DN)
    {
        error = m68k_encode_ea(context, &src, size, M68K_EAM_DATA, 0, &src_ea, src_ext, &src_ext_count);
        if (error != NULL) { return error; }
        opword = (uint16_t) (base_rw[kind] | (((uint32_t) dst.reg) << 9) | (m68k_std_size_bits(size) << 6) | src_ea);
        error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, opword);
        if (error != NULL) { return error; }
        return emit_ext_words(context, src_ext, src_ext_count);
    }

    if (src.mode == M68K_EA_OTHER && src.reg == M68K_SUB_IMMEDIATE)
    {
        error = m68k_encode_ea(context, &src, size, M68K_EAM_IMMEDIATE, 0, &src_ea, src_ext, &src_ext_count);
        if (error != NULL) { return error; }
        error = m68k_encode_ea(context, &dst, size, M68K_EAM_DATA_ALTERABLE, (uint32_t) src_ext_count * 2u,
                                &dst_ea, dst_ext, &dst_ext_count);
        if (error != NULL) { return error; }
        opword = (uint16_t) (base_imm[kind] | (m68k_std_size_bits(size) << 6) | dst_ea);
        error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, opword);
        if (error != NULL) { return error; }
        error = emit_ext_words(context, src_ext, src_ext_count);
        if (error != NULL) { return error; }
        return emit_ext_words(context, dst_ext, dst_ext_count);
    }

    if (src.mode != M68K_EA_DN)
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_BAD_OPERAND, ASSEMBLE_M68K_ERR_EA_NOT_ALLOWED,
                                   "AND/OR with a memory destination requires a data-register source");
    }

    error = m68k_encode_ea(context, &dst, size, M68K_EAM_MEMORY_ALTERABLE, 0, &dst_ea, dst_ext, &dst_ext_count);
    if (error != NULL)
    {
        return error;
    }
    opword = (uint16_t) (base_rw[kind] | (((uint32_t) src.reg) << 9) | ((4u + m68k_std_size_bits(size)) << 6) | dst_ea);
    error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, opword);
    if (error != NULL)
    {
        return error;
    }
    return emit_ext_words(context, dst_ext, dst_ext_count);
}

/*******************************************************************
 Function:      encode_bit_op
 Description:   Encodes BTST/BCHG/BCLR/BSET, both the dynamic (bit
                number in a data register) and static (bit number as
                an immediate) forms. The static form's bit-number
                extension word always precedes the destination EA's
                own extension words, so the destination is encoded
                with a 2-byte PC-relative bias for that form.
 Parameters:    context = the assembly context
                kind = 0=BTST, 1=BCHG, 2=BCLR, 3=BSET
                text/length = the operand text following the mnemonic
 Returns:       NULL if successful, otherwise a static error block
 ******************************************************************/
static _kernel_oserror *encode_bit_op(assemble_context_t *context, int kind, const uint8_t *text, size_t length)
{
    static const uint16_t dyn_base[4]    = { 0x0100u, 0x0140u, 0x0180u, 0x01C0u };
    static const uint16_t static_base[4] = { 0x0800u, 0x0840u, 0x0880u, 0x08C0u };

    m68k_operand_t src, dst;
    uint16_t dst_ea, dst_ext[2];
    unsigned char dst_ext_count;
    uint32_t dst_mask = (kind == 0) ? M68K_EAM_DATA : M68K_EAM_DATA_ALTERABLE;
    _kernel_oserror *error;

    error = parse_two_operands(context, text, length, &src, &dst);
    if (error != NULL)
    {
        return error;
    }

    if (src.mode == M68K_EA_DN)
    {
        error = m68k_encode_ea(context, &dst, M68K_SIZE_B, dst_mask, 0, &dst_ea, dst_ext, &dst_ext_count);
        if (error != NULL)
        {
            return error;
        }
        error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K,
                                       (uint16_t) (dyn_base[kind] | (((uint32_t) src.reg) << 9) | dst_ea));
        if (error != NULL)
        {
            return error;
        }
        return emit_ext_words(context, dst_ext, dst_ext_count);
    }

    if (src.mode == M68K_EA_OTHER && src.reg == M68K_SUB_IMMEDIATE)
    {
        int32_t bit = src.value;

        error = m68k_encode_ea(context, &dst, M68K_SIZE_B, dst_mask, 2, &dst_ea, dst_ext, &dst_ext_count);
        if (error != NULL)
        {
            return error;
        }
        if (dst.mode == M68K_EA_DN)
        {
            if (bit < 0 || bit > 31)
            {
                return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_RANGE,
                                           ASSEMBLE_M68K_ERR_IMMEDIATE_RANGE,
                                           "Bit number out of range 0..31 for a data-register destination");
            }
        }
        else if (bit < 0 || bit > 7)
        {
            return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_RANGE, ASSEMBLE_M68K_ERR_IMMEDIATE_RANGE,
                                       "Bit number out of range 0..7 for a memory destination");
        }

        error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, (uint16_t) (static_base[kind] | dst_ea));
        if (error != NULL)
        {
            return error;
        }
        error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, (uint16_t) ((uint32_t) bit & 0xFFu));
        if (error != NULL)
        {
            return error;
        }
        return emit_ext_words(context, dst_ext, dst_ext_count);
    }

    return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_BAD_OPERAND, ASSEMBLE_M68K_ERR_BAD_EA,
                               "BTST/BCHG/BCLR/BSET source must be a data register or #immediate bit number");
}

/*******************************************************************
 Function:      encode_shift
 Description:   Encodes ASx/LSx/ROXx/ROx, both the register form
                (#imm,Dn or Dy,Dx, size .B/.W/.L) and the memory form
                (a single word-sized alterable memory operand, shift
                count always 1 -- detected by the absence of a comma).
 Parameters:    context = the assembly context
                type = 0=AS, 1=LS, 2=ROX, 3=RO
                dir = 0=right, 1=left
                size = the parsed .B/.W/.L size suffix (register form
                       only; the memory form is always word-sized)
                text/length = the operand text following the mnemonic
 Returns:       NULL if successful, otherwise a static error block
 ******************************************************************/
static _kernel_oserror *encode_shift(assemble_context_t *context, uint32_t type, uint32_t dir,
                                      m68k_size_t size, const uint8_t *text, size_t length)
{
    size_t pos = 0;
    m68k_operand_t first, second;
    int has_comma;
    _kernel_oserror *error;

    pos += assemble_skip_spaces(text + pos, length - pos);
    error = parse_m68k_operand(context, text, length, &pos, &first);
    if (error != NULL)
    {
        return error;
    }
    pos += assemble_skip_spaces(text + pos, length - pos);
    has_comma = (pos < length && text[pos] == ',');

    if (!has_comma)
    {
        uint16_t dst_ea, dst_ext[2];
        unsigned char dst_ext_count;

        error = check_trailing(text, length, pos);
        if (error != NULL)
        {
            return error;
        }
        if (size != M68K_SIZE_NONE && size != M68K_SIZE_W)
        {
            return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_M68K_ERR_BAD_SIZE,
                                       "Memory shift/rotate is always word-sized");
        }

        error = m68k_encode_ea(context, &first, M68K_SIZE_W, M68K_EAM_MEMORY_ALTERABLE, 0,
                                &dst_ea, dst_ext, &dst_ext_count);
        if (error != NULL)
        {
            return error;
        }
        error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K,
                                       (uint16_t) (0xE000u | (type << 9) | (dir << 8) | 0xC0u | dst_ea));
        if (error != NULL)
        {
            return error;
        }
        return emit_ext_words(context, dst_ext, dst_ext_count);
    }

    if (size == M68K_SIZE_NONE)
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_M68K_ERR_BAD_SIZE,
                                   "Requires a .B/.W/.L size suffix");
    }

    pos += 1;
    pos += assemble_skip_spaces(text + pos, length - pos);
    error = parse_m68k_operand(context, text, length, &pos, &second);
    if (error != NULL)
    {
        return error;
    }
    error = check_trailing(text, length, pos);
    if (error != NULL)
    {
        return error;
    }

    if (second.mode != M68K_EA_DN)
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_BAD_OPERAND, ASSEMBLE_M68K_ERR_EA_NOT_ALLOWED,
                                   "Shift/rotate destination must be a data register");
    }

    if (first.mode == M68K_EA_OTHER && first.reg == M68K_SUB_IMMEDIATE)
    {
        int32_t count = first.value;
        uint16_t ddd;

        if (count < 1 || count > 8)
        {
            return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_RANGE, ASSEMBLE_M68K_ERR_IMMEDIATE_RANGE,
                                       "Shift/rotate count out of range 1..8");
        }
        ddd = (uint16_t) ((count == 8) ? 0 : count);
        return assemble_emit_word_be(context, ASSEMBLE_CPU_M68K,
                                      (uint16_t) (0xE000u | (ddd << 9) | (dir << 8) | (m68k_std_size_bits(size) << 6) |
                                                  (type << 3) | second.reg));
    }

    if (first.mode == M68K_EA_DN)
    {
        return assemble_emit_word_be(context, ASSEMBLE_CPU_M68K,
                                      (uint16_t) (0xE000u | (((uint32_t) first.reg) << 9) | (dir << 8) |
                                                  (m68k_std_size_bits(size) << 6) | 0x20u | (type << 3) | second.reg));
    }

    return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_BAD_OPERAND, ASSEMBLE_M68K_ERR_BAD_EA,
                               "Shift/rotate count must be a data register or #immediate");
}

static _kernel_oserror *dispatch_family(assemble_context_t *context, const m68k_mnemonic_entry_t *entry,
                                         m68k_size_t size, const uint8_t *text, size_t length)
{
    switch (entry->family)
    {
        case FAM_MOVE:
            if (strcmp(entry->root, "MOVEQ") == 0)
            {
                return encode_moveq(context, size, text, length);
            }
            return encode_move(context, strcmp(entry->root, "MOVEA") == 0, size, text, length);

        case FAM_NOOP:
            return encode_noop(context, (uint16_t) entry->param1, text, length);

        case FAM_ONE_OP:
            return encode_one_op(context, (uint16_t) entry->param1, size, text, length);

        case FAM_ADD_SUB:
            return encode_add_sub(context, (int) entry->param1, entry->param2, size, text, length);

        case FAM_ADDX_SUBX:
            return encode_addx_subx(context, (int) entry->param1, size, text, length);

        case FAM_ADDQ_SUBQ:
            return encode_addq_subq(context, (int) entry->param1, size, text, length);

        case FAM_MUL_DIV:
            return encode_mul_div(context, (uint16_t) entry->param1, text, length);

        case FAM_CMP:
            return encode_cmp(context, entry->param2, size, text, length);

        case FAM_CMPM:
            return encode_cmpm(context, size, text, length);

        case FAM_CHK:
            return encode_chk(context, size, text, length);

        case FAM_BCD:
            return encode_bcd(context, (int) entry->param1, size, text, length);

        case FAM_NBCD:
            return encode_nbcd(context, size, text, length);

        case FAM_LOGIC:
            return encode_logic(context, (int) entry->param1, entry->param2, size, text, length);

        case FAM_BIT_OP:
            return encode_bit_op(context, (int) entry->param1, text, length);

        case FAM_SHIFT:
            return encode_shift(context, entry->param1, entry->param2, size, text, length);

        default:
            break;
    }
    return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_INTERNAL, ASSEMBLE_M68K_ERR_NONE,
                               "Unhandled instruction family");
}

/*******************************************************************
 Function:      assemble_dc
 Description:   Assembles a DCB/DCW/DCD pseudo-op: a comma-separated
                list of expressions, each emitted as a byte, 16-bit
                word or 32-bit doubleword respectively, big-endian.
                No padding is added for an odd byte count -- see
                h/assemble_m68k's deficiencies comment.
 Parameters:    context = the assembly context
                mnemonic = "DCB", "DCW" or "DCD"
                text/length = the operand text following the mnemonic
 Returns:       NULL if successful, otherwise a static error block
 ******************************************************************/
static _kernel_oserror *assemble_dc(assemble_context_t *context, const char *mnemonic,
                                     const uint8_t *text, size_t length)
{
    size_t pos = 0;
    _kernel_oserror *error;

    for (;;)
    {
        int32_t number;

        pos += assemble_skip_spaces(text + pos, length - pos);
        error = eval_numeric(context, text, length, &pos, &number);
        if (error != NULL)
        {
            return error;
        }

        if (strcmp(mnemonic, "DCB") == 0)
        {
            error = assemble_emit_byte(context, ASSEMBLE_CPU_M68K, (uint8_t) (number & 0xFF));
        }
        else if (strcmp(mnemonic, "DCW") == 0)
        {
            error = assemble_emit_word_be(context, ASSEMBLE_CPU_M68K, (uint16_t) (number & 0xFFFF));
        }
        else
        {
            error = assemble_emit_dword_be(context, ASSEMBLE_CPU_M68K, (uint32_t) number);
        }
        if (error != NULL)
        {
            return error;
        }

        pos += assemble_skip_spaces(text + pos, length - pos);
        if (pos < length && text[pos] == ',')
        {
            pos += 1;
            continue;
        }
        break;
    }

    return check_trailing(text, length, pos);
}

/*******************************************************************
 Function:      assign_label
 Description:   Assigns a value to a label via the context's
                assign_var callback.
 Parameters:    context = the assembly context
                label/label_length = the label name
                value = the value to assign
 Returns:       NULL if successful, otherwise a static error block
 ******************************************************************/
static _kernel_oserror *assign_label(assemble_context_t *context,
                                      const char *label, size_t label_length,
                                      const assemble_value_t *value)
{
    _kernel_oserror *error = NULL;

    if (context->assign_var(context->user_data, label, label_length, value, &error) != ASSEMBLE_RESULT_OK)
    {
        if (error != NULL)
        {
            return error;
        }
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_BAD_LABEL, ASSEMBLE_M68K_ERR_NONE,
                                   "Label could not be assigned");
    }
    return NULL;
}

_kernel_oserror *assemble_m68k_line(assemble_context_t *context,
                                     const uint8_t *line, size_t line_length)
{
    size_t pos;
    char label[64];
    size_t label_length = 0;
    int have_label = 0;
    char mnemonic[8];
    size_t consumed;
    m68k_size_t size;
    const m68k_mnemonic_entry_t *entry;
    _kernel_oserror *error;

    context->bytes_used = 0;
    pos = 0;

    pos += assemble_skip_spaces(line + pos, line_length - pos);

    if (pos < line_length && line[pos] == '.')
    {
        size_t start;

        pos += 1;
        start = pos;
        if (!(pos < line_length && assemble_is_ident_start(line[pos])))
        {
            return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_BAD_LABEL, ASSEMBLE_M68K_ERR_NONE,
                                       "Expected a label name after '.'");
        }
        while (pos < line_length && assemble_is_ident_char(line[pos]))
        {
            pos += 1;
        }
        label_length = pos - start;
        if (label_length >= sizeof(label))
        {
            label_length = sizeof(label) - 1;
        }
        memcpy(label, line + start, label_length);
        label[label_length] = '\0';
        have_label = 1;

        pos += assemble_skip_spaces(line + pos, line_length - pos);
    }

    if (pos >= line_length)
    {
        if (have_label)
        {
            assemble_value_t value;

            value.type = ASSEMBLE_VALUE_INTEGER;
            value.value.as_integer = (int32_t) context->address;
            return assign_label(context, label, label_length, &value);
        }
        return NULL;
    }

    consumed = read_mnemonic(line + pos, line_length - pos, mnemonic);
    if (consumed == 0 || mnemonic[0] == '\0')
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_BAD_MNEMONIC, ASSEMBLE_M68K_ERR_NONE,
                                   "Mnemonic not recognised");
    }
    pos += consumed;

    if (strcmp(mnemonic, "EQU") == 0)
    {
        assemble_value_t value;

        if (!have_label)
        {
            return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_BAD_LABEL,
                                       ASSEMBLE_M68K_ERR_NEED_LABEL_FOR_EQU, "EQU used without a preceding label");
        }
        pos += assemble_skip_spaces(line + pos, line_length - pos);
        error = eval_expr(context, line + pos, line_length - pos, &value, &consumed);
        if (error != NULL)
        {
            return error;
        }
        pos += consumed;
        error = check_trailing(line, line_length, pos);
        if (error != NULL)
        {
            return error;
        }
        return assign_label(context, label, label_length, &value);
    }

    if (have_label)
    {
        assemble_value_t value;

        value.type = ASSEMBLE_VALUE_INTEGER;
        value.value.as_integer = (int32_t) context->address;
        error = assign_label(context, label, label_length, &value);
        if (error != NULL)
        {
            return error;
        }
    }

    if (strcmp(mnemonic, "OPT") == 0)
    {
        pos += assemble_skip_spaces(line + pos, line_length - pos);
        if (pos < line_length)
        {
            assemble_value_t value;

            error = eval_expr(context, line + pos, line_length - pos, &value, &consumed);
            if (error != NULL)
            {
                return error;
            }
            pos += consumed;
        }
        return check_trailing(line, line_length, pos);
    }

    if (strcmp(mnemonic, "DCB") == 0 || strcmp(mnemonic, "DCW") == 0 || strcmp(mnemonic, "DCD") == 0)
    {
        pos += assemble_skip_spaces(line + pos, line_length - pos);
        return assemble_dc(context, mnemonic, line + pos, line_length - pos);
    }

    entry = find_mnemonic(mnemonic);
    if (entry == NULL)
    {
        return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_BAD_MNEMONIC, ASSEMBLE_M68K_ERR_NONE,
                                   "Mnemonic not recognised");
    }

    error = parse_size_suffix(line, line_length, &pos, &size);
    if (error != NULL)
    {
        return error;
    }
    if (size != M68K_SIZE_NONE)
    {
        unsigned char bit = (size == M68K_SIZE_B) ? SZ_B : (size == M68K_SIZE_W) ? SZ_W : SZ_L;

        if ((entry->size_mask & bit) == 0)
        {
            return assemble_set_error(ASSEMBLE_CPU_M68K, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_M68K_ERR_BAD_SIZE,
                                       "Size suffix not supported by this mnemonic");
        }
    }
    pos += assemble_skip_spaces(line + pos, line_length - pos);

    return dispatch_family(context, entry, size, line + pos, line_length - pos);
}
