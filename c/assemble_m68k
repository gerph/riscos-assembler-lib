    { "ADDX", FAM_ADDX_SUBX, 0, 0, SZ_BWL },
    { "SUBX", FAM_ADDX_SUBX, 1, 0, SZ_BWL },

    { "ADDQ", FAM_ADDQ_SUBQ, 0, 0, SZ_BWL },
    { "SUBQ", FAM_ADDQ_SUBQ, 1, 0, SZ_BWL },

    { "MULU", FAM_MUL_DIV, 0xC0C0, 0, SZ_W },
    { "MULS", FAM_MUL_DIV, 0xC1C0, 0, SZ_W },
    { "DIVU", FAM_MUL_DIV, 0x80C0, 0, SZ_W },
    { "DIVS", FAM_MUL_DIV, 0x81C0, 0, SZ_W },

    { "CMP",  FAM_CMP, 0, M68K_FORCE_AUTO, SZ_BWL },
