int run_tests_arm32(void)
{
    size_t i;
    int passed = 0;
    int failed = 0;

    for (i = 0; i < sizeof(tests) / sizeof(tests[0]); i++)
    {
        if (run_case(&tests[i]))
        {
            passed += 1;
        }
        else
        {
            failed += 1;
        }
    }

    printf("assemble_arm32: %d passed, %d failed (of %d)\n", passed, failed, passed + failed);

    return failed;
}
