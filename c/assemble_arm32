    { "VADDHN",  FAMILY_NEON_HN, (0x4u<<1), 0, 0, 0, ASSEMBLE_ARM32_OPT_VFP },
    { "VRADDHN", FAMILY_NEON_HN, (0x4u<<1) | 1u, 0, 0, 0, ASSEMBLE_ARM32_OPT_VFP },
    { "VSUBHN",  FAMILY_NEON_HN, (0x6u<<1), 0, 0, 0, ASSEMBLE_ARM32_OPT_VFP },
    { "VRSUBHN", FAMILY_NEON_HN, (0x6u<<1) | 1u, 0, 0, 0, ASSEMBLE_ARM32_OPT_VFP },

