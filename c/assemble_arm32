    { "VST3", FAMILY_NEON_LDST_MULTIPLE, 0u | (2u<<1), 0, 0, 0, ASSEMBLE_ARM32_OPT_VFP },
    { "VLD4", FAMILY_NEON_LDST_MULTIPLE, 1u | (3u<<1), 0, 0, 0, ASSEMBLE_ARM32_OPT_VFP },
    { "VST4", FAMILY_NEON_LDST_MULTIPLE, 0u | (3u<<1), 0, 0, 0, ASSEMBLE_ARM32_OPT_VFP },

    /* param1: 0=VMAXNM, 1=VMINNM (the "op" bit; the same value selects
       MAX/MIN in both the VFP-scalar and NEON encodings). */
    { "VMAXNM", FAMILY_VFP_OR_NEON_MAXNM, 0u, 0, 0, 0, ASSEMBLE_ARM32_OPT_VFP },
    { "VMINNM", FAMILY_VFP_OR_NEON_MAXNM, 1u, 0, 0, 0, ASSEMBLE_ARM32_OPT_VFP },

    /* param1: 2-bit cc field (EQ=0, VS=1, GE=2, GT=3). */
    { "VSELEQ", FAMILY_VFP_SEL, 0u, 0, 0, 0, ASSEMBLE_ARM32_OPT_VFP },
    { "VSELVS", FAMILY_VFP_SEL, 1u, 0, 0, 0, ASSEMBLE_ARM32_OPT_VFP },
    { "VSELGE", FAMILY_VFP_SEL, 2u, 0, 0, 0, ASSEMBLE_ARM32_OPT_VFP },
    { "VSELGT", FAMILY_VFP_SEL, 3u, 0, 0, 0, ASSEMBLE_ARM32_OPT_VFP },

    /* param1: bits7:4 = scalar shape (0=VRINTR/Z legacy conditional,
       1=VRINTX legacy conditional, 2=VRINTA/N/P/M ARMv8 unconditional),
