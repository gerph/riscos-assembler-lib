    FAMILY_BRANCH,      /* B BL */
    FAMILY_BX,          /* BX BLX BXJ */
    FAMILY_LDR_STR,     /* full LDR/STR family incl B/H/SB/SH/D/T */
    FAMILY_LDM_STM,     /* LDM/STM incl PUSH/POP */
    FAMILY_SWI,
    FAMILY_SWP,         /* SWP SWPB */
    FAMILY_CDP,         /* CDP CDP2 */
    FAMILY_MCR_MRC,     /* MCR MRC MCR2 MRC2 */
    FAMILY_MCRR_MRRC,   /* MCRR MRRC */
    FAMILY_LDC_STC,     /* LDC STC LDC2 STC2 */
    FAMILY_MSR,
    FAMILY_MRS,
    FAMILY_CLZ,         /* Rd,Rm */
    FAMILY_PLD_PLI,
    FAMILY_BFC,         /* Rd,#lsb,#width */
    FAMILY_BFI,         /* Rd,Rn,#lsb,#width */
