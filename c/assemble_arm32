/* CPS{IE|ID} {a}{i}{f}{,#mode}; CPS #mode. Always unconditional. */
static _kernel_oserror *encode_cps(assemble_context_t *context, const mnemonic_entry_t *entry,
                                    uint32_t cond, int s_flag,
                                    const uint8_t *text, size_t length, size_t pos,
                                    uint32_t *out_instr)
{
    uint32_t imod = 0, aif = 0, have_mode = 0;
    int32_t mode = 0;
    _kernel_oserror *error;

    (void) cond; (void) s_flag;
    if (entry->param1 != 0) /* CPSIE/CPSID */
    {
        imod = (entry->param1 == 1) ? 2u : 3u;
        pos += assemble_skip_spaces(text + pos, length - pos);
        while (pos < length && (text[pos] == 'a' || text[pos] == 'A' ||
                                 text[pos] == 'i' || text[pos] == 'I' ||
                                 text[pos] == 'f' || text[pos] == 'F'))
        {
            switch (toupper((int) text[pos]))
            {
                case 'A': aif |= 4u; break;
                case 'I': aif |= 2u; break;
                case 'F': aif |= 1u; break;
                default: break;
            }
            pos += 1;
        }
        pos += assemble_skip_spaces(text + pos, length - pos);
    }
    if (pos < length && text[pos] == ',')
    {
        pos += 1;
        pos += assemble_skip_spaces(text + pos, length - pos);
        error = expect_char(text, length, &pos, '#');
        if (error != NULL) return error;
        error = eval_numeric(context, text, length, &pos, &mode);
        if (error != NULL) return error;
        have_mode = 1;
    }
    else if (entry->param1 == 0) /* plain 'CPS #mode' -- mode is mandatory */
    {
        error = expect_char(text, length, &pos, '#');
        if (error != NULL) return error;
        error = eval_numeric(context, text, length, &pos, &mode);
        if (error != NULL) return error;
        have_mode = 1;
    }
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;
    if (mode < 0 || mode > 31)
    {
        return error_bad_immediate();
    }

    *out_instr = 0xF1000000u | (imod << 18) | (have_mode ? (1u << 17) : 0) | (aif << 6) |
                 (have_mode ? (uint32_t) mode : 0);
    return NULL;
}

