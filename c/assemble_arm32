    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, '#');
    if (error != NULL) return error;
    error = eval_numeric(context, text, length, &pos, &sat_imm);
    if (error != NULL) return error;
    if (is_unsigned)
    {
        if (sat_imm < 0 || sat_imm > 31) return error_bad_immediate();
    }
    else
    {
        if (sat_imm < 1 || sat_imm > 32) return error_bad_immediate();
        sat_imm -= 1;
    }
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_register(context, text, length, &pos, &rn);
    if (error != NULL) return error;
    pos += assemble_skip_spaces(text + pos, length - pos);
    if (pos < length && text[pos] == ',')
    {
        char c0, c1, c2;
        int32_t shift_amount;

        pos += 1;
        pos += assemble_skip_spaces(text + pos, length - pos);
        c0 = (pos < length) ? (char) toupper((int) text[pos]) : 0;
        c1 = (pos + 1 < length) ? (char) toupper((int) text[pos + 1]) : 0;
        c2 = (pos + 2 < length) ? (char) toupper((int) text[pos + 2]) : 0;
        if (c0 == 'L' && c1 == 'S' && c2 == 'L')
        {
            sh = 0;
        }
        else if (c0 == 'A' && c1 == 'S' && c2 == 'R')
        {
            sh = 1;
        }
        else
        {
            return error_bad_shift();
        }
        pos += 3;
        error = expect_char(text, length, &pos, '#');
        if (error != NULL) return error;
        error = eval_numeric(context, text, length, &pos, &shift_amount);
        if (error != NULL) return error;
        if (sh == 0)
        {
            if (shift_amount < 0 || shift_amount > 31) return error_bad_shift();
        }
        else
        {
            if (shift_amount < 1 || shift_amount > 32) return error_bad_shift();
            if (shift_amount == 32) shift_amount = 0;
        }
        imm5 = (uint32_t) shift_amount;
    }
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    *out_instr = (cond << 28) | (is_unsigned ? 0x06E00010u : 0x06A00010u) |
                 ((uint32_t) sat_imm << 16) | (rd << 12) | (imm5 << 7) | (sh << 6) | rn;
    return NULL;
}

/* SSAT16/USAT16 Rd,#sat_imm,Rn. Signed: 1-16 (encoded n-1); unsigned: 0-15. */
static _kernel_oserror *encode_sat16(assemble_context_t *context, const mnemonic_entry_t *entry,
                                      uint32_t cond, int s_flag,
                                      const uint8_t *text, size_t length, size_t pos,
                                      uint32_t *out_instr)
{
    uint32_t rd, rn;
    int32_t sat_imm;
    _kernel_oserror *error;
    int is_unsigned = (int) entry->param1;

    (void) s_flag;
    error = parse_register(context, text, length, &pos, &rd);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, '#');
    if (error != NULL) return error;
    error = eval_numeric(context, text, length, &pos, &sat_imm);
    if (error != NULL) return error;
    if (is_unsigned)
    {
        if (sat_imm < 0 || sat_imm > 15) return error_bad_immediate();
    }
    else
    {
        if (sat_imm < 1 || sat_imm > 16) return error_bad_immediate();
        sat_imm -= 1;
    }
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_register(context, text, length, &pos, &rn);
    if (error != NULL) return error;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    *out_instr = (cond << 28) | (is_unsigned ? 0x06E0F030u : 0x06A0F030u) | ((uint32_t) sat_imm << 16) | (rd << 12) | rn;
    return NULL;
}

/* QADD/QSUB/QDADD/QDSUB Rd,Rm,Rn -- note the unusual operand order:
   Rm is the value being (de)saturated, Rn (added for QDADD/QDSUB) is
   doubled and saturated first. */
static _kernel_oserror *encode_qsat(assemble_context_t *context, const mnemonic_entry_t *entry,
                                     uint32_t cond, int s_flag,
                                     const uint8_t *text, size_t length, size_t pos,
                                     uint32_t *out_instr)
{
    uint32_t rd, rm, rn;
    _kernel_oserror *error;
    static const uint32_t base[4] = { 0x01000050u, 0x01200050u, 0x01400050u, 0x01600050u };

    (void) s_flag;
    error = parse_register(context, text, length, &pos, &rd);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_register(context, text, length, &pos, &rm);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_register(context, text, length, &pos, &rn);
    if (error != NULL) return error;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    *out_instr = (cond << 28) | base[entry->param1] | (rn << 16) | (rd << 12) | rm;
    return NULL;
}

/* The 36-instruction parallel add/subtract family: Rd,Rn,Rm.
   param1 = (U<<3)|op1 (bits22,21:20), param2 = op2 (bits7:5). */
static _kernel_oserror *encode_parallel(assemble_context_t *context, const mnemonic_entry_t *entry,
                                         uint32_t cond, int s_flag,
                                         const uint8_t *text, size_t length, size_t pos,
                                         uint32_t *out_instr)
{
    uint32_t rd, rn, rm;
    uint32_t u = (entry->param1 >> 3) & 1u;
    uint32_t op1 = entry->param1 & 3u;
    _kernel_oserror *error;

    (void) s_flag;
    error = parse_register(context, text, length, &pos, &rd);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_register(context, text, length, &pos, &rn);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_register(context, text, length, &pos, &rm);
    if (error != NULL) return error;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    *out_instr = (cond << 28) | 0x06000010u | (u << 22) | (op1 << 20) | (rn << 16) | (rd << 12) |
                 (0xFu << 8) | (entry->param2 << 5) | rm;
    return NULL;
}

/*******************************************************************
 Function:      parse_bracketed_register
 Description:   Parses a plain '[Rn]' operand with no offset, as
                used by LDREX/STREX/CLREX-family instructions.
 ******************************************************************/
static _kernel_oserror *parse_bracketed_register(assemble_context_t *context,
                                                   const uint8_t *text, size_t length,
                                                   size_t *pos_inout, uint32_t *out_rn)
{
    _kernel_oserror *error;

    error = expect_char(text, length, pos_inout, '[');
    if (error != NULL) return error;
    error = parse_register(context, text, length, pos_inout, out_rn);
    if (error != NULL) return error;
    return expect_char(text, length, pos_inout, ']');
}

/* LDREX{B|H|D} Rt,[Rn]; STREX{B|H|D} Rd,Rt,[Rn]. param1: 0=LDREX,
   1=LDREXB, 2=LDREXH, 3=LDREXD, 4=STREX, 5=STREXB, 6=STREXH, 7=STREXD. */
static _kernel_oserror *encode_ldrex_strex(assemble_context_t *context, const mnemonic_entry_t *entry,
                                            uint32_t cond, int s_flag,
                                            const uint8_t *text, size_t length, size_t pos,
                                            uint32_t *out_instr)
{
    static const uint32_t ldrex_base[4] = { 0x01900F9Fu, 0x01D00F9Fu, 0x01F00F9Fu, 0x01B00F9Fu };
    static const uint32_t strex_base[4] = { 0x01800F90u, 0x01C00F90u, 0x01E00F90u, 0x01A00F90u };
    uint32_t rn;
    _kernel_oserror *error;

    (void) s_flag;
    if (entry->param1 < 4)
    {
        uint32_t rt;

        error = parse_register(context, text, length, &pos, &rt);
        if (error != NULL) return error;
        error = expect_char(text, length, &pos, ',');
        if (error != NULL) return error;
        error = parse_bracketed_register(context, text, length, &pos, &rn);
        if (error != NULL) return error;
        error = check_trailing(text, length, pos);
        if (error != NULL) return error;

        *out_instr = (cond << 28) | ldrex_base[entry->param1] | (rn << 16) | (rt << 12);
    }
    else
    {
        uint32_t rd, rt;

        error = parse_register(context, text, length, &pos, &rd);
        if (error != NULL) return error;
        error = expect_char(text, length, &pos, ',');
        if (error != NULL) return error;
        error = parse_register(context, text, length, &pos, &rt);
        if (error != NULL) return error;
        error = expect_char(text, length, &pos, ',');
        if (error != NULL) return error;
        error = parse_bracketed_register(context, text, length, &pos, &rn);
        if (error != NULL) return error;
        error = check_trailing(text, length, pos);
        if (error != NULL) return error;

        *out_instr = (cond << 28) | strex_base[entry->param1 - 4] | (rn << 16) | (rd << 12) | rt;
    }
    return NULL;
}

static _kernel_oserror *encode_clrex(assemble_context_t *context, const mnemonic_entry_t *entry,
                                      uint32_t cond, int s_flag,
                                      const uint8_t *text, size_t length, size_t pos,
                                      uint32_t *out_instr)
{
    _kernel_oserror *error;

    (void) context; (void) entry; (void) cond; (void) s_flag;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;
    *out_instr = 0xF57FF01Fu;
    return NULL;
}

/* CPS{IE|ID} {a}{i}{f}{,#mode}; CPS #mode. Always unconditional. */
static _kernel_oserror *encode_cps(assemble_context_t *context, const mnemonic_entry_t *entry,
                                    uint32_t cond, int s_flag,
                                    const uint8_t *text, size_t length, size_t pos,
                                    uint32_t *out_instr)
{
    uint32_t imod = 0, aif = 0, have_mode = 0;
    int32_t mode = 0;
    _kernel_oserror *error;

    (void) cond; (void) s_flag;
    if (entry->param1 != 0) /* CPSIE/CPSID */
    {
        imod = (entry->param1 == 1) ? 2u : 3u;
        pos += assemble_skip_spaces(text + pos, length - pos);
        while (pos < length && (text[pos] == 'a' || text[pos] == 'A' ||
                                 text[pos] == 'i' || text[pos] == 'I' ||
                                 text[pos] == 'f' || text[pos] == 'F'))
        {
            switch (toupper((int) text[pos]))
            {
                case 'A': aif |= 4u; break;
                case 'I': aif |= 2u; break;
                case 'F': aif |= 1u; break;
                default: break;
            }
            pos += 1;
        }
        pos += assemble_skip_spaces(text + pos, length - pos);
    }
    if (pos < length && text[pos] == ',')
    {
        pos += 1;
        pos += assemble_skip_spaces(text + pos, length - pos);
        error = expect_char(text, length, &pos, '#');
        if (error != NULL) return error;
        error = eval_numeric(context, text, length, &pos, &mode);
        if (error != NULL) return error;
        have_mode = 1;
    }
    else if (entry->param1 == 0) /* plain 'CPS #mode' -- mode is mandatory */
    {
        error = expect_char(text, length, &pos, '#');
        if (error != NULL) return error;
        error = eval_numeric(context, text, length, &pos, &mode);
        if (error != NULL) return error;
        have_mode = 1;
    }
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;
    if (mode < 0 || mode > 31)
    {
        return error_bad_immediate();
    }

    *out_instr = 0xF1000000u | (imod << 18) | (have_mode ? (1u << 17) : 0) | (aif << 6) |
                 (have_mode ? (uint32_t) mode : 0);
    return NULL;
}

static _kernel_oserror *encode_setend(assemble_context_t *context, const mnemonic_entry_t *entry,
                                       uint32_t cond, int s_flag,
                                       const uint8_t *text, size_t length, size_t pos,
                                       uint32_t *out_instr)
{
    char c0;
    _kernel_oserror *error;

    (void) entry; (void) cond; (void) s_flag;
    pos += assemble_skip_spaces(text + pos, length - pos);
    c0 = (pos < length) ? (char) toupper((int) text[pos]) : 0;
    if (c0 != 'B' && c0 != 'L')
    {
        return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_ARM32_ERR_NONE,
                                   "Expected BE or LE");
    }
    pos += 2; /* consume 'BE'/'LE' */
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    *out_instr = 0xF1010000u | ((c0 == 'B') ? (1u << 9) : 0);
    return NULL;
}

static _kernel_oserror *encode_setpan(assemble_context_t *context, const mnemonic_entry_t *entry,
                                       uint32_t cond, int s_flag,
                                       const uint8_t *text, size_t length, size_t pos,
                                       uint32_t *out_instr)
{
    int32_t value;
    _kernel_oserror *error;

    (void) entry; (void) cond; (void) s_flag;
    error = expect_char(text, length, &pos, '#');
    if (error != NULL) return error;
    error = eval_numeric(context, text, length, &pos, &value);
    if (error != NULL) return error;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;
    if (value < 0 || value > 1)
    {
        return error_bad_immediate();
    }

    *out_instr = 0xF1010000u | ((uint32_t) value << 9);
    return NULL;
}

/* DMB/DSB/ISB {option}. Only the common named options are matched;
   the option defaults to SY (full system) if omitted. */
static _kernel_oserror *encode_barrier(assemble_context_t *context, const mnemonic_entry_t *entry,
                                        uint32_t cond, int s_flag,
                                        const uint8_t *text, size_t length, size_t pos,
                                        uint32_t *out_instr)
{
    static const uint32_t base[3] = { 0xF57FF050u, 0xF57FF040u, 0xF57FF060u };
    static const char * const names[] = {
        "OSHLD", "OSHST", "OSH", "NSHLD", "NSHST", "NSH", "ISHLD", "ISHST", "ISH", "LD", "ST", "SY"
    };
    static const uint32_t values[] = { 1, 2, 3, 5, 6, 7, 9, 10, 11, 13, 14, 15 };
    uint32_t option = 15;
    char token[8];
    size_t i;

    (void) context; (void) cond; (void) s_flag;
    pos += assemble_skip_spaces(text + pos, length - pos);
    if (pos < length)
    {
        size_t consumed = read_token(text + pos, length - pos, token);

        if (consumed == 0)
        {
            return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_ARM32_ERR_NONE,
                                       "Expected a barrier option");
        }
        for (i = 0; i < sizeof(names) / sizeof(names[0]); i++)
        {
            if (strcmp(token, names[i]) == 0)
            {
                option = values[i];
                break;
            }
        }
        if (i == sizeof(names) / sizeof(names[0]))
        {
            return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_ARM32_ERR_NONE,
                                       "Unrecognised barrier option");
        }
        pos += consumed;
    }
    {
        _kernel_oserror *error = check_trailing(text, length, pos);
        if (error != NULL) return error;
    }

    *out_instr = base[entry->param1] | option;
    return NULL;
}

static _kernel_oserror *encode_hint(assemble_context_t *context, const mnemonic_entry_t *entry,
                                     uint32_t cond, int s_flag,
                                     const uint8_t *text, size_t length, size_t pos,
                                     uint32_t *out_instr)
{
    _kernel_oserror *error;

    (void) context; (void) s_flag;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;
    *out_instr = (cond << 28) | 0x0320F000u | entry->param1;
