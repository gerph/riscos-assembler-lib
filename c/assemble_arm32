    split_vfp_register(rm, (int) sz, &vm, &dm);

    *out_instr = (cond << 28) | 0x0EB00A40u | entry->param1 | (dd << 22) | (vd << 12) | (sz << 8) | (dm << 5) | vm;
    return NULL;
}

/* VCMP/VCMPE {S|D}d,{S|D}m | {S|D}d,#0.0 */
static _kernel_oserror *encode_vfp_cmp(assemble_context_t *context, const mnemonic_entry_t *entry,
                                        uint32_t cond, int s_flag,
                                        const uint8_t *text, size_t length, size_t pos,
                                        uint32_t *out_instr)
{
    uint32_t sz, rd, rm = 0, vd, dd, vm = 0, dm = 0;
    int is_double;
    int vs_zero = 0;
    _kernel_oserror *error;

    (void) s_flag;
    error = parse_vfp_datatype(text, length, &pos, &sz);
    if (error != NULL) return error;
    error = parse_vfp_register(context, text, length, &pos, &rd, &is_double);
    if (error != NULL) return error;
    if (is_double != (int) sz) return error_vfp_mismatched_precision();
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;

    pos += assemble_skip_spaces(text + pos, length - pos);
    if (pos < length && text[pos] == '#')
    {
        assemble_value_t value;
        size_t consumed;

        pos += 1;
        error = eval_expr(context, text + pos, length - pos, &value, &consumed);
        if (error != NULL) return error;
        pos += consumed;
        {
            double v = (value.type == ASSEMBLE_VALUE_FLOAT) ? value.value.as_float : (double) value.value.as_integer;
            if (v != 0.0) return error_bad_fp_immediate();
        }
        vs_zero = 1;
    }
    else
    {
        error = parse_vfp_register(context, text, length, &pos, &rm, &is_double);
        if (error != NULL) return error;
        if (is_double != (int) sz) return error_vfp_mismatched_precision();
    }
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    split_vfp_register(rd, (int) sz, &vd, &dd);
    if (!vs_zero)
    {
        split_vfp_register(rm, (int) sz, &vm, &dm);
    }

    *out_instr = (cond << 28) | 0x0EB40A40u | (vs_zero ? (1u << 16) : 0) | entry->param1 |
                 (dd << 22) | (vd << 12) | (sz << 8) | (dm << 5) | vm;
    return NULL;
}

/* VLDR/VSTR {S|D}d,[Rn{,#imm}] -- same word-aligned +-1020 shape as
   the generic coprocessor and FPA transfers, but with no post-index
   or writeback form (VLDR/VSTR only ever have a plain offset). */
static _kernel_oserror *encode_vfp_ldr_str(assemble_context_t *context, const mnemonic_entry_t *entry,
                                            uint32_t cond, int s_flag,
                                            const uint8_t *text, size_t length, size_t pos,
                                            uint32_t *out_instr)
{
    uint32_t sz, rd, rn, vd, dd;
    int is_double;
    uint32_t bits = (1u << 23); /* U: default positive */
    _kernel_oserror *error;

    (void) s_flag;
    error = parse_vfp_datatype(text, length, &pos, &sz);
    if (error != NULL) return error;
    error = parse_vfp_register(context, text, length, &pos, &rd, &is_double);
    if (error != NULL) return error;
    if (is_double != (int) sz) return error_vfp_mismatched_precision();
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, '[');
    if (error != NULL) return error;
    error = parse_register(context, text, length, &pos, &rn);
    if (error != NULL) return error;
    bits |= rn << 16;
    pos += assemble_skip_spaces(text + pos, length - pos);
    if (pos < length && text[pos] == ',')
    {
        int32_t value;

        pos += 1;
        error = expect_char(text, length, &pos, '#');
        if (error != NULL) return error;
        error = eval_numeric(context, text, length, &pos, &value);
        if (error != NULL) return error;
        if (value < 0) { bits &= ~(1u << 23); value = -value; }
        if ((value & 3) != 0 || value > 0x3FC) return error_bad_offset();
        bits |= (uint32_t) (value >> 2);
    }
    error = expect_char(text, length, &pos, ']');
    if (error != NULL) return error;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    split_vfp_register(rd, (int) sz, &vd, &dd);
    *out_instr = (cond << 28) | 0x0D200A00u | entry->param1 | (dd << 22) | bits | (vd << 12) | (sz << 8);
    return NULL;
}

/* VLDMIA/VLDMDB/VSTMIA/VSTMDB Rn{!},{list} */
static _kernel_oserror *encode_vfp_ldm_stm(assemble_context_t *context, const mnemonic_entry_t *entry,
                                            uint32_t cond, int s_flag,
                                            const uint8_t *text, size_t length, size_t pos,
                                            uint32_t *out_instr)
{
    uint32_t rn, first, last, count;
    int is_double, is_double2;
    _kernel_oserror *error;

    (void) s_flag;
    pos += assemble_skip_spaces(text + pos, length - pos);
    if (pos < length && text[pos] == '.') /* optional, ignored ".32"/".64" size hint */
    {
        while (pos < length && text[pos] != ' ' && text[pos] != ',') pos += 1;
    }
    error = parse_register(context, text, length, &pos, &rn);
    if (error != NULL) return error;
    pos += assemble_skip_spaces(text + pos, length - pos);
    if (pos < length && text[pos] == '!')
    {
        pos += 1;
    }
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, '{');
    if (error != NULL) return error;
    error = parse_vfp_register(context, text, length, &pos, &first, &is_double);
    if (error != NULL) return error;
    last = first;
    pos += assemble_skip_spaces(text + pos, length - pos);
    if (pos < length && text[pos] == '-')
    {
        pos += 1;
        error = parse_vfp_register(context, text, length, &pos, &last, &is_double2);
        if (error != NULL) return error;
        if (is_double2 != is_double) return error_vfp_mismatched_precision();
    }
    error = expect_char(text, length, &pos, '}');
    if (error != NULL) return error;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;
    if (last < first)
    {
        return error_bad_register_list("Register range must be ascending");
    }

    count = last - first + 1;
    {
        uint32_t vd, dd;

        split_vfp_register(first, is_double, &vd, &dd);
        *out_instr = (cond << 28) | 0x0C000A00u | entry->param1 | (entry->param2 << 20) | (dd << 22) |
                     (rn << 16) | (vd << 12) | (is_double ? (1u << 8) : 0) | (is_double ? count * 2 : count);
    }
    return NULL;
}

/* VPUSH/VPOP {list} -- VSTMDB/VLDMIA SP!,{list} */
static _kernel_oserror *encode_vfp_push_pop(assemble_context_t *context, const mnemonic_entry_t *entry,
                                             uint32_t cond, int s_flag,
                                             const uint8_t *text, size_t length, size_t pos,
                                             uint32_t *out_instr)
{
    uint32_t first, last, count;
    int is_double, is_double2;
    _kernel_oserror *error;

    (void) s_flag;
    error = expect_char(text, length, &pos, '{');
    if (error != NULL) return error;
    error = parse_vfp_register(context, text, length, &pos, &first, &is_double);
    if (error != NULL) return error;
    last = first;
    pos += assemble_skip_spaces(text + pos, length - pos);
    if (pos < length && text[pos] == '-')
    {
        pos += 1;
        error = parse_vfp_register(context, text, length, &pos, &last, &is_double2);
        if (error != NULL) return error;
        if (is_double2 != is_double) return error_vfp_mismatched_precision();
    }
    error = expect_char(text, length, &pos, '}');
    if (error != NULL) return error;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;
    if (last < first)
    {
        return error_bad_register_list("Register range must be ascending");
    }

    count = last - first + 1;
    {
        uint32_t vd, dd;

        split_vfp_register(first, is_double, &vd, &dd);
        /* PUSH: P=1,U=0,W=1,L=0 (STMDB SP!); POP: P=0,U=1,W=1,L=1 (LDMIA SP!) */
        *out_instr = (cond << 28) | 0x0C2D0A00u | (entry->param1 << 20) | entry->param2 | (dd << 22) |
                     (13u << 16) | (vd << 12) | (is_double ? (1u << 8) : 0) | (is_double ? count * 2 : count);
    }
    return NULL;
}

static int text_equals_ci(const uint8_t *text, size_t length, size_t pos, const char *word)
{
    size_t wl = strlen(word);
    size_t i;

    if (pos + wl > length)
    {
        return 0;
    }
    for (i = 0; i < wl; i++)
    {
        if (toupper((int) text[pos + i]) != toupper((int) word[i]))
        {
            return 0;
        }
    }
    return !continues_identifier(text, length, pos + wl);
}

/* VMRS Rt,FPSCR | VMRS APSR_nzcv,FPSCR */
static _kernel_oserror *encode_vfp_mrs(assemble_context_t *context, const mnemonic_entry_t *entry,
                                        uint32_t cond, int s_flag,
                                        const uint8_t *text, size_t length, size_t pos,
                                        uint32_t *out_instr)
{
    uint32_t rt;
    _kernel_oserror *error;

    (void) entry; (void) s_flag;
    pos += assemble_skip_spaces(text + pos, length - pos);
    if (text_equals_ci(text, length, pos, "APSR_nzcv"))
    {
        rt = 15;
        pos += strlen("APSR_nzcv");
    }
    else
    {
        error = parse_register(context, text, length, &pos, &rt);
        if (error != NULL) return error;
    }
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    if (!text_equals_ci(text, length, pos, "FPSCR"))
    {
        return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_ARM32_ERR_NONE,
                                   "Expected FPSCR");
    }
    pos += strlen("FPSCR");
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    *out_instr = (cond << 28) | 0x0EF10A10u | (rt << 12);
    return NULL;
}

/* VMSR FPSCR,Rt */
static _kernel_oserror *encode_vfp_msr(assemble_context_t *context, const mnemonic_entry_t *entry,
                                        uint32_t cond, int s_flag,
                                        const uint8_t *text, size_t length, size_t pos,
                                        uint32_t *out_instr)
{
    uint32_t rt;
    _kernel_oserror *error;

    (void) entry; (void) s_flag;
