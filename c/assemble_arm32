/* HVC #imm16 (always unconditional); SMC #imm4 */
static _kernel_oserror *encode_svc_hint(assemble_context_t *context, const mnemonic_entry_t *entry,
                                         uint32_t cond, int s_flag,
                                         const uint8_t *text, size_t length, size_t pos,
