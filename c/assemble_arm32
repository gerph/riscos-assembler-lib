    uint32_t rn;
    _kernel_oserror *error;

    (void) s_flag;
    if (entry->param1 < 4)
    {
        uint32_t rt;

        error = parse_register(context, text, length, &pos, &rt);
        if (error != NULL) return error;
        error = expect_char(text, length, &pos, ',');
        if (error != NULL) return error;
        error = parse_bracketed_register(context, text, length, &pos, &rn);
        if (error != NULL) return error;
        error = check_trailing(text, length, pos);
        if (error != NULL) return error;

        *out_instr = (cond << 28) | ldrex_base[entry->param1] | (rn << 16) | (rt << 12);
    }
    else
    {
        uint32_t rd, rt;

        error = parse_register(context, text, length, &pos, &rd);
        if (error != NULL) return error;
        error = expect_char(text, length, &pos, ',');
        if (error != NULL) return error;
        error = parse_register(context, text, length, &pos, &rt);
        if (error != NULL) return error;
        error = expect_char(text, length, &pos, ',');
        if (error != NULL) return error;
        error = parse_bracketed_register(context, text, length, &pos, &rn);
        if (error != NULL) return error;
        error = check_trailing(text, length, pos);
        if (error != NULL) return error;

        *out_instr = (cond << 28) | strex_base[entry->param1 - 4] | (rn << 16) | (rd << 12) | rt;
    }
    return NULL;
}

