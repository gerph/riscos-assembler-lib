static _kernel_oserror *error_duplicate_register(void)
{
    return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_BAD_OPERAND, ASSEMBLE_ARM32_ERR_DUPLICATE_REGISTER,
                               "Duplicate register");
}

static _kernel_oserror *encode_mul(assemble_context_t *context, const mnemonic_entry_t *entry,
                                    uint32_t cond, int s_flag,
                                    const uint8_t *text, size_t length, size_t pos,
                                    uint32_t *out_instr)
{
    uint32_t rd, rm, rs, rn = 0;
    _kernel_oserror *error;

    error = parse_register(context, text, length, &pos, &rd);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_register(context, text, length, &pos, &rm);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_register(context, text, length, &pos, &rs);
    if (error != NULL) return error;
    if (entry->param2 == 4)
    {
        error = expect_char(text, length, &pos, ',');
        if (error != NULL) return error;
        error = parse_register(context, text, length, &pos, &rn);
        if (error != NULL) return error;
    }
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;
    if (rd == rm && entry->param1 == 0x000000)
    {
        return error_duplicate_register();
    }

    *out_instr = (cond << 28) | entry->param1 | (s_flag ? (1u << 20) : 0) |
                 (rd << 16) | (rn << 12) | (rs << 8) | 0x90u | rm;
    return NULL;
}

static _kernel_oserror *encode_umaal(assemble_context_t *context, const mnemonic_entry_t *entry,
                                      uint32_t cond, int s_flag,
                                      const uint8_t *text, size_t length, size_t pos,
                                      uint32_t *out_instr)
{
    uint32_t rdlo, rdhi, rm, rs;
    _kernel_oserror *error;

    (void) entry; (void) s_flag;
    error = parse_register(context, text, length, &pos, &rdlo);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_register(context, text, length, &pos, &rdhi);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_register(context, text, length, &pos, &rm);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_register(context, text, length, &pos, &rs);
    if (error != NULL) return error;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    *out_instr = (cond << 28) | 0x00400090u | (rdhi << 16) | (rdlo << 12) | (rs << 8) | rm;
    return NULL;
}

static _kernel_oserror *error_branch_range(void)
