#define NUM_MNEMONICS (sizeof(mnemonic_table) / sizeof(mnemonic_table[0]))

/*******************************************************************
 Function:      read_token
 Description:   Reads a raw mnemonic token (letters and digits) from
                'text', upper-cased, into 'out' (which must be at
                least 16 bytes).
 Parameters:    text/length = source text
                out = [[out]] the upper-cased token, NUL terminated
 Returns:       number of source bytes consumed
 ******************************************************************/
static size_t read_token(const uint8_t *text, size_t length, char *out)
{
    size_t pos = 0;
    size_t count = 0;

    while (pos < length && count < 15 &&
           ((text[pos] >= 'A' && text[pos] <= 'Z') || (text[pos] >= 'a' && text[pos] <= 'z') ||
            (text[pos] >= '0' && text[pos] <= '9')))
    {
        out[count] = (char) toupper((int) text[pos]);
        count += 1;
        pos += 1;
    }
    out[count] = '\0';
    return pos;
}

/*******************************************************************
 Function:      match_mnemonic
 Description:   Matches a raw token against mnemonic_table, trying
                every root that prefixes the token and accepting the
                longest root whose remaining text is empty, 'S' (if
                the root allows it), a condition code, or a condition
                code followed by 'S'.
 Parameters:    token = the upper-cased raw token (from read_token)
                out_entry = [[out]] the matched table entry
                out_cond = [[out]] the 4-bit condition field (AL if
                           none was written)
                out_s = [[out]] non-zero if an 'S' flag was written
 Returns:       non-zero if a mnemonic was matched
 ******************************************************************/
static int match_mnemonic(const char *token, const mnemonic_entry_t **out_entry,
                           uint32_t *out_cond, int *out_s)
{
    size_t token_len = strlen(token);
    const mnemonic_entry_t *best = NULL;
    size_t best_len = 0;
    uint32_t best_cond = COND_AL;
    int best_s = 0;
    size_t i;

    for (i = 0; i < NUM_MNEMONICS; i++)
    {
        size_t root_len = strlen(mnemonic_table[i].root);
        const char *rest;
        size_t rest_len;
        uint32_t cond;
        int s_flag;

        if (root_len <= best_len || root_len > token_len ||
            memcmp(mnemonic_table[i].root, token, root_len) != 0)
        {
            continue;
        }
        rest = token + root_len;
        rest_len = token_len - root_len;
        cond = COND_AL;
        s_flag = 0;

        if (rest_len == 0)
        {
            /* matches */
        }
        else if (rest_len == 1 && rest[0] == 'S' && mnemonic_table[i].allows_s)
        {
            s_flag = 1;
        }
        else if (rest_len == 2 && mnemonic_table[i].allows_cond && match_condition((const uint8_t *) rest, 2, &cond))
        {
            /* matches */
        }
        else if (rest_len == 3 && rest[2] == 'S' && mnemonic_table[i].allows_cond && mnemonic_table[i].allows_s &&
                 match_condition((const uint8_t *) rest, 2, &cond))
        {
            s_flag = 1;
        }
        else
        {
            continue;
        }
        best = &mnemonic_table[i];
        best_len = root_len;
        best_cond = cond;
        best_s = s_flag;
    }
    if (best == NULL)
    {
        return 0;
    }
    *out_entry = best;
    *out_cond = best_cond;
    *out_s = best_s;
    return 1;
}

static _kernel_oserror *error_bad_mnemonic(void)
{
    return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_BAD_MNEMONIC, ASSEMBLE_ARM32_ERR_NONE,
                               "Mnemonic not recognised");
}

/* ---------------------------------------------------------------
 * Per-family encoders. Each is called with 'pos' positioned just
 * after the mnemonic (and any condition/S suffix already consumed),
 * and returns the completed instruction word via '*out_instr'
 * (cond/26:27 class bits already filled in by the caller). Operand
 * text runs from text[pos] to text[length].
 * --------------------------------------------------------------- */

typedef _kernel_oserror *(*family_encoder_fn)(assemble_context_t *context,
                                               const mnemonic_entry_t *entry,
                                               uint32_t cond, int s_flag,
                                               const uint8_t *text, size_t length, size_t pos,
                                               uint32_t *out_instr);

static _kernel_oserror *encode_data_proc(assemble_context_t *context, const mnemonic_entry_t *entry,
                                          uint32_t cond, int s_flag,
                                          const uint8_t *text, size_t length, size_t pos,
                                          uint32_t *out_instr)
{
    uint32_t rd, rn, op2;
    _kernel_oserror *error;

    error = parse_register(context, text, length, &pos, &rd);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_register(context, text, length, &pos, &rn);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_operand2(context, text, length, &pos, &op2);
    if (error != NULL) return error;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    *out_instr = (cond << 28) | (entry->param1 << 21) | (s_flag ? (1u << 20) : 0) |
                 (rn << 16) | (rd << 12) | op2;
    return NULL;
}

static _kernel_oserror *encode_data_cmp(assemble_context_t *context, const mnemonic_entry_t *entry,
                                         uint32_t cond, int s_flag,
                                         const uint8_t *text, size_t length, size_t pos,
                                         uint32_t *out_instr)
{
    uint32_t rn, op2;
    _kernel_oserror *error;

    (void) s_flag;
    error = parse_register(context, text, length, &pos, &rn);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_operand2(context, text, length, &pos, &op2);
    if (error != NULL) return error;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    *out_instr = (cond << 28) | (entry->param1 << 21) | (1u << 20) | (rn << 16) | op2;
    return NULL;
}

