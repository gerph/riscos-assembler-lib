/* SSAT/USAT Rd,#sat_imm,Rn{,LSL #imm|ASR #imm}. Signed saturation
   takes sat_imm 1-32 (encoded n-1); unsigned takes 0-31 (encoded
   directly). */
static _kernel_oserror *encode_sat(assemble_context_t *context, const mnemonic_entry_t *entry,
                                    uint32_t cond, int s_flag,
                                    const uint8_t *text, size_t length, size_t pos,
                                    uint32_t *out_instr)
{
    uint32_t rd, rn;
    int32_t sat_imm;
    uint32_t sh = 0, imm5 = 0;
    _kernel_oserror *error;
    int is_unsigned = (int) entry->param1;

    (void) s_flag;
    error = parse_register(context, text, length, &pos, &rd);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, '#');
    if (error != NULL) return error;
    error = eval_numeric(context, text, length, &pos, &sat_imm);
    if (error != NULL) return error;
    if (is_unsigned)
    {
        if (sat_imm < 0 || sat_imm > 31) return error_bad_immediate();
    }
    else
    {
        if (sat_imm < 1 || sat_imm > 32) return error_bad_immediate();
        sat_imm -= 1;
    }
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_register(context, text, length, &pos, &rn);
    if (error != NULL) return error;
    pos += assemble_skip_spaces(text + pos, length - pos);
    if (pos < length && text[pos] == ',')
    {
        char c0, c1, c2;
        int32_t shift_amount;

        pos += 1;
        pos += assemble_skip_spaces(text + pos, length - pos);
        c0 = (pos < length) ? (char) toupper((int) text[pos]) : 0;
        c1 = (pos + 1 < length) ? (char) toupper((int) text[pos + 1]) : 0;
        c2 = (pos + 2 < length) ? (char) toupper((int) text[pos + 2]) : 0;
        if (c0 == 'L' && c1 == 'S' && c2 == 'L')
        {
            sh = 0;
        }
        else if (c0 == 'A' && c1 == 'S' && c2 == 'R')
        {
            sh = 1;
        }
        else
        {
            return error_bad_shift();
        }
        pos += 3;
        error = expect_char(text, length, &pos, '#');
        if (error != NULL) return error;
        error = eval_numeric(context, text, length, &pos, &shift_amount);
        if (error != NULL) return error;
        if (sh == 0)
        {
            if (shift_amount < 0 || shift_amount > 31) return error_bad_shift();
        }
        else
        {
            if (shift_amount < 1 || shift_amount > 32) return error_bad_shift();
            if (shift_amount == 32) shift_amount = 0;
        }
        imm5 = (uint32_t) shift_amount;
    }
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    *out_instr = (cond << 28) | (is_unsigned ? 0x06E00010u : 0x06A00010u) |
                 ((uint32_t) sat_imm << 16) | (rd << 12) | (imm5 << 7) | (sh << 6) | rn;
    return NULL;
}

