       root with is not. See encode_neon_vdup. */
    { "VDUP", FAMILY_NEON_VDUP, 0, 0, 1, 0, ASSEMBLE_ARM32_OPT_VFP },
    { "VEXT", FAMILY_NEON_VEXT, 0, 0, 0, 0, ASSEMBLE_ARM32_OPT_VFP },

