    FAMILY_VFP_LDR_STR,    /* {S|D}d,[address] -- VLDR VSTR */
    FAMILY_VFP_LDM_STM,    /* Rn{!},{list} -- VLDMIA VLDMDB VSTMIA VSTMDB */
    FAMILY_VFP_PUSH_POP,   /* {list} -- VPUSH VPOP */
    FAMILY_VFP_MRS,        /* VMRS Rt|APSR_nzcv,FPSCR */
    FAMILY_VFP_MSR,        /* VMSR FPSCR,Rt */

    /* NEON/Advanced SIMD (gated by the same ASSEMBLE_ARM32_OPT_VFP bit).
       VADD/VSUB/VMUL/VMLA/VMLS have both a scalar VFP form (Sd/Dd, F32/F64,
       optional condition code) and a NEON three-same form (Dd/Qd, any of
       I8-U64/F32, unconditional); since match_mnemonic() cannot pick between
       two entries sharing one root, these five are handled by a single
       merged encoder that parses the datatype/register shape first and
       dispatches accordingly (the same technique used for VMOV in the VFP
       scalar backend). */
    FAMILY_VFP_OR_NEON_ARITH3,  /* VADD VSUB VMUL VMLA VMLS -- scalar-or-NEON dispatch, see above */
    FAMILY_NEON_3SAME,          /* Dd/Qd,Dn/Qn,Dm/Qm -- integer (U/size fixed or S/U-derived) and/or
                                    F32 (all bits fixed) forms selected by the parsed dt; see
                                    encode_neon_three_same for the param1/param2 bit layout */
    FAMILY_NEON_3SAME_LOGICAL,  /* Dd/Qd,Dn/Qn,Dm/Qm -- size-independent bitwise ops (dt ignored) */

    FAMILY_NONE         /* unreachable placeholder root, never dispatched */
} instr_family_t;

typedef struct mnemonic_entry
{
    const char      *root;
    instr_family_t   family;
    uint32_t         param1;    /* family-specific: base opcode/class field */
    uint32_t         param2;    /* family-specific: secondary field */
    unsigned char    allows_cond;
    unsigned char    allows_s;
    uint32_t         requires_opt; /* 0, or an ASSEMBLE_ARM32_OPT_* bit that
                                       must be set in context->opt for this
                                       mnemonic to be recognised (eg VFP) */
} mnemonic_entry_t;

