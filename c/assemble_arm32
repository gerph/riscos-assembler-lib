/* DMB/DSB/ISB {option}. Only the common named options are matched;
   the option defaults to SY (full system) if omitted. */
static _kernel_oserror *encode_barrier(assemble_context_t *context, const mnemonic_entry_t *entry,
                                        uint32_t cond, int s_flag,
                                        const uint8_t *text, size_t length, size_t pos,
                                        uint32_t *out_instr)
{
    static const uint32_t base[3] = { 0xF57FF050u, 0xF57FF040u, 0xF57FF060u };
    static const char * const names[] = {
        "OSHLD", "OSHST", "OSH", "NSHLD", "NSHST", "NSH", "ISHLD", "ISHST", "ISH", "LD", "ST", "SY"
    };
    static const uint32_t values[] = { 1, 2, 3, 5, 6, 7, 9, 10, 11, 13, 14, 15 };
    uint32_t option = 15;
    char token[8];
    size_t i;

    (void) context; (void) cond; (void) s_flag;
    pos += assemble_skip_spaces(text + pos, length - pos);
    if (pos < length)
    {
        size_t consumed = read_token(text + pos, length - pos, token);

        if (consumed == 0)
        {
            return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_ARM32_ERR_NONE,
                                       "Expected a barrier option");
        }
        for (i = 0; i < sizeof(names) / sizeof(names[0]); i++)
        {
            if (strcmp(token, names[i]) == 0)
            {
                option = values[i];
                break;
            }
        }
        if (i == sizeof(names) / sizeof(names[0]))
        {
            return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_ARM32_ERR_NONE,
                                       "Unrecognised barrier option");
        }
        pos += consumed;
    }
    {
        _kernel_oserror *error = check_trailing(text, length, pos);
        if (error != NULL) return error;
    }

    *out_instr = base[entry->param1] | option;
    return NULL;
}

