/* SRS{addr_mode} SP{!}, #mode */
static _kernel_oserror *encode_srs(assemble_context_t *context, const mnemonic_entry_t *entry,
                                    uint32_t cond, int s_flag,
                                    const uint8_t *text, size_t length, size_t pos,
                                    uint32_t *out_instr)
{
    uint32_t sp;
    uint32_t w = 0;
    int32_t mode;
    _kernel_oserror *error;

    (void) cond; (void) s_flag;
    error = parse_register(context, text, length, &pos, &sp);
    if (error != NULL) return error;
    if (sp != 13)
    {
        return error_bad_register();
    }
    pos += assemble_skip_spaces(text + pos, length - pos);
    if (pos < length && text[pos] == '!')
    {
        pos += 1;
        w = 1;
    }
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, '#');
    if (error != NULL) return error;
    error = eval_numeric(context, text, length, &pos, &mode);
    if (error != NULL) return error;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;
    if (mode < 0 || mode > 31)
    {
        return error_bad_immediate();
    }

    *out_instr = 0xF84D0500u | (entry->param1 << 23) | (w << 21) | (uint32_t) mode;
    return NULL;
}

static _kernel_oserror *encode_bkpt(assemble_context_t *context, const mnemonic_entry_t *entry,
                                     uint32_t cond, int s_flag,
