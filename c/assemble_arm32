/*******************************************************************
 * File:        assemble_arm32
 * Purpose:     Assembler backend for the base 32-bit ARM instruction
 *              set (ARMv4 through the AArch32 subset of ARMv8),
 *              ported from ROOLBASIC's s/Assembler (BBC BASIC's
 *              inline ARM assembler). All values are little-endian.
 *              FPA and VFP/NEON mnemonics are handled by separate
 *              follow-on backends, not this one.
 * Author:      Charles Ferguson (Gerph)
 ******************************************************************/

#include <string.h>
#include <ctype.h>

#include "assemble_arm32.h"

#define COND_AL 0xEu
#define COND_NV 0xFu

/* ---------------------------------------------------------------
 * Condition codes. Both canonical and alias spellings (HS==CS,
 * LO==CC) are matched, mirroring the original CONDTAB.
 * --------------------------------------------------------------- */

typedef struct cond_entry
{
    const char *name;
    uint32_t    value;
} cond_entry_t;

static const cond_entry_t cond_table[] = {
    { "EQ", 0x0 }, { "NE", 0x1 }, { "CS", 0x2 }, { "HS", 0x2 },
    { "CC", 0x3 }, { "LO", 0x3 }, { "MI", 0x4 }, { "PL", 0x5 },
    { "VS", 0x6 }, { "VC", 0x7 }, { "HI", 0x8 }, { "LS", 0x9 },
    { "GE", 0xA }, { "LT", 0xB }, { "GT", 0xC }, { "LE", 0xD },
    { "AL", 0xE }, { "NV", 0xF }
};
#define NUM_CONDS (sizeof(cond_table) / sizeof(cond_table[0]))

/*******************************************************************
 Function:      match_condition
 Description:   Tests whether two characters at 'text' spell a
                condition code.
 Parameters:    text/length = candidate characters (need length >= 2)
                out_value = [[out]] the 4-bit condition field
 Returns:       non-zero if matched
 ******************************************************************/
static int match_condition(const uint8_t *text, size_t length, uint32_t *out_value)
{
    char c1, c2;
    size_t i;

    if (length < 2)
    {
        return 0;
    }
    c1 = (char) toupper((int) text[0]);
    c2 = (char) toupper((int) text[1]);
    for (i = 0; i < NUM_CONDS; i++)
    {
        if (cond_table[i].name[0] == c1 && cond_table[i].name[1] == c2)
        {
            *out_value = cond_table[i].value;
            return 1;
        }
    }
    return 0;
}

/* ---------------------------------------------------------------
 * Registers: R0-R15, PC(=15), LR(=14), SP(=13). No APCS aliases,
 * matching the original (GETREG recognises only these spellings).
 * Anything else falls back to a full expression, range-checked to
 * 0-15.
 * --------------------------------------------------------------- */

static _kernel_oserror *error_bad_register(void)
{
    return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_BAD_LABEL, ASSEMBLE_ARM32_ERR_BAD_REGISTER,
                               "Bad register");
}

static int32_t value_to_integer(const assemble_value_t *value)
{
    switch (value->type)
    {
        case ASSEMBLE_VALUE_FLOAT:
            return (int32_t) value->value.as_float;
        case ASSEMBLE_VALUE_INTEGER:
        default:
            return value->value.as_integer;
    }
}

static _kernel_oserror *eval_expr(assemble_context_t *context,
                                   const uint8_t *text, size_t length,
                                   assemble_value_t *value, size_t *consumed)
{
    _kernel_oserror *error = NULL;

    if (context->resolve_expr(context->user_data, text, length, value, consumed, &error) != ASSEMBLE_RESULT_OK)
    {
        if (error != NULL)
        {
            return error;
        }
        return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_EXPRESSION, ASSEMBLE_ARM32_ERR_NONE,
                                   "Expression could not be evaluated");
    }
    if (value->type == ASSEMBLE_VALUE_STRING)
    {
        return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_EXPRESSION, ASSEMBLE_ARM32_ERR_NONE,
                                   "Expected a numeric value");
    }
    return NULL;
}

static _kernel_oserror *eval_numeric(assemble_context_t *context,
                                      const uint8_t *text, size_t length,
                                      size_t *pos_inout, int32_t *out_value)
{
    assemble_value_t value;
    size_t consumed;
    _kernel_oserror *error;

    error = eval_expr(context, text + *pos_inout, length - *pos_inout, &value, &consumed);
    if (error != NULL)
    {
        return error;
    }
    *pos_inout += consumed;
    *out_value = value_to_integer(&value);
    return NULL;
}

/* Is 'ch' a character that could continue an identifier -- used to stop
   R/PC/LR/SP being matched as a prefix of a longer variable name. */
static int continues_identifier(const uint8_t *text, size_t length, size_t pos)
{
    return pos < length && assemble_is_ident_char(text[pos]);
}

/*******************************************************************
 Function:      parse_register
 Description:   Parses a register operand: R0-R15, PC, LR, SP, or
                (falling back) any expression evaluating to 0-15.
 Parameters:    context = the assembly context
                text/length = source text
                pos_inout = [[inout]] position within text
                out_reg = [[out]] register number 0-15
 Returns:       NULL if successful, otherwise a static error block
 ******************************************************************/
static _kernel_oserror *parse_register(assemble_context_t *context,
                                        const uint8_t *text, size_t length,
                                        size_t *pos_inout, uint32_t *out_reg)
{
    size_t pos = *pos_inout;
    uint8_t c0, c1;
    int32_t value;
    _kernel_oserror *error;

    pos += assemble_skip_spaces(text + pos, length - pos);
    c0 = (pos < length) ? (uint8_t) toupper((int) text[pos]) : 0;
    c1 = (pos + 1 < length) ? (uint8_t) toupper((int) text[pos + 1]) : 0;

    if (c0 == 'R' && c1 >= '0' && c1 <= '9')
    {
        size_t end = pos + 2;
        uint32_t regnum = (uint32_t) (c1 - '0');

        if (end < length && text[end] >= '0' && text[end] <= '9' && regnum <= 1)
        {
            regnum = regnum * 10 + (uint32_t) (text[end] - '0');
            end += 1;
        }
        if (regnum <= 15 && !continues_identifier(text, length, end))
        {
            *out_reg = regnum;
            *pos_inout = end;
            return NULL;
        }
    }
    else if (c0 == 'P' && c1 == 'C' && !continues_identifier(text, length, pos + 2))
    {
        *out_reg = 15;
        *pos_inout = pos + 2;
        return NULL;
    }
    else if (c0 == 'L' && c1 == 'R' && !continues_identifier(text, length, pos + 2))
    {
        *out_reg = 14;
        *pos_inout = pos + 2;
        return NULL;
    }
    else if (c0 == 'S' && c1 == 'P' && !continues_identifier(text, length, pos + 2))
    {
        *out_reg = 13;
        *pos_inout = pos + 2;
        return NULL;
    }

    *pos_inout = pos;
    error = eval_numeric(context, text, length, pos_inout, &value);
    if (error != NULL)
    {
        return error;
    }
    if (value < 0 || value > 15)
    {
        return error_bad_register();
    }
    *out_reg = (uint32_t) value;
    return NULL;
}

static _kernel_oserror *expect_char(const uint8_t *text, size_t length, size_t *pos_inout, char ch)
{
    size_t pos = *pos_inout;

    pos += assemble_skip_spaces(text + pos, length - pos);
    if (pos >= length || text[pos] != (uint8_t) ch)
    {
        if (ch == ',')
        {
            return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_ARM32_ERR_NONE,
                                       "Missing ,");
        }
        return assemble_set_error_f(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_ARM32_ERR_NONE,
                                     "Missing %c", ch);
    }
    *pos_inout = pos + 1;
    return NULL;
}

static _kernel_oserror *check_trailing(const uint8_t *text, size_t length, size_t pos)
{
    pos += assemble_skip_spaces(text + pos, length - pos);
    if (pos != length)
    {
        return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_ARM32_ERR_NONE,
                                   "Unexpected text after operand");
    }
    return NULL;
}

/* ---------------------------------------------------------------
 * Data-processing 8-bit rotated immediate encoding.
 * --------------------------------------------------------------- */

/*******************************************************************
 Function:      encode_dp_immediate
 Description:   Finds a rotation (0-30, even) that packs 'value'
                into an 8-bit immediate rotated right by that amount,
                as required by ARM data-processing immediate operands.
 Parameters:    value = the 32-bit value to encode
                out_encoded = [[out]] the 12-bit encoded operand2
                              (rotate<<8 | imm8)
 Returns:       non-zero if 'value' could be encoded
 ******************************************************************/
static int encode_dp_immediate(uint32_t value, uint32_t *out_encoded)
{
    int rot;

    if (value <= 0xFFu)
    {
        *out_encoded = value;
        return 1;
    }
    for (rot = 2; rot <= 30; rot += 2)
    {
        uint32_t rotated = (value << rot) | (value >> (32 - rot));

        if (rotated <= 0xFFu)
        {
            *out_encoded = (((uint32_t) (32 - rot) / 2) << 8) | rotated;
            return 1;
        }
    }
    return 0;
}

static _kernel_oserror *error_bad_immediate(void)
{
    return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_RANGE, ASSEMBLE_ARM32_ERR_BAD_IMMEDIATE,
                               "Bad immediate constant");
}

static _kernel_oserror *error_bad_shift(void)
{
    return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_RANGE, ASSEMBLE_ARM32_ERR_BAD_SHIFT,
                               "Bad shift");
}

/* ---------------------------------------------------------------
 * Shifts: LSL/ASL, LSR, ASR, ROR, RRX, applied either as a constant
 * (#imm) or by a register (Rs). Shift type occupies bits 6:5 of the
 * encoded shift field; bit 4 marks a register shift.
 * --------------------------------------------------------------- */

#define SHIFT_LSL 0u
#define SHIFT_LSR 1u
#define SHIFT_ASR 2u
#define SHIFT_ROR 3u

typedef struct shift_name_entry
{
    const char *name;
    uint32_t    type;
} shift_name_entry_t;

static const shift_name_entry_t shift_names[] = {
    { "LSL", SHIFT_LSL }, { "ASL", SHIFT_LSL },
    { "LSR", SHIFT_LSR }, { "ASR", SHIFT_ASR }, { "ROR", SHIFT_ROR }
};
#define NUM_SHIFT_NAMES (sizeof(shift_names) / sizeof(shift_names[0]))

/*******************************************************************
 Function:      parse_shift_suffix
 Description:   Parses an optional ',<shift> <amount>' suffix (used
                after a register operand in data-processing Op2,
                LDR/STR register offsets, and PKH). If no comma is
                present, the operand is left as a plain register with
                no shift.
 Parameters:    context = the assembly context
                text/length = source text
                pos_inout = [[inout]] position within text
                allow_register_shift = whether 'Rs' (not just '#imm')
                                        is permitted as the amount
                out_field = [[out]] encoded shift field (bits 11:4 of
                            a data-processing/LDR-STR instruction)
 Returns:       NULL if successful, otherwise a static error block
 ******************************************************************/
static _kernel_oserror *parse_shift_suffix(assemble_context_t *context,
                                            const uint8_t *text, size_t length,
                                            size_t *pos_inout, int allow_register_shift,
                                            uint32_t *out_field)
{
    size_t pos = *pos_inout;
    size_t save = pos;
    size_t i;
    char c0, c1, c2;
    uint32_t type = SHIFT_LSL;
    int is_rrx = 0;
    int found = 0;

    *out_field = 0;
    pos += assemble_skip_spaces(text + pos, length - pos);
    if (pos >= length || text[pos] != ',')
    {
        *pos_inout = save;
        return NULL;
    }
    pos += 1;
    pos += assemble_skip_spaces(text + pos, length - pos);

    c0 = (pos < length) ? (char) toupper((int) text[pos]) : 0;
    c1 = (pos + 1 < length) ? (char) toupper((int) text[pos + 1]) : 0;
    c2 = (pos + 2 < length) ? (char) toupper((int) text[pos + 2]) : 0;

    if (c0 == 'R' && c1 == 'R' && c2 == 'X' && !continues_identifier(text, length, pos + 3))
    {
        is_rrx = 1;
        found = 1;
        pos += 3;
    }
    else
    {
        for (i = 0; i < NUM_SHIFT_NAMES; i++)
        {
            if (c0 == shift_names[i].name[0] && c1 == shift_names[i].name[1] && c2 == shift_names[i].name[2] &&
                !continues_identifier(text, length, pos + 3))
            {
                type = shift_names[i].type;
                found = 1;
                pos += 3;
                break;
            }
        }
    }
    if (!found)
    {
        return error_bad_shift();
    }

    if (is_rrx)
    {
        *out_field = (SHIFT_ROR << 5);
        *pos_inout = pos;
        return NULL;
    }

    pos += assemble_skip_spaces(text + pos, length - pos);
    if (pos < length && text[pos] == '#')
    {
        int32_t amount;
        _kernel_oserror *error;

        pos += 1;
        *pos_inout = pos;
        error = eval_numeric(context, text, length, pos_inout, &amount);
        if (error != NULL)
        {
            return error;
        }
        if (type == SHIFT_LSL)
        {
            if (amount < 0 || amount > 31)
            {
                return error_bad_shift();
            }
        }
        else if (type == SHIFT_ROR)
        {
            if (amount <= 0 || amount > 31)
            {
                return error_bad_shift();
            }
        }
        else /* LSR/ASR: 1-32, with 32 encoded as 0 */
        {
            if (amount <= 0 || amount > 32)
            {
                return error_bad_shift();
            }
            if (amount == 32)
            {
                amount = 0;
            }
        }
        *out_field = ((uint32_t) amount << 7) | (type << 5);
        return NULL;
    }
    else
    {
        uint32_t rs;
        _kernel_oserror *error;

        if (!allow_register_shift)
        {
            return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_ARM32_ERR_NONE,
                                       "Register shift not permitted here");
        }
        *pos_inout = pos;
        error = parse_register(context, text, length, pos_inout, &rs);
        if (error != NULL)
        {
            return error;
        }
        *out_field = (rs << 8) | (type << 5) | (1u << 4);
        return NULL;
    }
}

/*******************************************************************
 Function:      parse_operand2
 Description:   Parses a data-processing Operand2: either '#imm'
                (rotate-8 encoded, setting the I bit) or 'Rm{,shift}'.
 Parameters:    context = the assembly context
                text/length = source text
                pos_inout = [[inout]] position within text
                out_field = [[out]] bits 25 (I) and 11:0 (Operand2) of
                            the instruction
 Returns:       NULL if successful, otherwise a static error block
 ******************************************************************/
static _kernel_oserror *parse_operand2(assemble_context_t *context,
                                        const uint8_t *text, size_t length,
                                        size_t *pos_inout, uint32_t *out_field)
{
    size_t pos = *pos_inout;

    pos += assemble_skip_spaces(text + pos, length - pos);
    if (pos < length && text[pos] == '#')
    {
        int32_t value;
        uint32_t encoded;
        _kernel_oserror *error;

        pos += 1;
        *pos_inout = pos;
        error = eval_numeric(context, text, length, pos_inout, &value);
        if (error != NULL)
        {
            return error;
        }
        if (!encode_dp_immediate((uint32_t) value, &encoded))
        {
            return error_bad_immediate();
        }
        *out_field = (1u << 25) | encoded;
        return NULL;
    }
    else
    {
        uint32_t rm, shift_field;
        _kernel_oserror *error;

        *pos_inout = pos;
        error = parse_register(context, text, length, pos_inout, &rm);
        if (error != NULL)
        {
            return error;
        }
        error = parse_shift_suffix(context, text, length, pos_inout, 1, &shift_field);
        if (error != NULL)
        {
            return error;
        }
        *out_field = shift_field | rm;
        return NULL;
    }
}

/* ---------------------------------------------------------------
 * LDM/STM register lists: '{' Rn {,Rn|Rn-Rm} '}' ['^'].
 * --------------------------------------------------------------- */

static _kernel_oserror *error_bad_register_list(const char *message)
{
    return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_BAD_OPERAND, ASSEMBLE_ARM32_ERR_BAD_REGISTER_LIST,
                               message);
}

/*******************************************************************
 Function:      parse_register_list
 Description:   Parses a '{...}' register list as used by LDM/STM,
                including 'Rn-Rm' ranges (either order) and a
                trailing '^' user-bank/S-bit marker.
 Parameters:    context = the assembly context
                text/length = source text
                pos_inout = [[inout]] position within text
                out_mask = [[out]] 16-bit register bitmask
                out_caret = [[out]] non-zero if '^' was present
 Returns:       NULL if successful, otherwise a static error block
 ******************************************************************/
static _kernel_oserror *parse_register_list(assemble_context_t *context,
                                             const uint8_t *text, size_t length,
                                             size_t *pos_inout, uint32_t *out_mask, int *out_caret)
{
    uint32_t mask = 0;
    _kernel_oserror *error;

    *out_caret = 0;
    error = expect_char(text, length, pos_inout, '{');
    if (error != NULL)
    {
        return error;
    }
    for (;;)
    {
        uint32_t first, last, r;

        error = parse_register(context, text, length, pos_inout, &first);
        if (error != NULL)
        {
            return error;
        }
        last = first;
        *pos_inout += assemble_skip_spaces(text + *pos_inout, length - *pos_inout);
        if (*pos_inout < length && text[*pos_inout] == '-')
        {
            *pos_inout += 1;
            error = parse_register(context, text, length, pos_inout, &last);
            if (error != NULL)
            {
                return error;
            }
            if (last < first)
            {
                uint32_t tmp = first;
                first = last;
                last = tmp;
            }
        }
        for (r = first; r <= last; r++)
        {
            if (mask & (1u << r))
            {
                return error_bad_register_list("Register specified more than once");
            }
            mask |= (1u << r);
        }
        *pos_inout += assemble_skip_spaces(text + *pos_inout, length - *pos_inout);
        if (*pos_inout < length && text[*pos_inout] == ',')
        {
            *pos_inout += 1;
            continue;
        }
        break;
    }
    error = expect_char(text, length, pos_inout, '}');
    if (error != NULL)
    {
        return error;
    }
    if (mask == 0)
    {
        return error_bad_register_list("Register list must not be empty");
    }
    *pos_inout += assemble_skip_spaces(text + *pos_inout, length - *pos_inout);
    if (*pos_inout < length && text[*pos_inout] == '^')
    {
        *pos_inout += 1;
        *out_caret = 1;
    }
    *out_mask = mask;
    return NULL;
}

/* ---------------------------------------------------------------
 * LDR/STR addressing modes: [Rn], [Rn,#imm]{!}, [Rn,{-}Rm{,shift}]{!},
 * [Rn]{,#imm|,{-}Rm} (post-indexed). Two offset encodings exist:
 * LDST_CLASS_NORMAL (word/byte -- 12-bit immediate, bit25 marks a
 * register offset) and LDST_CLASS_EXTRA (halfword/signed/doubleword
 * -- 8-bit split immediate, bit22 marks an *immediate* offset, the
 * opposite sense to bit25, and no shift is allowed on a register
 * offset). Both quirks are genuine ARM architecture behaviour, not
 * typos.
 * --------------------------------------------------------------- */

#define LDST_CLASS_NORMAL 0
#define LDST_CLASS_EXTRA  1

static _kernel_oserror *error_bad_offset(void)
{
    return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_RANGE, ASSEMBLE_ARM32_ERR_BAD_ADDRESS_OFFSET,
                               "Bad address offset");
}

static _kernel_oserror *encode_ldst_offset(int cls, int32_t value, uint32_t *out_bits)
{
    uint32_t bits = 0;

    if (value < 0)
    {
        value = -value;
    }
    else
    {
        bits |= (1u << 23); /* U: offset added */
    }
    if (cls == LDST_CLASS_NORMAL)
    {
        if (value > 0xFFF)
        {
            return error_bad_offset();
        }
        bits |= (uint32_t) value;
    }
    else
    {
        if (value > 0xFF)
        {
            return error_bad_offset();
        }
        bits |= (1u << 22); /* I: immediate offset */
        bits |= (uint32_t) ((value & 0xF0) << 4) | (uint32_t) (value & 0xF);
    }
    *out_bits = bits;
    return NULL;
}

/*******************************************************************
 Function:      parse_ldr_str_address
 Description:   Parses a full LDR/STR-family addressing mode,
                including the leading '[' and everything up to and
                including a trailing '!', if present.
 Parameters:    context = the assembly context
                text/length = source text
                pos_inout = [[inout]] position within text
                cls = LDST_CLASS_NORMAL or LDST_CLASS_EXTRA
                io_bits = [[inout]] instruction bits so far; on entry
                          bit 21 may already carry a 'T' (unprivileged)
                          marker set by the caller, valid only for the
                          post-indexed result this may produce; on
                          exit, bits 24 (P), 23 (U), 22/25 (I, per
                          'cls'), 21 (W), 19:16 (Rn) and the offset
                          field are all filled in
 Returns:       NULL if successful, otherwise a static error block
 ******************************************************************/
static _kernel_oserror *parse_ldr_str_address(assemble_context_t *context,
                                               const uint8_t *text, size_t length,
                                               size_t *pos_inout, int cls,
                                               uint32_t *io_bits)
{
    uint32_t rn;
    uint32_t bits = *io_bits;
    _kernel_oserror *error;

    error = expect_char(text, length, pos_inout, '[');
    if (error != NULL)
    {
        return error;
    }
    error = parse_register(context, text, length, pos_inout, &rn);
    if (error != NULL)
    {
        return error;
    }
    bits |= rn << 16;

    *pos_inout += assemble_skip_spaces(text + *pos_inout, length - *pos_inout);
    if (*pos_inout < length && text[*pos_inout] == ']')
    {
        *pos_inout += 1;
        /* Post-indexed, or no offset at all. */
        *pos_inout += assemble_skip_spaces(text + *pos_inout, length - *pos_inout);
        if (*pos_inout < length && text[*pos_inout] == ',')
        {
            *pos_inout += 1;
            *pos_inout += assemble_skip_spaces(text + *pos_inout, length - *pos_inout);
            if (*pos_inout < length && text[*pos_inout] == '#')
            {
                int32_t value;
                uint32_t offset_bits;

                *pos_inout += 1;
                error = eval_numeric(context, text, length, pos_inout, &value);
                if (error != NULL)
                {
                    return error;
                }
                error = encode_ldst_offset(cls, value, &offset_bits);
                if (error != NULL)
                {
                    return error;
                }
                bits |= offset_bits;
            }
            else
            {
                uint32_t rm, shift_field = 0;
                int negative = 0;

                if (*pos_inout < length && text[*pos_inout] == '-')
                {
                    negative = 1;
                    *pos_inout += 1;
                }
                error = parse_register(context, text, length, pos_inout, &rm);
                if (error != NULL)
                {
                    return error;
                }
                if (!negative)
                {
                    bits |= (1u << 23);
                }
                if (cls == LDST_CLASS_NORMAL)
                {
                    error = parse_shift_suffix(context, text, length, pos_inout, 0, &shift_field);
                    if (error != NULL)
                    {
                        return error;
                    }
                    bits |= (1u << 25) | shift_field | rm;
                }
                else
                {
                    bits |= rm; /* bit22 (I) stays clear: register offset */
                }
            }
        }
        else
        {
            /* "[Rn]" with nothing else is pre-indexed with an implicit
               zero offset (equivalent to "[Rn,#0]"), NOT post-indexed
               -- post-indexing needs a comma and offset after the ']'. */
            bits |= (1u << 24) | (1u << 23); /* P, U */
            if (cls == LDST_CLASS_EXTRA)
            {
                bits |= (1u << 22);
            }
        }
    }
    else
    {
        /* Pre-indexed: [Rn, ...] ']' ['!'] */
        bits |= (1u << 24); /* P */
        *pos_inout += assemble_skip_spaces(text + *pos_inout, length - *pos_inout);
        if (*pos_inout < length && text[*pos_inout] == ',')
        {
            *pos_inout += 1;
            *pos_inout += assemble_skip_spaces(text + *pos_inout, length - *pos_inout);
            if (*pos_inout < length && text[*pos_inout] == '#')
            {
                int32_t value;
                uint32_t offset_bits;

                *pos_inout += 1;
                error = eval_numeric(context, text, length, pos_inout, &value);
                if (error != NULL)
                {
                    return error;
                }
                error = encode_ldst_offset(cls, value, &offset_bits);
                if (error != NULL)
                {
                    return error;
                }
                bits |= offset_bits;
            }
            else
            {
                uint32_t rm, shift_field = 0;
                int negative = 0;

                if (*pos_inout < length && text[*pos_inout] == '-')
                {
                    negative = 1;
                    *pos_inout += 1;
                }
                error = parse_register(context, text, length, pos_inout, &rm);
                if (error != NULL)
                {
                    return error;
                }
                if (!negative)
                {
                    bits |= (1u << 23);
                }
                if (cls == LDST_CLASS_NORMAL)
                {
                    error = parse_shift_suffix(context, text, length, pos_inout, 0, &shift_field);
                    if (error != NULL)
                    {
                        return error;
                    }
                    bits |= (1u << 25) | shift_field | rm;
                }
                else
                {
                    bits |= rm;
                }
            }
        }
        else
        {
            bits |= (1u << 23); /* [Rn] with no offset: U=1, offset 0 */
            if (cls == LDST_CLASS_EXTRA)
            {
                bits |= (1u << 22);
            }
        }
        error = expect_char(text, length, pos_inout, ']');
        if (error != NULL)
        {
            return error;
        }
        *pos_inout += assemble_skip_spaces(text + *pos_inout, length - *pos_inout);
        if (*pos_inout < length && text[*pos_inout] == '!')
        {
            *pos_inout += 1;
            bits |= (1u << 21); /* W */
        }
    }
    *io_bits = bits;
    return NULL;
}

/* ---------------------------------------------------------------
 * Mnemonic dispatch. Every mnemonic root is matched against the raw
 * source token; whatever text follows the root must be empty, 'S'
 * (if the root allows it), a condition code, or a condition code
 * followed by 'S'. All roots that satisfy this for a given token are
 * considered, and the longest root wins, so root ordering in the
 * table below does not matter for correctness.
 * --------------------------------------------------------------- */

typedef enum instr_family
{
    FAMILY_DATA_PROC,   /* Rd,Rn,Op2 -- AND EOR SUB RSB ADD ADC SBC RSC ORR BIC */
    FAMILY_DATA_CMP,    /* Rn,Op2 -- TST TEQ CMP CMN (S implied) */
    FAMILY_DATA_MOV,    /* Rd,Op2 -- MOV MVN */
    FAMILY_MUL,         /* Rd,Rm,Rs{,Rn} -- MUL MLA MLS */
    FAMILY_MULL,        /* RdLo,RdHi,Rm,Rs -- UMULL UMLAL SMULL SMLAL */
    FAMILY_UMAAL,       /* RdLo,RdHi,Rm,Rs */
    FAMILY_BRANCH,      /* B BL */
    FAMILY_BX,          /* BX BLX BXJ */
    FAMILY_LDR_STR,     /* full LDR/STR family incl B/H/SB/SH/D/T */
    FAMILY_LDM_STM,     /* LDM/STM incl PUSH/POP */
    FAMILY_SWI,
    FAMILY_SWP,         /* SWP SWPB */
    FAMILY_CDP,         /* CDP CDP2 */
    FAMILY_MCR_MRC,     /* MCR MRC MCR2 MRC2 */
    FAMILY_MCRR_MRRC,   /* MCRR MRRC */
    FAMILY_LDC_STC,     /* LDC STC LDC2 STC2 */
    FAMILY_MSR,
    FAMILY_MRS,
    FAMILY_CLZ,         /* Rd,Rm */
    FAMILY_PLD_PLI,
    FAMILY_BFC,         /* Rd,#lsb,#width */
    FAMILY_BFI,         /* Rd,Rn,#lsb,#width */
    FAMILY_SBFX_UBFX,   /* Rd,Rn,#lsb,#width */
    FAMILY_REV,         /* Rd,Rm -- REV REV16 REVSH RBIT */
    FAMILY_SEL,         /* Rd,Rn,Rm */
    FAMILY_USAD8,       /* Rd,Rn,Rm */
    FAMILY_USADA8,      /* Rd,Rn,Rm,Ra */
    FAMILY_SAT,         /* Rd,#sat_imm,Rn{,shift} -- SSAT USAT */
    FAMILY_SAT16,       /* Rd,#sat_imm,Rn -- SSAT16 USAT16 */
    FAMILY_QSAT,        /* Rd,Rm,Rn -- QADD QSUB QDADD QDSUB */
    FAMILY_PARALLEL,    /* Rd,Rn,Rm -- the 36 SIMD add/subtract family */
    FAMILY_SMMUL_LA_LS, /* SMMUL SMMLA SMMLS (+R rounding forms) */
    FAMILY_SMLAXY,      /* Rd,Rm,Rs,Rn -- SMLABB/BT/TB/TT */
