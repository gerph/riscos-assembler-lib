static _kernel_oserror *encode_branch(assemble_context_t *context, const mnemonic_entry_t *entry,
                                       uint32_t cond, int s_flag,
                                       const uint8_t *text, size_t length, size_t pos,
                                       uint32_t *out_instr)
{
    int32_t target;
    int32_t offset;
    _kernel_oserror *error;

    (void) s_flag;
    error = eval_numeric(context, text, length, &pos, &target);
    if (error != NULL) return error;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    offset = target - (int32_t) (context->address + 8);
    if ((offset & 3) != 0 || offset < -0x2000000 || offset >= 0x2000000)
    {
        return error_branch_range();
    }
    *out_instr = (cond << 28) | 0x0A000000u | (entry->param1 << 24) | (((uint32_t) offset >> 2) & 0xFFFFFFu);
    return NULL;
}

