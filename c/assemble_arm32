    /* Classic VFP scalar (gated by ASSEMBLE_ARM32_OPT_VFP) */
    FAMILY_VFP_MOV_REG,    /* VMOV Sd,Sm | Dd,Dm */
    FAMILY_VFP_MOV_CORE,   /* VMOV Sn,Rt | Rt,Sn */
