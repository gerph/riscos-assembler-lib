static _kernel_oserror *error_bad_psr_field(void)
{
    return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_BAD_OPERAND, ASSEMBLE_ARM32_ERR_BAD_PSR_FIELD,
                               "Bad PSR name or field mask");
}

/* MSR <psr>_<fields>, #imm | Rm. <psr> is CPSR or SPSR; <fields> is
   1-4 of 'c' (control), 'x' (extension), 's' (status), 'f' (flags).
   The banked-register form (eg 'MSR R0_usr, Rn') is not implemented
   -- a documented gap, see the mnemonic table comment above. */
static _kernel_oserror *encode_msr(assemble_context_t *context, const mnemonic_entry_t *entry,
                                    uint32_t cond, int s_flag,
                                    const uint8_t *text, size_t length, size_t pos,
                                    uint32_t *out_instr)
{
    char c0, c1, c2;
    uint32_t r_bit;
    uint32_t mask = 0;
    _kernel_oserror *error;

    (void) entry; (void) s_flag;
    pos += assemble_skip_spaces(text + pos, length - pos);
    c0 = (pos < length) ? (char) toupper((int) text[pos]) : 0;
    c1 = (pos + 1 < length) ? (char) toupper((int) text[pos + 1]) : 0;
    c2 = (pos + 2 < length) ? (char) toupper((int) text[pos + 2]) : 0;
    if (c0 == 'C' && c1 == 'P' && c2 == 'S' && pos + 3 < length && toupper((int) text[pos + 3]) == 'R')
    {
        r_bit = 0;
        pos += 4;
    }
    else if (c0 == 'S' && c1 == 'P' && c2 == 'S' && pos + 3 < length && toupper((int) text[pos + 3]) == 'R')
    {
        r_bit = 1;
        pos += 4;
    }
    else
    {
        return error_bad_psr_field();
    }
    if (pos < length && text[pos] == '_')
    {
        pos += 1;
        while (pos < length)
        {
            char ch = (char) toupper((int) text[pos]);

            if (ch == 'C') mask |= 1u;
            else if (ch == 'X') mask |= 2u;
            else if (ch == 'S') mask |= 4u;
            else if (ch == 'F') mask |= 8u;
            else break;
            pos += 1;
        }
        if (mask == 0)
        {
            return error_bad_psr_field();
        }
    }
    else
    {
        mask = 8u; /* bare CPSR/SPSR means the flags field, matching common usage */
    }
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    pos += assemble_skip_spaces(text + pos, length - pos);
    if (pos < length && text[pos] == '#')
    {
        int32_t value;
        uint32_t encoded;

        pos += 1;
        error = eval_numeric(context, text, length, &pos, &value);
        if (error != NULL) return error;
        if (!encode_dp_immediate((uint32_t) value, &encoded))
        {
            return error_bad_immediate();
        }
        error = check_trailing(text, length, pos);
        if (error != NULL) return error;
        *out_instr = (cond << 28) | 0x0320F000u | (r_bit << 22) | (mask << 16) | encoded;
    }
    else
    {
        uint32_t rm;

        error = parse_register(context, text, length, &pos, &rm);
        if (error != NULL) return error;
        error = check_trailing(text, length, pos);
        if (error != NULL) return error;
        *out_instr = (cond << 28) | 0x0120F000u | (r_bit << 22) | (mask << 16) | rm;
    }
    return NULL;
}

/* MRS Rd, <psr> (CPSR or SPSR, no field mask). The banked-register
   form is not implemented -- see the mnemonic table comment above. */
static _kernel_oserror *encode_mrs(assemble_context_t *context, const mnemonic_entry_t *entry,
                                    uint32_t cond, int s_flag,
                                    const uint8_t *text, size_t length, size_t pos,
                                    uint32_t *out_instr)
{
    uint32_t rd;
    char c0, c1, c2, c3;
    uint32_t r_bit;
    _kernel_oserror *error;

    (void) entry; (void) s_flag;
    error = parse_register(context, text, length, &pos, &rd);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    pos += assemble_skip_spaces(text + pos, length - pos);
    c0 = (pos < length) ? (char) toupper((int) text[pos]) : 0;
    c1 = (pos + 1 < length) ? (char) toupper((int) text[pos + 1]) : 0;
    c2 = (pos + 2 < length) ? (char) toupper((int) text[pos + 2]) : 0;
    c3 = (pos + 3 < length) ? (char) toupper((int) text[pos + 3]) : 0;
    if (c0 == 'C' && c1 == 'P' && c2 == 'S' && c3 == 'R')
    {
        r_bit = 0;
    }
    else if (c0 == 'S' && c1 == 'P' && c2 == 'S' && c3 == 'R')
    {
        r_bit = 1;
    }
    else
    {
        return error_bad_psr_field();
    }
    pos += 4;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    *out_instr = (cond << 28) | 0x010F0000u | (r_bit << 22) | (rd << 12);
    return NULL;
}

/* PUSH {list} == STMDB SP!,{list}; POP {list} == LDMIA SP!,{list}.
   (Real LDM/STM are handled separately, before generic mnemonic
   dispatch -- see handle_ldm_stm.) */
static _kernel_oserror *encode_push_pop(assemble_context_t *context, const mnemonic_entry_t *entry,
                                         uint32_t cond, int s_flag,
                                         const uint8_t *text, size_t length, size_t pos,
                                         uint32_t *out_instr)
{
    uint32_t mask;
    int caret;
    _kernel_oserror *error;

    (void) s_flag;
    error = parse_register_list(context, text, length, &pos, &mask, &caret);
    if (error != NULL) return error;
    if (caret)
    {
        return error_bad_register_list("'^' is not permitted with PUSH/POP");
    }
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    *out_instr = (cond << 28) | (entry->param1 ? 0x092D0000u : 0x08BD0000u) | mask;
    return NULL;
}

/* ---------------------------------------------------------------
 * LDR/STR: uniquely among ARM mnemonics, the size/sign suffix is
 * written *after* the condition code (eg "LDREQB", not "LDRBEQ"),
 * so this is parsed directly rather than through the generic
 * mnemonic table.
 * --------------------------------------------------------------- */

/*******************************************************************
 Function:      handle_ldr_str
 Description:   Parses and encodes a full LDR/STR-family instruction,
                starting just after the matched "LDR"/"STR" root.
 Parameters:    context = the assembly context
                text/length = full source text
                pos_inout = [[inout]] position, just after "LDR"/"STR"
                is_str = non-zero for STR, zero for LDR
                out_instr = [[out]] the completed instruction word
 Returns:       NULL if successful, otherwise a static error block
 ******************************************************************/
static _kernel_oserror *handle_ldr_str(assemble_context_t *context,
                                        const uint8_t *text, size_t length, size_t *pos_inout,
                                        int is_str, uint32_t *out_instr)
{
    size_t pos = *pos_inout;
    uint32_t cond = COND_AL;
    uint8_t c0, c1;
    uint32_t rd;
    uint32_t bits = 0;
    int cls = LDST_CLASS_NORMAL;
    _kernel_oserror *error;

    if (match_condition(text + pos, length - pos, &cond))
    {
        pos += 2;
    }
    else
    {
        cond = COND_AL;
    }

    c0 = (pos < length) ? (uint8_t) toupper((int) text[pos]) : 0;
    c1 = (pos + 1 < length) ? (uint8_t) toupper((int) text[pos + 1]) : 0;

    if (c0 == 'B' && !continues_identifier(text, length, pos + 1))
    {
        bits |= (1u << 22);
        pos += 1;
    }
    else if (c0 == 'B' && c1 == 'T')
    {
        bits |= (1u << 22) | (1u << 21); /* B + T (unprivileged) */
        pos += 2;
    }
    else if (c0 == 'T' && !continues_identifier(text, length, pos + 1))
    {
        bits |= (1u << 21); /* T (unprivileged), word-sized */
        pos += 1;
    }
    else if (c0 == 'H')
    {
        cls = LDST_CLASS_EXTRA;
        bits |= 0xB0u;
        pos += 1;
    }
    else if (c0 == 'S' && c1 == 'B')
    {
        if (is_str)
        {
            return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_UNSUPPORTED_ON_VARIANT,
                                       ASSEMBLE_ARM32_ERR_NONE, "STRSB does not exist");
        }
        cls = LDST_CLASS_EXTRA;
        bits |= 0xD0u | (1u << 20);
        pos += 2;
    }
    else if (c0 == 'S' && c1 == 'H')
    {
        if (is_str)
        {
            return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_UNSUPPORTED_ON_VARIANT,
                                       ASSEMBLE_ARM32_ERR_NONE, "STRSH does not exist");
        }
        cls = LDST_CLASS_EXTRA;
        bits |= 0xF0u | (1u << 20);
        pos += 2;
    }
    else if (c0 == 'D')
    {
        cls = LDST_CLASS_EXTRA;
        bits |= is_str ? 0xF0u : 0xD0u; /* bit20 (L) stays 0 for LDRD/STRD */
        pos += 1;
    }

    if (cls == LDST_CLASS_NORMAL && !is_str)
    {
        bits |= (1u << 20); /* L: LDR word/byte */
    }
    else if (cls == LDST_CLASS_EXTRA && (bits & 0xF0u) == 0xB0u && !is_str)
    {
        bits |= (1u << 20); /* L: LDRH (STRH already has L=0 by default) */
    }

    error = parse_register(context, text, length, &pos, &rd);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_ldr_str_address(context, text, length, &pos, cls, &bits);
    if (error != NULL) return error;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    if (cls == LDST_CLASS_NORMAL)
    {
        *out_instr = (cond << 28) | 0x04000000u | bits | (rd << 12);
    }
    else
    {
        *out_instr = (cond << 28) | 0x00000090u | bits | (rd << 12);
    }
    *pos_inout = pos;
    return NULL;
}

/* ---------------------------------------------------------------
 * LDM/STM: also has its addressing-mode suffix written after the
 * condition code (eg "LDMEQFD", not "LDMFDEQ"), and unlike LDR/STR
 * the suffix is mandatory. The FD/FA/EA/ED stack aliases mean a
 * different P/U combination for LDM than for STM.
 * --------------------------------------------------------------- */

typedef struct ldm_stm_suffix_entry
{
    const char *name;
    uint32_t    ldm_pu;   /* (P<<1)|U when used with LDM */
    uint32_t    stm_pu;   /* (P<<1)|U when used with STM */
} ldm_stm_suffix_entry_t;

static const ldm_stm_suffix_entry_t ldm_stm_suffixes[] = {
    { "IA", 1, 1 }, { "IB", 3, 3 }, { "DA", 0, 0 }, { "DB", 2, 2 },
    { "FD", 1, 2 }, { "FA", 0, 3 }, { "EA", 2, 1 }, { "ED", 3, 0 }
};
#define NUM_LDM_STM_SUFFIXES (sizeof(ldm_stm_suffixes) / sizeof(ldm_stm_suffixes[0]))

/*******************************************************************
 Function:      handle_ldm_stm
 Description:   Parses and encodes a full LDM/STM instruction,
                starting just after the matched "LDM"/"STM" root.
 Parameters:    context = the assembly context
                text/length = full source text
                pos_inout = [[inout]] position, just after "LDM"/"STM"
                is_stm = non-zero for STM, zero for LDM
                out_instr = [[out]] the completed instruction word
 Returns:       NULL if successful, otherwise a static error block
 ******************************************************************/
static _kernel_oserror *handle_ldm_stm(assemble_context_t *context,
                                        const uint8_t *text, size_t length, size_t *pos_inout,
                                        int is_stm, uint32_t *out_instr)
{
    size_t pos = *pos_inout;
    uint32_t cond = COND_AL;
    char c0, c1;
    uint32_t pu = 0xFFFFFFFFu;
    uint32_t rn, mask;
    int caret;
    size_t i;
    _kernel_oserror *error;

    if (match_condition(text + pos, length - pos, &cond))
    {
        pos += 2;
    }
    else
    {
        cond = COND_AL;
    }

    c0 = (pos < length) ? (char) toupper((int) text[pos]) : 0;
    c1 = (pos + 1 < length) ? (char) toupper((int) text[pos + 1]) : 0;
    for (i = 0; i < NUM_LDM_STM_SUFFIXES; i++)
    {
        if (c0 == ldm_stm_suffixes[i].name[0] && c1 == ldm_stm_suffixes[i].name[1])
        {
            pu = is_stm ? ldm_stm_suffixes[i].stm_pu : ldm_stm_suffixes[i].ldm_pu;
            pos += 2;
            break;
        }
    }
    if (pu == 0xFFFFFFFFu)
    {
        return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_ARM32_ERR_NONE,
                                   "Expected an addressing mode (IA/IB/DA/DB/FD/FA/EA/ED)");
    }

    error = parse_register(context, text, length, &pos, &rn);
    if (error != NULL) return error;
    pos += assemble_skip_spaces(text + pos, length - pos);
    {
        uint32_t w = 0;

        if (pos < length && text[pos] == '!')
        {
            w = 1;
            pos += 1;
        }
        error = expect_char(text, length, &pos, ',');
        if (error != NULL) return error;
        error = parse_register_list(context, text, length, &pos, &mask, &caret);
        if (error != NULL) return error;
        error = check_trailing(text, length, pos);
        if (error != NULL) return error;

        *out_instr = (cond << 28) | 0x08000000u | (pu << 23) | (caret ? (1u << 22) : 0) | (w << 21) |
                     (is_stm ? 0 : (1u << 20)) | (rn << 16) | mask;
    }
    *pos_inout = pos;
    return NULL;
}

/* SWP{B} Rd,Rm,[Rn] -- also has its 'B' suffix after the condition. */
static _kernel_oserror *handle_swp(assemble_context_t *context,
                                    const uint8_t *text, size_t length, size_t *pos_inout,
                                    uint32_t *out_instr)
{
    size_t pos = *pos_inout;
    uint32_t cond = COND_AL;
    uint32_t b_bit = 0;
    uint32_t rd, rm, rn;
    _kernel_oserror *error;

    if (match_condition(text + pos, length - pos, &cond))
    {
        pos += 2;
    }
    if (pos < length && toupper((int) text[pos]) == 'B' && !continues_identifier(text, length, pos + 1))
    {
        b_bit = 1;
        pos += 1;
    }

    error = parse_register(context, text, length, &pos, &rd);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_register(context, text, length, &pos, &rm);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_bracketed_register(context, text, length, &pos, &rn);
    if (error != NULL) return error;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    *out_instr = (cond << 28) | 0x01000090u | (b_bit << 22) | (rn << 16) | (rd << 12) | rm;
    *pos_inout = pos;
    return NULL;
}

/* UMULL/UMLAL/SMULL/SMLAL RdLo,RdHi,Rm,Rs -- the "LL"/"LA" suffix
   comes after the condition code, spelling eg "UMULEQLL". */
static _kernel_oserror *handle_long_multiply(assemble_context_t *context,
                                              const uint8_t *text, size_t length, size_t *pos_inout,
                                              int is_signed, uint32_t *out_instr)
{
    size_t pos = *pos_inout;
    uint32_t cond = COND_AL;
    char c0, c1;
    int is_accumulate;
    uint32_t rdlo, rdhi, rm, rs;
    int s_flag = 0;
    _kernel_oserror *error;

    if (match_condition(text + pos, length - pos, &cond))
    {
        pos += 2;
    }
    c0 = (pos < length) ? (char) toupper((int) text[pos]) : 0;
    c1 = (pos + 1 < length) ? (char) toupper((int) text[pos + 1]) : 0;
    if (c0 == 'L' && c1 == 'L')
    {
        is_accumulate = 0;
    }
    else if (c0 == 'L' && c1 == 'A')
    {
        is_accumulate = 1;
    }
    else
    {
        return error_bad_mnemonic();
    }
    pos += 2;
    if (pos < length && toupper((int) text[pos]) == 'S' && !continues_identifier(text, length, pos + 1))
    {
        s_flag = 1;
        pos += 1;
    }

    error = parse_register(context, text, length, &pos, &rdlo);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_register(context, text, length, &pos, &rdhi);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_register(context, text, length, &pos, &rm);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_register(context, text, length, &pos, &rs);
    if (error != NULL) return error;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;
    if (rdlo == rdhi || rdlo == rm || rdhi == rm)
    {
        return error_duplicate_register();
    }

    *out_instr = (cond << 28) | 0x00800090u | (is_signed ? (1u << 22) : 0) | (is_accumulate ? (1u << 21) : 0) |
                 (s_flag ? (1u << 20) : 0) | (rdhi << 16) | (rdlo << 12) | (rs << 8) | rm;
    *pos_inout = pos;
    return NULL;
}

/* ---------------------------------------------------------------
 * Generic coprocessor instructions: CDP{2}, MCR{2}, MRC{2}, LDC{2},
 * STC{2}. The '2' (force-unconditional) and, for LDC/STC, 'L' (long
 * transfer) markers both come after the condition code, same pattern
 * as LDR/STR. MRRC/MCRR are a documented gap (see the mnemonic table
 * comment above), not handled here.
 * --------------------------------------------------------------- */

#define COPROC_CDP 0
#define COPROC_MCR 1
#define COPROC_MRC 2
#define COPROC_LDC 3
#define COPROC_STC 4

static _kernel_oserror *error_bad_coprocessor_field(void)
{
    return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_RANGE, ASSEMBLE_ARM32_ERR_BAD_COPROCESSOR_FIELD,
                               "Bad coprocessor field");
}

/*******************************************************************
 Function:      parse_coproc_number
 Description:   Parses a coprocessor number, either 'CPn' or 'Cn'/
                'pn' (0-15), or a plain expression.
 ******************************************************************/
static _kernel_oserror *parse_coproc_number(assemble_context_t *context,
                                             const uint8_t *text, size_t length,
                                             size_t *pos_inout, uint32_t *out_num)
{
    size_t pos = *pos_inout;
    uint8_t c0, c1;
    int32_t value;
    _kernel_oserror *error;

    pos += assemble_skip_spaces(text + pos, length - pos);
    c0 = (pos < length) ? (uint8_t) toupper((int) text[pos]) : 0;
    c1 = (pos + 1 < length) ? (uint8_t) toupper((int) text[pos + 1]) : 0;
    if (c0 == 'C' && c1 == 'P' && pos + 2 < length && text[pos + 2] >= '0' && text[pos + 2] <= '9')
    {
        pos += 2;
    }
    else if (c0 == 'P' && pos + 1 < length && text[pos + 1] >= '0' && text[pos + 1] <= '9')
    {
        pos += 1;
    }
    *pos_inout = pos;
    error = eval_numeric(context, text, length, pos_inout, &value);
    if (error != NULL) return error;
    if (value < 0 || value > 15)
    {
        return error_bad_coprocessor_field();
    }
    *out_num = (uint32_t) value;
    return NULL;
}

/* Cn/CRn register (0-15), matching CHKCPREG in the original. */
static _kernel_oserror *parse_cp_register(assemble_context_t *context,
                                           const uint8_t *text, size_t length,
                                           size_t *pos_inout, uint32_t *out_num)
{
    size_t pos = *pos_inout;
    uint8_t c0;
    int32_t value;
    _kernel_oserror *error;

    pos += assemble_skip_spaces(text + pos, length - pos);
    c0 = (pos < length) ? (uint8_t) toupper((int) text[pos]) : 0;
    if ((c0 == 'C' || c0 == 'R') && pos + 1 < length && text[pos + 1] >= '0' && text[pos + 1] <= '9')
    {
        pos += 1;
    }
    *pos_inout = pos;
    error = eval_numeric(context, text, length, pos_inout, &value);
    if (error != NULL) return error;
    if (value < 0 || value > 15)
    {
        return error_bad_coprocessor_field();
    }
    *out_num = (uint32_t) value;
    return NULL;
}

/*******************************************************************
 Function:      handle_coprocessor
 Description:   Parses and encodes CDP{2}/MCR{2}/MRC{2}/LDC{2}/STC{2},
                starting just after the matched 3-character root.
 ******************************************************************/
static _kernel_oserror *handle_coprocessor(assemble_context_t *context,
                                            const uint8_t *text, size_t length, size_t *pos_inout,
                                            int kind, uint32_t *out_instr)
{
    size_t pos = *pos_inout;
    uint32_t cond = COND_AL;
    uint32_t coproc, crd_or_rd, crn, crm;
    int32_t opcode1, opcode2 = 0;
    _kernel_oserror *error;

    if (match_condition(text + pos, length - pos, &cond))
    {
        pos += 2;
    }
    if (pos < length && text[pos] == '2')
    {
        cond = COND_NV;
        pos += 1;
    }

    if (kind == COPROC_LDC || kind == COPROC_STC)
    {
        uint32_t n_bit = 0;
        uint32_t l_bit = (kind == COPROC_LDC) ? 1u : 0u;
        uint32_t bits = 0;

        if (pos < length && toupper((int) text[pos]) == 'L')
        {
            n_bit = 1;
            pos += 1;
        }
        error = parse_coproc_number(context, text, length, &pos, &coproc);
        if (error != NULL) return error;
        error = expect_char(text, length, &pos, ',');
        if (error != NULL) return error;
        error = parse_cp_register(context, text, length, &pos, &crd_or_rd);
        if (error != NULL) return error;
        error = expect_char(text, length, &pos, ',');
        if (error != NULL) return error;

        error = expect_char(text, length, &pos, '[');
        if (error != NULL) return error;
        {
            uint32_t rn;

            error = parse_register(context, text, length, &pos, &rn);
            if (error != NULL) return error;
            bits |= rn << 16;
        }
        pos += assemble_skip_spaces(text + pos, length - pos);
        if (pos < length && text[pos] == ']')
        {
            pos += 1;
            bits |= (1u << 23); /* U */
            pos += assemble_skip_spaces(text + pos, length - pos);
            if (pos < length && text[pos] == ',')
            {
                int32_t value;

                pos += 1;
                error = expect_char(text, length, &pos, '#');
                if (error != NULL) return error;
                error = eval_numeric(context, text, length, &pos, &value);
                if (error != NULL) return error;
                if (value < 0) { bits &= ~(1u << 23); value = -value; }
                if ((value & 3) != 0 || value > 0x3FC) return error_bad_offset();
                bits |= (uint32_t) (value >> 2);
            }
        }
        else
        {
            int32_t value;

            bits |= (1u << 24); /* P */
            bits |= (1u << 23); /* U */
            error = expect_char(text, length, &pos, ',');
            if (error != NULL) return error;
            error = expect_char(text, length, &pos, '#');
            if (error != NULL) return error;
            error = eval_numeric(context, text, length, &pos, &value);
            if (error != NULL) return error;
            if (value < 0) { bits &= ~(1u << 23); value = -value; }
            if ((value & 3) != 0 || value > 0x3FC) return error_bad_offset();
            bits |= (uint32_t) (value >> 2);
            error = expect_char(text, length, &pos, ']');
            if (error != NULL) return error;
            pos += assemble_skip_spaces(text + pos, length - pos);
            if (pos < length && text[pos] == '!')
            {
                pos += 1;
                bits |= (1u << 21); /* W */
            }
        }
        error = check_trailing(text, length, pos);
        if (error != NULL) return error;

        *out_instr = (cond << 28) | 0x0C000000u | (n_bit << 22) | (l_bit << 20) | bits |
                     (crd_or_rd << 12) | (coproc << 8);
    }
    else
    {
        error = parse_coproc_number(context, text, length, &pos, &coproc);
        if (error != NULL) return error;
        error = expect_char(text, length, &pos, ',');
        if (error != NULL) return error;
        error = expect_char(text, length, &pos, '#');
        if (error != NULL) return error;
        error = eval_numeric(context, text, length, &pos, &opcode1);
        if (error != NULL) return error;
        error = expect_char(text, length, &pos, ',');
        if (error != NULL) return error;

        if (kind == COPROC_CDP)
        {
            if (opcode1 < 0 || opcode1 > 15) return error_bad_coprocessor_field();
            error = parse_cp_register(context, text, length, &pos, &crd_or_rd);
            if (error != NULL) return error;
            error = expect_char(text, length, &pos, ',');
            if (error != NULL) return error;
            error = parse_cp_register(context, text, length, &pos, &crn);
            if (error != NULL) return error;
            error = expect_char(text, length, &pos, ',');
            if (error != NULL) return error;
            error = parse_cp_register(context, text, length, &pos, &crm);
            if (error != NULL) return error;
            pos += assemble_skip_spaces(text + pos, length - pos);
            if (pos < length && text[pos] == ',')
            {
                pos += 1;
                error = expect_char(text, length, &pos, '#');
                if (error != NULL) return error;
                error = eval_numeric(context, text, length, &pos, &opcode2);
                if (error != NULL) return error;
            }
            if (opcode2 < 0 || opcode2 > 7) return error_bad_coprocessor_field();
            error = check_trailing(text, length, pos);
            if (error != NULL) return error;

            *out_instr = (cond << 28) | 0x0E000000u | ((uint32_t) opcode1 << 20) | (crn << 16) |
                         (crd_or_rd << 12) | (coproc << 8) | ((uint32_t) opcode2 << 5) | crm;
        }
        else /* MCR / MRC */
        {
            if (opcode1 < 0 || opcode1 > 7) return error_bad_coprocessor_field();
            error = parse_register(context, text, length, &pos, &crd_or_rd);
            if (error != NULL) return error;
            error = expect_char(text, length, &pos, ',');
            if (error != NULL) return error;
            error = parse_cp_register(context, text, length, &pos, &crn);
            if (error != NULL) return error;
            error = expect_char(text, length, &pos, ',');
            if (error != NULL) return error;
            error = parse_cp_register(context, text, length, &pos, &crm);
            if (error != NULL) return error;
            pos += assemble_skip_spaces(text + pos, length - pos);
            if (pos < length && text[pos] == ',')
            {
                pos += 1;
                error = expect_char(text, length, &pos, '#');
                if (error != NULL) return error;
                error = eval_numeric(context, text, length, &pos, &opcode2);
                if (error != NULL) return error;
            }
            if (opcode2 < 0 || opcode2 > 7) return error_bad_coprocessor_field();
            error = check_trailing(text, length, pos);
            if (error != NULL) return error;

            *out_instr = (cond << 28) | 0x0E000010u | ((uint32_t) opcode1 << 21) |
                         ((kind == COPROC_MRC) ? (1u << 20) : 0) | (crn << 16) |
                         (crd_or_rd << 12) | (coproc << 8) | ((uint32_t) opcode2 << 5) | crm;
        }
    }
    *pos_inout = pos;
    return NULL;
}

/* ADR Rd, label -- an ADD/SUB Rd,PC,#imm pseudo-instruction. */
static _kernel_oserror *encode_adr(assemble_context_t *context, const mnemonic_entry_t *entry,
                                    uint32_t cond, int s_flag,
                                    const uint8_t *text, size_t length, size_t pos,
                                    uint32_t *out_instr)
{
    uint32_t rd;
    int32_t target;
    int32_t offset;
    uint32_t encoded;
    uint32_t opcode;
    _kernel_oserror *error;

    (void) entry; (void) s_flag;
    error = parse_register(context, text, length, &pos, &rd);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = eval_numeric(context, text, length, &pos, &target);
    if (error != NULL) return error;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    offset = target - (int32_t) (context->address + 8);
    if (offset >= 0)
    {
        opcode = 0x4; /* ADD */
    }
    else
    {
        opcode = 0x2; /* SUB */
        offset = -offset;
    }
    if (!encode_dp_immediate((uint32_t) offset, &encoded))
    {
        return error_bad_immediate();
    }

    *out_instr = (cond << 28) | (opcode << 21) | (0xFu << 16) /* Rn = PC */ | (rd << 12) | (1u << 25) | encoded;
    return NULL;
}

/* ---------------------------------------------------------------
 * Dispatch table: maps each generically-handled family to its
 * encoder function. Families handled by dedicated functions (LDR/STR,
 * LDM/STM proper, SWP, the long-multiply family, and the generic
 * coprocessor instructions) are not listed here -- they are matched
 * directly in assemble_arm32_line before generic dispatch runs.
 * --------------------------------------------------------------- */

static family_encoder_fn family_encoder(instr_family_t family)
{
    switch (family)
    {
        case FAMILY_DATA_PROC:    return encode_data_proc;
        case FAMILY_DATA_CMP:     return encode_data_cmp;
        case FAMILY_DATA_MOV:     return encode_data_mov;
        case FAMILY_MUL:          return encode_mul;
        case FAMILY_UMAAL:        return encode_umaal;
        case FAMILY_BRANCH:       return encode_branch;
        case FAMILY_BX:           return encode_bx;
        case FAMILY_SWI:          return encode_swi;
        case FAMILY_LDM_STM:      return encode_push_pop;
        case FAMILY_MSR:          return encode_msr;
        case FAMILY_MRS:          return encode_mrs;
        case FAMILY_CLZ:          return encode_clz;
        case FAMILY_PLD_PLI:      return encode_pld_pli;
        case FAMILY_BFC:          return encode_bfc;
        case FAMILY_BFI:          return encode_bfi;
        case FAMILY_SBFX_UBFX:    return encode_bfx;
        case FAMILY_REV:          return encode_rev;
        case FAMILY_SEL:          return encode_sel;
        case FAMILY_USAD8:        return encode_usad8;
        case FAMILY_USADA8:       return encode_usada8;
        case FAMILY_SAT:          return encode_sat;
        case FAMILY_SAT16:        return encode_sat16;
        case FAMILY_QSAT:         return encode_qsat;
        case FAMILY_PARALLEL:     return encode_parallel;
        case FAMILY_SDIV_UDIV:    return encode_sdiv_udiv;
        case FAMILY_LDREX_STREX:  return encode_ldrex_strex;
        case FAMILY_CLREX:        return encode_clrex;
        case FAMILY_CPS:          return encode_cps;
        case FAMILY_SETEND:       return encode_setend;
        case FAMILY_SETPAN:       return encode_setpan;
        case FAMILY_BARRIER:      return encode_barrier;
        case FAMILY_HINT:         return encode_hint;
        case FAMILY_RFE:          return encode_rfe;
        case FAMILY_SRS:          return encode_srs;
        case FAMILY_BKPT:         return encode_bkpt;
        case FAMILY_SVC_HINT:     return encode_svc_hint;
        case FAMILY_ERET:         return encode_eret;
        case FAMILY_HLT:          return encode_hlt;
        case FAMILY_CRC32:        return encode_crc32;
        case FAMILY_BARRIER_NOOP: return encode_barrier_noop;
        case FAMILY_PKH:          return encode_pkh;
        case FAMILY_SXT_UXT:      return encode_sxt_uxt;
        case FAMILY_SXT_UXT_A:    return encode_sxt_uxt_a;
        case FAMILY_ADR:          return encode_adr;
        default:                  return NULL;
    }
}

/* ---------------------------------------------------------------
 * Pseudo-ops: EQU, DCB/DCW/DCD, ALIGN, OPT. These don't produce a
 * single instruction word, so (like the other backends' EQU/DCB/etc)
 * they're handled directly in assemble_arm32_line rather than through
 * the family-encoder dispatch above.
 * --------------------------------------------------------------- */

static _kernel_oserror *assign_label(assemble_context_t *context,
                                      const char *label, size_t label_length,
                                      const assemble_value_t *value)
{
    _kernel_oserror *error = NULL;

    if (context->assign_var(context->user_data, label, label_length, value, &error) != ASSEMBLE_RESULT_OK)
    {
        if (error != NULL)
        {
            return error;
        }
        return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_BAD_LABEL, ASSEMBLE_ARM32_ERR_NONE,
                                   "Label could not be assigned");
    }
    return NULL;
}

static _kernel_oserror *assemble_dc(assemble_context_t *context, const char *mnemonic,
                                     const uint8_t *text, size_t length)
{
    size_t pos = 0;
    _kernel_oserror *error;

    for (;;)
    {
        int32_t number;

        pos += assemble_skip_spaces(text + pos, length - pos);
        error = eval_numeric(context, text, length, &pos, &number);
        if (error != NULL)
        {
            return error;
        }

        if (strcmp(mnemonic, "DCB") == 0)
        {
            error = assemble_emit_byte(context, ASSEMBLE_CPU_ARM32, (uint8_t) (number & 0xFF));
        }
        else if (strcmp(mnemonic, "DCW") == 0)
        {
            error = assemble_emit_word(context, ASSEMBLE_CPU_ARM32, (uint16_t) (number & 0xFFFF));
        }
        else
        {
            error = assemble_emit_dword(context, ASSEMBLE_CPU_ARM32, (uint32_t) number);
        }
        if (error != NULL)
        {
            return error;
        }

        pos += assemble_skip_spaces(text + pos, length - pos);
        if (pos < length && text[pos] == ',')
        {
            pos += 1;
            continue;
        }
        break;
    }

    return check_trailing(text, length, pos);
}

static _kernel_oserror *assemble_align(assemble_context_t *context, const uint8_t *text, size_t length)
{
    uint32_t pad = (4u - (context->address & 3u)) & 3u;
    _kernel_oserror *error;

    error = check_trailing(text, length, 0);
    if (error != NULL)
    {
        return error;
    }
    while (pad > 0)
    {
        error = assemble_emit_byte(context, ASSEMBLE_CPU_ARM32, 0);
        if (error != NULL)
        {
            return error;
        }
        pad -= 1;
    }
    return NULL;
}

/*******************************************************************
 Function:      assemble_arm32_line
 Description:   see h/assemble_arm32
 ******************************************************************/
_kernel_oserror *assemble_arm32_line(assemble_context_t *context,
                                      const uint8_t *line, size_t line_length)
{
    size_t pos;
    char label[64];
    size_t label_length = 0;
    int have_label = 0;
    char mnemonic[16];
    size_t consumed;
    _kernel_oserror *error;

    context->bytes_used = 0;
    pos = 0;
    pos += assemble_skip_spaces(line + pos, line_length - pos);

    if (pos < line_length && line[pos] == '.')
    {
        size_t start;

        pos += 1;
        start = pos;
        if (!(pos < line_length && assemble_is_ident_start(line[pos])))
        {
            return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_BAD_LABEL, ASSEMBLE_ARM32_ERR_NONE,
                                       "Expected a label name after '.'");
        }
        while (pos < line_length && assemble_is_ident_char(line[pos]))
        {
            pos += 1;
        }
        label_length = pos - start;
        if (label_length >= sizeof(label))
        {
            label_length = sizeof(label) - 1;
        }
        memcpy(label, line + start, label_length);
        label[label_length] = '\0';
        have_label = 1;
        pos += assemble_skip_spaces(line + pos, line_length - pos);
    }

    if (pos >= line_length)
    {
        if (have_label)
        {
            assemble_value_t value;

            value.type = ASSEMBLE_VALUE_INTEGER;
            value.value.as_integer = (int32_t) context->address;
            return assign_label(context, label, label_length, &value);
        }
        return NULL;
    }

    consumed = read_token(line + pos, line_length - pos, mnemonic);
    if (consumed == 0 || mnemonic[0] == '\0')
    {
        return error_bad_mnemonic();
    }

    /* LDR, STR, LDM, STM, SWP, the long-multiply family, and the
       generic coprocessor instructions all write their size/mode
       suffix *after* the condition code, so they are matched here on
       their fixed 3-character root and handed to a dedicated parser
       rather than going through match_mnemonic(). */
    if (strlen(mnemonic) >= 3 &&
        (memcmp(mnemonic, "LDR", 3) == 0 || memcmp(mnemonic, "STR", 3) == 0 ||
         memcmp(mnemonic, "LDM", 3) == 0 || memcmp(mnemonic, "STM", 3) == 0 ||
         memcmp(mnemonic, "SWP", 3) == 0 || memcmp(mnemonic, "UMU", 3) == 0 ||
         memcmp(mnemonic, "UML", 3) == 0 || memcmp(mnemonic, "SMU", 3) == 0 ||
         memcmp(mnemonic, "SML", 3) == 0 || memcmp(mnemonic, "CDP", 3) == 0 ||
         memcmp(mnemonic, "MCR", 3) == 0 || memcmp(mnemonic, "MRC", 3) == 0 ||
         memcmp(mnemonic, "LDC", 3) == 0 || memcmp(mnemonic, "STC", 3) == 0))
    {
        size_t opstart = pos + 3;
        uint32_t instr;

        if (have_label)
        {
            assemble_value_t value;

            value.type = ASSEMBLE_VALUE_INTEGER;
            value.value.as_integer = (int32_t) context->address;
            error = assign_label(context, label, label_length, &value);
            if (error != NULL) return error;
        }

        if (memcmp(mnemonic, "LDR", 3) == 0)
        {
            error = handle_ldr_str(context, line, line_length, &opstart, 0, &instr);
        }
        else if (memcmp(mnemonic, "STR", 3) == 0)
        {
            error = handle_ldr_str(context, line, line_length, &opstart, 1, &instr);
        }
        else if (memcmp(mnemonic, "LDM", 3) == 0)
        {
            error = handle_ldm_stm(context, line, line_length, &opstart, 0, &instr);
        }
        else if (memcmp(mnemonic, "STM", 3) == 0)
        {
            error = handle_ldm_stm(context, line, line_length, &opstart, 1, &instr);
        }
        else if (memcmp(mnemonic, "SWP", 3) == 0)
        {
            error = handle_swp(context, line, line_length, &opstart, &instr);
        }
        else if (memcmp(mnemonic, "UMU", 3) == 0)
        {
            error = handle_long_multiply(context, line, line_length, &opstart, 0, &instr);
        }
        else if (memcmp(mnemonic, "UML", 3) == 0)
        {
            error = handle_long_multiply(context, line, line_length, &opstart, 0, &instr);
        }
        else if (memcmp(mnemonic, "SMU", 3) == 0)
        {
            error = handle_long_multiply(context, line, line_length, &opstart, 1, &instr);
        }
        else if (memcmp(mnemonic, "SML", 3) == 0)
        {
            error = handle_long_multiply(context, line, line_length, &opstart, 1, &instr);
        }
        else if (memcmp(mnemonic, "CDP", 3) == 0)
        {
            error = handle_coprocessor(context, line, line_length, &opstart, COPROC_CDP, &instr);
        }
        else if (memcmp(mnemonic, "MCR", 3) == 0)
        {
            error = handle_coprocessor(context, line, line_length, &opstart, COPROC_MCR, &instr);
        }
        else if (memcmp(mnemonic, "MRC", 3) == 0)
        {
            error = handle_coprocessor(context, line, line_length, &opstart, COPROC_MRC, &instr);
        }
        else if (memcmp(mnemonic, "LDC", 3) == 0)
        {
            error = handle_coprocessor(context, line, line_length, &opstart, COPROC_LDC, &instr);
        }
        else /* STC */
        {
            error = handle_coprocessor(context, line, line_length, &opstart, COPROC_STC, &instr);
        }
        if (error != NULL)
        {
            return error;
        }
        return assemble_emit_dword(context, ASSEMBLE_CPU_ARM32, instr);
    }

    if (strcmp(mnemonic, "EQU") == 0)
    {
        assemble_value_t value;
        size_t p2 = pos + consumed;

        if (!have_label)
        {
            return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_BAD_LABEL,
                                       ASSEMBLE_ARM32_ERR_NEED_LABEL_FOR_EQU,
                                       "EQU used without a preceding label");
        }
        error = eval_expr(context, line + p2, line_length - p2, &value, &consumed);
        if (error != NULL)
        {
            return error;
        }
        p2 += consumed;
        error = check_trailing(line, line_length, p2);
        if (error != NULL)
        {
            return error;
        }
        return assign_label(context, label, label_length, &value);
    }

    if (have_label)
    {
        assemble_value_t value;

        value.type = ASSEMBLE_VALUE_INTEGER;
        value.value.as_integer = (int32_t) context->address;
        error = assign_label(context, label, label_length, &value);
        if (error != NULL)
        {
            return error;
        }
    }

    if (strcmp(mnemonic, "OPT") == 0)
    {
        size_t p2 = pos + consumed;

        p2 += assemble_skip_spaces(line + p2, line_length - p2);
        if (p2 < line_length)
        {
            assemble_value_t value;

            error = eval_expr(context, line + p2, line_length - p2, &value, &consumed);
            if (error != NULL)
            {
                return error;
            }
            p2 += consumed;
        }
        return check_trailing(line, line_length, p2);
    }

    if (strcmp(mnemonic, "ALIGN") == 0)
    {
        size_t p2 = pos + consumed;

        return assemble_align(context, line + p2, line_length - p2);
    }

    if (strcmp(mnemonic, "DCB") == 0 || strcmp(mnemonic, "DCW") == 0 || strcmp(mnemonic, "DCD") == 0)
    {
        size_t p2 = pos + consumed;

        return assemble_dc(context, mnemonic, line + p2, line_length - p2);
    }

    {
        const mnemonic_entry_t *matched_entry;
        uint32_t cond;
        int s_flag;

        if (!match_mnemonic(mnemonic, &matched_entry, &cond, &s_flag))
        {
            return error_bad_mnemonic();
        }
        {
            family_encoder_fn encoder = family_encoder(matched_entry->family);
            uint32_t instr;
            size_t p2 = pos + consumed;

            if (encoder == NULL)
            {
                return error_bad_mnemonic();
            }
            error = encoder(context, matched_entry, cond, s_flag, line, line_length, p2, &instr);
            if (error != NULL)
            {
                return error;
            }
            return assemble_emit_dword(context, ASSEMBLE_CPU_ARM32, instr);
        }
    }
}
