    { "VSRA",   FAMILY_NEON_SHIFT_IMM, (0x1u<<0) | (1u<<4), 0, 0, 0, ASSEMBLE_ARM32_OPT_VFP },
    { "VRSHR",  FAMILY_NEON_SHIFT_IMM, (0x2u<<0) | (1u<<4), 0, 0, 0, ASSEMBLE_ARM32_OPT_VFP },
    { "VRSRA",  FAMILY_NEON_SHIFT_IMM, (0x3u<<0) | (1u<<4), 0, 0, 0, ASSEMBLE_ARM32_OPT_VFP },
    { "VSRI",   FAMILY_NEON_SHIFT_IMM, (0x4u<<0) | (1u<<5), 0, 0, 0, ASSEMBLE_ARM32_OPT_VFP },
    { "VSLI",   FAMILY_NEON_SHIFT_IMM, (0x5u<<0) | (1u<<5) | (1u<<6), 0, 0, 0, ASSEMBLE_ARM32_OPT_VFP },
    { "VQSHLU", FAMILY_NEON_SHIFT_IMM, (0x6u<<0) | (1u<<5) | (1u<<6), 0, 0, 0, ASSEMBLE_ARM32_OPT_VFP },

