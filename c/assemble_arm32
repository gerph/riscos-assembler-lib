    /* param1: 0=VQMOVN (sign-derived op), 1=VQMOVUN (fixed op=1). */
    { "VQMOVN",  FAMILY_NEON_QMOVN, 0, 0, 0, 0, ASSEMBLE_ARM32_OPT_VFP },
