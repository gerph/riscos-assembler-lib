/*******************************************************************
 Function:      parse_bracketed_register
 Description:   Parses a plain '[Rn]' operand with no offset, as
                used by LDREX/STREX/CLREX-family instructions.
 ******************************************************************/
static _kernel_oserror *parse_bracketed_register(assemble_context_t *context,
                                                   const uint8_t *text, size_t length,
                                                   size_t *pos_inout, uint32_t *out_rn)
{
    _kernel_oserror *error;

    error = expect_char(text, length, pos_inout, '[');
    if (error != NULL) return error;
    error = parse_register(context, text, length, pos_inout, out_rn);
    if (error != NULL) return error;
    return expect_char(text, length, pos_inout, ']');
}

/* LDREX{B|H|D} Rt,[Rn]; STREX{B|H|D} Rd,Rt,[Rn]. param1: 0=LDREX,
   1=LDREXB, 2=LDREXH, 3=LDREXD, 4=STREX, 5=STREXB, 6=STREXH, 7=STREXD. */
static _kernel_oserror *encode_ldrex_strex(assemble_context_t *context, const mnemonic_entry_t *entry,
                                            uint32_t cond, int s_flag,
                                            const uint8_t *text, size_t length, size_t pos,
                                            uint32_t *out_instr)
{
    static const uint32_t ldrex_base[4] = { 0x01900F9Fu, 0x01D00F9Fu, 0x01F00F9Fu, 0x01B00F9Fu };
