/* VSHLL Qd,Dm,#imm -- widening shift left. When the immediate equals
   the element size exactly, real syntax and hardware both use a
   dedicated, simpler "A2" encoding (no imm6 field at all, just a
   2-bit size); anything less uses the general A1 imm6 form (which,
   since the source is always <=32 bits wide here, never needs the L
   size-extension bit). Vd is always Q and Vm always D -- unlike every
   other shift-immediate mnemonic there is no D/Q choice to encode, so
   this doesn't go through encode_neon_shift_imm_generic. */
static _kernel_oserror *encode_neon_vshll(assemble_context_t *context, const mnemonic_entry_t *entry,
                                           uint32_t cond, int s_flag,
                                           const uint8_t *text, size_t length, size_t pos,
                                           uint32_t *out_instr)
{
    neon_dt_t dt;
    uint32_t rd, rm;
    uint8_t cd, cm;
    assemble_value_t value;
    size_t consumed;
    int32_t shift_amt;
    uint32_t vd, dbit, vm, mbit, u;
    _kernel_oserror *error;

    (void) entry; (void) s_flag;
    if (cond != COND_AL) return error_neon_no_condition();

    error = parse_neon_dt(text, length, &pos, &dt);
    if (error != NULL) return error;
    if (dt.width != 8 && dt.width != 16 && dt.width != 32) return error_bad_datatype();
    error = parse_neon_register(text, length, &pos, &rd, &cd);
    if (error != NULL) return error;
    if (cd != 'Q') return error_neon_mismatched_size();
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_neon_register(text, length, &pos, &rm, &cm);
    if (error != NULL) return error;
    if (cm != 'D') return error_neon_mismatched_size();
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, '#');
    if (error != NULL) return error;
    error = eval_expr(context, text + pos, length - pos, &value, &consumed);
    if (error != NULL) return error;
    pos += consumed;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    shift_amt = value_to_integer(&value);
    split_neon_register(rd, cd, &vd, &dbit);
    split_neon_register(rm, cm, &vm, &mbit);

    if (shift_amt >= 0 && (uint32_t) shift_amt == dt.width)
    {
        *out_instr = 0xF3B20300u | (dbit << 22) | (neon_dt_size2(dt.width) << 18) | (vd << 12) |
                     (mbit << 5) | vm;
        return NULL;
    }

    if (shift_amt < 0 || (uint32_t) shift_amt >= dt.width) return error_bad_shift();
    if (dt.kind == 'S') u = 0u;
    else if (dt.kind == 'U') u = 1u;
    else return error_bad_datatype();
    {
        uint32_t field = dt.width + (uint32_t) shift_amt;
        uint32_t l = (field >> 6) & 1u;
        uint32_t imm6 = field & 0x3Fu;

        *out_instr = assemble_neon_shift_imm(u, dbit, imm6, vd, 0xAu /* opcode 1010 */, l, 0u /* Q fixed 0 */,
                                              mbit, vm);
    }
    return NULL;
}

/* VSHL/VQSHL -- three-same register form ({Dd|Qd},{Dn|Qn},{Dm|Qm}) or
   shift-immediate form ({Dd|Qd},{Dn|Qn},#imm), selected by whether the
   third operand is a register or an immediate; both share one root
   the same way VADD etc do (see encode_vfp_or_neon_arith3), just with
   a NEON-vs-NEON choice instead of scalar-vs-NEON.
   param1 (register form): bits11:8=opcode, bit4=opbit (both always
   S/U-derived, same convention as FAMILY_NEON_3SAME's param1).
   param2 (immediate form): bits11:8=opcode, bit25=u_derived, bit24=
   u_fixed (when not derived). */
static _kernel_oserror *encode_neon_vshl_or_reg(assemble_context_t *context, const mnemonic_entry_t *entry,
                                                  uint32_t cond, int s_flag,
                                                  const uint8_t *text, size_t length, size_t pos,
                                                  uint32_t *out_instr)
{
    neon_dt_t dt;
    uint32_t rd, rn;
    uint8_t cd, cn;
    size_t peek_pos;
    _kernel_oserror *error;

    (void) s_flag;
    if (cond != COND_AL) return error_neon_no_condition();

    error = parse_neon_dt(text, length, &pos, &dt);
    if (error != NULL) return error;
    error = parse_neon_register(text, length, &pos, &rd, &cd);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_neon_register(text, length, &pos, &rn, &cn);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;

    peek_pos = pos + assemble_skip_spaces(text + pos, length - pos);
    if (peek_pos < length && text[peek_pos] == '#')
    {
        assemble_value_t value;
        size_t consumed;
        int32_t shift_amt;
        uint32_t vd, dbit, vm, mbit, q, u, opcode4, l, imm6, field;

        pos = peek_pos + 1;
        error = eval_expr(context, text + pos, length - pos, &value, &consumed);
        if (error != NULL) return error;
        pos += consumed;
        error = check_trailing(text, length, pos);
        if (error != NULL) return error;
        if (cd != cn) return error_neon_mismatched_size();
        q = (cd == 'Q') ? 1u : 0u;

        shift_amt = value_to_integer(&value);
        if (shift_amt < 0 || (uint32_t) shift_amt >= dt.width) return error_bad_shift();

        opcode4 = (entry->param2 >> 8) & 0xFu;
        if (entry->param2 & (1u << 25)) /* u_derived */
        {
            if (dt.kind == 'S') u = 0u;
            else if (dt.kind == 'U') u = 1u;
            else return error_bad_datatype();
        }
        else
        {
            if (dt.kind != 0 && dt.kind != 'I') return error_bad_datatype();
            u = (entry->param2 >> 24) & 1u;
        }

        field = dt.width + (uint32_t) shift_amt;
        l = (field >> 6) & 1u;
        imm6 = field & 0x3Fu;

        split_neon_register(rd, cd, &vd, &dbit);
        split_neon_register(rn, cn, &vm, &mbit);
        *out_instr = assemble_neon_shift_imm(u, dbit, imm6, vd, opcode4, l, q, mbit, vm);
        return NULL;
    }
    else
    {
        uint32_t rm;
        uint8_t cm;
        uint32_t vd, dbit, vn, nbit, vm, mbit, q, u, opcode4, opbit, size2;

        pos = peek_pos;
        error = parse_neon_register(text, length, &pos, &rm, &cm);
        if (error != NULL) return error;
        error = check_trailing(text, length, pos);
        if (error != NULL) return error;
        if (cd != cn || cd != cm) return error_neon_mismatched_size();
        q = (cd == 'Q') ? 1u : 0u;

        if (dt.kind == 'S') u = 0u;
        else if (dt.kind == 'U') u = 1u;
        else return error_bad_datatype();
        opcode4 = (entry->param1 >> 8) & 0xFu;
        opbit = (entry->param1 >> 4) & 1u;
        size2 = neon_dt_size2(dt.width);

        split_neon_register(rn, cn, &vn, &nbit);
        split_neon_register(rd, cd, &vd, &dbit);
        split_neon_register(rm, cm, &vm, &mbit);
        *out_instr = assemble_neon_three_same(u, dbit, size2 >> 1, size2 & 1u, vn, vd, opcode4, nbit, q, mbit,
                                               opbit, vm);
        return NULL;
    }
}

/* ---------------------------------------------------------------
 * NEON/Advanced SIMD -- "long"/widening arithmetic (ARM DDI 0406C
 * A7.4.3): Qd,Dn,Dm (destination double the source width) or, for
 * VADDW/VSUBW, Qd,Qn,Dm (one operand already wide). Also "halving
 * narrow" (Dd,Qn,Qm, both sources wide, destination half width) and
 * the various narrowing/widening move forms, which share the same
 * general shape but different fixed skeletons.
 * --------------------------------------------------------------- */

/* Assembles a "long" word: unconditional, bit23=1 (like shift-immediate
   and two-reg-misc, unlike three-same's bit23=0), no Q bit (dest is
   always Q, so there is nothing to select) and no opbit (bit4 is
   always 0 -- the full distinguishing value lives in the 4-bit opcode
   at bits11:8). */
static uint32_t assemble_neon_long(uint32_t u, uint32_t dbit, uint32_t size2, uint32_t vn, uint32_t vd,
                                    uint32_t opcode4, uint32_t nbit, uint32_t mbit, uint32_t vm)
{
    return 0xF2800000u | (u << 24) | (dbit << 22) | (size2 << 20) | (vn << 16) | (vd << 12) |
           (opcode4 << 8) | (nbit << 7) | (mbit << 5) | vm;
}

/* VADDL/VADDW/VSUBL/VSUBW/VABAL/VABDL/VMLAL/VMLSL/VQDMLAL/VQDMLSL/
   VQDMULL -- Qd,Dn,Dm or Qd,Qn,Dm; see FAMILY_NEON_LONG in the
   mnemonic table for the param1 layout. */
static _kernel_oserror *encode_neon_long(assemble_context_t *context, const mnemonic_entry_t *entry,
                                          uint32_t cond, int s_flag,
                                          const uint8_t *text, size_t length, size_t pos,
                                          uint32_t *out_instr)
{
    neon_dt_t dt;
    uint32_t rd, rn, rm;
    uint8_t cd, cn, cm, vn_class;
    uint32_t vd, dbit, vn, nbit, vm, mbit, u, opcode4, size2;
    _kernel_oserror *error;

    (void) s_flag;
    if (cond != COND_AL) return error_neon_no_condition();

    error = parse_neon_dt(text, length, &pos, &dt);
    if (error != NULL) return error;
    if (dt.width == 64) return error_bad_datatype(); /* max source width is 32 */
    error = parse_neon_register(text, length, &pos, &rd, &cd);
    if (error != NULL) return error;
    if (cd != 'Q') return error_neon_mismatched_size();
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_neon_register(text, length, &pos, &rn, &cn);
    if (error != NULL) return error;
    vn_class = (entry->param1 & (1u << 6)) ? 'Q' : 'D';
    if (cn != vn_class) return error_neon_mismatched_size();
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;

    if ((entry->param1 & (1u << 7)) != 0 && peek_neon_scalar_operand(text, length, pos))
    {
        uint32_t reg, index, vmx_mbit, vmx_vm;

        error = parse_neon_scalar_operand(context, text, length, &pos, &reg, &index);
        if (error != NULL) return error;
        error = check_trailing(text, length, pos);
        if (error != NULL) return error;

        if (dt.kind == 'S') u = 0u;
        else if (dt.kind == 'U') u = 1u;
        else return error_bad_datatype();
        if (dt.width != 16 && dt.width != 32) return error_bad_datatype();
        error = neon_scalar_vmx(dt.width, reg, index, &vmx_mbit, &vmx_vm);
        if (error != NULL) return error;
        size2 = neon_dt_size2(dt.width);

        split_neon_register(rd, cd, &vd, &dbit);
        split_neon_register(rn, cn, &vn, &nbit);
        *out_instr = assemble_neon_by_scalar(u, dbit, size2, vn, vd, (entry->param1 >> 8) & 0xFu,
                                              nbit, vmx_mbit, vmx_vm);
        return NULL;
    }

    error = parse_neon_register(text, length, &pos, &rm, &cm);
    if (error != NULL) return error;
    if (cm != 'D') return error_neon_mismatched_size();
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    opcode4 = entry->param1 & 0xFu;
    if (entry->param1 & (1u << 4)) /* u_derived */
    {
        if (dt.kind == 'S') u = 0u;
        else if (dt.kind == 'U') u = 1u;
        else return error_bad_datatype();
    }
    else
    {
        if (dt.kind != 'S' && dt.kind != 0 && dt.kind != 'I') return error_bad_datatype();
        u = (entry->param1 >> 5) & 1u;
    }
    size2 = neon_dt_size2(dt.width);

    split_neon_register(rd, cd, &vd, &dbit);
    split_neon_register(rn, cn, &vn, &nbit);
    split_neon_register(rm, cm, &vm, &mbit);
    *out_instr = assemble_neon_long(u, dbit, size2, vn, vd, opcode4, nbit, mbit, vm);
    return NULL;
}

/* VMULL.<dt> Qd,Dn,Dm -- dedicated (rather than a FAMILY_NEON_LONG
   entry) because of the P8 special case: opcode/U/size are all fixed
   for polynomial multiply, rather than derived from an S/U dt. */
static _kernel_oserror *encode_neon_vmull(assemble_context_t *context, const mnemonic_entry_t *entry,
                                           uint32_t cond, int s_flag,
                                           const uint8_t *text, size_t length, size_t pos,
                                           uint32_t *out_instr)
{
    neon_dt_t dt;
    uint32_t rd, rn, rm;
    uint8_t cd, cn, cm;
    uint32_t vd, dbit, vn, nbit, vm, mbit, u, opcode4, size2;
    _kernel_oserror *error;

    (void) entry; (void) s_flag;
    if (cond != COND_AL) return error_neon_no_condition();

    error = parse_neon_dt(text, length, &pos, &dt);
    if (error != NULL) return error;
    error = parse_neon_register(text, length, &pos, &rd, &cd);
    if (error != NULL) return error;
    if (cd != 'Q') return error_neon_mismatched_size();
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_neon_register(text, length, &pos, &rn, &cn);
    if (error != NULL) return error;
    if (cn != 'D') return error_neon_mismatched_size();
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;

    /* The by-scalar form exists for S16/U16/S32/U32 but not P8. */
    if (dt.kind != 'P' && peek_neon_scalar_operand(text, length, pos))
    {
        uint32_t reg, index, vmx_mbit, vmx_vm;

        error = parse_neon_scalar_operand(context, text, length, &pos, &reg, &index);
        if (error != NULL) return error;
        error = check_trailing(text, length, pos);
        if (error != NULL) return error;

        if ((dt.kind != 'S' && dt.kind != 'U') || (dt.width != 16 && dt.width != 32)) return error_bad_datatype();
        u = (dt.kind == 'U') ? 1u : 0u;
        error = neon_scalar_vmx(dt.width, reg, index, &vmx_mbit, &vmx_vm);
        if (error != NULL) return error;
        size2 = neon_dt_size2(dt.width);

        split_neon_register(rd, cd, &vd, &dbit);
        split_neon_register(rn, cn, &vn, &nbit);
        *out_instr = assemble_neon_by_scalar(u, dbit, size2, vn, vd, 0xAu, nbit, vmx_mbit, vmx_vm);
        return NULL;
    }

    error = parse_neon_register(text, length, &pos, &rm, &cm);
    if (error != NULL) return error;
    if (cm != 'D') return error_neon_mismatched_size();
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    if (dt.kind == 'P')
    {
        if (dt.width != 8) return error_bad_datatype();
        u = 1u;
        size2 = 0u;
        opcode4 = 0xDu;
    }
    else
    {
        if ((dt.kind != 'S' && dt.kind != 'U') || dt.width == 64) return error_bad_datatype();
        u = (dt.kind == 'U') ? 1u : 0u;
        size2 = neon_dt_size2(dt.width);
        opcode4 = 0xCu;
    }

    split_neon_register(rd, cd, &vd, &dbit);
    split_neon_register(rn, cn, &vn, &nbit);
    split_neon_register(rm, cm, &vm, &mbit);
    *out_instr = assemble_neon_long(u, dbit, size2, vn, vd, opcode4, nbit, mbit, vm);
    return NULL;
}

/* VADDHN/VSUBHN/VRADDHN/VRSUBHN -- Dd,Qn,Qm (halving narrow: both
   sources wide, destination half width). Reuses assemble_neon_long
   (same word shape) with size1 = size - 1 in place of size, per
   VFPLib's own naming for this field. */
static _kernel_oserror *encode_neon_hn(assemble_context_t *context, const mnemonic_entry_t *entry,
                                        uint32_t cond, int s_flag,
                                        const uint8_t *text, size_t length, size_t pos,
                                        uint32_t *out_instr)
{
    neon_dt_t dt;
    uint32_t rd, rn, rm;
    uint8_t cd, cn, cm;
    uint32_t vd, dbit, vn, nbit, vm, mbit, size1;
    _kernel_oserror *error;

    (void) s_flag;
    if (cond != COND_AL) return error_neon_no_condition();

    error = parse_neon_dt(text, length, &pos, &dt);
    if (error != NULL) return error;
    if (dt.kind != 0 && dt.kind != 'I') return error_bad_datatype();
    if (dt.width != 16 && dt.width != 32 && dt.width != 64) return error_bad_datatype();
    error = parse_neon_register(text, length, &pos, &rd, &cd);
    if (error != NULL) return error;
    if (cd != 'D') return error_neon_mismatched_size();
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_neon_register(text, length, &pos, &rn, &cn);
    if (error != NULL) return error;
    if (cn != 'Q') return error_neon_mismatched_size();
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_neon_register(text, length, &pos, &rm, &cm);
    if (error != NULL) return error;
    if (cm != 'Q') return error_neon_mismatched_size();
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    size1 = neon_dt_size2(dt.width) - 1u;

    split_neon_register(rd, cd, &vd, &dbit);
    split_neon_register(rn, cn, &vn, &nbit);
    split_neon_register(rm, cm, &vm, &mbit);
    *out_instr = assemble_neon_long(entry->param1 & 1u, dbit, size1, vn, vd, (entry->param1 >> 1) & 0xFu,
                                     nbit, mbit, vm);
    return NULL;
}

/* VMOVL.<dt> Qd,Dm -- widening move. Uses a 3-bit imm3 size marker
   (1<<size_class) rather than the 2-bit size field the rest of this
   family uses, and bit4 is fixed 1 rather than 0, so this doesn't
   reuse assemble_neon_long. */
static _kernel_oserror *encode_neon_vmovl(assemble_context_t *context, const mnemonic_entry_t *entry,
                                           uint32_t cond, int s_flag,
                                           const uint8_t *text, size_t length, size_t pos,
                                           uint32_t *out_instr)
{
    neon_dt_t dt;
    uint32_t rd, rm;
    uint8_t cd, cm;
    uint32_t vd, dbit, vm, mbit, u, imm3;
    _kernel_oserror *error;

    (void) entry; (void) s_flag;
    if (cond != COND_AL) return error_neon_no_condition();

    error = parse_neon_dt(text, length, &pos, &dt);
    if (error != NULL) return error;
    if (dt.width != 8 && dt.width != 16 && dt.width != 32) return error_bad_datatype();
    error = parse_neon_register(text, length, &pos, &rd, &cd);
    if (error != NULL) return error;
    if (cd != 'Q') return error_neon_mismatched_size();
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_neon_register(text, length, &pos, &rm, &cm);
    if (error != NULL) return error;
    if (cm != 'D') return error_neon_mismatched_size();
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    if (dt.kind == 'S') u = 0u;
    else if (dt.kind == 'U') u = 1u;
    else return error_bad_datatype();
    imm3 = 1u << neon_dt_size2(dt.width);

    split_neon_register(rd, cd, &vd, &dbit);
    split_neon_register(rm, cm, &vm, &mbit);
    *out_instr = 0xF2800A10u | (u << 24) | (dbit << 22) | (imm3 << 19) | (vd << 12) | (mbit << 5) | vm;
    return NULL;
}

/* VMOVN.<dt> Dd,Qm -- narrowing move (truncate). */
static _kernel_oserror *encode_neon_vmovn(assemble_context_t *context, const mnemonic_entry_t *entry,
                                           uint32_t cond, int s_flag,
                                           const uint8_t *text, size_t length, size_t pos,
                                           uint32_t *out_instr)
{
    neon_dt_t dt;
    uint32_t rd, rm;
    uint8_t cd, cm;
    uint32_t vd, dbit, vm, mbit, size1;
    _kernel_oserror *error;

    (void) entry; (void) s_flag;
    if (cond != COND_AL) return error_neon_no_condition();

    error = parse_neon_dt(text, length, &pos, &dt);
    if (error != NULL) return error;
    if (dt.kind != 0 && dt.kind != 'I') return error_bad_datatype();
    if (dt.width != 16 && dt.width != 32 && dt.width != 64) return error_bad_datatype();
    error = parse_neon_register(text, length, &pos, &rd, &cd);
    if (error != NULL) return error;
    if (cd != 'D') return error_neon_mismatched_size();
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_neon_register(text, length, &pos, &rm, &cm);
    if (error != NULL) return error;
    if (cm != 'Q') return error_neon_mismatched_size();
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    size1 = neon_dt_size2(dt.width) - 1u;
    split_neon_register(rd, cd, &vd, &dbit);
    split_neon_register(rm, cm, &vm, &mbit);
    *out_instr = 0xF3B20200u | (dbit << 22) | (size1 << 18) | (vd << 12) | (mbit << 5) | vm;
    return NULL;
}

/* VQMOVN/VQMOVUN.<dt> Dd,Qm -- narrowing saturating move. The 2-bit
   op field selects the sign combination: %10/%11 for VQMOVN (signed or
   unsigned source and destination, same sign), %01 for VQMOVUN
   (signed source, unsigned saturated destination). */
static _kernel_oserror *encode_neon_qmovn(assemble_context_t *context, const mnemonic_entry_t *entry,
                                           uint32_t cond, int s_flag,
                                           const uint8_t *text, size_t length, size_t pos,
                                           uint32_t *out_instr)
{
    neon_dt_t dt;
    uint32_t rd, rm;
    uint8_t cd, cm;
    uint32_t vd, dbit, vm, mbit, size1, op2;
    _kernel_oserror *error;

    (void) s_flag;
    if (cond != COND_AL) return error_neon_no_condition();

    error = parse_neon_dt(text, length, &pos, &dt);
    if (error != NULL) return error;
    if (dt.width != 16 && dt.width != 32 && dt.width != 64) return error_bad_datatype();
    error = parse_neon_register(text, length, &pos, &rd, &cd);
    if (error != NULL) return error;
    if (cd != 'D') return error_neon_mismatched_size();
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_neon_register(text, length, &pos, &rm, &cm);
    if (error != NULL) return error;
    if (cm != 'Q') return error_neon_mismatched_size();
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    if (entry->param1 == 0u) /* VQMOVN: sign-derived */
    {
        if (dt.kind == 'S') op2 = 2u;
        else if (dt.kind == 'U') op2 = 3u;
        else return error_bad_datatype();
    }
    else /* VQMOVUN: fixed */
    {
        if (dt.kind != 'S') return error_bad_datatype();
        op2 = 1u;
    }

    size1 = neon_dt_size2(dt.width) - 1u;
    split_neon_register(rd, cd, &vd, &dbit);
    split_neon_register(rm, cm, &vm, &mbit);
    *out_instr = 0xF3B20200u | (dbit << 22) | (size1 << 18) | (vd << 12) | (op2 << 6) | (mbit << 5) | vm;
    return NULL;
}

/* VPADAL/VPADDL.<dt> {Dd|Qd},{Dm|Qm} -- pairwise add (accumulate, for
   VPADAL). entry->param1 holds the full fixed-bit skeleton (the two
   mnemonics differ only in opcode). */
static _kernel_oserror *encode_neon_padal(assemble_context_t *context, const mnemonic_entry_t *entry,
                                           uint32_t cond, int s_flag,
                                           const uint8_t *text, size_t length, size_t pos,
                                           uint32_t *out_instr)
{
    neon_dt_t dt;
    uint32_t rd, rm;
    uint8_t cd, cm;
    uint32_t vd, dbit, vm, mbit, q, u, size2;
    _kernel_oserror *error;

    (void) s_flag;
    if (cond != COND_AL) return error_neon_no_condition();

    error = parse_neon_dt(text, length, &pos, &dt);
    if (error != NULL) return error;
    if (dt.width == 64) return error_bad_datatype();
    error = parse_neon_register(text, length, &pos, &rd, &cd);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_neon_register(text, length, &pos, &rm, &cm);
    if (error != NULL) return error;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;
    if (cd != cm) return error_neon_mismatched_size();
    q = (cd == 'Q') ? 1u : 0u;

    if (dt.kind == 'S') u = 0u;
    else if (dt.kind == 'U') u = 1u;
    else return error_bad_datatype();
    size2 = neon_dt_size2(dt.width);

    split_neon_register(rd, cd, &vd, &dbit);
    split_neon_register(rm, cm, &vm, &mbit);
    *out_instr = entry->param1 | (dbit << 22) | (size2 << 18) | (vd << 12) | (u << 7) | (q << 6) | (mbit << 5) | vm;
    return NULL;
}

/* VMOV/VMVN (immediate) -- {Dd|Qd},#imm, where the datatype selects
   how the immediate's bit pattern is derived (I8: replicated per
   byte; I16: per halfword; I32: taken directly), and VMVN loads the
   bitwise complement of the resulting pattern. VFPLib determines the
   specific cmode/imm8 encoding by decomposing the (possibly
   already-replicated) 32-bit value into 4 bytes and matching against
   a fixed set of shapes -- ported directly from its byte-decompose
   logic (VFPLib/VFPLib DEF FNvfp_parseop, the "#c" 32-bit immediate
   case) rather than deriving cmode from dt alone, since dt alone
   doesn't determine it (eg I32 #0x00004200 uses the same "halfword,
   byte 1" shape as I16 #0x42). Deliberately not supported: I64
   (per-bit expansion) and F32 (floating-point immediate) datatypes,
   and the "ones-fill" cmode 1100/1101 shapes -- VFPLib's own opcmode
   restriction lists for VMOV/VMVN specifically never reach either
   (they're reachable from VORR/VBIC instead, not implemented here),
   so there is nothing to port for these two mnemonics. Likewise,
   VFPLib's own restriction list for VMVN never reaches the per-byte
   cmode 1110 (its byte-decompose code hardcodes op=0 for that shape,
   which never matches VMVN's all-op=1 restriction list), so a
   uniform-byte VMVN immediate is rejected here exactly as it would be
   by VFPLib itself, not because of a gap in this port. */
static _kernel_oserror *encode_neon_mov_mvn_imm_impl(assemble_context_t *context, uint32_t cond, int is_mvn,
                                                       const uint8_t *text, size_t length, size_t pos,
                                                       uint32_t *out_instr)
{
    neon_dt_t dt;
    uint32_t rd;
    uint8_t cd;
    assemble_value_t value;
    size_t consumed;
    uint32_t raw, b0, b1, b2, b3, imm, cmode, op, q, vd, dbit;
    _kernel_oserror *error;

    if (cond != COND_AL) return error_neon_no_condition();

    error = parse_neon_dt(text, length, &pos, &dt);
    if (error != NULL) return error;
    if (dt.width != 8 && dt.width != 16 && dt.width != 32) return error_bad_datatype();
    error = parse_neon_register(text, length, &pos, &rd, &cd);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, '#');
    if (error != NULL) return error;
    error = eval_expr(context, text + pos, length - pos, &value, &consumed);
    if (error != NULL) return error;
    pos += consumed;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;
    q = (cd == 'Q') ? 1u : 0u;

    raw = (uint32_t) value_to_integer(&value);
    if (dt.width == 8)
    {
        raw &= 0xFFu;
        raw = raw | (raw << 8) | (raw << 16) | (raw << 24);
    }
    else if (dt.width == 16)
    {
        raw &= 0xFFFFu;
        raw = raw | (raw << 16);
    }

    b0 = raw & 0xFFu;
    b1 = (raw >> 8) & 0xFFu;
    b2 = (raw >> 16) & 0xFFu;
    b3 = (raw >> 24) & 0xFFu;

    if (b3 == 0 && b2 == 0 && b1 == 0) { cmode = 0x0u; imm = b0; }
    else if (b3 == 0 && b2 == 0 && b1 != 0 && b0 == 0) { cmode = 0x2u; imm = b1; }
    else if (b3 == 0 && b2 != 0 && b1 == 0 && b0 == 0) { cmode = 0x4u; imm = b2; }
    else if (b3 != 0 && b2 == 0 && b1 == 0 && b0 == 0) { cmode = 0x6u; imm = b3; }
    else if (b3 == 0 && b1 == 0 && b2 == b0 && b0 != 0) { cmode = 0x8u; imm = b0; }
    else if (b2 == 0 && b0 == 0 && b3 == b1 && b1 != 0) { cmode = 0xAu; imm = b1; }
    else if (!is_mvn && b3 == b2 && b2 == b1 && b1 == b0 && b0 != 0) { cmode = 0xEu; imm = b0; }
    else
    {
        return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_RANGE, ASSEMBLE_ARM32_ERR_NONE,
                                   "Immediate cannot be encoded (unsupported bit pattern for this dt)");
    }
    op = is_mvn ? 1u : 0u;

    split_neon_register(rd, cd, &vd, &dbit);
    *out_instr = assemble_neon_shift_imm((imm >> 7) & 1u, dbit, (imm >> 4) & 0x7u, vd, cmode, 0u, q, op, imm & 0xFu);
    return NULL;
}

/* VDUP{cond}.<size> {Dd|Qd},Dm[x] (scalar, unconditional) or
   VDUP{cond}.<size> {Dd|Qd},Rt (from an ARM core register,
   conditional -- an older, structurally different encoding entirely,
   sharing this root only because BASIC syntax-wise both are spelled
   "VDUP"). */
static _kernel_oserror *encode_neon_vdup(assemble_context_t *context, const mnemonic_entry_t *entry,
                                          uint32_t cond, int s_flag,
                                          const uint8_t *text, size_t length, size_t pos,
                                          uint32_t *out_instr)
{
    neon_dt_t dt;
    uint32_t rd;
    uint8_t cd;
    _kernel_oserror *error;

    (void) entry; (void) s_flag;

    error = parse_neon_dt(text, length, &pos, &dt);
    if (error != NULL) return error;
    if (dt.width != 8 && dt.width != 16 && dt.width != 32) return error_bad_datatype();
    error = parse_neon_register(text, length, &pos, &rd, &cd);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;

    if (peek_neon_scalar_operand(text, length, pos))
    {
        static const uint32_t MAXINDEX[3] = { 7u, 3u, 1u }; /* per size_class 8/16/32 */
        uint32_t reg, index, vd, dbit, vm, mbit, q, imm4, size_class;

        if (cond != COND_AL) return error_neon_no_condition();
        error = parse_neon_scalar_operand(context, text, length, &pos, &reg, &index);
        if (error != NULL) return error;
        error = check_trailing(text, length, pos);
        if (error != NULL) return error;
        q = (cd == 'Q') ? 1u : 0u;

        size_class = neon_dt_size2(dt.width);
        if (index > MAXINDEX[size_class]) return error_bad_datatype();
        imm4 = (index << (size_class + 1u)) | (1u << size_class);

        split_neon_register(rd, cd, &vd, &dbit);
        split_neon_register(reg, 'D', &vm, &mbit);
        *out_instr = 0xF3B00C00u | (dbit << 22) | (imm4 << 16) | (vd << 12) | (q << 6) | (mbit << 5) | vm;
        return NULL;
    }
    else
    {
        uint32_t rt, vd, dbit, q, esize;

        error = parse_register(context, text, length, &pos, &rt);
        if (error != NULL) return error;
        error = check_trailing(text, length, pos);
        if (error != NULL) return error;
        q = (cd == 'Q') ? 1u : 0u;

        esize = neon_dt_size2(dt.width);
        split_neon_register(rd, cd, &vd, &dbit);
        *out_instr = (cond << 28) | 0x0E800B10u | (((esize >> 1) & 1u) << 22) | (q << 21) | (vd << 16) |
                     (rt << 12) | (dbit << 7) | ((esize & 1u) << 5);
        return NULL;
    }
}

/* VEXT.<size> {Dd|Qd},{Dn|Qn},{Dm|Qm},#imm -- extract a byte-aligned
   window across a register pair. The immediate is specified in
   dt-sized elements but encoded as a byte offset (0-7 for Dd, 0-15
   for Qd). */
static _kernel_oserror *encode_neon_vext(assemble_context_t *context, const mnemonic_entry_t *entry,
                                          uint32_t cond, int s_flag,
                                          const uint8_t *text, size_t length, size_t pos,
                                          uint32_t *out_instr)
{
    neon_dt_t dt;
    uint32_t rd, rn, rm;
    uint8_t cd, cn, cm;
    assemble_value_t value;
    size_t consumed;
    int32_t index;
    uint32_t vd, dbit, vn, nbit, vm, mbit, q, byte_offset, max_offset;
    _kernel_oserror *error;

    (void) entry; (void) s_flag;
    if (cond != COND_AL) return error_neon_no_condition();

    error = parse_neon_dt(text, length, &pos, &dt);
    if (error != NULL) return error;
    if (dt.width != 8 && dt.width != 16 && dt.width != 32 && dt.width != 64) return error_bad_datatype();
    error = parse_neon_register(text, length, &pos, &rd, &cd);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_neon_register(text, length, &pos, &rn, &cn);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_neon_register(text, length, &pos, &rm, &cm);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, '#');
    if (error != NULL) return error;
    error = eval_expr(context, text + pos, length - pos, &value, &consumed);
    if (error != NULL) return error;
    pos += consumed;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;
    if (cd != cn || cd != cm) return error_neon_mismatched_size();
    q = (cd == 'Q') ? 1u : 0u;

    index = value_to_integer(&value);
    max_offset = q ? 15u : 7u;
    if (index < 0) return error_bad_shift();
    byte_offset = ((uint32_t) index) << (dt.width == 8 ? 0 : (dt.width == 16 ? 1 : (dt.width == 32 ? 2 : 3)));
    if (byte_offset > max_offset) return error_bad_shift();

    split_neon_register(rd, cd, &vd, &dbit);
    split_neon_register(rn, cn, &vn, &nbit);
    split_neon_register(rm, cm, &vm, &mbit);
    *out_instr = 0xF2B00000u | (dbit << 22) | (vn << 16) | (vd << 12) | (byte_offset << 8) | (nbit << 7) |
                 (q << 6) | (mbit << 5) | vm;
    return NULL;
}

/* VTBL/VTBX Dd,(register list),Dm -- table lookup (VTBL) or extend
   (VTBX, keeping unmatched destination lanes rather than zeroing
   them). The register list is a parenthesised, comma-separated run of
   1-4 consecutive D registers, eg "(D1,D2,D3)"; a "-" range spelling
   like "(D1-D3)" is also accepted, matching real syntax. */
static _kernel_oserror *encode_neon_tbl(assemble_context_t *context, const mnemonic_entry_t *entry,
                                         uint32_t cond, int s_flag,
                                         const uint8_t *text, size_t length, size_t pos,
                                         uint32_t *out_instr)
{
    uint32_t rd, rn, rm, rn_last;
    uint8_t cd, cn, cm, cn_last;
    uint32_t vd, dbit, vn, nbit, vm, mbit, len;
    _kernel_oserror *error;

    (void) s_flag;
    if (cond != COND_AL) return error_neon_no_condition();

    if (pos < length && text[pos] == '.')
    {
        neon_dt_t dt;

        error = parse_neon_dt(text, length, &pos, &dt);
        if (error != NULL) return error;
        if (dt.width != 8) return error_bad_datatype();
    }
    error = parse_neon_register(text, length, &pos, &rd, &cd);
    if (error != NULL) return error;
    if (cd != 'D') return error_neon_mismatched_size();
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, '(');
    if (error != NULL) return error;
    error = parse_neon_register(text, length, &pos, &rn, &cn);
    if (error != NULL) return error;
    if (cn != 'D') return error_neon_mismatched_size();

    len = 0u;
    rn_last = rn;
    cn_last = cn;
    while (1)
    {
        size_t peek = pos;

        peek += assemble_skip_spaces(text + peek, length - peek);
        if (peek < length && (text[peek] == ',' || text[peek] == '-'))
        {
            peek += 1;
            error = parse_neon_register(text, length, &peek, &rn_last, &cn_last);
            if (error != NULL) return error;
            if (cn_last != 'D' || rn_last != rn + len + 1u)
            {
                return error_bad_register_list("VTBL/VTBX register list must be consecutive D registers");
            }
            len += 1u;
            pos = peek;
            if (len > 3u) return error_bad_register_list("VTBL/VTBX register list can contain at most 4 registers");
        }
        else
        {
            break;
        }
    }
    error = expect_char(text, length, &pos, ')');
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_neon_register(text, length, &pos, &rm, &cm);
    if (error != NULL) return error;
    if (cm != 'D') return error_neon_mismatched_size();
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    split_neon_register(rd, cd, &vd, &dbit);
    split_neon_register(rn, cn, &vn, &nbit);
    split_neon_register(rm, cm, &vm, &mbit);
    *out_instr = 0xF3B00800u | (dbit << 22) | (vn << 16) | (vd << 12) | (len << 8) | (nbit << 7) |
                 ((uint32_t) entry->param1 << 6) | (mbit << 5) | vm;
    return NULL;
}

/* ---------------------------------------------------------------
 * NEON/Advanced SIMD -- structure load/store, "multiple" form only
 * (ARM DDI 0406C A7.7/A7.9). This is one of three quite different
 * addressing shapes VLD1-4/VST1-4 support (the others being "single
 * lane" and "single all lanes"/replicate, neither implemented here --
 * see AGENTS.md); "multiple" transfers a run of 1-4 D registers as a
 * sequential (or, for VLD2/VLD3/VLD4, de-interleaved) block, and uses
 * a much more regular encoding than the other two forms (a plain
 * 4-bit "type" field and 2-bit size/align fields, no bit-interleaved
 * lane index).
 * --------------------------------------------------------------- */

/* Parses "[Rn{@align}]{!}{,Rm}". out_vm is the resulting Vm field
   value: 0xD (writeback by the transfer size, ie "!" was given with
   no explicit Rm), 0xF (no writeback), or the parsed Rm register
   number. out_align is the raw requested alignment in bits (0 if no
   "@" was given) -- validating and encoding it is the caller's job,
   since which alignments are legal depends on the register count. */
static _kernel_oserror *parse_neon_ldst_address(assemble_context_t *context, const uint8_t *text, size_t length,
                                                 size_t *pos_inout, uint32_t *out_rn, uint32_t *out_align,
                                                 uint32_t *out_vm)
{
    size_t pos = *pos_inout;
    uint32_t rn, align = 0u, vm;
    _kernel_oserror *error;

    error = expect_char(text, length, &pos, '[');
    if (error != NULL) return error;
    error = parse_register(context, text, length, &pos, &rn);
    if (error != NULL) return error;
    pos += assemble_skip_spaces(text + pos, length - pos);
    if (pos < length && text[pos] == '@')
    {
        assemble_value_t value;
        size_t consumed;

        pos += 1;
        error = eval_expr(context, text + pos, length - pos, &value, &consumed);
        if (error != NULL) return error;
        pos += consumed;
        align = (uint32_t) value_to_integer(&value);
        pos += assemble_skip_spaces(text + pos, length - pos);
    }
    error = expect_char(text, length, &pos, ']');
    if (error != NULL) return error;

    pos += assemble_skip_spaces(text + pos, length - pos);
    if (pos < length && text[pos] == '!')
    {
        pos += 1;
        vm = 0xDu;
    }
    else if (pos < length && text[pos] == ',')
    {
        pos += 1;
        error = parse_register(context, text, length, &pos, &vm);
        if (error != NULL) return error;
    }
    else
    {
        vm = 0xFu;
    }

    *out_rn = rn;
    *out_align = align;
    *out_vm = vm;
    *pos_inout = pos;
    return NULL;
}

/* Parses "(Dd{,|-}Dd+gap{,|-}...)", 1-4 D registers with a consistent
   gap of 1 (consecutive) or 2 (the "widely spaced" VLD2/VLD3/VLD4
   forms that de-interleave into every other register). */
static _kernel_oserror *parse_neon_reglist_gap(const uint8_t *text, size_t length, size_t *pos_inout,
                                                uint32_t *out_base, uint32_t *out_count, uint32_t *out_gap)
{
    size_t pos = *pos_inout;
    uint32_t base, count, gap, prev, cur;
    uint8_t regclass;
    _kernel_oserror *error;

    error = expect_char(text, length, &pos, '(');
    if (error != NULL) return error;
    error = parse_neon_register(text, length, &pos, &base, &regclass);
    if (error != NULL) return error;
    if (regclass != 'D') return error_neon_mismatched_size();
    count = 1u;
    gap = 1u;
    prev = base;

    while (1)
    {
        size_t peek = pos;

        peek += assemble_skip_spaces(text + peek, length - peek);
        if (peek < length && (text[peek] == ',' || text[peek] == '-'))
        {
            peek += 1;
            error = parse_neon_register(text, length, &peek, &cur, &regclass);
            if (error != NULL) return error;
            if (regclass != 'D') return error_neon_mismatched_size();
            if (count == 1u)
            {
                if (cur <= prev) return error_bad_register_list("Register list must be ascending");
                gap = cur - prev;
                if (gap != 1u && gap != 2u)
                {
                    return error_bad_register_list("Register list must have a gap of 1 or 2");
                }
            }
            else if (cur != prev + gap)
            {
                return error_bad_register_list("Register list must use a consistent gap");
            }
            prev = cur;
            count += 1u;
            pos = peek;
            if (count > 4u) return error_bad_register_list("Register list can contain at most 4 registers");
        }
        else
        {
            break;
        }
    }
    error = expect_char(text, length, &pos, ')');
    if (error != NULL) return error;

    *out_base = base;
    *out_count = count;
    *out_gap = gap;
    *pos_inout = pos;
    return NULL;
}

/* VLD1/VLD2/VLD3/VLD4/VST1/VST2/VST3/VST4 (register list),[Rn{@align}]
   {!}{,Rm} -- "multiple" structure load/store. entry->param1: bit0=
   is_load, bits2:1=struct_class (0=VLD1/VST1 .. 3=VLD4/VST4); see
   FAMILY_NEON_LDST_MULTIPLE in the mnemonic table. */
static _kernel_oserror *encode_neon_ldst_multiple(assemble_context_t *context, const mnemonic_entry_t *entry,
                                                    uint32_t cond, int s_flag,
                                                    const uint8_t *text, size_t length, size_t pos,
                                                    uint32_t *out_instr)
{
    /* [struct_class][slot] = { count, gap, type }; type 0xFF marks an unused slot. */
    static const uint32_t TYPES[4][4][3] =
    {
        { { 1u, 1u, 0x7u }, { 2u, 1u, 0xAu }, { 3u, 1u, 0x6u }, { 4u, 1u, 0x2u } }, /* VLD1/VST1 */
        { { 2u, 1u, 0x8u }, { 2u, 2u, 0x9u }, { 4u, 1u, 0x3u }, { 0u, 0u, 0xFFu } }, /* VLD2/VST2 */
        { { 3u, 1u, 0x4u }, { 3u, 2u, 0x5u }, { 0u, 0u, 0xFFu }, { 0u, 0u, 0xFFu } }, /* VLD3/VST3 */
        { { 4u, 1u, 0x0u }, { 4u, 2u, 0x1u }, { 0u, 0u, 0xFFu }, { 0u, 0u, 0xFFu } }  /* VLD4/VST4 */
    };
    neon_dt_t dt;
    uint32_t base = 0u, count = 0u, gap = 0u;
    uint32_t rn, align_req, vm_field;
    uint32_t struct_class, is_load, type, align_code, size2, vd, dbit;
    uint32_t i;
    _kernel_oserror *error;

    (void) s_flag;
    if (cond != COND_AL) return error_neon_no_condition();

    error = parse_neon_dt(text, length, &pos, &dt);
    if (error != NULL) return error;
    if (dt.width != 8 && dt.width != 16 && dt.width != 32 && dt.width != 64) return error_bad_datatype();
    error = parse_neon_reglist_gap(text, length, &pos, &base, &count, &gap);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_neon_ldst_address(context, text, length, &pos, &rn, &align_req, &vm_field);
    if (error != NULL) return error;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    is_load = entry->param1 & 1u;
    struct_class = (entry->param1 >> 1) & 3u;

    type = 0xFFu;
    for (i = 0u; i < 4u; i++)
    {
        if (TYPES[struct_class][i][0] == count && TYPES[struct_class][i][1] == gap)
        {
            type = TYPES[struct_class][i][2];
            break;
        }
    }
    if (type == 0xFFu)
    {
        return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_BAD_OPERAND, ASSEMBLE_ARM32_ERR_NONE,
                                   "Unsupported register list shape for this mnemonic");
    }

    align_code = 0u;
    if (align_req != 0u)
    {
        int allow_256 = (struct_class == 3u) || (struct_class == 0u && count == 4u) ||
                         (struct_class == 1u && count == 4u);
        int allow_128 = allow_256 || (struct_class == 0u && count == 2u) || (struct_class == 1u && count != 4u);

        if (align_req == 64u) align_code = 1u;
        else if (align_req == 128u && allow_128) align_code = 2u;
        else if (align_req == 256u && allow_256) align_code = 3u;
        else return error_bad_datatype();
    }

    size2 = neon_dt_size2(dt.width);
    split_neon_register(base, 'D', &vd, &dbit);

    *out_instr = (is_load ? 0xF4200000u : 0xF4000000u) | (dbit << 22) | (rn << 16) | (vd << 12) |
                 (type << 8) | (size2 << 6) | (align_code << 4) | vm_field;
    return NULL;
}

/* ---------------------------------------------------------------
 * ARMv8-only VFP/NEON additions: VMAXNM/VMINNM, VSEL, the VRINT*
 * directed-rounding family and VCVTA/N/P/M (float-to-integer,
 * directed rounding), plus VCVTB/VCVTT (half-precision). General
 * VCVT (the plain integer/fixed-point/half-precision forms other
 * than VCVTB/VCVTT) remains a deliberate gap -- see the comment
 * above the classic VFP scalar section, near parse_vfp_register.
 * --------------------------------------------------------------- */

/* VMAXNM/VMINNM -- {S|D}d,{S|D}n,{S|D}m (VFP scalar, F32/F64, ARMv8
   "A2" encoding -- unconditional, not the classic conditional VFP
   shape) or Dd/Qd,Dn/Qn,Dm/Qm (NEON "A1" encoding, F32 only,
   unconditional). A D-register operand is ambiguous between the two
   (VFP's F64 form and NEON's F32 form both use D registers), so this
   dispatches on the parsed datatype/register shape exactly like
   FAMILY_VFP_OR_NEON_ARITH3's encode_vfp_or_neon_arith3. Both forms
   use "op" (entry->param1: 0=MAX, 1=MIN) with the same polarity. */
static _kernel_oserror *encode_vfp_or_neon_maxnm(assemble_context_t *context, const mnemonic_entry_t *entry,
                                                  uint32_t cond, int s_flag,
                                                  const uint8_t *text, size_t length, size_t pos,
                                                  uint32_t *out_instr)
{
    size_t peek_pos = pos;
    uint8_t regclass;
    neon_dt_t dt;
    uint32_t rd, rn, rm;
    uint8_t cd, cn, cm;
    uint32_t vd, dbit, vn, nbit, vm, mbit, q;
    _kernel_oserror *error;

    (void) s_flag;
    if (cond != COND_AL) return error_neon_no_condition();

    error = parse_neon_dt(text, length, &peek_pos, &dt);
    if (error != NULL) return error;
    if (dt.kind != 'F' || (dt.width != 32 && dt.width != 64)) return error_bad_datatype();
    regclass = peek_neon_reg_class(text, length, peek_pos);

    if (regclass == 'S' || (regclass == 'D' && dt.width == 64))
    {
        uint32_t sz = (dt.width == 64) ? 1u : 0u;
        int is_double;
        uint32_t vfpvd, vfpdd, vfpvn, vfpdn, vfpvm, vfpdm;

        pos = peek_pos;
        error = parse_vfp_register(context, text, length, &pos, &rd, &is_double);
        if (error != NULL) return error;
        if (is_double != (int) sz) return error_vfp_mismatched_precision();
        error = expect_char(text, length, &pos, ',');
        if (error != NULL) return error;
        error = parse_vfp_register(context, text, length, &pos, &rn, &is_double);
        if (error != NULL) return error;
        if (is_double != (int) sz) return error_vfp_mismatched_precision();
        error = expect_char(text, length, &pos, ',');
        if (error != NULL) return error;
        error = parse_vfp_register(context, text, length, &pos, &rm, &is_double);
        if (error != NULL) return error;
        if (is_double != (int) sz) return error_vfp_mismatched_precision();
        error = check_trailing(text, length, pos);
        if (error != NULL) return error;

        split_vfp_register(rd, (int) sz, &vfpvd, &vfpdd);
        split_vfp_register(rn, (int) sz, &vfpvn, &vfpdn);
        split_vfp_register(rm, (int) sz, &vfpvm, &vfpdm);
        *out_instr = 0xFE800A00u | (vfpdd << 22) | (vfpvn << 16) | (vfpvd << 12) | (sz << 8) |
                     (vfpdn << 7) | (entry->param1 << 6) | (vfpdm << 5) | vfpvm;
        return NULL;
    }

    if (dt.width != 32) return error_bad_datatype();
    pos = peek_pos;
    error = parse_neon_register(text, length, &pos, &rd, &cd);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_neon_register(text, length, &pos, &rn, &cn);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_neon_register(text, length, &pos, &rm, &cm);
    if (error != NULL) return error;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;
    if (cd != cn || cd != cm) return error_neon_mismatched_size();
    q = (cd == 'Q') ? 1u : 0u;

    split_neon_register(rn, cn, &vn, &nbit);
    split_neon_register(rd, cd, &vd, &dbit);
    split_neon_register(rm, cm, &vm, &mbit);
    *out_instr = assemble_neon_three_same(1u, dbit, entry->param1, 0u, vn, vd, 0xFu, nbit, q, mbit, 1u, vm);
    return NULL;
}

/* VSELEQ/VSELGE/VSELGT/VSELVS -- {S|D}d,{S|D}n,{S|D}m (ARMv8, VFP
   scalar only, unconditional). The EQ/GE/GT/VS suffix selects which
   APSR condition steers the run-time select and is encoded in a 2-bit
   "cc" field -- it is not an ordinary condition-code suffix (VSEL is
   always executed), so each combination is its own literal mnemonic
   root with allows_cond=0 rather than going through the usual
   root+cond grammar. entry->param1 is the 2-bit cc field. */
static _kernel_oserror *encode_vfp_sel(assemble_context_t *context, const mnemonic_entry_t *entry,
                                        uint32_t cond, int s_flag,
                                        const uint8_t *text, size_t length, size_t pos,
                                        uint32_t *out_instr)
{
    uint32_t sz, rd, rn, rm, vd, dd, vn, dn, vm, dm;
    int is_double;
    _kernel_oserror *error;

    (void) cond; (void) s_flag;
    error = parse_vfp_datatype(text, length, &pos, &sz);
    if (error != NULL) return error;
    error = parse_vfp_register(context, text, length, &pos, &rd, &is_double);
    if (error != NULL) return error;
    if (is_double != (int) sz) return error_vfp_mismatched_precision();
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_vfp_register(context, text, length, &pos, &rn, &is_double);
    if (error != NULL) return error;
    if (is_double != (int) sz) return error_vfp_mismatched_precision();
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_vfp_register(context, text, length, &pos, &rm, &is_double);
    if (error != NULL) return error;
    if (is_double != (int) sz) return error_vfp_mismatched_precision();
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    split_vfp_register(rd, (int) sz, &vd, &dd);
    split_vfp_register(rn, (int) sz, &vn, &dn);
    split_vfp_register(rm, (int) sz, &vm, &dm);

    *out_instr = 0xFE000A00u | (dd << 22) | (entry->param1 << 20) | (vn << 16) | (vd << 12) | (sz << 8) |
                 (dn << 7) | (dm << 5) | vm;
    return NULL;
}

/* VRINTR/VRINTZ/VRINTX (VFP scalar, legacy conditional shape -- these
   three, uniquely among this group, genuinely support a condition
   code) and VRINTA/VRINTN/VRINTP/VRINTM (VFP scalar, ARMv8
   unconditional-only shape) all also have a NEON Dd/Qd,Dm/Qm F32 form
   (VRINTR is the only one that doesn't); dispatch on the parsed
   datatype/register shape, same technique as encode_vfp_or_neon_maxnm
   above. Syntax doubles the dt tag for every scalar form here (eg
   "VRINTA.F32.F32 Sd,Sm", "VRINTZ.F64.F64 Dd,Dm") -- this mirrors the
   real UAL assembly syntax for these mnemonics, confirmed against
   VFPLib's own lookup table, not a guess.
   entry->param1: bits7:4 = scalar shape (0=VRINTR/Z, 1=VRINTX,
   2=VRINTA/N/P/M), bits3:0 = op (shape 0) or rm (shape 2), unused for
   shape 1. entry->param2: NEON "op" field (0-7), or 0xFFFFFFFFu if
   this mnemonic has no NEON form (VRINTR only). */
static _kernel_oserror *encode_vfp_or_neon_rint(assemble_context_t *context, const mnemonic_entry_t *entry,
                                                 uint32_t cond, int s_flag,
                                                 const uint8_t *text, size_t length, size_t pos,
                                                 uint32_t *out_instr)
{
    size_t peek_pos = pos;
    uint8_t regclass;
    neon_dt_t dt1, dt2;
    uint32_t shape, val;
    _kernel_oserror *error;

    (void) context; (void) s_flag;
    shape = (entry->param1 >> 4) & 0xFu;
    val = entry->param1 & 0xFu;

    error = parse_neon_dt(text, length, &peek_pos, &dt1);
    if (error != NULL) return error;
    error = parse_neon_dt(text, length, &peek_pos, &dt2);
    if (error != NULL) return error;
    if (dt1.kind != 'F' || dt2.kind != 'F' || dt1.width != dt2.width) return error_bad_datatype();
    if (dt1.width != 32 && dt1.width != 64) return error_bad_datatype();
    regclass = peek_neon_reg_class(text, length, peek_pos);

    if (regclass == 'S' || (regclass == 'D' && dt1.width == 64))
    {
        uint32_t sz, rd, rm_reg, vd, dd, vm, dm;
        int is_double;

        sz = (dt1.width == 64) ? 1u : 0u;
        pos = peek_pos;
        error = parse_vfp_register(context, text, length, &pos, &rd, &is_double);
        if (error != NULL) return error;
        if (is_double != (int) sz) return error_vfp_mismatched_precision();
        error = expect_char(text, length, &pos, ',');
        if (error != NULL) return error;
        error = parse_vfp_register(context, text, length, &pos, &rm_reg, &is_double);
        if (error != NULL) return error;
        if (is_double != (int) sz) return error_vfp_mismatched_precision();
        error = check_trailing(text, length, pos);
        if (error != NULL) return error;

        split_vfp_register(rd, (int) sz, &vd, &dd);
        split_vfp_register(rm_reg, (int) sz, &vm, &dm);

        if (shape == 0u) /* VRINTR/VRINTZ */
        {
            *out_instr = (cond << 28) | 0x0EB60A40u | (dd << 22) | (vd << 12) | (sz << 8) |
                         (val << 7) | (dm << 5) | vm;
        }
        else if (shape == 1u) /* VRINTX */
        {
            *out_instr = (cond << 28) | 0x0EB70A40u | (dd << 22) | (vd << 12) | (sz << 8) |
                         (dm << 5) | vm;
        }
        else /* VRINTA/N/P/M */
        {
            *out_instr = 0xFEB80A40u | (dd << 22) | (val << 16) | (vd << 12) | (sz << 8) |
                         (dm << 5) | vm;
        }
        return NULL;
    }

    if (entry->param2 == 0xFFFFFFFFu) return error_bad_datatype(); /* VRINTR has no NEON form */
    if (cond != COND_AL) return error_neon_no_condition();
    if (dt1.width != 32) return error_bad_datatype();
    {
        uint32_t rd, rm_reg;
        uint8_t cd, cm;
        uint32_t vd, dbit, vm, mbit, q;

        pos = peek_pos;
        error = parse_neon_register(text, length, &pos, &rd, &cd);
        if (error != NULL) return error;
        error = expect_char(text, length, &pos, ',');
        if (error != NULL) return error;
        error = parse_neon_register(text, length, &pos, &rm_reg, &cm);
        if (error != NULL) return error;
        error = check_trailing(text, length, pos);
        if (error != NULL) return error;
        if (cd != cm) return error_neon_mismatched_size();
        q = (cd == 'Q') ? 1u : 0u;

        split_neon_register(rd, cd, &vd, &dbit);
        split_neon_register(rm_reg, cm, &vm, &mbit);
        *out_instr = assemble_neon_two_reg_misc(dbit, 2u, 2u, vd, 8u | entry->param2, 0u, 0u, q, mbit, vm);
    }
    return NULL;
}

/* VCVTA/VCVTN/VCVTP/VCVTM -- Sd,{S|D}m (VFP scalar, ARMv8
   unconditional, float-to-integer with directed rounding; the
   destination is always a single-precision register holding the S32/
   U32 result) or Dd/Qd,Dn/Qm (NEON, F32 source only, unconditional).
   Unlike the dispatchers above, the destination register's class
   alone disambiguates the two forms -- NEON never writes to an S
   register -- so this parses both dt tags first (the same syntax
   shape either way: "VCVTA.S32.F32 ..." or "VCVTA.U32.F64 ...", the
   second tag restricted to F32 for the NEON form) and only then peeks
   at Vd's class to decide the branch. The "op" (signed/unsigned) bit
   has opposite polarity between the two real encodings -- S32 is
   op=1 in the VFP scalar form but op=0 in the NEON form -- confirmed
   against VFPLib's own lookup table entries for both forms, not
   assumed.
   entry->param1 is the 2-bit rm field (A=0, N=1, P=2, M=3), shared by
   both encodings. */
static _kernel_oserror *encode_vfp_or_neon_cvt_dir(assemble_context_t *context, const mnemonic_entry_t *entry,
                                                     uint32_t cond, int s_flag,
                                                     const uint8_t *text, size_t length, size_t pos,
                                                     uint32_t *out_instr)
{
    neon_dt_t dt1, dt2;
    uint32_t op_signed;
    uint8_t regclass;
    _kernel_oserror *error;

    (void) s_flag;
    error = parse_neon_dt(text, length, &pos, &dt1);
    if (error != NULL) return error;
    if (dt1.width != 32 || (dt1.kind != 'S' && dt1.kind != 'U')) return error_bad_datatype();
    op_signed = (dt1.kind == 'S') ? 1u : 0u;
    error = parse_neon_dt(text, length, &pos, &dt2);
    if (error != NULL) return error;
    if (dt2.kind != 'F') return error_bad_datatype();

    regclass = peek_neon_reg_class(text, length, pos);

    if (regclass == 'S')
    {
        uint32_t sz, rd, rm_reg, vd, dd, vm, dm;
        int is_double;

        if (dt2.width != 32 && dt2.width != 64) return error_bad_datatype();
        sz = (dt2.width == 64) ? 1u : 0u;
        error = parse_vfp_register(context, text, length, &pos, &rd, &is_double);
        if (error != NULL) return error;
        if (is_double) return error_vfp_mismatched_precision();
        error = expect_char(text, length, &pos, ',');
        if (error != NULL) return error;
        error = parse_vfp_register(context, text, length, &pos, &rm_reg, &is_double);
        if (error != NULL) return error;
        if (is_double != (int) sz) return error_vfp_mismatched_precision();
        error = check_trailing(text, length, pos);
        if (error != NULL) return error;

        split_vfp_register(rd, 0, &vd, &dd);
        split_vfp_register(rm_reg, (int) sz, &vm, &dm);
        *out_instr = 0xFEBC0A40u | (dd << 22) | (entry->param1 << 16) | (vd << 12) | (sz << 8) |
                     (op_signed << 7) | (dm << 5) | vm;
        return NULL;
    }

    if (cond != COND_AL) return error_neon_no_condition();
    if (dt2.width != 32) return error_bad_datatype();
    {
        uint32_t rd, rm_reg, neon_u;
        uint8_t cd, cm;
        uint32_t vd, dbit, vm, mbit, q;

        error = parse_neon_register(text, length, &pos, &rd, &cd);
        if (error != NULL) return error;
        error = expect_char(text, length, &pos, ',');
        if (error != NULL) return error;
        error = parse_neon_register(text, length, &pos, &rm_reg, &cm);
        if (error != NULL) return error;
        error = check_trailing(text, length, pos);
        if (error != NULL) return error;
        if (cd != cm) return error_neon_mismatched_size();
        q = (cd == 'Q') ? 1u : 0u;

        split_neon_register(rd, cd, &vd, &dbit);
        split_neon_register(rm_reg, cm, &vm, &mbit);
        neon_u = 1u - op_signed;
        *out_instr = assemble_neon_two_reg_misc(dbit, 2u, 3u, vd, (entry->param1 << 1) | neon_u, 0u, 0u, q, mbit, vm);
    }
    return NULL;
}

/* VCVTB/VCVTT -- half-precision <-> single/double conversion (VFP
   scalar, conditional; no NEON form). Syntax always pairs F16 with
   F32 or F64 across two dt tags (eg "VCVTB.F32.F16 Sd,Sm"); which tag
   is F16 selects widening (op=0, half->float) or narrowing (op=1,
   float->half), and the non-F16 tag's width selects sz and, via op,
   which of Vd/Vm is constrained to S (half-precision always lives in
   the bottom 16 bits of a single-precision register) and which
   follows sz.
   entry->param1: T bit (0=VCVTB, bottom half; 1=VCVTT, top half). */
static _kernel_oserror *encode_vfp_cvt_half(assemble_context_t *context, const mnemonic_entry_t *entry,
                                             uint32_t cond, int s_flag,
                                             const uint8_t *text, size_t length, size_t pos,
                                             uint32_t *out_instr)
{
    neon_dt_t dt1, dt2;
    uint32_t op, sz, rd, rm_reg, vd, dd, vm, dm;
    int is_double, dst_is_double, src_is_double;
    _kernel_oserror *error;

    (void) s_flag;
    error = parse_neon_dt(text, length, &pos, &dt1);
    if (error != NULL) return error;
    error = parse_neon_dt(text, length, &pos, &dt2);
    if (error != NULL) return error;

    if (dt1.kind == 'F' && dt1.width == 16 && dt2.kind == 'F' && (dt2.width == 32 || dt2.width == 64))
    {
        op = 1u;
        sz = (dt2.width == 64) ? 1u : 0u;
        dst_is_double = 0;
        src_is_double = (int) sz;
    }
    else if (dt2.kind == 'F' && dt2.width == 16 && dt1.kind == 'F' && (dt1.width == 32 || dt1.width == 64))
    {
        op = 0u;
        sz = (dt1.width == 64) ? 1u : 0u;
        dst_is_double = (int) sz;
        src_is_double = 0;
    }
    else
    {
        return error_bad_datatype();
    }

    error = parse_vfp_register(context, text, length, &pos, &rd, &is_double);
    if (error != NULL) return error;
    if (is_double != dst_is_double) return error_vfp_mismatched_precision();
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_vfp_register(context, text, length, &pos, &rm_reg, &is_double);
    if (error != NULL) return error;
    if (is_double != src_is_double) return error_vfp_mismatched_precision();
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    split_vfp_register(rd, dst_is_double, &vd, &dd);
    split_vfp_register(rm_reg, src_is_double, &vm, &dm);

    *out_instr = (cond << 28) | 0x0EB20A40u | (dd << 22) | (op << 16) | (vd << 12) | (sz << 8) |
                 (entry->param1 << 7) | (dm << 5) | vm;
    return NULL;
}
