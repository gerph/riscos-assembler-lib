                                   "Expected FPSCR");
    }
    pos += strlen("FPSCR");
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_register(context, text, length, &pos, &rt);
    if (error != NULL) return error;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;

    *out_instr = (cond << 28) | 0x0EE10A10u | (rt << 12);
    return NULL;
}

/* ---------------------------------------------------------------
 * NEON/Advanced SIMD -- "three registers of the same length"
 * (ARM DDI 0406C A7.4.1/A7.4.4/A7.4.5), ported from ROOLBASIC's
 * VFPLib/VFPLib. Unlike VFP scalar instructions, NEON data-processing
 * instructions are unconditional (cond field fixed to 0xF) and never
 * take an S suffix.
 * --------------------------------------------------------------- */

static _kernel_oserror *error_bad_datatype(void)
{
    return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_ARM32_ERR_BAD_DATATYPE,
                               "Bad or missing NEON datatype suffix");
}

static _kernel_oserror *error_neon_no_condition(void)
{
    return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_ARM32_ERR_NONE,
                               "NEON instructions do not accept a condition code");
}

static _kernel_oserror *error_neon_mismatched_size(void)
{
    return assemble_set_error(ASSEMBLE_CPU_ARM32, ASSEMBLE_ERROR_TYPE_BAD_OPERAND, ASSEMBLE_ARM32_ERR_NONE,
                               "Operands must all be the same width (all Dn or all Qn), and not Sn");
}

typedef struct neon_dt
{
    uint8_t  kind;   /* 'I', 'S', 'U', 'P', 'F', or 0 for a bare size (no letter) */
    uint32_t width;  /* 8, 16, 32 or 64 */
} neon_dt_t;

/* Mandatory ".<kind><width>" or ".<width>" datatype suffix, eg
   ".I32"/".S16"/".U8"/".P8"/".F32"/".16". */
static _kernel_oserror *parse_neon_dt(const uint8_t *text, size_t length, size_t *pos_inout, neon_dt_t *out_dt)
{
    size_t pos = *pos_inout;
    size_t start;
    uint8_t kind = 0;
    uint32_t width;

    if (pos >= length || text[pos] != '.')
    {
        return error_bad_datatype();
    }
    pos += 1;
    if (pos < length)
    {
        uint8_t c = (uint8_t) toupper((int) text[pos]);

        if (c == 'I' || c == 'S' || c == 'U' || c == 'P' || c == 'F')
        {
            kind = c;
            pos += 1;
        }
    }
    start = pos;
    while (pos < length && text[pos] >= '0' && text[pos] <= '9')
    {
        pos += 1;
    }
    if (pos == start || pos - start > 2)
    {
        return error_bad_datatype();
    }
    width = (uint32_t) (text[start] - '0');
    if (pos - start == 2)
    {
        width = width * 10 + (uint32_t) (text[start + 1] - '0');
    }
    if (width != 8 && width != 16 && width != 32 && width != 64)
    {
        return error_bad_datatype();
    }
    if (continues_identifier(text, length, pos))
    {
        return error_bad_datatype();
    }
    out_dt->kind = kind;
    out_dt->width = width;
    *pos_inout = pos;
    return NULL;
}

static uint32_t neon_dt_size2(uint32_t width)
{
    switch (width)
    {
        case 8:  return 0u;
        case 16: return 1u;
        case 32: return 2u;
        default: return 3u; /* 64 */
    }
}

/* Dn (0-31) or Qn (0-15); unlike parse_vfp_register there is no
   expression fallback -- NEON operands are always named registers. */
static _kernel_oserror *parse_neon_register(const uint8_t *text, size_t length,
                                             size_t *pos_inout, uint32_t *out_reg, uint8_t *out_class)
{
    size_t pos = *pos_inout;
    uint8_t c0;

    pos += assemble_skip_spaces(text + pos, length - pos);
    c0 = (pos < length) ? (uint8_t) toupper((int) text[pos]) : 0;
    if ((c0 == 'D' || c0 == 'Q') && pos + 1 < length && text[pos + 1] >= '0' && text[pos + 1] <= '9')
    {
        size_t end = pos + 2;
        uint32_t regnum = (uint32_t) (text[pos + 1] - '0');
        uint32_t maxreg = (c0 == 'Q') ? 15u : 31u;

        if (end < length && text[end] >= '0' && text[end] <= '9')
        {
            regnum = regnum * 10 + (uint32_t) (text[end] - '0');
            end += 1;
        }
        if (regnum <= maxreg && !continues_identifier(text, length, end))
        {
            *out_reg = regnum;
            *out_class = c0;
            *pos_inout = end;
            return NULL;
        }
    }
    return error_bad_register();
}

/* Non-consuming peek at the class ('S'/'D'/'Q') of the next register,
   used to decide between the scalar-VFP and NEON encodings of a
   mnemonic that supports both (see encode_vfp_or_neon_arith3). */
static uint8_t peek_neon_reg_class(const uint8_t *text, size_t length, size_t pos)
{
    pos += assemble_skip_spaces(text + pos, length - pos);
    if (pos < length)
    {
        uint8_t c = (uint8_t) toupper((int) text[pos]);

        if ((c == 'S' || c == 'D' || c == 'Q') && pos + 1 < length && text[pos + 1] >= '0' && text[pos + 1] <= '9')
        {
            return c;
        }
    }
    return 0;
}

/* Splits a Dn/Qn register into its 4-bit field and extension bit,
   per the same D-register convention as split_vfp_register: a Qn
   register is first doubled to the base of its underlying D-register
   pair (Qn = D(2n):D(2n+1)). */
static void split_neon_register(uint32_t regnum, uint8_t reg_class, uint32_t *out_vx, uint32_t *out_ext)
{
    split_vfp_register((reg_class == 'Q') ? (regnum * 2u) : regnum, 1, out_vx, out_ext);
}

/* Assembles a "three registers of the same length" word from its
   already-split fields. cond is fixed to 0xF (unconditional) and
   bit23 to 0, matching every encoding in this family. */
static uint32_t assemble_neon_three_same(uint32_t u, uint32_t dbit, uint32_t bit21, uint32_t bit20,
                                          uint32_t vn, uint32_t vd, uint32_t opcode4,
                                          uint32_t nbit, uint32_t q, uint32_t mbit, uint32_t opbit,
                                          uint32_t vm)
{
    return 0xF2000000u | (u << 24) | (dbit << 22) | (bit21 << 21) | (bit20 << 20) |
           (vn << 16) | (vd << 12) | (opcode4 << 8) | (nbit << 7) | (q << 6) | (mbit << 5) |
           (opbit << 4) | vm;
}

/* VADD/VSUB/VMUL/VMLA/VMLS -- these five mnemonics have both a scalar
   VFP form ({S|D}d,{S|D}n,{S|D}m, F32/F64, optional condition code)
   and a NEON three-same form (Dd/Qd,Dn/Qn,Dm/Qm, any integer dt or
   F32, unconditional). match_mnemonic() cannot dispatch on two
   entries sharing one root, so this single encoder parses the
   datatype and peeks at the following register to decide which form
   applies: Sd, or Dd with an F64 dt, means scalar (delegated to
   encode_vfp_arith3 via a shim table translating the tag into its
   opc1/opc3 param convention); anything else (Qd, or Dd with any
   other dt) means NEON.
   entry->param1 is a tag: 0=ADD, 1=SUB, 2=MUL, 3=MLA, 4=MLS. */
static _kernel_oserror *encode_vfp_or_neon_arith3(assemble_context_t *context, const mnemonic_entry_t *entry,
                                                    uint32_t cond, int s_flag,
                                                    const uint8_t *text, size_t length, size_t pos,
                                                    uint32_t *out_instr)
{
    static const mnemonic_entry_t SCALAR_SHIM[5] =
    {
        { NULL, FAMILY_VFP_ARITH3, 3, 0, 0, 0, 0 }, /* ADD */
        { NULL, FAMILY_VFP_ARITH3, 3, 1, 0, 0, 0 }, /* SUB */
        { NULL, FAMILY_VFP_ARITH3, 2, 0, 0, 0, 0 }, /* MUL */
        { NULL, FAMILY_VFP_ARITH3, 0, 0, 0, 0, 0 }, /* MLA */
        { NULL, FAMILY_VFP_ARITH3, 0, 1, 0, 0, 0 }  /* MLS */
    };
    size_t peek_pos = pos;
    uint8_t regclass;
    neon_dt_t dt;
    uint32_t rd, rn, rm;
    uint8_t cd, cn, cm;
    uint32_t vd, dbit, vn, nbit, vm, mbit, q;
    _kernel_oserror *error;

    (void) s_flag;

    error = parse_neon_dt(text, length, &peek_pos, &dt);
    if (error != NULL) return error;
    regclass = peek_neon_reg_class(text, length, peek_pos);

    if (regclass == 'S' || (regclass == 'D' && dt.kind == 'F' && dt.width == 64))
    {
        return encode_vfp_arith3(context, &SCALAR_SHIM[entry->param1], cond, s_flag, text, length, pos, out_instr);
    }

    if (cond != COND_AL) return error_neon_no_condition();

    pos = peek_pos;
    error = parse_neon_register(text, length, &pos, &rd, &cd);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_neon_register(text, length, &pos, &rn, &cn);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_neon_register(text, length, &pos, &rm, &cm);
    if (error != NULL) return error;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;
    if (cd != cn || cd != cm) return error_neon_mismatched_size();
    q = (cd == 'Q') ? 1u : 0u;

    split_neon_register(rn, cn, &vn, &nbit);
    split_neon_register(rd, cd, &vd, &dbit);
    split_neon_register(rm, cm, &vm, &mbit);

    if (dt.kind == 'F')
    {
        static const uint32_t FLOATC[5][4] = /* { u, op21, opcode4, opbit } */
        {
            /* ADD */ { 0, 0, 0xD, 0 }, /* SUB */ { 0, 1, 0xD, 0 }, /* MUL */ { 1, 0, 0xD, 1 },
            /* MLA */ { 0, 0, 0xD, 1 }, /* MLS */ { 0, 1, 0xD, 1 }
        };
        const uint32_t *c = FLOATC[entry->param1];

        if (dt.width != 32) return error_bad_datatype();
        *out_instr = assemble_neon_three_same(c[0], dbit, c[1], 0u, vn, vd, c[2], nbit, q, mbit, c[3], vm);
        return NULL;
    }
    else
    {
        /* MUL's integer form doubles as the poly8 form when dt is P8
           (op=1, size forced to 00); MLA/MLS's op selects MLA(0)/MLS(1)
           directly (dt has no sign, so there is nothing to derive). */
        static const uint32_t INTC[5][3] = /* { u, opcode4, opbit } */
        {
            /* ADD */ { 0, 0x8, 0 }, /* SUB */ { 1, 0x8, 0 }, /* MUL */ { 0, 0x9, 1 },
            /* MLA */ { 0, 0x9, 0 }, /* MLS */ { 1, 0x9, 0 }
        };
        const uint32_t *c = INTC[entry->param1];
        uint32_t u, size2;

        if (entry->param1 == 2u && dt.kind == 'P') /* VMUL poly8 */
        {
            if (dt.width != 8) return error_bad_datatype();
            u = 1u;
            size2 = 0u;
        }
        else
        {
            if (dt.kind != 0 && dt.kind != 'I') return error_bad_datatype();
            if (entry->param1 >= 2u && dt.width == 64) return error_bad_datatype(); /* MUL/MLA/MLS: no 64-bit form */
            u = c[0];
            size2 = neon_dt_size2(dt.width);
        }
        *out_instr = assemble_neon_three_same(u, dbit, size2 >> 1, size2 & 1u, vn, vd, c[1], nbit, q, mbit, c[2], vm);
        return NULL;
    }
}

/* Generic "three registers of the same length" encoder, covering
   every NEON mnemonic in this family that is not one of the five
   scalar/NEON dual mnemonics above (see FAMILY_NEON_3SAME in the
   mnemonic table for the param1/param2 bit layout). */
static _kernel_oserror *encode_neon_three_same(assemble_context_t *context, const mnemonic_entry_t *entry,
                                                uint32_t cond, int s_flag,
                                                const uint8_t *text, size_t length, size_t pos,
                                                uint32_t *out_instr)
{
    neon_dt_t dt;
    uint32_t rd, rn, rm;
    uint8_t cd, cn, cm;
    uint32_t vd, dbit, vn, nbit, vm, mbit, q;
    _kernel_oserror *error;

    (void) context; (void) s_flag;
    if (cond != COND_AL) return error_neon_no_condition();

    error = parse_neon_dt(text, length, &pos, &dt);
    if (error != NULL) return error;
    error = parse_neon_register(text, length, &pos, &rd, &cd);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_neon_register(text, length, &pos, &rn, &cn);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_neon_register(text, length, &pos, &rm, &cm);
    if (error != NULL) return error;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;
    if (cd != cn || cd != cm) return error_neon_mismatched_size();
    q = (cd == 'Q') ? 1u : 0u;
    if (q && (entry->param1 & 1u)) return error_neon_mismatched_size(); /* d_only */

    if (entry->param1 & (1u << 2)) /* swap Vn/Vm (VCLE/VCLT/VACLE/VACLT) */
    {
        uint32_t t = rn; uint8_t tc = cn;
        rn = rm; cn = cm;
        rm = t; cm = tc;
    }

    split_neon_register(rn, cn, &vn, &nbit);
    split_neon_register(rd, cd, &vd, &dbit);
    split_neon_register(rm, cm, &vm, &mbit);

    if (dt.kind == 'F')
    {
        uint32_t u, op21, opcode4, opbit;

        if ((entry->param2 & 0x80000000u) == 0) return error_bad_datatype();
        if (dt.width != 32) return error_bad_datatype();
        u = (entry->param2 >> 24) & 1u;
        op21 = (entry->param2 >> 21) & 1u;
        opcode4 = (entry->param2 >> 8) & 0xFu;
        opbit = (entry->param2 >> 4) & 1u;
        *out_instr = assemble_neon_three_same(u, dbit, op21, 0u, vn, vd, opcode4, nbit, q, mbit, opbit, vm);
        return NULL;
    }
    else
    {
        uint32_t u, size2, opcode4, opbit;

        if ((entry->param1 & 0x80000000u) == 0) return error_bad_datatype();
        if (dt.width == 64 && (entry->param1 & 2u) == 0) return error_bad_datatype();
        opcode4 = (entry->param1 >> 8) & 0xFu;
        opbit = (entry->param1 >> 4) & 1u;
        if (entry->param1 & (1u << 25)) /* u_derived */
        {
            if (dt.kind == 'S') u = 0u;
            else if (dt.kind == 'U') u = 1u;
            else return error_bad_datatype();
        }
        else
        {
            if (dt.kind != 0 && dt.kind != 'I') return error_bad_datatype();
            u = (entry->param1 >> 24) & 1u;
        }
        size2 = neon_dt_size2(dt.width);
        *out_instr = assemble_neon_three_same(u, dbit, size2 >> 1, size2 & 1u, vn, vd, opcode4, nbit, q, mbit, opbit, vm);
        return NULL;
    }
}

/* VAND/VBIC/VORR/VORN/VEOR/VBSL/VBIT/VBIF -- size-independent bitwise
   three-same operations; a datatype suffix is accepted (matching real
   syntax, eg "VAND.I32") but does not affect the encoding, so it is
   parsed and discarded. entry->param1 already has every fixed bit
   (U, bit21, bit20, opcode, opbit) positioned, so the encoder only
   has to OR in the register fields. */
static _kernel_oserror *encode_neon_three_same_logical(assemble_context_t *context, const mnemonic_entry_t *entry,
                                                         uint32_t cond, int s_flag,
                                                         const uint8_t *text, size_t length, size_t pos,
                                                         uint32_t *out_instr)
{
    uint32_t rd, rn, rm;
    uint8_t cd, cn, cm;
    uint32_t vd, dbit, vn, nbit, vm, mbit, q;
    _kernel_oserror *error;

    (void) context; (void) s_flag;
    if (cond != COND_AL) return error_neon_no_condition();

    if (pos < length && text[pos] == '.')
    {
        neon_dt_t dt;

        error = parse_neon_dt(text, length, &pos, &dt);
        if (error != NULL) return error;
    }
    error = parse_neon_register(text, length, &pos, &rd, &cd);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_neon_register(text, length, &pos, &rn, &cn);
    if (error != NULL) return error;
    error = expect_char(text, length, &pos, ',');
    if (error != NULL) return error;
    error = parse_neon_register(text, length, &pos, &rm, &cm);
    if (error != NULL) return error;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;
    if (cd != cn || cd != cm) return error_neon_mismatched_size();
    q = (cd == 'Q') ? 1u : 0u;

    split_neon_register(rn, cn, &vn, &nbit);
    split_neon_register(rd, cd, &vd, &dbit);
    split_neon_register(rm, cm, &vm, &mbit);

    *out_instr = 0xF2000000u | entry->param1 | (dbit << 22) | (vn << 16) | (vd << 12) |
                 (nbit << 7) | (q << 6) | (mbit << 5) | vm;
    return NULL;
}
