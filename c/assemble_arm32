/* PLD/PLI [Rn{,#imm}] or [Rn,{-}Rm{,shift}] -- always pre-indexed,
   never writeback, unconditional (cond forced 1111). */
static _kernel_oserror *encode_pld_pli(assemble_context_t *context, const mnemonic_entry_t *entry,
                                        uint32_t cond, int s_flag,
                                        const uint8_t *text, size_t length, size_t pos,
                                        uint32_t *out_instr)
{
    uint32_t bits = 0xF550F000u; /* NV | P=1 U=1 B(=1 for PLD data, differs for PLI) | Rd=1111 */
    _kernel_oserror *error;

    (void) cond; (void) s_flag;
    if (entry->param1 == 1) /* PLI: opcode byte differs from PLD (no B bit, uses 0110 class) */
    {
        bits = 0xF450F000u;
    }
    error = parse_ldr_str_address(context, text, length, &pos, LDST_CLASS_NORMAL, &bits);
    if (error != NULL) return error;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;
    /* PLD/PLI addressing never sets bit25 register-offset-with-shift's I
       differently; parse_ldr_str_address already encoded it correctly. */
    *out_instr = bits;
    return NULL;
}

