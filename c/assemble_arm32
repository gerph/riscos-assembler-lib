static _kernel_oserror *encode_barrier_noop(assemble_context_t *context, const mnemonic_entry_t *entry,
                                             uint32_t cond, int s_flag,
                                             const uint8_t *text, size_t length, size_t pos,
                                             uint32_t *out_instr)
{
    _kernel_oserror *error;

    (void) context; (void) cond; (void) s_flag;
    error = check_trailing(text, length, pos);
    if (error != NULL) return error;
    *out_instr = entry->param1 ? 0xF57FF044u : 0xF57FF040u;
