/* BASIC tokenises OR/AND/EOR as single bytes; since ORA/AND/EOR are
   also 6502 mnemonics, these tokens must be recognised and expanded
   back to their mnemonic spelling before normal mnemonic lookup. */
#define TOKEN_AND 0x80
#define TOKEN_EOR 0x82
#define TOKEN_OR  0x84

typedef enum addr_mode
{
    MODE_IMPLIED,       /* no operand, eg NOP */
    MODE_ACCUMULATOR,   /* A, eg ASL A (or bare ASL on plain 6502) */
    MODE_IMMEDIATE,     /* #nn -- 1 byte */
    MODE_ZP,            /* nn -- zero/direct page, 1 byte */
    MODE_ZPX,           /* nn,X -- 1 byte */
    MODE_ZPY,           /* nn,Y -- 1 byte */
    MODE_ABS,           /* nnnn -- 2 bytes */
    MODE_ABSX,          /* nnnn,X -- 2 bytes */
    MODE_ABSY,          /* nnnn,Y -- 2 bytes */
    MODE_IND,           /* (nnnn) -- 2 bytes, JMP only */
    MODE_INDX,          /* (nn,X) -- 1 byte */
    MODE_INDY,          /* (nn),Y -- 1 byte */
    MODE_ZPIND,         /* (nn) -- 1 byte, 65C02+ zero-page indirect w/o index */
    MODE_ABSINDX,       /* (nnnn,X) -- 2 bytes, JMP/JSR absolute indexed indirect */
    MODE_INDLONGABS,    /* [nnnn] -- 2 bytes, 65816 JMP absolute indirect long */
    MODE_REL,           /* branch target -- 1 byte signed offset */
    MODE_RELLONG,       /* PER / BRL -- 2 byte signed offset, 65816 */
    MODE_ZPREL,         /* BBR/BBS -- zero page + 1 byte signed branch offset */
    MODE_LONG,          /* nnnnnn -- 3 bytes, 65816 absolute long */
    MODE_LONGX,         /* nnnnnn,X -- 3 bytes, 65816 */
    MODE_INDLONG,       /* [nn] -- 1 byte, 65816 indirect long */
    MODE_INDLONGY,      /* [nn],Y -- 1 byte, 65816 */
    MODE_STACKREL,      /* nn,S -- 1 byte, 65816 stack relative */
    MODE_STACKRELY,     /* (nn,S),Y -- 1 byte, 65816 stack relative indirect indexed */
    MODE_BLOCKMOVE,     /* MVN/MVP -- 2 operand bytes (src bank, dest bank), 65816 */
    MODE_IMMEDIATE16    /* PEA nnnn -- 2 byte immediate-like operand, 65816 */
} addr_mode_t;

typedef struct opcode_entry
{
    const char *mnemonic;   /* upper case, eg "LDA" */
    addr_mode_t mode;
    uint8_t     opcode;
    uint8_t     min_variant;  /* 0 = plain NMOS 6502, 1 = 65C02, 2 = 65C816 */
} opcode_entry_t;

