typedef enum width
{
    WIDTH_AUTO,
    WIDTH_ZP,
    WIDTH_ABS,
    WIDTH_LONG
} width_t;

assemble_6502_variant_t assemble_6502_variant_from_opt(uint32_t opt)
{
    if (opt & ASSEMBLE_6502_OPT_65C816)
    {
        return ASSEMBLE_6502_VARIANT_65C816;
    }
    if (opt & ASSEMBLE_6502_OPT_65C02)
    {
        return ASSEMBLE_6502_VARIANT_65C02;
    }
    return ASSEMBLE_6502_VARIANT_6502;
}

static int is_char_ci(uint8_t byte, char ch)
{
    return toupper((int) byte) == toupper((int) ch);
}

static int mnemonic_has_mode(const char *mnemonic, addr_mode_t mode)
{
    size_t i;

    for (i = 0; i < NUM_OPCODES; i++)
    {
        if (strcmp(opcode_table[i].mnemonic, mnemonic) == 0 && opcode_table[i].mode == mode)
        {
            return 1;
        }
    }
    return 0;
}

static int mnemonic_has_any_zp_mode(const char *mnemonic)
{
    return mnemonic_has_mode(mnemonic, MODE_ZP) ||
           mnemonic_has_mode(mnemonic, MODE_ZPX) ||
           mnemonic_has_mode(mnemonic, MODE_ZPY);
}

static const opcode_entry_t *find_opcode(const char *mnemonic, addr_mode_t mode,
                                          assemble_6502_variant_t variant,
                                          int *mode_exists_elsewhere)
{
    size_t i;

    *mode_exists_elsewhere = 0;
    for (i = 0; i < NUM_OPCODES; i++)
    {
        if (strcmp(opcode_table[i].mnemonic, mnemonic) == 0 && opcode_table[i].mode == mode)
        {
            if (opcode_table[i].min_variant <= (uint8_t) variant)
            {
                return &opcode_table[i];
            }
            *mode_exists_elsewhere = 1;
        }
    }
    return NULL;
}

static void resolve_alias(const char *mnemonic, char *canonical, int *force_accumulator)
{
    size_t i;

    for (i = 0; i < sizeof(alias_table) / sizeof(alias_table[0]); i++)
    {
        if (strcmp(mnemonic, alias_table[i].alias) == 0)
        {
            strcpy(canonical, alias_table[i].canonical);
            *force_accumulator = alias_table[i].force_accumulator;
            return;
        }
    }
    strcpy(canonical, mnemonic);
    *force_accumulator = 0;
}

static int allows_implicit_accumulator(const char *mnemonic)
{
    return strcmp(mnemonic, "ASL") == 0 || strcmp(mnemonic, "ROL") == 0 ||
           strcmp(mnemonic, "LSR") == 0 || strcmp(mnemonic, "ROR") == 0;
}

static int is_branch_mnemonic(const char *mnemonic)
{
    static const char *const names[] = {
        "BPL", "BMI", "BVC", "BVS", "BRA", "BCC", "BCS", "BNE", "BEQ", "BRL"
    };
    size_t i;

    for (i = 0; i < sizeof(names) / sizeof(names[0]); i++)
    {
        if (strcmp(mnemonic, names[i]) == 0)
        {
            return 1;
        }
    }
    return 0;
}

static int is_bit_mnemonic_no_branch(const char *mnemonic)
{
    return strlen(mnemonic) == 4 &&
           (memcmp(mnemonic, "RMB", 3) == 0 || memcmp(mnemonic, "SMB", 3) == 0);
}

static int is_bit_mnemonic_with_branch(const char *mnemonic)
{
    return strlen(mnemonic) == 4 &&
           (memcmp(mnemonic, "BBR", 3) == 0 || memcmp(mnemonic, "BBS", 3) == 0);
}

static int32_t value_to_integer(const assemble_value_t *value)
{
    switch (value->type)
    {
        case ASSEMBLE_VALUE_FLOAT:
            return (int32_t) value->value.as_float;
        case ASSEMBLE_VALUE_INTEGER:
        default:
            return value->value.as_integer;
    }
}

static _kernel_oserror *eval_expr(assemble_context_t *context,
                                   const uint8_t *text, size_t length,
                                   assemble_value_t *value, size_t *consumed)
{
    _kernel_oserror *error = NULL;

    if (context->resolve_expr(context->user_data, text, length, value, consumed, &error) != ASSEMBLE_RESULT_OK)
    {
        if (error != NULL)
        {
            return error;
        }
        return assemble_set_error(ASSEMBLE_CPU_6502, ASSEMBLE_ERROR_TYPE_EXPRESSION, ASSEMBLE_6502_ERR_NONE,
                                   "Expression could not be evaluated");
    }
    if (value->type == ASSEMBLE_VALUE_STRING)
    {
        return assemble_set_error(ASSEMBLE_CPU_6502, ASSEMBLE_ERROR_TYPE_EXPRESSION, ASSEMBLE_6502_ERR_NONE,
                                   "Expected a numeric value");
    }
    return NULL;
}

static _kernel_oserror *eval_numeric(assemble_context_t *context,
                                      const uint8_t *text, size_t length,
                                      size_t *pos_inout, int32_t *out_value)
{
    assemble_value_t value;
    size_t consumed;
    _kernel_oserror *error;

    error = eval_expr(context, text + *pos_inout, length - *pos_inout, &value, &consumed);
    if (error != NULL)
    {
        return error;
    }
    *pos_inout += consumed;
    *out_value = value_to_integer(&value);
    return NULL;
}

static _kernel_oserror *compute_branch_offset(assemble_context_t *context, int32_t target,
                                               int instruction_length, int is_long, int32_t *out_offset)
{
    int32_t next_address = (int32_t) context->address + instruction_length;
    int32_t offset = target - next_address;

    if (is_long)
    {
        if (offset < -32768 || offset > 32767)
        {
            return assemble_set_error(ASSEMBLE_CPU_6502, ASSEMBLE_ERROR_TYPE_RANGE,
                                       ASSEMBLE_6502_ERR_BRANCH_RANGE, "Branch target out of range");
        }
    }
    else
    {
        if (offset < -128 || offset > 127)
        {
            return assemble_set_error(ASSEMBLE_CPU_6502, ASSEMBLE_ERROR_TYPE_RANGE,
                                       ASSEMBLE_6502_ERR_BRANCH_RANGE, "Branch target out of range");
        }
    }
    *out_offset = offset;
    return NULL;
}

static _kernel_oserror *check_trailing(const uint8_t *text, size_t length, size_t pos)
{
    pos += assemble_skip_spaces(text + pos, length - pos);
    if (pos != length)
    {
        return assemble_set_error(ASSEMBLE_CPU_6502, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_6502_ERR_NONE,
                                   "Unexpected text after operand");
    }
    return NULL;
}

static size_t read_mnemonic(const uint8_t *text, size_t length, char *out, int *bit_number_missing)
{
    size_t pos = 0;
    size_t count = 0;

    *bit_number_missing = 0;

    if (length == 0)
    {
        out[0] = '\0';
        return 0;
    }

    if (text[0] == TOKEN_OR)
    {
        out[count++] = 'O';
        out[count++] = 'R';
        pos = 1;
        if (pos < length && is_char_ci(text[pos], 'A'))
        {
            out[count++] = 'A';
            pos += 1;
        }
    }
    else if (text[0] == TOKEN_AND)
    {
        out[count++] = 'A';
        out[count++] = 'N';
        out[count++] = 'D';
        pos = 1;
    }
    else if (text[0] == TOKEN_EOR)
    {
        out[count++] = 'E';
        out[count++] = 'O';
        out[count++] = 'R';
        pos = 1;
    }
    else
    {
        while (pos < length && count < 3 &&
               ((text[pos] >= 'A' && text[pos] <= 'Z') || (text[pos] >= 'a' && text[pos] <= 'z')))
        {
            out[count] = (char) toupper((int) text[pos]);
            count += 1;
            pos += 1;
        }
    }

    if (count == 3 &&
        (memcmp(out, "RMB", 3) == 0 || memcmp(out, "SMB", 3) == 0 ||
         memcmp(out, "BBR", 3) == 0 || memcmp(out, "BBS", 3) == 0))
    {
        if (pos < length && text[pos] >= '0' && text[pos] <= '7')
        {
            out[count++] = text[pos];
            pos += 1;
        }
        else
        {
            *bit_number_missing = 1;
        }
    }

    out[count] = '\0';
    return pos;
}

static _kernel_oserror *parse_indirect(assemble_context_t *context,
                                        const char *mnemonic,
                                        const uint8_t *text, size_t length,
                                        size_t *pos_inout,
                                        addr_mode_t *out_mode, int32_t *out_value1)
{
    size_t pos = *pos_inout;
    int square = (text[pos] == '[');
    char close_char = square ? ']' : ')';
    int32_t value;
    _kernel_oserror *error;
    int abs_width = (strcmp(mnemonic, "JMP") == 0 || strcmp(mnemonic, "JSR") == 0);

    pos += 1;
    pos += assemble_skip_spaces(text + pos, length - pos);

    error = eval_numeric(context, text, length, &pos, &value);
    if (error != NULL)
    {
        return error;
    }

    pos += assemble_skip_spaces(text + pos, length - pos);

    if (pos < length && text[pos] == ',')
    {
        pos += 1;
        pos += assemble_skip_spaces(text + pos, length - pos);

        if (pos < length && is_char_ci(text[pos], 'X'))
        {
            pos += 1;
            pos += assemble_skip_spaces(text + pos, length - pos);
            if (!(pos < length && text[pos] == close_char))
            {
                return assemble_set_error(ASSEMBLE_CPU_6502, ASSEMBLE_ERROR_TYPE_SYNTAX,
                                           ASSEMBLE_6502_ERR_EXPECT_RBRACKET,
                                           "Indirect addressing: expected closing bracket");
            }
            pos += 1;
            *out_mode = abs_width ? MODE_ABSINDX : MODE_INDX;
        }
        else if (!square && pos < length && is_char_ci(text[pos], 'S'))
        {
            pos += 1;
            pos += assemble_skip_spaces(text + pos, length - pos);
            if (!(pos < length && text[pos] == close_char))
            {
                return assemble_set_error(ASSEMBLE_CPU_6502, ASSEMBLE_ERROR_TYPE_SYNTAX,
                                           ASSEMBLE_6502_ERR_EXPECT_RBRACKET,
                                           "Stack relative indirect addressing: expected ')'");
            }
            pos += 1;
            pos += assemble_skip_spaces(text + pos, length - pos);
            if (!(pos < length && text[pos] == ','))
            {
                return assemble_set_error(ASSEMBLE_CPU_6502, ASSEMBLE_ERROR_TYPE_SYNTAX,
                                           ASSEMBLE_6502_ERR_EXPECT_Y,
                                           "Stack relative indirect addressing: expected ',Y'");
            }
            pos += 1;
            pos += assemble_skip_spaces(text + pos, length - pos);
            if (!(pos < length && is_char_ci(text[pos], 'Y')))
            {
                return assemble_set_error(ASSEMBLE_CPU_6502, ASSEMBLE_ERROR_TYPE_SYNTAX,
                                           ASSEMBLE_6502_ERR_EXPECT_Y,
                                           "Stack relative indirect addressing: expected 'Y'");
            }
            pos += 1;
            *out_mode = MODE_STACKRELY;
        }
        else
        {
            return assemble_set_error(ASSEMBLE_CPU_6502, ASSEMBLE_ERROR_TYPE_SYNTAX,
                                       ASSEMBLE_6502_ERR_EXPECT_X_OR_S,
                                       "Indirect addressing: expected 'X' or 'S'");
        }
    }
    else if (pos < length && text[pos] == close_char)
    {
        pos += 1;

        if (pos < length && text[pos] == ',')
        {
            pos += 1;
            pos += assemble_skip_spaces(text + pos, length - pos);
            if (!(pos < length && is_char_ci(text[pos], 'Y')))
            {
                return assemble_set_error(ASSEMBLE_CPU_6502, ASSEMBLE_ERROR_TYPE_SYNTAX,
                                           ASSEMBLE_6502_ERR_EXPECT_Y,
                                           "Indirect addressing: expected ',Y'");
            }
            pos += 1;
            *out_mode = square ? MODE_INDLONGY : MODE_INDY;
        }
        else if (abs_width)
        {
            *out_mode = square ? MODE_INDLONGABS : MODE_IND;
        }
        else
        {
            *out_mode = square ? MODE_INDLONG : MODE_ZPIND;
        }
    }
    else
    {
        return assemble_set_error(ASSEMBLE_CPU_6502, ASSEMBLE_ERROR_TYPE_SYNTAX,
                                   ASSEMBLE_6502_ERR_EXPECT_COMMA_OR_RBRACKET,
                                   "Indirect addressing: expected ',' or a closing bracket");
    }

    *pos_inout = pos;
    *out_value1 = value;
    return NULL;
}

static _kernel_oserror *parse_direct(const char *mnemonic,
                                      const uint8_t *text, size_t length,
                                      size_t *pos_inout,
                                      addr_mode_t *out_mode, int32_t *out_value1,
                                      assemble_context_t *context);

/*******************************************************************
 Function:      parse_operand
 Description:   Parses the operand text following a mnemonic and
                determines the addressing mode and its value(s).
 Parameters:    context = the assembly context (for expression
                          evaluation and the current address)
                variant = the selected CPU dialect
                mnemonic = canonical (alias-resolved) mnemonic
                text/length = the operand text (after the mnemonic)
                out_mode, out_value1, out_value2 = results
 Returns:       NULL if successful, otherwise a static error block
 ******************************************************************/
static _kernel_oserror *parse_operand(assemble_context_t *context,
                                       assemble_6502_variant_t variant,
                                       const char *mnemonic,
                                       const uint8_t *text, size_t length,
                                       addr_mode_t *out_mode,
                                       int32_t *out_value1, int32_t *out_value2)
{
    size_t pos = 0;
    _kernel_oserror *error;

    (void) variant;

    pos += assemble_skip_spaces(text + pos, length - pos);

    if (pos >= length)
    {
        if (mnemonic_has_mode(mnemonic, MODE_IMPLIED))
        {
            *out_mode = MODE_IMPLIED;
            return NULL;
        }
        if (allows_implicit_accumulator(mnemonic))
        {
            *out_mode = MODE_ACCUMULATOR;
            return NULL;
        }
        return assemble_set_error_f(ASSEMBLE_CPU_6502, ASSEMBLE_ERROR_TYPE_BAD_OPERAND, ASSEMBLE_6502_ERR_NONE,
                                     "%s requires an operand", mnemonic);
    }

    if ((pos + 1 == length) && is_char_ci(text[pos], 'A'))
    {
        *out_mode = MODE_ACCUMULATOR;
        return NULL;
    }

    if (strcmp(mnemonic, "MVN") == 0 || strcmp(mnemonic, "MVP") == 0)
    {
        int32_t bank1, bank2;

        error = eval_numeric(context, text, length, &pos, &bank1);
        if (error != NULL)
        {
            return error;
        }
        pos += assemble_skip_spaces(text + pos, length - pos);
        if (!(pos < length && text[pos] == ','))
        {
            return assemble_set_error(ASSEMBLE_CPU_6502, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_6502_ERR_NONE,
                                       "Expected ',' between block move banks");
        }
        pos += 1;
        pos += assemble_skip_spaces(text + pos, length - pos);
        error = eval_numeric(context, text, length, &pos, &bank2);
        if (error != NULL)
        {
            return error;
        }
        error = check_trailing(text, length, pos);
        if (error != NULL)
        {
            return error;
        }
        *out_mode = MODE_BLOCKMOVE;
        *out_value1 = bank1;
        *out_value2 = bank2;
        return NULL;
    }

    if (strcmp(mnemonic, "PEA") == 0)
    {
        int32_t value;

        if (text[pos] == '#')
        {
            pos += 1;
        }
        error = eval_numeric(context, text, length, &pos, &value);
        if (error != NULL)
        {
            return error;
        }
        error = check_trailing(text, length, pos);
        if (error != NULL)
        {
            return error;
        }
        *out_mode = MODE_IMMEDIATE16;
        *out_value1 = value;
        return NULL;
    }

    if (strcmp(mnemonic, "PER") == 0)
    {
        int32_t target, offset;

        error = eval_numeric(context, text, length, &pos, &target);
        if (error != NULL)
        {
            return error;
        }
        error = check_trailing(text, length, pos);
        if (error != NULL)
        {
            return error;
        }
        error = compute_branch_offset(context, target, 3, 1, &offset);
        if (error != NULL)
        {
            return error;
        }
        *out_mode = MODE_RELLONG;
        *out_value1 = offset;
        return NULL;
    }

    if (is_branch_mnemonic(mnemonic))
    {
        int32_t target, offset;
        int is_long = (strcmp(mnemonic, "BRL") == 0);

        error = eval_numeric(context, text, length, &pos, &target);
        if (error != NULL)
        {
            return error;
        }
        error = check_trailing(text, length, pos);
        if (error != NULL)
        {
            return error;
        }
        error = compute_branch_offset(context, target, is_long ? 3 : 2, is_long, &offset);
        if (error != NULL)
        {
            return error;
        }
        *out_mode = is_long ? MODE_RELLONG : MODE_REL;
        *out_value1 = offset;
        return NULL;
    }

    if (is_bit_mnemonic_no_branch(mnemonic))
    {
        int32_t zp;

        error = eval_numeric(context, text, length, &pos, &zp);
        if (error != NULL)
        {
            return error;
        }
        error = check_trailing(text, length, pos);
        if (error != NULL)
        {
            return error;
        }
        *out_mode = MODE_ZP;
        *out_value1 = zp;
        return NULL;
    }

    if (is_bit_mnemonic_with_branch(mnemonic))
    {
        int32_t zp, target, offset;

        error = eval_numeric(context, text, length, &pos, &zp);
        if (error != NULL)
        {
            return error;
        }
        pos += assemble_skip_spaces(text + pos, length - pos);
        if (!(pos < length && text[pos] == ','))
        {
            return assemble_set_error(ASSEMBLE_CPU_6502, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_6502_ERR_NONE,
                                       "Expected ',' between address and branch target");
        }
        pos += 1;
        pos += assemble_skip_spaces(text + pos, length - pos);
        error = eval_numeric(context, text, length, &pos, &target);
        if (error != NULL)
        {
            return error;
        }
        error = check_trailing(text, length, pos);
        if (error != NULL)
        {
            return error;
        }
        error = compute_branch_offset(context, target, 3, 0, &offset);
        if (error != NULL)
        {
            return error;
        }
        *out_mode = MODE_ZPREL;
        *out_value1 = zp;
        *out_value2 = offset;
        return NULL;
    }

    if (text[pos] == '#')
    {
        int32_t value;

        pos += 1;
        error = eval_numeric(context, text, length, &pos, &value);
        if (error != NULL)
        {
            return error;
        }
        error = check_trailing(text, length, pos);
        if (error != NULL)
        {
            return error;
        }
        *out_mode = MODE_IMMEDIATE;
        *out_value1 = value;
        return NULL;
    }

    if (text[pos] == '(' || text[pos] == '[')
    {
        error = parse_indirect(context, mnemonic, text, length, &pos, out_mode, out_value1);
        if (error != NULL)
        {
            return error;
        }
        return check_trailing(text, length, pos);
    }

    error = parse_direct(mnemonic, text, length, &pos, out_mode, out_value1, context);
    if (error != NULL)
    {
        return error;
    }
    return check_trailing(text, length, pos);
}

static _kernel_oserror *parse_direct(const char *mnemonic,
                                      const uint8_t *text, size_t length,
                                      size_t *pos_inout,
                                      addr_mode_t *out_mode, int32_t *out_value1,
                                      assemble_context_t *context)
{
    size_t pos = *pos_inout;
    width_t width = WIDTH_AUTO;
    int32_t value;
    _kernel_oserror *error;
    int index = 0;

    if (pos < length && (text[pos] == '<' || text[pos] == '>' || text[pos] == '^'))
    {
        width = (text[pos] == '<') ? WIDTH_ZP : (text[pos] == '>') ? WIDTH_ABS : WIDTH_LONG;
        pos += 1;
    }

    error = eval_numeric(context, text, length, &pos, &value);
    if (error != NULL)
    {
        return error;
    }

    pos += assemble_skip_spaces(text + pos, length - pos);

    if (pos < length && text[pos] == ',')
    {
        pos += 1;
        pos += assemble_skip_spaces(text + pos, length - pos);
        if (pos < length &&
            (is_char_ci(text[pos], 'X') || is_char_ci(text[pos], 'Y') || is_char_ci(text[pos], 'S')))
        {
            index = toupper((int) text[pos]);
            pos += 1;
        }
        else
        {
            return assemble_set_error(ASSEMBLE_CPU_6502, ASSEMBLE_ERROR_TYPE_SYNTAX,
                                       ASSEMBLE_6502_ERR_EXPECT_XY_ABS,
                                       "Indexed addressing: expected 'X', 'Y' or 'S'");
        }
    }

    /* Stack relative addressing (nn,S) is always a 1-byte offset;
       it has no zero-page/absolute/long width variation. */
    if (index == 'S')
    {
        *out_mode = MODE_STACKREL;
        *pos_inout = pos;
        *out_value1 = value;
        return NULL;
    }

    if (width == WIDTH_AUTO)
    {
        uint32_t magnitude = (uint32_t) value;

        if ((magnitude & 0xFFFFFF00u) == 0 && mnemonic_has_any_zp_mode(mnemonic))
        {
            width = WIDTH_ZP;
        }
        else if ((magnitude & 0xFFFF0000u) == 0)
        {
            width = WIDTH_ABS;
        }
        else
        {
            width = WIDTH_LONG;
        }
    }

    if (width == WIDTH_LONG && index == 'Y')
    {
        return assemble_set_error(ASSEMBLE_CPU_6502, ASSEMBLE_ERROR_TYPE_BAD_OPERAND, ASSEMBLE_6502_ERR_NONE,
                                   "Absolute long addressing does not support ',Y'");
    }

    switch (width)
    {
        case WIDTH_ZP:
            *out_mode = (index == 'X') ? MODE_ZPX : (index == 'Y') ? MODE_ZPY : MODE_ZP;
            break;
        case WIDTH_ABS:
            *out_mode = (index == 'X') ? MODE_ABSX : (index == 'Y') ? MODE_ABSY : MODE_ABS;
            break;
        case WIDTH_LONG:
        default:
            *out_mode = (index == 'X') ? MODE_LONGX : MODE_LONG;
            break;
    }

    *pos_inout = pos;
    *out_value1 = value;
    return NULL;
}

static _kernel_oserror *error_unsupported(assemble_6502_variant_t variant)
{
    assemble_6502_error_variant_t v;
    const char *name;

    switch (variant)
    {
        case ASSEMBLE_6502_VARIANT_65C02:
            v = ASSEMBLE_6502_ERR_UNSUPPORTED_65C02;
            name = "65C02";
            break;
        case ASSEMBLE_6502_VARIANT_65C816:
            v = ASSEMBLE_6502_ERR_UNSUPPORTED_65C816;
            name = "65C816";
            break;
        default:
            v = ASSEMBLE_6502_ERR_UNSUPPORTED_6502;
            name = "6502";
            break;
    }
    return assemble_set_error_f(ASSEMBLE_CPU_6502, ASSEMBLE_ERROR_TYPE_UNSUPPORTED_ON_VARIANT, v,
                                 "Instruction not supported by %s", name);
}

static _kernel_oserror *error_bad_operand_mode(const char *mnemonic)
{
    return assemble_set_error_f(ASSEMBLE_CPU_6502, ASSEMBLE_ERROR_TYPE_BAD_OPERAND, ASSEMBLE_6502_ERR_NONE,
                                 "%s does not support this addressing mode", mnemonic);
}

/*******************************************************************
 Function:      assemble_dc
 Description:   Assembles a DCB/DCW/DCD pseudo-op: a comma-separated
                list of expressions, each emitted as a byte, 16-bit
                word or 32-bit doubleword respectively.
 Parameters:    context = the assembly context
                mnemonic = "DCB", "DCW" or "DCD"
                text/length = the operand text following the mnemonic
 Returns:       NULL if successful, otherwise a static error block
 ******************************************************************/
static _kernel_oserror *assemble_dc(assemble_context_t *context, const char *mnemonic,
                                     const uint8_t *text, size_t length)
{
    size_t pos = 0;
    _kernel_oserror *error;

    for (;;)
    {
        int32_t number;

        pos += assemble_skip_spaces(text + pos, length - pos);
        error = eval_numeric(context, text, length, &pos, &number);
        if (error != NULL)
        {
            return error;
        }

        if (strcmp(mnemonic, "DCB") == 0)
        {
            error = assemble_emit_byte(context, ASSEMBLE_CPU_6502, (uint8_t) (number & 0xFF));
        }
        else if (strcmp(mnemonic, "DCW") == 0)
        {
            error = assemble_emit_word(context, ASSEMBLE_CPU_6502, (uint16_t) (number & 0xFFFF));
        }
        else
        {
            error = assemble_emit_dword(context, ASSEMBLE_CPU_6502, (uint32_t) number);
        }
        if (error != NULL)
        {
            return error;
        }

        pos += assemble_skip_spaces(text + pos, length - pos);
        if (pos < length && text[pos] == ',')
        {
            pos += 1;
            continue;
        }
        break;
    }

    return check_trailing(text, length, pos);
}

/*******************************************************************
 Function:      assemble_instruction
 Description:   Parses the operand for a real 6502/65C02/65C816
                mnemonic (after alias resolution) and emits its
                opcode and operand bytes.
 Parameters:    context = the assembly context
                variant = the selected CPU dialect
                mnemonic = the mnemonic as read from the source line
                text/length = the operand text following the mnemonic
 Returns:       NULL if successful, otherwise a static error block
 ******************************************************************/
static _kernel_oserror *assemble_instruction(assemble_context_t *context,
                                              assemble_6502_variant_t variant,
                                              const char *mnemonic,
                                              const uint8_t *text, size_t length)
{
    char canonical[8];
    int force_accumulator;
    addr_mode_t mode = MODE_IMPLIED;
    int32_t value1 = 0;
    int32_t value2 = 0;
    _kernel_oserror *error;
    const opcode_entry_t *entry;
    int mode_exists_elsewhere;

    resolve_alias(mnemonic, canonical, &force_accumulator);

    if (force_accumulator)
    {
        size_t p = assemble_skip_spaces(text, length);

        if (p != length)
        {
            return assemble_set_error(ASSEMBLE_CPU_6502, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_6502_ERR_NONE,
                                       "Unexpected text after operand");
        }
        mode = MODE_ACCUMULATOR;
    }
    else
    {
        error = parse_operand(context, variant, canonical, text, length, &mode, &value1, &value2);
        if (error != NULL)
        {
            return error;
        }
    }

    entry = find_opcode(canonical, mode, variant, &mode_exists_elsewhere);
    if (entry == NULL)
    {
        if (mode_exists_elsewhere)
        {
            return error_unsupported(variant);
        }
        return error_bad_operand_mode(canonical);
    }

    error = assemble_emit_byte(context, ASSEMBLE_CPU_6502, entry->opcode);
    if (error != NULL)
    {
        return error;
    }

    switch (mode)
    {
        case MODE_IMPLIED:
        case MODE_ACCUMULATOR:
            break;

        case MODE_IMMEDIATE:
        case MODE_ZP:
        case MODE_ZPX:
        case MODE_ZPY:
        case MODE_INDX:
        case MODE_INDY:
        case MODE_ZPIND:
        case MODE_INDLONG:
        case MODE_INDLONGY:
        case MODE_STACKREL:
        case MODE_STACKRELY:
        case MODE_REL:
            error = assemble_emit_byte(context, ASSEMBLE_CPU_6502, (uint8_t) (value1 & 0xFF));
            break;

        case MODE_ABS:
        case MODE_ABSX:
        case MODE_ABSY:
        case MODE_IND:
        case MODE_ABSINDX:
        case MODE_INDLONGABS:
        case MODE_IMMEDIATE16:
        case MODE_RELLONG:
            error = assemble_emit_word(context, ASSEMBLE_CPU_6502, (uint16_t) (value1 & 0xFFFF));
            break;

        case MODE_LONG:
        case MODE_LONGX:
            error = assemble_emit_tribyte(context, ASSEMBLE_CPU_6502, (uint32_t) value1);
            break;

        case MODE_ZPREL:
        case MODE_BLOCKMOVE:
            error = assemble_emit_byte(context, ASSEMBLE_CPU_6502, (uint8_t) (value1 & 0xFF));
            if (error == NULL)
            {
                error = assemble_emit_byte(context, ASSEMBLE_CPU_6502, (uint8_t) (value2 & 0xFF));
            }
            break;

        default:
            error = assemble_set_error(ASSEMBLE_CPU_6502, ASSEMBLE_ERROR_TYPE_INTERNAL, ASSEMBLE_6502_ERR_NONE,
                                        "Unhandled addressing mode");
            break;
    }

    return error;
}

/*******************************************************************
 Function:      assign_label
 Description:   Assigns a value to a label via the context's
                assign_var callback.
 Parameters:    context = the assembly context
                label/label_length = the label name
                value = the value to assign
 Returns:       NULL if successful, otherwise a static error block
 ******************************************************************/
static _kernel_oserror *assign_label(assemble_context_t *context,
                                      const char *label, size_t label_length,
                                      const assemble_value_t *value)
{
    _kernel_oserror *error = NULL;

    if (context->assign_var(context->user_data, label, label_length, value, &error) != ASSEMBLE_RESULT_OK)
    {
        if (error != NULL)
        {
            return error;
        }
        return assemble_set_error(ASSEMBLE_CPU_6502, ASSEMBLE_ERROR_TYPE_BAD_LABEL, ASSEMBLE_6502_ERR_NONE,
                                   "Label could not be assigned");
    }
    return NULL;
}

_kernel_oserror *assemble_6502_line(assemble_context_t *context,
                                     const uint8_t *line, size_t line_length)
{
    assemble_6502_variant_t variant;
    size_t pos;
    char label[64];
    size_t label_length = 0;
    int have_label = 0;
    char mnemonic[8];
    size_t consumed;
    int bit_number_missing;
    _kernel_oserror *error;

    context->bytes_used = 0;
    variant = assemble_6502_variant_from_opt(context->opt);
    pos = 0;

    pos += assemble_skip_spaces(line + pos, line_length - pos);

    if (pos < line_length && line[pos] == '.')
    {
        size_t start;

        pos += 1;
        start = pos;
        if (!(pos < line_length && assemble_is_ident_start(line[pos])))
        {
            return assemble_set_error(ASSEMBLE_CPU_6502, ASSEMBLE_ERROR_TYPE_BAD_LABEL, ASSEMBLE_6502_ERR_NONE,
                                       "Expected a label name after '.'");
        }
        while (pos < line_length && assemble_is_ident_char(line[pos]))
        {
            pos += 1;
        }
        label_length = pos - start;
        if (label_length >= sizeof(label))
        {
            label_length = sizeof(label) - 1;
        }
        memcpy(label, line + start, label_length);
        label[label_length] = '\0';
        have_label = 1;

        pos += assemble_skip_spaces(line + pos, line_length - pos);
    }

    if (pos >= line_length)
    {
        if (have_label)
        {
            assemble_value_t value;

            value.type = ASSEMBLE_VALUE_INTEGER;
            value.value.as_integer = (int32_t) context->address;
            return assign_label(context, label, label_length, &value);
        }
        return NULL;
    }

    consumed = read_mnemonic(line + pos, line_length - pos, mnemonic, &bit_number_missing);
    if (bit_number_missing)
    {
        return assemble_set_error(ASSEMBLE_CPU_6502, ASSEMBLE_ERROR_TYPE_SYNTAX, ASSEMBLE_6502_ERR_BIT_NUMBER,
                                   "Expected bit number (0-7) attached to mnemonic");
    }
    if (consumed == 0 || mnemonic[0] == '\0')
    {
        return assemble_set_error(ASSEMBLE_CPU_6502, ASSEMBLE_ERROR_TYPE_BAD_MNEMONIC, ASSEMBLE_6502_ERR_NONE,
                                   "Mnemonic not recognised");
    }
    pos += consumed;
    pos += assemble_skip_spaces(line + pos, line_length - pos);

    if (strcmp(mnemonic, "EQU") == 0)
    {
        assemble_value_t value;

        if (!have_label)
        {
            return assemble_set_error(ASSEMBLE_CPU_6502, ASSEMBLE_ERROR_TYPE_BAD_LABEL,
                                       ASSEMBLE_6502_ERR_NEED_LABEL_FOR_EQU,
                                       "EQU used without a preceding label");
        }
        error = eval_expr(context, line + pos, line_length - pos, &value, &consumed);
        if (error != NULL)
        {
            return error;
        }
        pos += consumed;
        error = check_trailing(line, line_length, pos);
        if (error != NULL)
        {
            return error;
        }
        return assign_label(context, label, label_length, &value);
    }

    if (have_label)
    {
        assemble_value_t value;

        value.type = ASSEMBLE_VALUE_INTEGER;
        value.value.as_integer = (int32_t) context->address;
        error = assign_label(context, label, label_length, &value);
        if (error != NULL)
        {
            return error;
        }
    }

    if (strcmp(mnemonic, "OPT") == 0)
    {
        /* OPT does not affect the assembled bytes; controlling passes
           and listing output is the calling assembler driver's job. */
        if (pos < line_length)
        {
            assemble_value_t value;

            error = eval_expr(context, line + pos, line_length - pos, &value, &consumed);
            if (error != NULL)
            {
                return error;
            }
            pos += consumed;
        }
        return check_trailing(line, line_length, pos);
    }

    if (strcmp(mnemonic, "DCB") == 0 || strcmp(mnemonic, "DCW") == 0 || strcmp(mnemonic, "DCD") == 0)
    {
        return assemble_dc(context, mnemonic, line + pos, line_length - pos);
    }

    return assemble_instruction(context, variant, mnemonic, line + pos, line_length - pos);
}
