/* BASIC tokenises OR/AND/EOR as single bytes; since ORA/ORB/ORCC,
   ANDA/ANDB/ANDCC and EORA/EORB are also 6809 mnemonics, these
   tokens must be recognised and expanded back to their mnemonic
   spelling before normal mnemonic lookup. */
#define TOKEN_AND 0x80
#define TOKEN_EOR 0x82
#define TOKEN_OR  0x84

typedef enum addr_mode
{
    MODE_IMPLIED,        /* no operand, eg NOP, RTS, ASLA, CLRB */
    MODE_IMMEDIATE,      /* #n or #nnnn, size given by immediate_size */
    MODE_DIRECT,         /* n -- 1 byte offset from the Direct Page register, forced by leading '<' */
    MODE_EXTENDED,       /* nnnn -- 2 byte absolute address; the default when no '<'/'>' is given */
    MODE_INDEXED,        /* rich postbyte-based addressing; encoded dynamically, not via this table */
    MODE_RELATIVE8,      /* short branch -- 1 byte signed offset */
    MODE_RELATIVE16,     /* long branch ('L' prefix on the mnemonic) -- 2 byte signed offset */
    MODE_REGISTER_LIST,  /* PSH/PUL -- 1 byte register bitmask */
    MODE_REGISTER_PAIR   /* EXG/TFR -- 1 byte packed register-pair nibbles */
} addr_mode_t;

typedef struct opcode_entry
{
    const char *mnemonic;      /* upper case, full word, eg "ADCA", "LDX", "LBSR" */
    addr_mode_t mode;
    uint16_t    opcode;        /* if > 0xFF, the high byte is a page-2/3 prefix (0x10/0x11)
                                   emitted first, then the low byte */
    uint8_t     immediate_size; /* only meaningful when mode == MODE_IMMEDIATE: 1 or 2 */
} opcode_entry_t;

